<!--
  Telas do launcher, uma DataTemplate por ViewModel (layout: design/prototype/index.html e DESIGN.md).
  Canvas de referência 1920x1080 (a janela escala com Viewbox). Área de conteúdo começa após a barra lateral.
  Navegação: elementos com nav:Nav.Group são navegáveis; nav:Nav.ScrollHost marca o que rola com o foco.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Launcher.UI.Wpf.Controls"
                    xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels"
                    xmlns:p10="clr-namespace:Launcher.PlayniteCompat.P10.Controls;assembly=Launcher.PlayniteCompat.P10">

  <!-- Esmaece o conteúdo rolável antes do cabeçalho (topo) e da barra de dicas (base). -->
  <!-- Absolute: a máscara segue a viewport (1080 de altura), não o conteúdo rolável, que é mais alto. -->
  <LinearGradientBrush x:Key="ContentFadeMask" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,1080">
    <GradientStop Offset="0" Color="Transparent" />
    <GradientStop Offset="0.111" Color="Transparent" />
    <GradientStop Offset="0.157" Color="Black" />
    <GradientStop Offset="0.889" Color="Black" />
    <GradientStop Offset="0.918" Color="Transparent" />
  </LinearGradientBrush>

  <!-- Fileira horizontal de capas: título + trilho que rola mantendo o item focado na primeira posição. -->
  <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type vm:GameItemViewModel}">
    <Button Style="{StaticResource GameCard}" Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}" CommandParameter="{Binding}"
            nav:Nav.Group="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            nav:Nav.Key="{Binding Id}" />
  </DataTemplate>

  <ItemsPanelTemplate x:Key="HorizontalPanel">
    <StackPanel Orientation="Horizontal" />
  </ItemsPanelTemplate>

  <!-- ===================================================================== Início -->
  <DataTemplate DataType="{x:Type vm:HomeViewModel}">
    <Grid>
      <TextBlock Text="{Binding Title}" Margin="64,60,0,0" Style="{StaticResource SectionTitle}" FontSize="{DynamicResource FsTitle}" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" />
      <Button Style="{StaticResource ChipButton}" Width="420" Height="60" Margin="0,56,72,0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2"
              Command="{Binding SearchCommand}" nav:Nav.Group="header" nav:Nav.Key="home:search">
        <StackPanel Orientation="Horizontal">
          <c:Icon Key="Icon.Search" Width="26" Height="26" Foreground="{DynamicResource OnAccentMutedBrush}" Margin="0,0,14,0" />
          <TextBlock Text="Buscar jogos" Foreground="{DynamicResource OnAccentMutedBrush}" />
        </StackPanel>
      </Button>

      <!-- Biblioteca vazia: como começar. -->
      <StackPanel Margin="64,0,72,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="1100"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Nenhum jogo ainda" Style="{StaticResource PageTitle}" />
        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="{DynamicResource FsBodyLg}" Foreground="{DynamicResource OnAccentMutedBrush}"
                   Text="O Tako encontra sozinho os jogos instalados pela Steam. Para outros jogos, adicione o executável ou atalho; capa, descrição e nota vêm automaticamente." />
        <StackPanel Orientation="Horizontal" Margin="0,40,0,0">
          <Button Style="{StaticResource PillButton}" Tag="primary" Command="{Binding AddGameCommand}" nav:Nav.Group="empty" nav:Nav.Key="home:add" nav:Nav.IsDefault="True">
            <StackPanel Orientation="Horizontal">
              <c:Icon Key="Icon.More" Width="26" Height="26" Foreground="{DynamicResource OnSurfaceSolidBrush}" Margin="0,0,14,0" />
              <TextBlock Text="Adicionar jogo" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PillButton}" Margin="18,0,0,0" Command="{Binding RescanCommand}" nav:Nav.Group="empty" nav:Nav.Key="home:rescan">
            <TextBlock Text="Procurar de novo" />
          </Button>
        </StackPanel>
      </StackPanel>

      <Canvas x:Name="Viewport" ClipToBounds="True" OpacityMask="{StaticResource ContentFadeMask}"
              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
        <StackPanel nav:Nav.ScrollHost="Vertical" Width="{Binding ActualWidth, ElementName=Viewport}">
          <StackPanel.RenderTransform>
            <TranslateTransform />
          </StackPanel.RenderTransform>

          <!-- Destaque: ancorado embaixo; o título cresce para cima e os botões não se movem. -->
          <Grid Height="500">
            <StackPanel Margin="64,0,72,40" VerticalAlignment="Bottom">
              <TextBlock Style="{StaticResource Overline}" Text="{Binding HeroOverline, Converter={StaticResource Upper}}" />
              <TextBlock Style="{StaticResource GameTitle}" Text="{Binding Hero.Title}" />
              <TextBlock Text="{Binding Hero.Meta}" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource OnAccentMutedBrush}" />
              <StackPanel Orientation="Horizontal" Margin="0,34,0,0">
                <Button Style="{StaticResource PillButton}" Tag="primary" Command="{Binding PlayHeroCommand}"
                        nav:Nav.Group="hero" nav:Nav.Key="home:play" nav:Nav.IsDefault="True">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Key="Icon.Play" Width="26" Height="26" Foreground="{DynamicResource OnSurfaceSolidBrush}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding PlayLabel}" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource RoundButton}" Margin="18,0,0,0" Command="{Binding HeroDetailsCommand}" nav:Nav.Group="hero" nav:Nav.Key="home:info">
                  <c:Icon Key="Icon.Info" Width="28" Height="28" Foreground="{DynamicResource OnAccentBrush}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Jogados recentemente -->
          <StackPanel Margin="0,0,0,40">
            <StackPanel Orientation="Horizontal" Margin="64,0,0,20">
              <TextBlock Text="Jogados recentemente" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding RecentCountText}" Margin="18,0,0,4" VerticalAlignment="Bottom" FontSize="{DynamicResource FsLabelMd}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentSubtleBrush}" />
            </StackPanel>
            <Canvas Height="456" ClipToBounds="True" Margin="0,-36,0,0">
              <StackPanel Orientation="Horizontal" Canvas.Left="64" Canvas.Top="36" nav:Nav.ScrollHost="Horizontal">
                <StackPanel.RenderTransform>
                  <TranslateTransform />
                </StackPanel.RenderTransform>
                <ItemsControl ItemsSource="{Binding RecentlyPlayed}" Tag="row-recent" ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource GameCardTemplate}" Focusable="False" />
                <Button Style="{StaticResource MoreTile}" Command="{Binding SeeAllCommand}" nav:Nav.Group="row-recent" nav:Nav.Key="home:see-all" />
              </StackPanel>
            </Canvas>
          </StackPanel>

          <!-- Adicionados recentemente -->
          <StackPanel Margin="0,0,0,160">
            <TextBlock Text="Adicionados recentemente" Margin="64,0,0,20" Style="{StaticResource SectionTitle}" />
            <Canvas Height="456" ClipToBounds="True" Margin="0,-36,0,0">
              <StackPanel Orientation="Horizontal" Canvas.Left="64" Canvas.Top="36" nav:Nav.ScrollHost="Horizontal">
                <StackPanel.RenderTransform>
                  <TranslateTransform />
                </StackPanel.RenderTransform>
                <ItemsControl ItemsSource="{Binding RecentlyAdded}" Tag="row-added" ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource GameCardTemplate}" Focusable="False" />
              </StackPanel>
            </Canvas>
          </StackPanel>
        </StackPanel>
      </Canvas>
    </Grid>
  </DataTemplate>

  <!-- ===================================================================== Biblioteca -->
  <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
    <Canvas x:Name="Viewport" ClipToBounds="True" OpacityMask="{StaticResource ContentFadeMask}">
      <StackPanel nav:Nav.ScrollHost="Vertical" Width="{Binding ActualWidth, ElementName=Viewport}">
        <StackPanel.RenderTransform>
          <TranslateTransform />
        </StackPanel.RenderTransform>
        <!-- Cabeçalho: título e contagem; abaixo, busca, filtros e ordem (frente E: UX-001/002/004). -->
        <StackPanel Margin="64,140,72,0">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" VerticalAlignment="Bottom" Margin="18,0,0,0" Command="{Binding AddGameCommand}" nav:Nav.Group="lib-head" nav:Nav.Key="lib:add">
              <StackPanel Orientation="Horizontal">
                <c:Icon Key="Icon.More" Width="24" Height="24" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,10,0" />
                <TextBlock Text="Adicionar jogo" />
              </StackPanel>
            </Button>
            <StackPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding CountText}" Margin="0,12,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource OnAccentMutedBrush}" />
            </StackPanel>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
            <Button Style="{StaticResource ChipButton}" MinWidth="300" Command="{Binding SearchCommand}" nav:Nav.Group="lib-head" nav:Nav.Key="lib:search">
              <StackPanel Orientation="Horizontal">
                <c:Icon Key="Icon.Search" Width="24" Height="24" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,12,0" />
                <TextBlock x:Name="SearchText" Text="{Binding SearchLabel}" MaxWidth="520" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource OnAccentMutedBrush}" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ChipButton}" Margin="18,0,0,0" Command="{Binding OpenFiltersCommand}" nav:Nav.Group="lib-head" nav:Nav.Key="lib:filters">
              <StackPanel Orientation="Horizontal">
                <c:Icon Key="Icon.Filter" Width="24" Height="24" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,12,0" />
                <TextBlock x:Name="FiltersText" Text="{Binding FiltersLabel}" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ChipButton}" Margin="18,0,0,0" Command="{Binding CycleSortCommand}" nav:Nav.Group="lib-head" nav:Nav.Key="lib:sort">
              <StackPanel Orientation="Horizontal">
                <c:Icon Key="Icon.Sort" Width="24" Height="24" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,12,0" />
                <TextBlock>
                  <Run Text="Ordenar:" /> <Run Text="{Binding SortLabel, Mode=OneWay}" FontWeight="ExtraBold" />
                </TextBlock>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ChipButton}" Margin="18,0,0,0" Command="{Binding ClearCriteriaCommand}" nav:Nav.Group="lib-head" nav:Nav.Key="lib:clear"
                    Visibility="{Binding HasCriteria, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <c:Icon Key="Icon.Close" Width="24" Height="24" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,12,0" />
                <TextBlock Text="Limpar" />
              </StackPanel>
            </Button>
          </StackPanel>
          <!-- Sem resultados: diz por quê e como sair (o foco fica na busca). -->
          <StackPanel Margin="0,72,0,0" MaxWidth="1100" HorizontalAlignment="Left" Visibility="{Binding IsEmptyResult, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding EmptyTitle}" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding EmptyText}" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="{DynamicResource FsBodyLg}" Foreground="{DynamicResource OnAccentMutedBrush}" />
          </StackPanel>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Games}" Tag="grid" Margin="64,48,72,200" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- Quebra pela largura disponível: mais colunas em telas mais largas. -->
              <WrapPanel ItemWidth="240" ItemHeight="440" HorizontalAlignment="Left" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource GameCard}" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                      nav:Nav.Group="grid" nav:Nav.Key="{Binding Id}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Canvas>
    <DataTemplate.Triggers>
      <!-- Busca ou filtro ligado: o texto do botão fica em destaque. -->
      <DataTrigger Binding="{Binding HasSearch}" Value="True">
        <Setter TargetName="SearchText" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter TargetName="SearchText" Property="FontWeight" Value="ExtraBold" />
      </DataTrigger>
      <DataTrigger Binding="{Binding HasFilters}" Value="True">
        <Setter TargetName="FiltersText" Property="FontWeight" Value="ExtraBold" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ===================================================================== Detalhes -->
  <DataTemplate DataType="{x:Type vm:DetailsViewModel}">
    <StackPanel Margin="64,0,72,150" VerticalAlignment="Bottom" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource Overline}" Text="{Binding Game.Overline, Converter={StaticResource Upper}}" />
      <TextBlock Style="{StaticResource GameTitle}" Text="{Binding Game.Title}" />
      <ItemsControl ItemsSource="{Binding Stats}" Margin="0,26,0,30" Focusable="False" ItemsPanel="{StaticResource HorizontalPanel}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,48,0">
              <TextBlock Text="{Binding Label, Converter={StaticResource Upper}}" FontSize="{DynamicResource FsLabelSm}" FontWeight="Bold" Foreground="{DynamicResource OnAccentSubtleBrush}" />
              <TextBlock Text="{Binding Value}" Margin="0,8,0,0" FontSize="{DynamicResource FsTitle}" FontWeight="Bold" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Game.Description}" MaxWidth="900" HorizontalAlignment="Left" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                 FontSize="{DynamicResource FsBodyLg}" LineStackingStrategy="BlockLineHeight" LineHeight="39" MaxHeight="117" Foreground="{DynamicResource OnAccentMutedBrush}" />
      <Border Background="#47000000" CornerRadius="14" Padding="20,12" Margin="0,22,0,0" HorizontalAlignment="Left"
              Visibility="{Binding Game.Note, Converter={StaticResource NotNullToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <c:Icon Key="Icon.Alert" Width="24" Height="24" Foreground="{DynamicResource WarningBrush}" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Game.Note}" FontSize="{DynamicResource FsLabelMd}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,44,0,0">
        <Button Style="{StaticResource PillButton}" Tag="primary" Command="{Binding PrimaryCommand}" nav:Nav.Group="details" nav:Nav.Key="details:primary" nav:Nav.IsDefault="True">
          <StackPanel Orientation="Horizontal">
            <c:Icon Key="Icon.Play" Width="26" Height="26" Foreground="{DynamicResource OnSurfaceSolidBrush}" Margin="0,0,14,0"
                    Visibility="{Binding PrimaryHasPlayIcon, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding PrimaryLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource PillButton}" Margin="18,0,0,0" Command="{Binding ToggleFavoriteCommand}" nav:Nav.Group="details" nav:Nav.Key="details:fav">
          <StackPanel Orientation="Horizontal">
            <c:Icon Key="{Binding FavoriteIconKey}" Width="26" Height="26" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,14,0" />
            <TextBlock Text="{Binding FavoriteLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource PillButton}" Margin="18,0,0,0" Command="{Binding OptionsCommand}" nav:Nav.Group="details" nav:Nav.Key="details:options">
          <StackPanel Orientation="Horizontal">
            <c:Icon Key="Icon.Folder" Width="26" Height="26" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,14,0" />
            <TextBlock Text="Opções" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <!-- ===================================================================== Configurações -->
  <DataTemplate x:Key="SettingText">
    <StackPanel>
      <TextBlock Text="{Binding [0]}" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding [1]}" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <!-- Rola com o foco: há mais linhas do que cabem na altura. -->
    <Canvas x:Name="Viewport" ClipToBounds="True" OpacityMask="{StaticResource ContentFadeMask}">
    <StackPanel Canvas.Left="64" Canvas.Top="140" Width="1180" Margin="0,0,0,200" nav:Nav.ScrollHost="Vertical">
      <StackPanel.RenderTransform>
        <TranslateTransform />
      </StackPanel.RenderTransform>
      <TextBlock Text="Configurações" Margin="0,0,0,40" Style="{StaticResource PageTitle}" />
      <Button Style="{StaticResource SettingRow}" Command="{Binding AddGameCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:add">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Escolher" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Adicionar jogo" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Executável ou atalho de qualquer jogo; capa e informações são buscadas automaticamente" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding RescanCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:rescan">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Procurar" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Procurar jogos instalados" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Lê de novo as bibliotecas da Steam (todas as pastas configuradas na Steam)" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding RefreshMetadataCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:metadata">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Atualizar" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Atualizar dados dos jogos" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Descrição, gêneros, lançamento, desenvolvedora, nota do Metacritic e artes (fonte: Steam Store)" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding OpenLogsCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:logs">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Abrir" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Abrir pasta de logs" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Registros de diagnóstico dos últimos 7 dias, sem dados pessoais; anexe ao relatar um problema" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <!-- Atualizações (GitHub Releases): estado, verificar agora e preferências. -->
      <Button Style="{StaticResource SettingRow}" Command="{Binding DataContext.CheckUpdatesNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" nav:Nav.Group="settings" nav:Nav.Key="settings:updates">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Verificar agora" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Atualizações" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DataContext.UpdateStatus, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding DataContext.ToggleAutoUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}" nav:Nav.Group="settings" nav:Nav.Key="settings:autoupdate">
        <DockPanel>
          <ContentControl DockPanel.Dock="Right" Style="{StaticResource ToggleVisual}" Tag="{Binding DataContext.UpdatePreferences.AutoUpdate, RelativeSource={RelativeSource AncestorType=Window}}" />
          <StackPanel>
            <TextBlock Text="Atualizar automaticamente" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Ao abrir, procura e baixa a versão nova em segundo plano; instala ao reiniciar ou ao sair" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding DataContext.TogglePrereleaseUpdatesCommand, RelativeSource={RelativeSource AncestorType=Window}}" nav:Nav.Group="settings" nav:Nav.Key="settings:prerelease">
        <DockPanel>
          <ContentControl DockPanel.Dock="Right" Style="{StaticResource ToggleVisual}" Tag="{Binding DataContext.UpdatePreferences.Prereleases, RelativeSource={RelativeSource AncestorType=Window}}" />
          <StackPanel>
            <TextBlock Text="Receber versões de teste" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Alpha e beta chegam antes e podem ter falhas; versões de teste já recebem testes" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <!-- Resiliência (frente D): modo seguro (MVP-036) e estado do Xbox mode / FSE (MVP-008). -->
      <Button Style="{StaticResource SettingRow}" Command="{Binding DataContext.ExitSafeModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" nav:Nav.Group="settings" nav:Nav.Key="settings:safemode">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding DataContext.SafeModeLabel, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Modo seguro" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DataContext.SafeModeDescription, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding DataContext.ShowFseStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}" nav:Nav.Group="settings" nav:Nav.Key="settings:fse">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding DataContext.FseStatus.Label, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
          <StackPanel>
            <TextBlock Text="Xbox mode (tela cheia do Windows)" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DataContext.FseDescription, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <!-- Monitores e áudio (frente E2, MVP-012). -->
      <Button Style="{StaticResource SettingRow}" Command="{Binding ToggleRestoreEnvironmentCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:environment">
        <DockPanel>
          <ContentControl DockPanel.Dock="Right" Style="{StaticResource ToggleVisual}" Tag="{Binding Settings.RestoreEnvironmentAfterGame}" />
          <StackPanel>
            <TextBlock Text="Restaurar monitores e áudio ao sair do jogo" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Volta resolução, taxa de atualização, monitor principal, saída de áudio e volume como estavam antes do jogo" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <!-- Diagnóstico do sistema (frente G, MVP-034): relatório para o checklist de hardware. -->
      <Button Style="{StaticResource SettingRow}" Command="{Binding DataContext.ShowSystemDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=Window}}" nav:Nav.Group="settings" nav:Nav.Key="settings:diagnostics">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Gerar" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Diagnóstico do sistema" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Windows, monitores, controles, Steam e Xbox mode, sem dados pessoais; anexe ao rodar o checklist de hardware" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding ReapplyThemeCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:theme" nav:Nav.IsDefault="True">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding ThemeLabel}" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Tema" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Recarrega o tema padrão pelo carregador XAML restrito. Temas do Playnite 10 chegam no Marco 1." Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding ToggleDynamicColorCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:dynamic">
        <DockPanel>
          <ContentControl DockPanel.Dock="Right" Style="{StaticResource ToggleVisual}" Tag="{Binding Settings.DynamicColor}" />
          <StackPanel>
            <TextBlock Text="Cor dinâmica" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="A interface assume a cor da arte do jogo em foco" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding ToggleReducedMotionCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:motion">
        <DockPanel>
          <ContentControl DockPanel.Dock="Right" Style="{StaticResource ToggleVisual}" Tag="{Binding Settings.ReducedMotion}" />
          <StackPanel>
            <TextBlock Text="Reduzir animações" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Remove transições de cor e de rolagem" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding ToggleStartupCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:startup">
        <DockPanel>
          <ContentControl DockPanel.Dock="Right" Style="{StaticResource ToggleVisual}" Tag="{Binding Settings.StartFullscreenOnLogin}" />
          <StackPanel>
            <TextBlock Text="Abrir em tela cheia ao iniciar o Windows" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Fullscreen convencional; integração com o Xbox mode depende da Microsoft (MVP-007)" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <!-- Temas (frente C, MVP-020): página própria em Resources/ThemeViews.xaml. -->
      <Button Style="{StaticResource SettingRow}" Command="{Binding DataContext.OpenThemesCommand, RelativeSource={RelativeSource AncestorType=Window}}" nav:Nav.Group="settings" nav:Nav.Key="settings:themes">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Gerenciar" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Temas" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Importar temas do Playnite (.pthm), prévia, diagnóstico, remover e restaurar o padrão" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding PreviewPlayniteThemeCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:playnite">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Abrir" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Prévia de tema Playnite 10" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Renderiza o tema Playnite em uso (padrão: Fullscreen do Playnite) com a sua biblioteca, sem o Playnite instalado (H2)" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource SettingRow}" Command="{Binding SimulateThemeFailureCommand}" nav:Nav.Group="settings" nav:Nav.Key="settings:crash">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Testar" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
            <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Carregar tema inválido" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
            <TextBlock Text="Aplica Themes/Exemplo-Invalido e mostra a tela de recuperação (MVP-021)" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Button>
    </StackPanel>
    </Canvas>
  </DataTemplate>

  <!-- ===================================================================== Sobreposições -->

  <!-- Botão de ação de diálogo/recuperação (estilo por ActionStyle). -->
  <DataTemplate x:Key="OverlayActionTemplate" DataType="{x:Type vm:OverlayAction}">
    <Button x:Name="Action" Style="{StaticResource PillButton}" Margin="0,0,18,18" Command="{Binding Command}"
            nav:Nav.Group="overlay" nav:Nav.Key="{Binding Label}" nav:Nav.IsDefault="{Binding IsDefault}">
      <TextBlock Text="{Binding Label}" />
    </Button>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Style}" Value="Primary">
        <Setter TargetName="Action" Property="Tag" Value="primary" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Style}" Value="Danger">
        <Setter TargetName="Action" Property="Tag" Value="danger" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Iniciando -->
  <DataTemplate DataType="{x:Type vm:LaunchOverlayViewModel}">
    <Grid Background="{Binding Game.FallbackBrush}">
      <StackPanel Margin="160,0,160,0" VerticalAlignment="Center" HorizontalAlignment="Left">
        <Border Width="190" Height="285" CornerRadius="14" HorizontalAlignment="Left" Margin="0,0,0,40" Background="{Binding Game.FallbackBrush}" Effect="{StaticResource FocusShadow}">
          <Border.Clip>
            <RectangleGeometry Rect="0,0,190,285" RadiusX="14" RadiusY="14" />
          </Border.Clip>
          <Image Source="{Binding Game.Cover}" Stretch="UniformToFill" />
        </Border>
        <TextBlock Style="{StaticResource Overline}" Text="INICIANDO" />
        <TextBlock Style="{StaticResource GameTitle}" Text="{Binding Game.Title}" />
        <Border Width="560" Height="8" CornerRadius="4" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,24,0,0">
          <Border x:Name="Progress" CornerRadius="4" Background="White" HorizontalAlignment="Left" Width="0" />
        </Border>
        <TextBlock Text="{Binding Status}" Margin="0,22,0,0" FontSize="{DynamicResource FsBodyLg}" Foreground="{DynamicResource OnAccentMutedBrush}" />
        <Button Style="{StaticResource PillButton}" Margin="0,34,0,0" HorizontalAlignment="Left" Command="{Binding Cancel}" nav:Nav.Group="overlay" nav:Nav.IsDefault="True">
          <TextBlock Text="Cancelar" />
        </Button>
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Progress" Storyboard.TargetProperty="Width" From="0" To="560" Duration="0:0:2.4" EasingFunction="{StaticResource EaseOut}" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Jogo em execução (simulado no Marco 0) + HUD de desempenho. -->
  <DataTemplate DataType="{x:Type vm:GameSessionViewModel}">
    <Grid Background="Black">
      <Rectangle Fill="{Binding Game.FallbackBrush}" />
      <Image Source="{Binding Frame}" Stretch="UniformToFill" />
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0.55" Color="Transparent" />
            <GradientStop Offset="1" Color="#73000000" />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Border x:Name="Hud" Margin="32,28,0,0" Padding="18,10" CornerRadius="8" Background="#99000000" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Foreground="{DynamicResource SuccessBrush}" FontSize="{DynamicResource FsLabelSm}" FontWeight="Bold">
            <Run Text="{Binding Performance.Fps, Mode=OneWay}" /><Run Text=" FPS" />
          </TextBlock>
          <TextBlock x:Name="HudFull" Margin="18,0,0,0" FontSize="{DynamicResource FsLabelSm}" FontWeight="Bold" Visibility="Collapsed">
            <Run Text="Quadro " Foreground="#8CFFFFFF" /><Run Text="{Binding Performance.FrameTimeMs, Mode=OneWay, StringFormat={}{0:0.0} ms}" />
            <Run Text="   CPU " Foreground="#8CFFFFFF" /><Run Text="{Binding Performance.Cpu, Mode=OneWay, StringFormat={}{0}%}" />
            <Run Text="   GPU " Foreground="#8CFFFFFF" /><Run Text="{Binding Performance.Gpu, Mode=OneWay, StringFormat={}{0}%}" /><Run Text="{Binding Performance.GpuTemperature, Mode=OneWay, StringFormat={} · {0}°C}" />
          </TextBlock>
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Options.PerfMode}" Value="1">
        <Setter TargetName="Hud" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Options.PerfMode}" Value="2">
        <Setter TargetName="Hud" Property="Visibility" Value="Visible" />
        <Setter TargetName="HudFull" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Central de Controle (topo): barra de ícones, cartões vivos e painel do ícone. -->
  <DataTemplate DataType="{x:Type vm:ControlCenterViewModel}">
    <Grid x:Name="Root">
      <!-- Clique fora: fecha o painel, ou o menu. -->
      <Button Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False" Cursor="Arrow">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Rectangle>
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Offset="0" Color="#F5060810" />
                  <GradientStop Offset="0.3" Color="#E0060810" />
                  <GradientStop Offset="0.58" Color="#59060810" />
                  <GradientStop Offset="0.8" Color="#00060810" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
          </ControlTemplate>
        </Button.Template>
      </Button>

      <ItemsControl ItemsSource="{Binding Bar}" Margin="0,40,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Focusable="False" nav:Nav.LockHorizontal="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Rectangle x:Name="Separator" Width="2" Height="40" Fill="#2EFFFFFF" Margin="6,0" Visibility="Collapsed" />
              <Button x:Name="Icon" Style="{StaticResource ControlBarIcon}"
                      Command="{Binding DataContext.ActivateBarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}"
                      nav:Nav.Group="qbar" nav:Nav.Key="{Binding Key, StringFormat=bar:{0}}" nav:Nav.Link="{Binding Key}">
                <Grid>
                  <c:Icon x:Name="Glyph" Key="{Binding IconKey}" Width="34" Height="34" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <Border x:Name="Cover" Width="52" Height="52" CornerRadius="12" Visibility="Collapsed"
                          Background="{Binding DataContext.Game.FallbackBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                    <Border.Clip>
                      <RectangleGeometry Rect="0,0,52,52" RadiusX="12" RadiusY="12" />
                    </Border.Clip>
                    <Image Source="{Binding DataContext.Game.Cover, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Stretch="UniformToFill" />
                  </Border>
                  <Ellipse x:Name="Dot" Width="14" Height="14" Fill="{DynamicResource SuccessBrush}" Stroke="#FF0B0E13" StrokeThickness="3"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Visibility="Collapsed" />
                </Grid>
              </Button>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                <Setter TargetName="Separator" Property="Visibility" Value="Visible" />
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsGame}" Value="True">
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Cover" Property="Visibility" Value="Visible" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsDanger}" Value="True">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Trilho de cartões: rola com o foco (mais cartões que a largura da tela) sem recortar o anel de foco. -->
      <Canvas Margin="0,160,0,0" Height="340" VerticalAlignment="Top" ClipToBounds="True"
              Visibility="{Binding IsPopoverOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
      <ItemsControl ItemsSource="{Binding Cards}" Canvas.Left="72" Canvas.Top="20" Focusable="False" nav:Nav.LockHorizontal="True" nav:Nav.ScrollHost="Horizontal">
        <ItemsControl.RenderTransform>
          <TranslateTransform />
        </ItemsControl.RenderTransform>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource ControlCard}"
                    Command="{Binding DataContext.ActivateCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}"
                    nav:Nav.Group="qcards" nav:Nav.Key="{Binding Key, StringFormat=card:{0}}" nav:Nav.Link="{Binding Key}" nav:Nav.IsDefault="{Binding IsWide}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Canvas>

      <!-- Painel do ícone: um por vez; os cartões saem de cena enquanto ele está aberto. -->
      <Border x:Name="Popover" Width="600" Margin="0,160,0,0" Padding="26,26,26,16" CornerRadius="26" Background="{DynamicResource PanelStrongBrush}"
              HorizontalAlignment="Left" VerticalAlignment="Top" Effect="{StaticResource FocusShadow}"
              nav:Nav.IsModalScope="True" Tag="{Binding Popover.Key}"
              Visibility="{Binding Popover, Converter={StaticResource NotNullToVisibility}}">
        <ItemsControl ItemsSource="{Binding Popover.Sections}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4,0,8">
                <TextBlock Text="{Binding Title, Converter={StaticResource Upper}}" Margin="0,0,0,12" FontSize="{DynamicResource FsLabelSm}" FontWeight="Bold" Foreground="#80FFFFFF" />
                <TextBlock Text="{Binding Description}" Margin="0,-4,0,12" TextWrapping="Wrap" FontSize="{DynamicResource FsLabelSm}" Foreground="#8CFFFFFF"
                           Visibility="{Binding Description, Converter={StaticResource NotNullToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button x:Name="Row" Style="{StaticResource PanelRow}" Command="{Binding Command}"
                              nav:Nav.Group="qpop" nav:Nav.AdjustCommand="{Binding AdjustCommand}">
                        <DockPanel>
                          <c:Icon DockPanel.Dock="Left" Key="{Binding IconKey}" Width="30" Height="30" Margin="0,0,18,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Visibility="{Binding IconKey, Converter={StaticResource NotNullToVisibility}}" />
                          <!-- Fim da linha: marcador, chave, valor ou bateria. -->
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="End" Text="{Binding EndText}" FontSize="{DynamicResource FsLabelMd}" Opacity="0.65" VerticalAlignment="Center" />
                            <Ellipse x:Name="Radio" Width="26" Height="26" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="3" Opacity="0.5" Visibility="Collapsed" />
                            <ContentControl x:Name="Toggle" Style="{StaticResource ToggleVisual}" Tag="{Binding IsOn}" Visibility="Collapsed" />
                          </StackPanel>
                          <Grid x:Name="Bar" Tag="bar" Width="360" Height="26" Margin="18,0,22,0" HorizontalAlignment="Left" Background="Transparent" Visibility="Collapsed">
                            <Border Height="10" CornerRadius="5" Background="#33FFFFFF" />
                            <Border Height="10" CornerRadius="5" HorizontalAlignment="Left" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Width="{Binding Fraction, Converter={StaticResource FractionToWidth}, ConverterParameter=360}" />
                            <Ellipse Width="26" Height="26" HorizontalAlignment="Left" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     Margin="{Binding Fraction, Converter={StaticResource FractionToThumbMargin}, ConverterParameter=360}" />
                          </Grid>
                          <TextBlock x:Name="Label" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </Button>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsRadio}" Value="True">
                          <Setter TargetName="Radio" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                          <Setter TargetName="Radio" Property="Opacity" Value="1" />
                          <Setter TargetName="Radio" Property="StrokeThickness" Value="8" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToggle}" Value="True">
                          <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
                          <Setter TargetName="Radio" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSlider}" Value="True">
                          <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                          <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBattery}" Value="True">
                          <Setter TargetName="End" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                          <Setter TargetName="End" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                          <Setter TargetName="Row" Property="Tag" Value="danger" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Grid>
  </DataTemplate>

  <!-- Prévia de tema Playnite 10: tudo dentro do ThemeScope usa os recursos do tema (estilos, cores, templates). -->
  <DataTemplate DataType="{x:Type vm:PlaynitePreviewViewModel}">
    <c:ThemeScope ThemeResources="{Binding Resources}">
      <Grid Background="{DynamicResource MainBackgourndBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <!-- Espaço da barra de dicas do launcher, que fica por cima de tudo. -->
          <RowDefinition Height="88" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource TopBarBackgroundBrush}" Padding="72,40,72,28">
          <StackPanel>
            <TextBlock Text="Tema Playnite 10 (prévia)" Style="{DynamicResource TextBlockBaseStyle}" FontSize="40" />
            <TextBlock Text="{Binding Summary}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDark}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <c:NavigableListBox Grid.Row="1" ItemsSource="{Binding Games}" ItemGroup="p10-games" Margin="64,40,64,0"
                            Background="Transparent" BorderThickness="0" ItemContainerStyle="{DynamicResource ListGameItemStyle}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <p10:GameListItem Width="200" Height="300" Style="{DynamicResource ListGameItemTemplate}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </c:NavigableListBox>
        <Border Grid.Row="2" Background="{DynamicResource BottomBarBackgroundBrush}" Padding="72,18">
          <DockPanel>
            <p10:ButtonEx DockPanel.Dock="Right" Style="{DynamicResource ButtonBottomMenu}" Command="{Binding Close}" nav:Nav.Group="p10-bar" Padding="18,8">
              <TextBlock Text="Voltar ao Tako" Style="{DynamicResource TextBlockBaseStyle}" />
            </p10:ButtonEx>
            <ItemsControl ItemsSource="{Binding RejectedLines}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat=Não suportado: {0}}" Style="{DynamicResource TextBlockBaseStyle}" FontSize="14" Foreground="{DynamicResource TextBrushDark}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>
    </c:ThemeScope>
  </DataTemplate>

  <!-- Diálogo -->
  <DataTemplate DataType="{x:Type vm:DialogViewModel}">
    <Grid>
      <Button Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False" Cursor="Arrow">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Rectangle Fill="{DynamicResource ScrimBrush}" />
          </ControlTemplate>
        </Button.Template>
      </Button>
      <Border Width="820" CornerRadius="28" Background="#FF1A1E26" Padding="56" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Text}" Margin="0,16,0,0" FontSize="{DynamicResource FsBodyLg}" Foreground="#B3FFFFFF" TextWrapping="Wrap" />
          <!-- Várias ações (ex.: opções do jogo) quebram em linhas. -->
          <ItemsControl ItemsSource="{Binding Actions}" Margin="0,40,0,-18" Focusable="False" ItemTemplate="{StaticResource OverlayActionTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>

  <!-- Recuperação (MVP-021/036) -->
  <DataTemplate DataType="{x:Type vm:RecoveryViewModel}">
    <Grid Background="#FF12151B">
      <StackPanel Margin="160,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="1300">
        <Border Width="88" Height="88" CornerRadius="26" Background="#29FF5A5F" HorizontalAlignment="Left" Margin="0,0,0,36">
          <c:Icon Key="Icon.Alert" Width="48" Height="48" Foreground="{DynamicResource ErrorBrush}" />
        </Border>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontWeight="Normal" />
        <TextBlock Text="{Binding Message}" Margin="0,18,0,0"
                   FontSize="{DynamicResource FsBodyLg}" Foreground="#B3FFFFFF" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Actions}" Margin="0,44,0,0" Focusable="False" ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource OverlayActionTemplate}" />
        <TextBlock Text="{Binding Detail}" Margin="0,30,0,0" FontFamily="Consolas" FontSize="{DynamicResource FsLabelSm}" Foreground="#73FFFFFF" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
