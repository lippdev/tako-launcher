<!--
  Configurações › Dados dos jogos (IGDB), ADR-0021, e Dados de ROMs (ScreenScraper), ADR-0022. Separado de Views.xaml para que a reorganização das Configurações
  mova só a linha que abre esta sobreposição. Usa FieldBox/FieldLabel de SessionViews.xaml e PillButton de Styles.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels">

  <!-- ↑ ↓ ← → passam pelos botões e campos; Esc/B cancela. -->
  <DataTemplate DataType="{x:Type vm:IgdbSettingsViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="1180" CornerRadius="28" Background="#FF1A1E26" Padding="56,40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource HintBarReserve}">
        <StackPanel>
          <TextBlock Text="Dados dos jogos (IGDB)" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" />
          <TextBlock Text="A IGDB traz descrição, gêneros, notas e artes de jogos de qualquer loja e de consoles. Ela é gratuita, mas pede uma chave da Twitch sua; o Tako guarda a chave cifrada neste PC." Margin="0,10,0,0" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" />

          <Button Style="{StaticResource PillButton}" Margin="0,24,0,0" HorizontalAlignment="Stretch" Command="{Binding ToggleEnabledCommand}"
                  nav:Nav.Group="overlay" nav:Nav.Key="igdb:enabled" nav:Nav.IsDefault="True">
            <TextBlock Text="{Binding EnabledLabel}" />
          </Button>

          <!-- Passo a passo curto: criar o app na Twitch e copiar a chave. -->
          <ItemsControl ItemsSource="{Binding Steps}" Margin="0,22,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Margin="0,0,0,8" FontSize="{DynamicResource FsLabelSm}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource PillButton}" Margin="0,6,0,0" HorizontalAlignment="Left" Command="{Binding OpenConsoleCommand}" nav:Nav.Group="overlay" nav:Nav.Key="igdb:console">
            <TextBlock Text="Abrir dev.twitch.tv no navegador" />
          </Button>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Client ID" />
              <TextBox Style="{StaticResource FieldBox}" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                       nav:Nav.Group="overlay" nav:Nav.Key="igdb:clientid" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Margin="18,0,0,0" VerticalAlignment="Bottom" Command="{Binding PasteClientIdCommand}" nav:Nav.Group="overlay" nav:Nav.Key="igdb:paste-id">
              <TextBlock Text="Colar" />
            </Button>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding SecretLabel}" />
              <TextBox Style="{StaticResource SecretBox}" Tag="{Binding IsSecretVisible}" Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}"
                       nav:Nav.Group="overlay" nav:Nav.Key="igdb:secret" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Margin="18,0,0,0" VerticalAlignment="Bottom" Command="{Binding PasteSecretCommand}" nav:Nav.Group="overlay" nav:Nav.Key="igdb:paste-secret">
              <TextBlock Text="Colar" />
            </Button>
            <!-- Segredo mascarado: "Mostrar" alterna entre ● e o texto. -->
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Margin="18,0,0,0" VerticalAlignment="Bottom" Command="{Binding ToggleSecretVisibleCommand}" nav:Nav.Group="overlay" nav:Nav.Key="igdb:show-secret">
              <TextBlock Text="{Binding SecretToggleLabel}" />
            </Button>
          </Grid>

          <TextBlock x:Name="StatusText" Text="{Binding Status}" Margin="0,22,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

          <Grid Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" Margin="0,0,18,0" Command="{Binding TestCommand}" nav:Nav.Group="overlay" nav:Nav.Key="igdb:test">
              <TextBlock Text="{Binding TestLabel}" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Tag="primary" Margin="0,0,18,0" Command="{Binding SaveCommand}" nav:Nav.Group="overlay" nav:Nav.Key="igdb:save">
              <TextBlock Text="Salvar" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Command="{Binding CancelCommand}" nav:Nav.Group="overlay" nav:Nav.Key="igdb:cancel">
              <TextBlock Text="Cancelar" />
            </Button>
          </Grid>

          <!-- Atribuição exigida pelos termos da IGDB. -->
          <TextBlock Text="Dados e imagens fornecidos pela IGDB.com (Twitch). A IGDB não endossa o Tako." Margin="0,20,0,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" />
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasStatus}" Value="True">
        <Setter TargetName="StatusText" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusIsError}" Value="True">
        <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Configurações › Dados de ROMs (ScreenScraper), ADR-0022: mesmo padrão da IGDB. ↑ ↓ ← → passam pelos botões e campos; Esc/B cancela. -->
  <DataTemplate DataType="{x:Type vm:ScreenScraperSettingsViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="1180" CornerRadius="28" Background="#FF1A1E26" Padding="56,40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource HintBarReserve}">
        <StackPanel>
          <TextBlock Text="Dados de ROMs (ScreenScraper)" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" />
          <TextBlock Text="O ScreenScraper reconhece ROMs pelo arquivo e traz nome, descrição, caixa, logo, capturas e vídeo de jogos de console. Ele é gratuito, mas pede uma conta sua; o Tako guarda a conta cifrada neste PC." Margin="0,10,0,0" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" />

          <Button Style="{StaticResource PillButton}" Margin="0,24,0,0" HorizontalAlignment="Stretch" Command="{Binding ToggleEnabledCommand}"
                  nav:Nav.Group="overlay" nav:Nav.Key="ss:enabled" nav:Nav.IsDefault="True">
            <TextBlock Text="{Binding EnabledLabel}" />
          </Button>

          <ItemsControl ItemsSource="{Binding Steps}" Margin="0,22,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Margin="0,0,0,8" FontSize="{DynamicResource FsLabelSm}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource PillButton}" Margin="0,6,0,0" HorizontalAlignment="Left" Command="{Binding OpenSiteCommand}" nav:Nav.Group="overlay" nav:Nav.Key="ss:site">
            <TextBlock Text="Criar conta em screenscraper.fr" />
          </Button>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Usuário do ScreenScraper" />
              <TextBox Style="{StaticResource FieldBox}" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}"
                       nav:Nav.Group="overlay" nav:Nav.Key="ss:user" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Margin="18,0,0,0" VerticalAlignment="Bottom" Command="{Binding PasteUserCommand}" nav:Nav.Group="overlay" nav:Nav.Key="ss:paste-user">
              <TextBlock Text="Colar" />
            </Button>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding PasswordLabel}" />
              <TextBox Style="{StaticResource SecretBox}" Tag="{Binding IsSecretVisible}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                       nav:Nav.Group="overlay" nav:Nav.Key="ss:password" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Margin="18,0,0,0" VerticalAlignment="Bottom" Command="{Binding PastePasswordCommand}" nav:Nav.Group="overlay" nav:Nav.Key="ss:paste-password">
              <TextBlock Text="Colar" />
            </Button>
            <!-- Segredo mascarado: "Mostrar" alterna entre ● e o texto. -->
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Margin="18,0,0,0" VerticalAlignment="Bottom" Command="{Binding ToggleSecretVisibleCommand}" nav:Nav.Group="overlay" nav:Nav.Key="ss:show-password">
              <TextBlock Text="{Binding SecretToggleLabel}" />
            </Button>
          </Grid>

          <TextBlock x:Name="StatusText" Text="{Binding Status}" Margin="0,22,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

          <Grid Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" Margin="0,0,18,0" Command="{Binding TestCommand}" nav:Nav.Group="overlay" nav:Nav.Key="ss:test">
              <TextBlock Text="{Binding TestLabel}" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Tag="primary" Margin="0,0,18,0" Command="{Binding SaveCommand}" nav:Nav.Group="overlay" nav:Nav.Key="ss:save">
              <TextBlock Text="Salvar" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Command="{Binding CancelCommand}" nav:Nav.Group="overlay" nav:Nav.Key="ss:cancel">
              <TextBlock Text="Cancelar" />
            </Button>
          </Grid>

          <!-- Créditos exigidos pelo ScreenScraper. -->
          <TextBlock Text="Dados e mídias fornecidos por ScreenScraper.fr, um banco de dados comunitário. Obrigado a todos os colaboradores." Margin="0,20,0,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasStatus}" Value="True">
        <Setter TargetName="StatusText" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusIsError}" Value="True">
        <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
