<!--
  Tela de jogo (MVP-002): confirmação "Você consegue ver esta tela?" na primeira vez com uma tela ou modo novo.
  Sem resposta, as telas voltam ao normal sozinhas (contagem regressiva). Também a tela de andamento do modo console
  e da volta para a mesa.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels">

  <DataTemplate DataType="{x:Type vm:ScreenConfirmViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="820" CornerRadius="28" Background="#FF1A1E26" Padding="56" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource HintBarReserve}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Text}" Margin="0,16,0,0" FontSize="{DynamicResource FsBodyLg}" Foreground="#B3FFFFFF" TextWrapping="Wrap" />
          <ProgressBar Margin="0,28,0,0" Height="6" Minimum="0" Maximum="{Binding Seconds}" Value="{Binding SecondsLeft, Mode=OneWay}" Foreground="#E6FFFFFF" Background="#26FFFFFF" BorderThickness="0" />
          <TextBlock Text="{Binding CountdownText}" Margin="0,10,0,0" FontSize="{DynamicResource FsLabelSm}" Foreground="#99FFFFFF" />
          <ItemsControl ItemsSource="{Binding Actions}" Margin="0,36,0,-18" Focusable="False" ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource OverlayActionTemplate}" />
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>

  <!-- "Voltando para a mesa…" / "Indo para a tela de jogo…": o trabalho roda fora da thread da UI e a barra continua andando. -->
  <DataTemplate DataType="{x:Type vm:ProgressOverlayViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="820" CornerRadius="28" Background="#FF1A1E26" Padding="56" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource HintBarReserve}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail}" Margin="0,16,0,0" FontSize="{DynamicResource FsBodyLg}" Foreground="#B3FFFFFF" TextWrapping="Wrap" />
          <Border Height="6" Margin="0,32,0,0" CornerRadius="3" Background="#26FFFFFF" ClipToBounds="True">
            <Border x:Name="Runner" Width="180" CornerRadius="3" Background="#E6FFFFFF" HorizontalAlignment="Left">
              <Border.RenderTransform>
                <TranslateTransform X="-180" />
              </Border.RenderTransform>
            </Border>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
        <BeginStoryboard>
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Runner" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-180" To="708" Duration="0:0:1.4" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
