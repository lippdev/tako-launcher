<!--
  Telas de áudio, Steam e TV durante o jogo (MVP-002 parte 2). Separado de Views.xaml para que as frentes não editem o
  mesmo arquivo. Usa FieldBox/FieldLabel de SessionViews.xaml e PillButton de Styles.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels">

  <!-- Configurações › TV: ↑ ↓ ← → passam pelos campos e botões; Esc/B cancela. -->
  <DataTemplate DataType="{x:Type vm:TvSettingsViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="1180" CornerRadius="28" Background="#FF1A1E26" Padding="56,44" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource HintBarReserve}">
        <StackPanel>
          <TextBlock Text="Ligar a TV e trocar a entrada" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Help}" Margin="0,10,0,0" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" />

          <Button Style="{StaticResource PillButton}" Margin="0,28,0,0" HorizontalAlignment="Stretch" Command="{Binding ToggleEnabledCommand}"
                  nav:Nav.Group="overlay" nav:Nav.Key="tv:enabled" nav:Nav.IsDefault="True">
            <TextBlock Text="{Binding EnabledLabel}" />
          </Button>

          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" Command="{Binding CycleKindCommand}" nav:Nav.Group="overlay" nav:Nav.Key="tv:kind">
              <TextBlock Text="{Binding KindLabel}" TextTrimming="CharacterEllipsis" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" Command="{Binding DetectCommand}" nav:Nav.Group="overlay" nav:Nav.Key="tv:detect">
              <TextBlock Text="{Binding DetectLabel}" />
            </Button>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding HostLabel}" />
              <TextBox Style="{StaticResource FieldBox}" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                       nav:Nav.Group="overlay" nav:Nav.Key="tv:host" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource FieldLabel}" Text="MAC para Wake-on-LAN (opcional)" />
              <TextBox Style="{StaticResource FieldBox}" Text="{Binding MacAddress, UpdateSourceTrigger=PropertyChanged}"
                       nav:Nav.Group="overlay" nav:Nav.Key="tv:mac" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" Command="{Binding CycleHdmiCommand}" nav:Nav.Group="overlay" nav:Nav.Key="tv:hdmi">
              <TextBlock Text="{Binding HdmiLabel}" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" Command="{Binding ToggleStandbyCommand}" nav:Nav.Group="overlay" nav:Nav.Key="tv:standby">
              <TextBlock Text="{Binding StandbyLabel}" TextTrimming="CharacterEllipsis" />
            </Button>
          </Grid>

          <StackPanel x:Name="AndroidCommand">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Comando da entrada (avançado; só se a TV ignorar a tecla HDMI)" />
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding InputCommand, UpdateSourceTrigger=PropertyChanged}"
                     nav:Nav.Group="overlay" nav:Nav.Key="tv:command" />
          </StackPanel>

          <TextBlock x:Name="StatusText" Text="{Binding Status}" Margin="0,24,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

          <Grid Margin="0,32,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" Margin="0,0,18,0" Command="{Binding TestCommand}" nav:Nav.Group="overlay" nav:Nav.Key="tv:test">
              <TextBlock Text="{Binding TestLabel}" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Tag="primary" Margin="0,0,18,0" Command="{Binding SaveCommand}" nav:Nav.Group="overlay" nav:Nav.Key="tv:save">
              <TextBlock Text="Salvar" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Command="{Binding CancelCommand}" nav:Nav.Group="overlay" nav:Nav.Key="tv:cancel">
              <TextBlock Text="Cancelar" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasStatus}" Value="True">
        <Setter TargetName="StatusText" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusIsError}" Value="True">
        <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsAndroid}" Value="False">
        <Setter TargetName="AndroidCommand" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
