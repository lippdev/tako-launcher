<!--
  Telas da sessão de jogo e da edição de jogos adicionados (frente B: MVP-024/026/027).
  Separado de Views.xaml para que as frentes não editem o mesmo arquivo.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels">

  <!-- Campo de texto navegável: anel de foco como as pílulas; o cursor aparece com o foco. -->
  <Style x:Key="FieldBox" TargetType="TextBox">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="FontSize" Value="{DynamicResource FsBodyLg}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="SelectionBrush" Value="#66FFFFFF" />
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Ring" Margin="-8" CornerRadius="26" BorderBrush="White" BorderThickness="4" Visibility="Collapsed" />
            <Border CornerRadius="18" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Campo de segredo (senha, Client Secret): o texto aparece como ● até o usuário pedir "Mostrar" (Tag = True). Continua um
    TextBox (colar, teclado físico e navegação iguais aos outros campos); só o desenho do texto muda.
  -->
  <Style x:Key="SecretBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Ring" Margin="-8" CornerRadius="26" BorderBrush="White" BorderThickness="4" Visibility="Collapsed" />
            <Border CornerRadius="18" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Opacity="0" />
                <TextBlock x:Name="Mask" Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SecretMask}}" Margin="2,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Tag">
              <Trigger.Value>
                <sys:Boolean>True</sys:Boolean>
              </Trigger.Value>
              <Setter TargetName="PART_ContentHost" Property="Opacity" Value="1" />
              <Setter TargetName="Mask" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,28,0,12" />
    <Setter Property="FontSize" Value="{DynamicResource FsLabelMd}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentMutedBrush}" />
  </Style>

  <!--
    Captura do atalho da Central (UX-005): "Segure os botões que quer usar" (controle) ou "Aperte as teclas" (teclado).
    A barra enche enquanto a combinação fica igual; um motivo em vermelho quando ela é recusada.
  -->
  <DataTemplate DataType="{x:Type vm:ShortcutCaptureViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="900" CornerRadius="28" Background="#FF1A1E26" Padding="56,48" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource HintBarReserve}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FsLabelMd}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentMutedBrush}" />
          <TextBlock Text="{Binding Prompt}" Margin="0,10,0,0" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Border Margin="0,32,0,0" Height="96" CornerRadius="20" Background="{DynamicResource Surface2Brush}" Padding="28,0">
            <TextBlock Text="{Binding Current}" VerticalAlignment="Center" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          </Border>
          <Border Height="8" Margin="0,16,0,0" CornerRadius="4" Background="#26FFFFFF">
            <Border CornerRadius="4" Background="White" HorizontalAlignment="Left"
                    Width="{Binding Progress, Converter={StaticResource FractionToWidth}, ConverterParameter=788}" />
          </Border>
          <TextBlock x:Name="ErrorText" Text="{Binding Error}" Margin="0,20,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
          <TextBlock Text="{Binding Help}" Margin="0,20,0,0" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CurrentShortcut}" Margin="0,12,0,0" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" />
          <!-- Para o mouse: com o controle, tocar B cancela; com o teclado, Esc. -->
          <Button Style="{StaticResource PillButton}" Margin="0,32,0,0" HorizontalAlignment="Left" Command="{Binding CancelCommand}" nav:Nav.Group="overlay" nav:Nav.Key="capture:cancel">
            <TextBlock Text="Cancelar" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasError}" Value="True">
        <Setter TargetName="ErrorText" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Editar jogo adicionado (MVP-024): ↑ ↓ (ou Enter) passam pelos campos até os botões; Esc/B cancela. -->
  <DataTemplate DataType="{x:Type vm:EditGameViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="980" CornerRadius="28" Background="#FF1A1E26" Padding="56,48" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource HintBarReserve}">
        <StackPanel>
          <TextBlock Text="Editar jogo" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Target}" Margin="0,10,0,0" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextTrimming="CharacterEllipsis" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Nome" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                   nav:Nav.Group="overlay" nav:Nav.Key="edit:name" nav:Nav.IsDefault="True" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="Argumentos (opcional)" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                   nav:Nav.Group="overlay" nav:Nav.Key="edit:arguments" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta de trabalho (vazio = pasta do executável)" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                   nav:Nav.Group="overlay" nav:Nav.Key="edit:folder" />

          <!-- Botões na largura dos campos: ↑ ↓ seguem em linha reta (a navegação penaliza desvio lateral). -->
          <Button Style="{StaticResource PillButton}" Margin="0,36,0,0" HorizontalAlignment="Stretch" Command="{Binding CycleTrackingCommand}"
                  nav:Nav.Group="overlay" nav:Nav.Key="edit:tracking">
            <TextBlock Text="{Binding TrackingLabel}" />
          </Button>

          <TextBlock x:Name="ErrorText" Text="{Binding Error}" Margin="0,24,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

          <Grid Margin="0,36,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" Tag="primary" Margin="0,0,18,0" Command="{Binding SaveCommand}" nav:Nav.Group="overlay" nav:Nav.Key="edit:save">
              <TextBlock Text="Salvar" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Command="{Binding CancelCommand}" nav:Nav.Group="overlay" nav:Nav.Key="edit:cancel">
              <TextBlock Text="Cancelar" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasError}" Value="True">
        <Setter TargetName="ErrorText" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
