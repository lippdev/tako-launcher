<!--
  Configurações deste jogo (UX-007). Painel lateral do mesmo componente dos filtros (LibraryViews.xaml): à direita, na
  altura da tela, linhas com o valor no fim. Valor "Padrão: ..." = segue as Configurações do Tako; o que o jogo muda
  fica em destaque. Separado para que as frentes não editem o mesmo arquivo.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels">

  <DataTemplate DataType="{x:Type vm:GameSettingsViewModel}">
    <Grid>
      <Button Template="{StaticResource SidePanelScrim}" Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False" Cursor="Arrow" />

      <Border Width="760" HorizontalAlignment="Right" Background="{DynamicResource PanelStrongBrush}">
        <Canvas x:Name="Viewport" ClipToBounds="True">
          <StackPanel nav:Nav.ScrollHost="Vertical" Width="{Binding ActualWidth, ElementName=Viewport}">
            <StackPanel.RenderTransform>
              <TranslateTransform />
            </StackPanel.RenderTransform>
            <StackPanel Margin="48,72,48,20">
              <TextBlock Text="Configurações deste jogo" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding GameTitle}" Margin="0,8,0,0" FontSize="{DynamicResource FsBodyLg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource OnAccentMutedBrush}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Sections}" Margin="48,0,48,160" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,12,0,18">
                    <TextBlock Text="{Binding Title, Converter={StaticResource Upper}}" Margin="0,0,0,12" FontSize="{DynamicResource FsLabelSm}" FontWeight="Bold" Foreground="#80FFFFFF" />
                    <TextBlock Text="{Binding Description}" Margin="0,-4,0,12" TextWrapping="Wrap" FontSize="{DynamicResource FsLabelSm}" Foreground="#8CFFFFFF"
                               Visibility="{Binding Description, Converter={StaticResource NotNullToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PanelRowViewModel}">
                          <Button Style="{StaticResource PanelRow}" Command="{Binding Command}" nav:Nav.Group="game-settings" nav:Nav.Key="{Binding Key}">
                            <DockPanel>
                              <TextBlock x:Name="Value" DockPanel.Dock="Right" Text="{Binding EndText}" MaxWidth="340" TextTrimming="CharacterEllipsis"
                                         FontSize="{DynamicResource FsLabelMd}" Opacity="0.65" VerticalAlignment="Center" Margin="16,0,0,0" />
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                          </Button>
                          <DataTemplate.Triggers>
                            <!-- Escolha própria do jogo: o valor aparece inteiro, em negrito. -->
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                              <Setter TargetName="Value" Property="Opacity" Value="1" />
                              <Setter TargetName="Value" Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Canvas>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
