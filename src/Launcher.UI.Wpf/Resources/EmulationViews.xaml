<!--
  Configurações › Emulação (ADR-0024): editor de argumentos de emulador, sistema e jogo. As páginas de Emulação usam
  SettingsDetailViewModel (SettingsViews.xaml) e o assistente usa SetupWizardViewModel; só o editor precisa de tela própria.
  Usa FieldBox/FieldLabel de SessionViews.xaml e PillButton de Styles.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels">

  <!-- Marcadores primeiro (A acrescenta ao texto), depois o campo, Colar/Padrão/Limpar e Salvar/Cancelar. B cancela. -->
  <DataTemplate DataType="{x:Type vm:ArgumentsEditorViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="1180" CornerRadius="28" Background="#FF1A1E26" Padding="56,40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Description}" Margin="0,10,0,0" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" />

          <TextBlock Style="{StaticResource FieldLabel}" Text="Acrescentar" />
          <ItemsControl ItemsSource="{Binding Placeholders}" Margin="0,0,0,0" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <Button Style="{StaticResource PillButton}" Margin="0,0,14,14" HorizontalAlignment="Stretch" Command="{Binding Command}"
                        nav:Nav.Group="overlay" nav:Nav.Key="{Binding NavKey}">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Argumentos" />
          <TextBox Style="{StaticResource FieldBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                   nav:Nav.Group="overlay" nav:Nav.Key="args:text" />
          <TextBlock Text="{Binding Preview}" Margin="0,12,0,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" />

          <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" Margin="0,0,14,0" Command="{Binding PasteCommand}" nav:Nav.Group="overlay" nav:Nav.Key="args:paste">
              <TextBlock Text="Colar" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Margin="0,0,14,0" Command="{Binding ResetCommand}" nav:Nav.Group="overlay" nav:Nav.Key="args:reset">
              <TextBlock Text="Padrão" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Command="{Binding ClearCommand}" nav:Nav.Group="overlay" nav:Nav.Key="args:clear">
              <TextBlock Text="Limpar" />
            </Button>
          </Grid>

          <TextBlock x:Name="ErrorText" Text="{Binding Error}" Margin="0,20,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

          <Grid Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" Tag="primary" Margin="0,0,18,0" Command="{Binding SaveCommand}" nav:Nav.Group="overlay" nav:Nav.Key="args:save" nav:Nav.IsDefault="True">
              <TextBlock Text="Salvar" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Command="{Binding CancelCommand}" nav:Nav.Group="overlay" nav:Nav.Key="args:cancel">
              <TextBlock Text="Cancelar" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasError}" Value="True">
        <Setter TargetName="ErrorText" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
