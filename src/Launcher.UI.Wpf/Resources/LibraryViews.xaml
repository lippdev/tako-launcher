<!--
  Busca com teclado virtual e painel de filtros da biblioteca (frente E: UX-001/002/004).
  Separado de Views.xaml para que as frentes não editem o mesmo arquivo. Os dois painéis ficam à direita, na altura
  da tela, e a grade continua à vista à esquerda: os resultados acompanham cada tecla ou escolha ao vivo.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Launcher.UI.Wpf.Controls"
                    xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels">

  <!-- Escurece da metade para a direita (a grade fica visível); clicar fora fecha o painel. -->
  <ControlTemplate x:Key="SidePanelScrim" TargetType="Button">
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Offset="0.35" Color="#00000000" />
          <GradientStop Offset="0.7" Color="#99000000" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
  </ControlTemplate>

  <!-- Tecla: quadrado arredondado; em foco vira branco com texto escuro (como as linhas de painel). Tag = "done" na tecla Pronto. -->
  <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
    <Setter Property="Height" Value="64" />
    <Setter Property="Margin" Value="0,0,10,10" />
    <Setter Property="FontSize" Value="{DynamicResource FsLabelLg}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Ring" Margin="-7" CornerRadius="21" BorderBrush="White" BorderThickness="4" Visibility="Collapsed" />
            <Border x:Name="Body" CornerRadius="14" Background="{DynamicResource Surface1Brush}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="done">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource Surface2Brush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              <Setter TargetName="Body" Property="Background" Value="White" />
              <Setter Property="Foreground" Value="#FF11141A" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== Busca (UX-001) -->
  <DataTemplate DataType="{x:Type vm:SearchViewModel}">
    <Grid>
      <Button Template="{StaticResource SidePanelScrim}" Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False" Cursor="Arrow" />

      <Border Width="760" HorizontalAlignment="Right" Background="{DynamicResource PanelStrongBrush}">
        <StackPanel Margin="40,0,20,40" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" Margin="0,0,0,24" />

          <!-- Campo: o texto buscado com o cursor no fim. -->
          <Border Height="72" Margin="0,0,10,0" CornerRadius="36" Background="{DynamicResource Surface2Brush}" Padding="26,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <c:Icon Key="Icon.Search" Width="28" Height="28" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,16,0" />
              <TextBlock x:Name="Placeholder" Text="{Binding Placeholder}" FontSize="{DynamicResource FsBodyLg}" Foreground="{DynamicResource OnAccentSubtleBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="Query" Text="{Binding Text}" FontSize="{DynamicResource FsBodyLg}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
              <Rectangle Width="3" Height="32" Margin="4,0,0,0" Fill="{DynamicResource OnAccentBrush}" VerticalAlignment="Center">
                <Rectangle.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                          <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
                          <DiscreteDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Rectangle.Triggers>
              </Rectangle>
            </StackPanel>
          </Border>
          <!-- Quantos jogos sobraram (ou como digitar, com a busca vazia). -->
          <TextBlock Text="{Binding ResultText}" Margin="26,14,10,30" TextWrapping="Wrap"
                     FontSize="{DynamicResource FsLabelMd}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentMutedBrush}" />

          <!-- Grade de teclas: o direcional anda entre elas; A digita. -->
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ItemsControl ItemsSource="{Binding}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VirtualKeyViewModel}">
                      <Button x:Name="Key" Style="{StaticResource KeyButton}" Width="{Binding Width}" Command="{Binding Command}"
                              nav:Nav.Group="keyboard" nav:Nav.Key="{Binding NavKey}" nav:Nav.IsDefault="{Binding IsDefault}">
                        <TextBlock x:Name="Label" Text="{Binding Label}" />
                      </Button>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsAction}" Value="True">
                          <Setter TargetName="Label" Property="FontSize" Value="{DynamicResource FsLabelMd}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                          <Setter TargetName="Key" Property="Tag" Value="done" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasText}" Value="True">
        <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Query" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ===================================================================== Filtros (UX-002/004) -->
  <DataTemplate DataType="{x:Type vm:LibraryFiltersViewModel}">
    <Grid>
      <Button Template="{StaticResource SidePanelScrim}" Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False" Cursor="Arrow" />

      <!-- Painel à direita, na altura da tela; a lista rola com o foco. -->
      <Border Width="640" HorizontalAlignment="Right" Background="{DynamicResource PanelStrongBrush}">
        <Canvas x:Name="Viewport" ClipToBounds="True">
          <StackPanel nav:Nav.ScrollHost="Vertical" Width="{Binding ActualWidth, ElementName=Viewport}">
            <StackPanel.RenderTransform>
              <TranslateTransform />
            </StackPanel.RenderTransform>
            <StackPanel Margin="48,72,48,20">
              <TextBlock Text="Filtros" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CountText}" Margin="0,8,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource OnAccentMutedBrush}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Sections}" Margin="48,0,48,160" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,12,0,18">
                    <TextBlock Text="{Binding Title, Converter={StaticResource Upper}}" Margin="0,0,0,12" FontSize="{DynamicResource FsLabelSm}" FontWeight="Bold" Foreground="#80FFFFFF" />
                    <TextBlock Text="{Binding Description}" Margin="0,-4,0,12" TextWrapping="Wrap" FontSize="{DynamicResource FsLabelSm}" Foreground="#8CFFFFFF"
                               Visibility="{Binding Description, Converter={StaticResource NotNullToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PanelRowViewModel}">
                          <Button Style="{StaticResource PanelRow}" Command="{Binding Command}" nav:Nav.Group="filters" nav:Nav.Key="{Binding Label, StringFormat=filter:{0}}">
                            <DockPanel>
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EndText}" FontSize="{DynamicResource FsLabelMd}" Opacity="0.65" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <Ellipse x:Name="Radio" Width="26" Height="26" Margin="16,0,0,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="3" Opacity="0.5" Visibility="Collapsed" />
                                <ContentControl x:Name="Toggle" Style="{StaticResource ToggleVisual}" Tag="{Binding IsOn}" Margin="16,0,0,0" Visibility="Collapsed" />
                              </StackPanel>
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                          </Button>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRadio}" Value="True">
                              <Setter TargetName="Radio" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                              <Setter TargetName="Radio" Property="Opacity" Value="1" />
                              <Setter TargetName="Radio" Property="StrokeThickness" Value="8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToggle}" Value="True">
                              <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Canvas>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
