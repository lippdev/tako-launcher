<!--
  Capas e metadados (ADR-0023): seletor de imagens, "Fontes e IDs" e o painel do SteamGridDB. Modais sobre a tela atual,
  com o fundo escurecido; o foco fica preso no modal (escopo da sobreposição do topo) e volta ao item de origem ao fechar.
  Usa PillButton/PanelRow de Styles.xaml e FieldBox/FieldLabel/SecretBox de SessionViews.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels">

  <!-- Aba/chip de modal: escolhida = branca; foco = anel. -->
  <Style x:Key="ModalTabButton" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
    <Setter Property="Height" Value="56" />
    <Setter Property="Margin" Value="0,0,14,0" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="FontSize" Value="{DynamicResource FsLabelMd}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Ring" Margin="-8" CornerRadius="36" BorderBrush="White" BorderThickness="4" Visibility="Collapsed" />
            <Border x:Name="Body" CornerRadius="28" Background="{DynamicResource Surface1Brush}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource OnSurfaceSolidBrush}" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ItemsPanelTemplate x:Key="ModalRow">
    <WrapPanel Orientation="Horizontal" />
  </ItemsPanelTemplate>

  <!-- Miniatura da grade do seletor: marcador enquanto carrega; ✓ na que está em uso; selo "animada". -->
  <Style x:Key="ArtTile" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
    <Setter Property="Margin" Value="0,0,18,18" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Ring" Margin="-7" CornerRadius="16" BorderBrush="White" BorderThickness="4" Visibility="Collapsed" />
            <Border CornerRadius="10" Background="{DynamicResource Surface1Brush}" ClipToBounds="True">
              <Grid>
                <TextBlock x:Name="Loading" Text="Carregando…" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="Failed" Text="Sem prévia" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                <Border x:Name="Current" Background="{DynamicResource SuccessBrush}" CornerRadius="12" Padding="10,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                  <TextBlock Text="✓ Em uso" FontSize="{DynamicResource FsLabelSm}" FontWeight="Bold" Foreground="#FF11141A" />
                </Border>
                <Border x:Name="Animated" Background="#CC000000" CornerRadius="12" Padding="10,3" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                  <TextBlock Text="Animada" FontSize="{DynamicResource FsLabelSm}" FontWeight="SemiBold" />
                </Border>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLoading}" Value="True">
              <Setter TargetName="Loading" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Failed}" Value="True">
              <Setter TargetName="Failed" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
              <Setter TargetName="Current" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAnimated}" Value="True">
              <Setter TargetName="Animated" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Seletor de imagens: abas de tipo (LB/RB), fontes, filtros do SteamGridDB, grade e prévia grande. -->
  <DataTemplate DataType="{x:Type vm:ArtPickerViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="1760" Height="900" CornerRadius="28" Background="#FF1A1E26" Padding="48,36,48,28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="560" />
          </Grid.ColumnDefinitions>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <ItemsControl DockPanel.Dock="Top" Margin="0,22,0,0" ItemsSource="{Binding Kinds}" ItemsPanel="{StaticResource ModalRow}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ModalTabButton}" Command="{Binding Command}" nav:Nav.Group="art-kinds" nav:Nav.Key="{Binding Key}" nav:Nav.IsDefault="{Binding IsSelected}">
                    <TextBlock Text="{Binding Label}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl DockPanel.Dock="Top" Margin="0,16,0,0" ItemsSource="{Binding Sources}" ItemsPanel="{StaticResource ModalRow}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ModalTabButton}" Command="{Binding Command}" nav:Nav.Group="art-sources" nav:Nav.Key="{Binding Key}">
                    <TextBlock Text="{Binding Label}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0" Visibility="{Binding IsSteamGridDb, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding SteamGridDbGame}" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentMutedBrush}" TextTrimming="CharacterEllipsis" />
              <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Filters}" ItemsPanel="{StaticResource ModalRow}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ModalTabButton}" Height="48" Command="{Binding Command}" nav:Nav.Group="art-filters" nav:Nav.Key="{Binding Key}">
                      <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsLabelSm}" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Button DockPanel.Dock="Top" Style="{StaticResource ChipButton}" Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding BrowseFileCommand}"
                    nav:Nav.Group="art-filters" nav:Nav.Key="art-browse" Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Outra imagem do PC… (teclado e mouse)" />
            </Button>
            <TextBlock DockPanel.Dock="Top" Margin="0,16,0,0" Text="{Binding Status}" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource OnAccentMutedBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
            <!-- Grade com rolagem que acompanha o foco (Nav.ScrollHost), recortada na moldura. -->
            <Canvas x:Name="Viewport" Margin="0,20,0,0" ClipToBounds="True">
              <ItemsControl x:Name="Tiles" ItemsSource="{Binding Items}" Width="{Binding ActualWidth, ElementName=Viewport}" Focusable="False" nav:Nav.ScrollHost="Vertical">
                <ItemsControl.RenderTransform>
                  <TranslateTransform />
                </ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" Margin="8,8,8,40" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ArtTile}"
                            Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            nav:Nav.Group="art-grid" nav:Nav.Key="{Binding NavKey}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Canvas>
          </DockPanel>

          <!-- Prévia grande da miniatura focada, com o autor (crédito do SteamGridDB), o tamanho e o estilo. -->
          <DockPanel Grid.Column="1" Margin="40,0,0,0">
            <StackPanel DockPanel.Dock="Bottom">
              <Button Style="{StaticResource PillButton}" Tag="primary" HorizontalAlignment="Stretch" Command="{Binding ApplyCommand}" nav:Nav.Group="art-actions" nav:Nav.Key="art:apply">
                <TextBlock Text="Aplicar" />
              </Button>
              <Button Style="{StaticResource PillButton}" Margin="0,18,0,0" HorizontalAlignment="Stretch" Command="{Binding ResetToAutomaticCommand}" nav:Nav.Group="art-actions" nav:Nav.Key="art:auto">
                <TextBlock Text="{Binding AutomaticLabel}" />
              </Button>
              <Button Style="{StaticResource PillButton}" Margin="0,18,0,0" HorizontalAlignment="Stretch" Command="{Binding CloseCommand}" nav:Nav.Group="art-actions" nav:Nav.Key="art:close">
                <TextBlock Text="Fechar" />
              </Button>
            </StackPanel>
            <StackPanel>
              <Border Height="500" CornerRadius="16" Background="{DynamicResource Surface1Brush}" ClipToBounds="True">
                <Grid>
                  <TextBlock Text="Escolha uma imagem para ver a prévia" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
                  <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
              </Border>
              <TextBlock Margin="0,16,0,0" Text="{Binding PreviewCaption}" FontSize="{DynamicResource FsLabelMd}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Margin="0,6,0,0" Text="{Binding PreviewCredit}" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>

  <!-- Fontes e IDs: busca pelo nome em todas as fontes; candidatos por fonte; digitar/colar o ID; nenhum; automático. -->
  <DataTemplate DataType="{x:Type vm:SourceIdsViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="1560" Height="900" CornerRadius="28" Background="#FF1A1E26" Padding="48,36,48,28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock DockPanel.Dock="Top" Margin="0,8,0,0" Text="O ID diz qual é o jogo em cada fonte. Escolha um resultado, cole o ID ou o endereço da página, ou marque Nenhum. O Tako nunca troca o que você escolheu." FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentMutedBrush}" TextWrapping="Wrap" />
          <ItemsControl DockPanel.Dock="Top" Margin="0,20,0,0" ItemsSource="{Binding Tools}" ItemsPanel="{StaticResource ModalRow}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource ModalTabButton}" Margin="0,0,14,12" Command="{Binding Command}" nav:Nav.Group="ids-tools" nav:Nav.Key="{Binding Key}" nav:Nav.IsDefault="{Binding IsSelected}">
                  <TextBlock Text="{Binding Label}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Canvas x:Name="Viewport" Margin="0,10,0,0" ClipToBounds="True">
            <StackPanel nav:Nav.ScrollHost="Vertical" Width="{Binding ActualWidth, ElementName=Viewport}">
              <StackPanel.RenderTransform>
                <TranslateTransform />
              </StackPanel.RenderTransform>
              <TextBlock Text="Nenhuma fonte ligada. Ligue a IGDB, o ScreenScraper ou o SteamGridDB em Configurações › Capas e metadados." FontSize="{DynamicResource FsBodyMd}" TextWrapping="Wrap" Margin="0,12,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasSections}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Sections}" Margin="0,0,0,120" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,10,0,18">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Source}" FontSize="{DynamicResource FsTitle}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Summary}" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentMutedBrush}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <TextBlock Text="{Binding Status}" Margin="0,6,0,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" Visibility="{Binding Status, Converter={StaticResource NotNullToVisibility}}" />
                      <ItemsControl ItemsSource="{Binding Rows}" Margin="0,12,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:SourceRowViewModel}">
                            <Button Style="{StaticResource PanelRow}" Command="{Binding Command}" nav:Nav.Group="ids" nav:Nav.Key="{Binding Key}">
                              <DockPanel Margin="0,6">
                                <Border x:Name="ThumbBox" DockPanel.Dock="Left" Width="44" Height="62" Margin="0,0,18,0" CornerRadius="6" Background="#22FFFFFF" ClipToBounds="True" Visibility="Collapsed">
                                  <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" MaxWidth="560" Margin="18,0,0,0" FontSize="{DynamicResource FsLabelSm}" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Label" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              </DockPanel>
                            </Button>
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding IsCandidate}" Value="True">
                                <Setter TargetName="ThumbBox" Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsBest}" Value="True">
                                <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Canvas>
        </DockPanel>
      </Border>
    </Grid>
  </DataTemplate>

  <!-- Configurações › Capas e metadados › SteamGridDB: mesmo padrão da IGDB. -->
  <DataTemplate DataType="{x:Type vm:SteamGridDbSettingsViewModel}">
    <Grid>
      <Rectangle Fill="{DynamicResource ScrimBrush}" />
      <Border Width="1180" CornerRadius="28" Background="#FF1A1E26" Padding="56,40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Capas da comunidade (SteamGridDB)" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" />
          <TextBlock Text="O SteamGridDB tem capas, fundos, logos e ícones feitos por fãs para quase todo jogo. É gratuito, mas pede uma chave sua; o Tako guarda a chave cifrada neste PC." Margin="0,10,0,0" FontSize="{DynamicResource FsLabelMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" />

          <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" Margin="0,0,18,0" HorizontalAlignment="Stretch" Command="{Binding ToggleEnabledCommand}"
                    nav:Nav.Group="overlay" nav:Nav.Key="sgdb:enabled" nav:Nav.IsDefault="True">
              <TextBlock Text="{Binding EnabledLabel}" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" Command="{Binding ToggleAutoFillCommand}" nav:Nav.Group="overlay" nav:Nav.Key="sgdb:autofill">
              <TextBlock Text="{Binding AutoFillLabel}" />
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding Steps}" Margin="0,22,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Margin="0,0,0,8" FontSize="{DynamicResource FsLabelSm}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource PillButton}" Margin="0,6,0,0" HorizontalAlignment="Left" Command="{Binding OpenSiteCommand}" nav:Nav.Group="overlay" nav:Nav.Key="sgdb:site">
            <TextBlock Text="Abrir Preferências › API no navegador" />
          </Button>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding KeyLabel}" />
              <TextBox Style="{StaticResource SecretBox}" Tag="{Binding IsSecretVisible}" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                       nav:Nav.Group="overlay" nav:Nav.Key="sgdb:key" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Margin="18,0,0,0" VerticalAlignment="Bottom" Command="{Binding PasteKeyCommand}" nav:Nav.Group="overlay" nav:Nav.Key="sgdb:paste">
              <TextBlock Text="Colar" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Margin="18,0,0,0" VerticalAlignment="Bottom" Command="{Binding ToggleSecretVisibleCommand}" nav:Nav.Group="overlay" nav:Nav.Key="sgdb:show">
              <TextBlock Text="{Binding SecretToggleLabel}" />
            </Button>
          </Grid>

          <TextBlock x:Name="StatusText" Text="{Binding Status}" Margin="0,22,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

          <Grid Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" Margin="0,0,18,0" Command="{Binding TestCommand}" nav:Nav.Group="overlay" nav:Nav.Key="sgdb:test">
              <TextBlock Text="{Binding TestLabel}" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Tag="primary" Margin="0,0,18,0" Command="{Binding SaveCommand}" nav:Nav.Group="overlay" nav:Nav.Key="sgdb:save">
              <TextBlock Text="Salvar" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Command="{Binding CancelCommand}" nav:Nav.Group="overlay" nav:Nav.Key="sgdb:cancel">
              <TextBlock Text="Cancelar" />
            </Button>
          </Grid>

          <!-- Crédito aos autores das imagens, como o SteamGridDB pede. -->
          <TextBlock Text="Imagens do SteamGridDB, feitas pela comunidade; o autor de cada uma aparece na prévia do seletor. O SteamGridDB não endossa o Tako." Margin="0,20,0,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasStatus}" Value="True">
        <Setter TargetName="StatusText" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusIsError}" Value="True">
        <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
