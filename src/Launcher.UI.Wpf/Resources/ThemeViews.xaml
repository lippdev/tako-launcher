<!--
  Configurações › Aparência › Tema (MVP-014/015/020): importar .pthm, restaurar o padrão e a lista de temas instalados.
  Mesmo layout e navegação da página de Configurações (linhas SettingRow num único grupo vertical).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Launcher.UI.Wpf.Controls"
                    xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels">

  <DataTemplate DataType="{x:Type vm:ThemesViewModel}">
    <Grid>
    <!-- Escurecimento como nas Configurações (ADR-0020): os textos não ficam direto sobre a arte do jogo. -->
    <Rectangle Fill="{StaticResource SettingsScrim}" />
    <Canvas x:Name="Viewport" ClipToBounds="True" OpacityMask="{StaticResource ContentFadeMask}">
      <StackPanel Canvas.Left="64" Canvas.Top="140" Width="1180" Margin="0,0,0,200" nav:Nav.ScrollHost="Vertical">
        <StackPanel.RenderTransform>
          <TranslateTransform />
        </StackPanel.RenderTransform>
        <TextBlock Text="Temas" Margin="0,0,0,40" Style="{StaticResource PageTitle}" />
        <Button Style="{StaticResource SettingRow}" Command="{Binding ImportCommand}" nav:Nav.Group="themes" nav:Nav.Key="themes:import" nav:Nav.IsDefault="True">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Escolher" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
              <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Importar tema do Playnite (.pthm)" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
              <TextBlock Text="Temas Fullscreen; o pacote é verificado antes de instalar e nada dele é executado" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentMutedBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Style="{StaticResource SettingRow}" Command="{Binding RestoreDefaultCommand}" nav:Nav.Group="themes" nav:Nav.Key="themes:restore">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Restaurar" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
              <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Restaurar tema padrão" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" />
              <TextBlock Text="Volta à interface e ao tema do Tako; a prévia volta ao Fullscreen padrão do Playnite" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentMutedBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </Button>
        <TextBlock Text="Instalados" Margin="0,26,0,18" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentSubtleBrush}" />
        <ItemsControl ItemsSource="{Binding Themes}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ThemeItemViewModel}">
              <Button Style="{StaticResource SettingRow}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                      nav:Nav.Group="themes" nav:Nav.Key="{Binding Key}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource FsLabelLg}" FontWeight="Bold" />
                    <c:Icon Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Margin="0,6,32,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentMutedBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding FolderText}" Margin="0,18,0,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentSubtleBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Canvas>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
