<!--
  Configurações em categorias e menu Modo Console (UX-006/009, ADR-0020; DESIGN.md › Components).
  - Configurações: coluna de categorias à esquerda e as linhas da categoria à direita, numa moldura com recorte que
    termina acima da barra de dicas (o item focado nunca fica atrás dela).
  - Modo Console: assistente "Configurar para jogar na TV" e um cartão por recurso, com o estado em selo colorido.
  - As páginas escurecem a arte do jogo (SettingsScrim) e os valores ficam numa pílula: legíveis sobre qualquer arte.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Launcher.UI.Wpf.Controls"
                    xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
                    xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels"
                    xmlns:core="clr-namespace:Launcher.Core.Presentation;assembly=Launcher.Core">

  <!-- ===================================================================== Estilos -->

  <!-- Categoria (coluna da esquerda): como o item da barra lateral; a escolhida fica branca. -->
  <Style x:Key="CategoryItem" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
    <Setter Property="Height" Value="68" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Ring" Margin="-8" CornerRadius="22" BorderBrush="White" BorderThickness="4" Visibility="Collapsed" />
            <Border x:Name="Body" CornerRadius="14" Background="Transparent" Padding="20,0">
              <DockPanel>
                <c:Icon Key="{Binding IconKey}" Width="32" Height="32" DockPanel.Dock="Left" Foreground="{TemplateBinding Foreground}" />
                <TextBlock Text="{Binding Title}" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource Surface2Brush}" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource OnSurfaceSolidBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Linha de configuração: altura pelo conteúdo (descrição em até duas linhas), superfície translúcida sobre o escurecimento. -->
  <Style x:Key="SettingLine" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
    <Setter Property="MinHeight" Value="92" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Ring" Margin="-10" CornerRadius="30" BorderBrush="White" BorderThickness="4" Visibility="Collapsed" />
            <Border x:Name="Body" CornerRadius="22" Background="{DynamicResource Surface1Brush}" Padding="28,16">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource Surface2Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Selo de estado (Ligado / Desligado / Falta configurar / Com problema). -->
  <Style x:Key="StateBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="{x:Static core:FeatureState.On}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="TextElement.Foreground" Value="#FF0B1A10" />
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="{x:Static core:FeatureState.NeedsSetup}">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
        <Setter Property="TextElement.Foreground" Value="#FF1F1500" />
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="{x:Static core:FeatureState.Problem}">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="TextElement.Foreground" Value="White" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Cartão de recurso do Modo Console. -->
  <Style x:Key="FeatureCard" TargetType="Button" BasedOn="{StaticResource NavButtonBase}">
    <Setter Property="Width" Value="420" />
    <Setter Property="Height" Value="208" />
    <Setter Property="Margin" Value="10,10,10,14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>
            <Border x:Name="Ring" Margin="-10" CornerRadius="32" BorderBrush="White" BorderThickness="4" Visibility="Collapsed" />
            <Border x:Name="Body" CornerRadius="22" Background="{DynamicResource Surface1Brush}" Padding="28,24">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                  <Border DockPanel.Dock="Right" Style="{StaticResource StateBadge}">
                    <TextBlock Text="{Binding ValueText}" FontSize="{DynamicResource FsLabelSm}" FontWeight="Bold" />
                  </Border>
                  <c:Icon Key="{Binding IconKey}" Width="40" Height="40" HorizontalAlignment="Left" Foreground="{DynamicResource OnAccentBrush}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Margin="0,18,0,0" FontSize="{DynamicResource FsTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}" Margin="0,8,0,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentMutedBrush}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" />
              </DockPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource Surface2Brush}" />
              <Setter TargetName="Body" Property="Effect" Value="{StaticResource FocusShadow}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== Linha de configuração -->

  <DataTemplate x:Key="SettingRowTemplate" DataType="{x:Type vm:SettingRowViewModel}">
    <Grid>
      <TextBlock x:Name="Header" Text="{Binding Title, Converter={StaticResource Upper}}" Margin="4,22,0,12" Visibility="Collapsed" Style="{StaticResource Overline}" />
      <Button x:Name="Line" Style="{StaticResource SettingLine}" Command="{Binding Command}" nav:Nav.Group="settings" nav:Nav.Key="{Binding Key}" nav:Nav.IsGroupEntry="{Binding IsEntry}"
              Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <!-- Valor à direita: chave, ou pílula com o valor (legível sobre qualquer arte) e a seta. -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
            <Border x:Name="Value" CornerRadius="18" Background="{DynamicResource Surface2Brush}" Padding="16,6" MaxWidth="380"
                    Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding ValueText}" FontSize="{DynamicResource FsLabelMd}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            </Border>
            <ContentControl x:Name="Toggle" Style="{StaticResource ToggleVisual}" Tag="{Binding IsOn}" Visibility="Collapsed" />
            <c:Icon x:Name="Arrow" Key="Icon.Chevron" Width="24" Height="24" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" />
          </StackPanel>
          <c:Icon x:Name="Glyph" DockPanel.Dock="Left" Key="{Binding IconKey}" Width="30" Height="30" Margin="0,0,20,0" VerticalAlignment="Center"
                  Foreground="{DynamicResource OnAccentBrush}" Visibility="{Binding IconKey, Converter={StaticResource NotNullToVisibility}}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FsLabelLg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Description}" Margin="0,6,0,0" FontSize="{DynamicResource FsLabelSm}" Foreground="{DynamicResource OnAccentMutedBrush}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48"
                       Visibility="{Binding Description, Converter={StaticResource NotNullToVisibility}}" />
          </StackPanel>
        </DockPanel>
      </Button>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="Header">
        <Setter TargetName="Header" Property="Visibility" Value="Visible" />
        <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Toggle">
        <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
        <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Choice">
        <Setter TargetName="Arrow" Property="Key" Value="Icon.Sort" />
        <Setter TargetName="Arrow" Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter TargetName="Arrow" Property="RenderTransform">
          <Setter.Value>
            <RotateTransform Angle="90" />
          </Setter.Value>
        </Setter>
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Info">
        <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <!-- Precisa de teclado e mouse (ADR-0017): esmaecida, mas focável para explicar. -->
      <DataTrigger Binding="{Binding IsDimmed}" Value="True">
        <Setter TargetName="Line" Property="Opacity" Value="0.45" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Lista de linhas que rola com o foco dentro de uma moldura com recorte (sem passar por trás da barra de dicas). -->
  <DataTemplate x:Key="SettingRowsList">
    <Canvas x:Name="Viewport" ClipToBounds="True" Margin="-16,0,-16,0">
      <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SettingRowTemplate}" Focusable="False" Width="{Binding ActualWidth, ElementName=Viewport}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Margin="16,16,16,120" nav:Nav.ScrollHost="Vertical">
              <StackPanel.RenderTransform>
                <TranslateTransform />
              </StackPanel.RenderTransform>
            </StackPanel>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Canvas>
  </DataTemplate>

  <!-- Conteúdo de uma categoria (coluna da direita). Trocar de categoria troca a árvore inteira: a rolagem recomeça. -->
  <DataTemplate x:Key="SettingsCategoryContent" DataType="{x:Type vm:SettingsCategoryViewModel}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{Binding Description}" Margin="0,6,0,0" FontSize="{DynamicResource FsBodyMd}" Foreground="{DynamicResource OnAccentMutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingRowsList}" Focusable="False" />
    </DockPanel>
  </DataTemplate>

  <!-- ===================================================================== Configurações -->

  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <Grid>
      <Rectangle Fill="{StaticResource SettingsScrim}" />
      <Grid Margin="64,40,72,100">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Configurações" Style="{StaticResource PageTitle}" />
        <Grid Grid.Row="1" Margin="0,28,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ItemsControl ItemsSource="{Binding Categories}" Focusable="False" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SettingsCategoryViewModel}">
                <Button Style="{StaticResource CategoryItem}" Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        nav:Nav.Group="settings-cat" nav:Nav.Key="{Binding NavKey}" nav:Nav.IsGroupEntry="{Binding IsSelected}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Pedir uma linha de outra categoria (voltar a ela, teste) troca a categoria: RevealHost → SettingsViewModel.RevealKey. -->
          <c:RevealHost Grid.Column="2">
            <ContentControl Content="{Binding SelectedCategory}" ContentTemplate="{StaticResource SettingsCategoryContent}" Focusable="False" />
          </c:RevealHost>
        </Grid>
      </Grid>
    </Grid>
  </DataTemplate>

  <!-- ===================================================================== Modo Console -->

  <DataTemplate DataType="{x:Type vm:ConsoleModeViewModel}">
    <Grid>
      <Rectangle Fill="{StaticResource SettingsScrim}" />
      <Canvas x:Name="Viewport" ClipToBounds="True" Margin="0,0,0,100">
        <StackPanel nav:Nav.ScrollHost="Vertical" Width="{Binding ActualWidth, ElementName=Viewport}">
          <StackPanel.RenderTransform>
            <TranslateTransform />
          </StackPanel.RenderTransform>
          <StackPanel Margin="64,40,72,0">
            <TextBlock Text="Modo Console" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Jogue na TV como num console: a tela, o som e a TV mudam sozinhos ao abrir um jogo e voltam ao fechar."
                       Margin="0,10,0,0" MaxWidth="1100" HorizontalAlignment="Left" FontSize="{DynamicResource FsBodyLg}" Foreground="{DynamicResource OnAccentMutedBrush}" TextWrapping="Wrap" />
            <Button Style="{StaticResource PillButton}" Tag="primary" Margin="0,32,0,0" HorizontalAlignment="Left" Command="{Binding StartWizardCommand}"
                    nav:Nav.Group="console-top" nav:Nav.Key="console:wizard" nav:Nav.IsDefault="True">
              <StackPanel Orientation="Horizontal">
                <c:Icon Key="Icon.Tv" Width="28" Height="28" Margin="0,0,14,0" Foreground="{DynamicResource OnSurfaceSolidBrush}" />
                <TextBlock Text="Configurar para jogar na TV" />
              </StackPanel>
            </Button>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Cards}" Margin="54,36,62,120" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SettingRowViewModel}">
                <Button Style="{StaticResource FeatureCard}" Command="{Binding Command}" nav:Nav.Group="console-cards" nav:Nav.Key="{Binding Key}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Canvas>
    </Grid>
  </DataTemplate>

  <!-- Detalhe de um recurso: o cartão no topo (ícone, nome, selo e resumo) e as linhas dele. -->
  <DataTemplate DataType="{x:Type vm:SettingsDetailViewModel}">
    <Grid>
      <Rectangle Fill="{StaticResource SettingsScrim}" />
      <Grid Margin="64,40,72,100" MaxWidth="1400" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Overline, Converter={StaticResource Upper}}" Style="{StaticResource Overline}" />
          <StackPanel DataContext="{Binding Feature}">
            <DockPanel Margin="0,4,0,0">
              <c:Icon Key="{Binding IconKey}" Width="52" Height="52" DockPanel.Dock="Left" Margin="0,0,20,0" Foreground="{DynamicResource OnAccentBrush}" />
              <Border DockPanel.Dock="Right" Style="{StaticResource StateBadge}" Margin="24,0,0,0">
                <TextBlock Text="{Binding ValueText}" FontSize="{DynamicResource FsLabelMd}" FontWeight="Bold" />
              </Border>
              <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock Text="{Binding Description}" Margin="0,10,0,0" FontSize="{DynamicResource FsBodyLg}" Foreground="{DynamicResource OnAccentMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        <ContentControl Grid.Row="1" Margin="0,24,0,0" Content="{Binding}" ContentTemplate="{StaticResource SettingRowsList}" Focusable="False" />
      </Grid>
    </Grid>
  </DataTemplate>

  <!-- ===================================================================== Assistente -->

  <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}">
    <Grid>
      <Button Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False" Cursor="Arrow">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Rectangle Fill="{DynamicResource ScrimBrush}" />
          </ControlTemplate>
        </Button.Template>
      </Button>
      <Border Width="1000" MaxHeight="900" CornerRadius="28" Background="#FF1A1E26" Padding="56,44" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding Heading, Converter={StaticResource Upper}}" Style="{StaticResource Overline}" />
          <!-- Passos: o atual em branco, os feitos com ✓. -->
          <ItemsControl ItemsSource="{Binding Steps}" Margin="0,18,0,0" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:WizardStepViewModel}">
                <StackPanel Margin="0,0,10,0">
                  <Border x:Name="Bar" Height="6" CornerRadius="3" Background="{DynamicResource Surface2Brush}" />
                  <TextBlock x:Name="Label" Text="{Binding Label}" Margin="0,10,0,0" FontSize="{DynamicResource FsLabelSm}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentSubtleBrush}" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource OnAccentMutedBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="White" />
                    <Setter TargetName="Label" Property="Foreground" Value="White" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding StepText}" Margin="0,30,0,0" FontSize="{DynamicResource FsLabelSm}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentSubtleBrush}" />
          <TextBlock Text="{Binding Title}" Margin="0,6,0,0" FontFamily="{DynamicResource FontDisplay}" FontSize="{DynamicResource FsHeadlineMd}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Text}" Margin="0,14,0,0" FontSize="{DynamicResource FsBodyLg}" Foreground="#B3FFFFFF" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Actions}" Margin="0,36,0,-18" Focusable="False" ItemTemplate="{StaticResource OverlayActionTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
