<Application x:Class="Launcher.UI.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Os tokens do tema (Themes/*/Tokens.xaml) entram na posição 0 em tempo de execução (ThemeService). -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Icons.xaml" />
        <ResourceDictionary Source="Resources/Styles.xaml" />
        <ResourceDictionary Source="Resources/Views.xaml" />
        <ResourceDictionary Source="Resources/SessionViews.xaml" />
        <ResourceDictionary Source="Resources/LibraryViews.xaml" />
        <ResourceDictionary Source="Resources/DeviceViews.xaml" />
        <ResourceDictionary Source="Resources/ThemeViews.xaml" />
        <ResourceDictionary Source="Resources/DiagnosticsViews.xaml" />
        <ResourceDictionary Source="Resources/GameScreenViews.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
