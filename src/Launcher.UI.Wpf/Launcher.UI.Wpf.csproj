<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Nome do produto: o executável é Tako.exe; namespaces continuam Launcher.UI.Wpf. -->
    <AssemblyName>Tako</AssemblyName>
    <RootNamespace>Launcher.UI.Wpf</RootNamespace>
    <!-- Main próprio: o mesmo Tako.exe roda como supervisor (sem WPF) ou como UI (ADR-0012). -->
    <StartupObject>Launcher.UI.Wpf.Program</StartupObject>
    <Product>Tako</Product>
    <!-- Versão local; a release usa a da tag (build\Publish-Tako.ps1 -Version). -->
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\Brand\tako.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- LibraryImport (XInput) gera código unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConsoleMode.Runtime.Windows\ConsoleMode.Runtime.Windows.csproj" />
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
    <ProjectReference Include="..\Launcher.Themes\Launcher.Themes.csproj" />
    <ProjectReference Include="..\Launcher.PlayniteCompat.P10\Launcher.PlayniteCompat.P10.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Brand\*" />
    <None Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\OFL-SourceSans3.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Avisos de licença de terceiros (PresentMon, CapFrameX) ao lado do Tako.exe. -->
    <None Include="..\..\NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Temas são dados não confiáveis: ficam soltos na pasta de saída e passam pelo carregador XAML restrito (MVP-016). -->
    <Page Remove="Themes\**\*.xaml" />
    <Content Include="Themes\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Cópia embutida do tema padrão: fallback quando o arquivo solto falha (MVP-021). -->
    <Resource Include="Themes\Default\Tokens.xaml" />
  </ItemGroup>
  <!-- PresentMon da Intel (MIT) para o contador de FPS (ADR-0017): build\Publish-Tako.ps1 baixa a release oficial, confere
       o SHA-256 e passa -p:PresentMonExe=<arquivo>. Sem ele (compilação local) o contador aparece como indisponível. -->
  <ItemGroup Condition="'$(PresentMonExe)' != '' And Exists('$(PresentMonExe)')">
    <None Include="$(PresentMonExe)" Link="PresentMon\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
