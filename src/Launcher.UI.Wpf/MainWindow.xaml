<Window x:Class="Launcher.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Launcher.UI.Wpf.Controls"
        xmlns:nav="clr-namespace:Launcher.UI.Wpf.Navigation"
        xmlns:vm="clr-namespace:Launcher.UI.Wpf.ViewModels"
        Title="Tako" Icon="pack://application:,,,/Tako;component/Assets/Brand/tako.ico" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" Background="Black"
        FontFamily="{DynamicResource FontText}" Foreground="{DynamicResource OnAccentBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
  <Window.Resources>
    <Duration x:Key="PageDuration">0:0:0.28</Duration>
  </Window.Resources>

  <!-- Canvas de referência 1920x1080, escalado uniformemente para qualquer resolução (DESIGN.md › Layout). -->
  <Viewbox Stretch="Uniform">
    <Grid x:Name="Stage" Width="1920" Height="1080" ClipToBounds="True">
      <Grid.Background>
        <SolidColorBrush Color="{DynamicResource CanvasColor}" />
      </Grid.Background>

      <c:BackdropView State="{Binding Backdrop}" IsLarge="{Binding IsBackdropLarge}" />

      <!-- Área de conteúdo: desloca quando a barra lateral expande. -->
      <Grid x:Name="ContentArea" Margin="120,0,0,0">
        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Focusable="False" />
      </Grid>

      <!-- Barra lateral: recolhida (ícones) e expandida quando recebe o foco. -->
      <Border x:Name="Sidebar" Width="120" HorizontalAlignment="Left" Background="{DynamicResource SurfaceSidebarBrush}" Panel.ZIndex="5" ClipToBounds="True">
        <DockPanel Margin="20,48,20,96" LastChildFill="False">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="64" Margin="20,0,0,24">
            <Image Source="pack://application:,,,/Tako;component/Assets/Brand/tako-mark.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="BrandName" Text="Tako" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FsTitle}" FontWeight="ExtraBold" Opacity="0" />
          </StackPanel>
          <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SidebarMain}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SidebarItemViewModel}">
                <StackPanel>
                  <TextBlock x:Name="Section" Text="{Binding SectionTitle, Converter={StaticResource Upper}}" Margin="20,22,0,8" FontSize="{DynamicResource FsLabelSm}" FontWeight="Bold"
                             Foreground="{DynamicResource OnAccentSubtleBrush}" Visibility="{Binding SectionTitle, Converter={StaticResource NotNullToVisibility}}" />
                  <Button Style="{StaticResource SidebarItem}" Command="{Binding Command}" nav:Nav.Group="sidebar" nav:Nav.Key="{Binding Key}" nav:Nav.IsGroupEntry="{Binding IsSelected}" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter TargetName="Section" Property="Opacity" Value="0" />
                    <Setter TargetName="Section" Property="Height" Value="0" />
                    <Setter TargetName="Section" Property="Margin" Value="0,10" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding SidebarFooter}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SidebarItemViewModel}">
                <Button Style="{StaticResource SidebarItem}" Command="{Binding Command}" nav:Nav.Group="sidebar" nav:Nav.Key="{Binding Key}" nav:Nav.IsGroupEntry="{Binding IsSelected}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                <DataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Width" To="400" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Width" To="120" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>

      <!-- Sobreposições empilhadas: a última fica por cima. -->
      <ItemsControl x:Name="OverlayHost" ItemsSource="{Binding Overlays}" Panel.ZIndex="20" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Grid />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- Status: canto superior direito; desce para o canto inferior esquerdo com a Central de Controle aberta. -->
      <StackPanel x:Name="Status" Orientation="Horizontal" Height="30" Panel.ZIndex="30">
        <c:Icon x:Name="InputIcon" Key="Icon.Keyboard" Width="24" Height="24" Foreground="{DynamicResource OnAccentMutedBrush}" Margin="0,0,8,0" />
        <TextBlock Text="{Binding InputStatus}" VerticalAlignment="Center" FontSize="{DynamicResource FsLabelSm}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentMutedBrush}" />
        <TextBlock Text="{Binding Clock}" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource FsLabelMd}" FontWeight="Bold" />
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <!-- Posição no estilo (não local): valores locais venceriam os gatilhos. -->
            <Setter Property="Margin" Value="0,14,72,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsQuickMenuOpen}" Value="True">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="72,0,0,29" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsInGame}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
      </StackPanel>

      <!-- Barra de dicas: glifos do dispositivo atual; cada dica é clicável. -->
      <Border Height="88" VerticalAlignment="Bottom" Panel.ZIndex="30" Padding="72,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
            <GradientStop Offset="0" Color="#59000000" />
            <GradientStop Offset="1" Color="#00000000" />
          </LinearGradientBrush>
        </Border.Background>
        <ItemsControl ItemsSource="{Binding Hints}" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:HintViewModel}">
              <Button Style="{StaticResource HintButton}" Command="{Binding DataContext.HintCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Command}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsInGame}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>

      <!-- Aviso (toast) -->
      <Border x:Name="Toast" Background="White" CornerRadius="34" Padding="32,20" Margin="0,0,0,120" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Panel.ZIndex="40" IsHitTestVisible="False" Effect="{StaticResource FocusShadow}" Opacity="0">
        <TextBlock Text="{Binding ToastMessage}" Foreground="#FF11141A" FontSize="{DynamicResource FsBodyMd}" FontWeight="SemiBold" />
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                <DataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
    </Grid>
  </Viewbox>
</Window>
