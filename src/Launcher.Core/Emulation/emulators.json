      "systems": ["ps2"],
      "arguments": "-batch -nogui {fullscreen} -- {rom}",
      "fullscreen": "-fullscreen",
      "exitKey": "Escape",
      "folders": ["{ProgramFiles}\\PCSX2", "{ProgramFilesX86}\\PCSX2", "{LocalAppData}\\Programs\\PCSX2", "C:\\PCSX2"],
      "scoop": ["pcsx2", "pcsx2-dev"],
      "winget": ["PCSX2Team.PCSX2"],
      "uninstallNames": ["PCSX2"]
    },
