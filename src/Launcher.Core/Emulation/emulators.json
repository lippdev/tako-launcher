  "retroarchHotkeys": [
    { "key": "input_quit_gamepad_combo", "value": "4", "unset": ["0", ""] },
    { "key": "quit_press_twice", "value": "false", "unset": ["true", ""] }
  ],
  "emulators": [
    {
      "id": "retroarch",
      "name": "RetroArch",
      "executables": ["retroarch.exe"],
      "usesCores": true,
      "systems": [],
      "arguments": "-L {core} {rom} {fullscreen}",
      "fullscreen": "-f",
      "configArgument": "--appendconfig {config}",
      "exitKey": "Escape",
      "exitKeyPresses": 2,
      "folders": ["{ProgramFiles}\\RetroArch", "{ProgramFiles}\\RetroArch-Win64", "C:\\RetroArch-Win64", "C:\\RetroArch", "{AppData}\\RetroArch", "{ProgramFilesX86}\\Steam\\steamapps\\common\\RetroArch"],
      "scoop": ["retroarch"],
      "winget": ["Libretro.RetroArch"],
      "uninstallNames": ["RetroArch"]
    },
    {
      "id": "dolphin",
      "name": "Dolphin",
      "executables": ["Dolphin.exe"],
      "systems": ["gamecube", "wii"],
      "arguments": "-b {fullscreen} -e {rom}",
      "fullscreen": "-C Dolphin.Display.Fullscreen=True",
      "exitKey": "Escape",
      "folders": ["{ProgramFiles}\\Dolphin", "{ProgramFiles}\\Dolphin-x64", "{LocalAppData}\\Dolphin", "C:\\Dolphin-x64"],
      "scoop": ["dolphin", "dolphin-dev"],
      "winget": ["DolphinEmulator.Dolphin"],
      "uninstallNames": ["Dolphin"]
    },
    {
      "id": "pcsx2",
