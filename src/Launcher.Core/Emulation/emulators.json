  "bios": [
    {
      "emulator": "duckstation",
      "system": "ps1",
      "label": "BIOS do PlayStation (arquivo .bin, como scph5501.bin)",
      "folders": ["{exe}\\bios", "{Documents}\\DuckStation\\bios", "{LocalAppData}\\DuckStation\\bios"],
      "patterns": [".bin"]
    },
    {
      "emulator": "pcsx2",
      "system": "ps2",
