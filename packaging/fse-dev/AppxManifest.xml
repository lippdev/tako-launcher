<?xml version="1.0" encoding="utf-8"?>
<!--
  Pacote SOMENTE DE DESENVOLVIMENTO do spike MVP-007. Registra a FseProbe como gaming home app do
  Xbox mode (antigo Full Screen Experience). A capability gamingHome exige um SCCD assinado pela
  Microsoft; o CustomCapability.SCCD daqui usa o catálogo de desenvolvimento (FFFF) e só funciona
  com o Modo de Desenvolvedor ligado. Não distribuir.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap4="http://schemas.microsoft.com/appx/manifest/uap/windows10/4"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap4 uap10 rescap">

  <Identity Name="UltraLauncher.FseProbe" Publisher="CN=UltraLauncher Dev" Version="0.1.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>UltraLauncher FseProbe</DisplayName>
    <PublisherDisplayName>UltraLauncher</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Launcher.FseProbe.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--home">
      <uap:VisualElements
        DisplayName="UltraLauncher FseProbe"
        Description="Probe do spike MVP-007"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Extensão que faz o app aparecer em Configurações > Jogos > Xbox mode > Escolher app inicial. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="windows.gamingApp" Id="App" DisplayName="UltraLauncher FseProbe" Description="Probe do spike MVP-007" PublicFolder="Public" />
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap4:CustomCapability Name="Microsoft.appCategory.gamingHome_8wekyb3d8bbwe" />
  </Capabilities>
</Package>
