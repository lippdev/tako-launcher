<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Benchmark do Tako (MVP-035): abre a UI real (mesma composição do app) com uma biblioteca fictícia e mede abertura,
    memória, CPU, fluidez e overhead com um "jogo" (carga de CPU) em execução. Ver docs/marco-1/benchmark.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Mesmo manifesto do Tako (PerMonitorV2): monitores e escala lidos como o app lê. -->
    <ApplicationManifest>..\..\src\Launcher.UI.Wpf\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Launcher.UI.Wpf\Launcher.UI.Wpf.csproj" />
  </ItemGroup>
</Project>
