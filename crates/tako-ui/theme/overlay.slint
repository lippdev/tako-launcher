// Camadas por cima da página (diálogos, painéis, teclado virtual, seletor de arte, "Abrindo…") e as structs delas.
// Usadas pela tela cheia (`main.slint`, que as reexporta na API de tema) e pela janela do modo desktop.
import { Ui } from "tokens.slint";
import { PanelRow, Icon, RowView } from "widgets.slint";

export struct Tile {
    id: string,
    title: string,
    meta: string,
    cover: image,
    accent: color,
    installed: bool,
    favorite: bool,
    running: bool,
}

// Tecla do teclado virtual: posição em colunas e linhas (as teclas largas ocupam várias colunas).
export struct Key { label: string, row: int, col: int, span: int }

// Camada por cima da página. `kind`: dialog, panel (lateral), keyboard, art, launch, progress, recovery.
export struct Overlay {
    kind: string,
    title: string,
    overline: string,
    text: string,
    rows: [PanelRow],
    sel: int,
    wide: bool,
    image: image,
    // Teclado virtual.
    keys: [Key],
    key-cols: int,
    input: string,
    input-hint: string,
    secret: bool,
    // Seletor de arte: abas de tipo e de fonte, miniaturas e prévia.
    tabs: [string],
    tab: int,
    tabs2: [string],
    tab2: int,
    thumbs: [Tile],
    thumb-cols: int,
    preview: image,
    preview-text: string,
}

export component Overline inherits Text {
    color: Ui.on-accent-muted;
    font-family: Ui.font-text;
    font-size: Ui.label-sm;
    font-weight: 700;
    letter-spacing: 0.16 * Ui.label-sm;
}

// Linhas roláveis de um painel ou diálogo: o item focado sempre inteiro, acima da barra de dicas.
export component RowList inherits Rectangle {
    in property <[PanelRow]> rows;
    in property <int> sel;
    callback clicked(int);
    callback hovered(int);
    property <length> row-h: 100 * Ui.u;
    property <int> shown;
    init => { shown = sel; }
    changed sel => { if (!Ui.pointer) { shown = sel; } }
    property <length> scroll: min(0, max(self.height - rows.length * row-h, -(max(0, shown) * row-h) + (self.height - row-h) / 2));
    clip: true;
    Rectangle {
        y: scroll;
        animate y { duration: Ui.focus-time; }
        for r[i] in rows: RowView {
            x: 0;
            y: i * row-h + 4 * Ui.u;
            width: parent.width;
            height: row-h - 8 * Ui.u;
            data: r;
            focused: i == sel;
            clicked => { root.clicked(i); }
            hovered => { root.hovered(i); }
        }
    }
}

export component OverlayView inherits Rectangle {
    in property <Overlay> ov;
    in property <bool> top-most;
    // Arte do jogo em foco e "saindo para o jogo" (só para "Abrindo…").
    in property <image> art;
    in property <bool> leaving;
    callback clicked(string, int);
    callback hovered(string, int);
    // "Abrindo…": a arte do jogo em tela cheia até a janela dele aparecer; aí some aos poucos (a janela fica
    // transparente e o jogo aparece por trás).
    if ov.kind == "splash": Rectangle {
        opacity: leaving ? 0 : 1;
        animate opacity { duration: Ui.leave-time; easing: ease-in-out; }
        background: @linear-gradient(160deg, Ui.accent 0%, Ui.accent-deep 100%);
        if art.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: art;
            image-fit: cover;
        }
        Rectangle { background: @linear-gradient(0deg, #000000E6 0%, #00000099 35%, #00000000 70%); }
        TouchArea { }
        VerticalLayout {
            x: Ui.safe-x;
            y: parent.height - Ui.hint-bar - self.height - 24 * Ui.u;
            width: parent.width * 0.6;
            height: self.preferred-height;
            spacing: 14 * Ui.u;
            Overline { text: ov.overline; color: Ui.on-accent; }
            Text { text: ov.title; color: Ui.on-accent; font-size: Ui.display; font-family: Ui.font-title; font-weight: 700; wrap: word-wrap; }
            // Barra indeterminada: o jogo está carregando.
            Rectangle {
                width: 360 * Ui.u;
                height: 6 * Ui.u;
                border-radius: self.height / 2;
                background: #FFFFFF33;
                clip: true;
                property <float> t: mod(animation-tick() / 1400ms, 1);
                Rectangle {
                    width: 120 * Ui.u;
                    x: (parent.width + self.width) * t - self.width;
                    border-radius: parent.border-radius;
                    background: Ui.on-accent;
                }
            }
            if ov.text != "": Text { text: ov.text; color: Ui.on-accent-muted; font-size: Ui.body-md; font-family: Ui.font-text; wrap: word-wrap; }
        }
    }
    // Painel lateral: à direita, na altura da tela; o resto da página aparece atrás.
    if ov.kind == "panel": Rectangle {
        background: Ui.scrim;
        TouchArea { clicked => { root.clicked("outside", 0); } }
        Rectangle {
            x: parent.width - self.width;
            width: (ov.wide ? 760 : 600) * Ui.u;
            background: Ui.accent-deep.with-alpha(0.97);
            VerticalLayout {
                padding-left: 40 * Ui.u;
                padding-right: 40 * Ui.u;
                padding-top: 56 * Ui.u;
                padding-bottom: Ui.hint-bar;
                spacing: 12 * Ui.u;
                if ov.overline != "": Overline { text: ov.overline; }
                Text { text: ov.title; color: Ui.on-accent; font-size: Ui.headline-md; font-family: Ui.font-title; font-weight: 600; wrap: word-wrap; }
                if ov.text != "": Text { text: ov.text; color: Ui.on-accent-muted; font-size: Ui.body-md; font-family: Ui.font-text; wrap: word-wrap; }
                Rectangle { height: 12 * Ui.u; }
                RowList {
                    vertical-stretch: 1;
                    rows: ov.rows;
                    sel: top-most ? ov.sel : -1;
                    clicked(i) => { root.clicked("row", i); }
                    hovered(i) => { root.hovered("row", i); }
                }
            }
        }
    }
    // Diálogo central: título, texto e ações (linhas ou pílulas).
    if ov.kind == "dialog" || ov.kind == "recovery": Rectangle {
        background: Ui.scrim;
        Rectangle {
            width: (ov.wide ? 1000 : 760) * Ui.u;
            height: min(dlg.preferred-height, parent.height - Ui.hint-bar - 80 * Ui.u);
            y: (parent.height - Ui.hint-bar - self.height) / 2;
            border-radius: Ui.radius-lg;
            background: Ui.accent-deep.with-alpha(0.98);
            drop-shadow-blur: 40 * Ui.u;
            drop-shadow-color: #00000080;
            dlg := VerticalLayout {
                padding: 44 * Ui.u;
                spacing: 14 * Ui.u;
                if ov.overline != "": Overline { text: ov.overline; }
                if ov.image.width > 0: Image { source: ov.image; height: 160 * Ui.u; image-fit: contain; }
                Text { text: ov.title; color: Ui.on-accent; font-size: Ui.headline-md; font-family: Ui.font-title; font-weight: 600; wrap: word-wrap; }
                if ov.text != "": Text { text: ov.text; color: Ui.on-accent-muted; font-size: Ui.body-md; font-family: Ui.font-text; wrap: word-wrap; }
                Rectangle { height: 10 * Ui.u; }
                RowList {
                    height: min(ov.rows.length * 100 * Ui.u, 560 * Ui.u);
                    rows: ov.rows;
                    sel: top-most ? ov.sel : -1;
                    clicked(i) => { root.clicked("row", i); }
                    hovered(i) => { root.hovered("row", i); }
                }
            }
        }
    }
    // Teclado virtual da busca e dos campos de texto.
    if ov.kind == "keyboard": Rectangle {
        background: Ui.scrim;
        Rectangle {
            y: parent.height - self.height;
            height: kb.preferred-height + Ui.hint-bar;
            background: Ui.accent-deep.with-alpha(0.98);
            kb := VerticalLayout {
                y: 0;
                padding-left: Ui.safe-x;
                padding-right: Ui.safe-x;
                padding-top: 36 * Ui.u;
                spacing: 16 * Ui.u;
                height: self.preferred-height;
                Text { text: ov.title; color: Ui.on-accent; font-size: Ui.title-md; font-weight: 600; font-family: Ui.font-text; }
                Rectangle {
                    height: 72 * Ui.u;
                    border-radius: self.height / 2;
                    background: Ui.surface-1;
                    Text {
                        x: 32 * Ui.u;
                        text: ov.input == "" ? ov.input-hint : (ov.secret ? "●●●●●●●●" : ov.input) + "▏";
                        color: ov.input == "" ? Ui.on-accent-subtle : Ui.on-accent;
                        font-size: Ui.body-lg;
                        font-family: Ui.font-text;
                        vertical-alignment: center;
                    }
                }
                if ov.text != "": Text { text: ov.text; color: Ui.on-accent-muted; font-size: Ui.label-sm; font-family: Ui.font-text; }
                Rectangle {
                    property <int> cols: max(1, ov.key-cols);
                    property <length> kw: (self.width - (cols - 1) * 10 * Ui.u) / cols;
                    property <int> rows: ov.keys.length == 0 ? 0 : ov.keys[ov.keys.length - 1].row + 1;
                    height: rows * 74 * Ui.u;
                    for k[i] in ov.keys: Rectangle {
                        x: k.col * (kw + 10 * Ui.u);
                        y: k.row * 74 * Ui.u;
                        width: k.span * kw + (k.span - 1) * 10 * Ui.u;
                        height: 64 * Ui.u;
                        border-radius: Ui.radius-sm;
                        background: i == ov.sel ? Ui.surface-solid : Ui.surface-1;
                        Text {
                            text: k.label;
                            color: i == ov.sel ? Ui.on-surface-solid : Ui.on-accent;
                            font-size: Ui.label-lg;
                            font-weight: 600;
                            font-family: Ui.font-text;
                        }
                        TouchArea {
                            clicked => { root.clicked("key", i); }
                            changed has-hover => { if (self.has-hover) { root.hovered("key", i); } }
                        }
                    }
                }
            }
        }
    }
    // Seletor de arte: abas (tipo e fonte), miniaturas e prévia.
    if ov.kind == "art": Rectangle {
        background: Ui.accent-deep.with-alpha(0.97);
        property <int> cols: max(1, ov.thumb-cols);
        property <length> tw: 200 * Ui.u;
        VerticalLayout {
            padding-left: 64 * Ui.u;
            padding-right: 72 * Ui.u;
            padding-top: 48 * Ui.u;
            padding-bottom: Ui.hint-bar;
            spacing: 16 * Ui.u;
            Text { text: ov.title; color: Ui.on-accent; font-size: Ui.headline-md; font-family: Ui.font-title; font-weight: 600; }
            HorizontalLayout {
                spacing: 12 * Ui.u;
                alignment: start;
                for t[i] in ov.tabs: Rectangle {
                    height: 52 * Ui.u;
                    width: tt.preferred-width + 44 * Ui.u;
                    border-radius: self.height / 2;
                    background: i == ov.tab ? Ui.surface-solid : Ui.surface-1;
                    tt := Text { text: t; color: i == ov.tab ? Ui.on-surface-solid : Ui.on-accent; font-size: Ui.label-md; font-weight: 600; font-family: Ui.font-text; }
                    TouchArea { clicked => { root.clicked("tab", i); } }
                }
            }
            HorizontalLayout {
                spacing: 12 * Ui.u;
                alignment: start;
                for t[i] in ov.tabs2: Rectangle {
                    height: 44 * Ui.u;
                    width: t2.preferred-width + 36 * Ui.u;
                    border-radius: self.height / 2;
                    background: i == ov.tab2 ? Ui.surface-2 : transparent;
                    border-width: 2 * Ui.u;
                    border-color: Ui.surface-2;
                    t2 := Text { text: t; color: Ui.on-accent; font-size: Ui.label-sm; font-weight: 600; font-family: Ui.font-text; }
                    TouchArea { clicked => { root.clicked("tab2", i); } }
                }
            }
            HorizontalLayout {
                spacing: 40 * Ui.u;
                vertical-stretch: 1;
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    property <int> sel: ov.sel;
                    property <int> shown;
                    init => { shown = sel; }
                    changed sel => { if (!Ui.pointer) { shown = sel; } }
                    property <int> focus-row: floor(max(0, shown) / cols);
                    property <length> th: tw * 1.5 + 20 * Ui.u;
                    if ov.thumbs.length == 0: Text { y: 20 * Ui.u; text: ov.text; color: Ui.on-accent-muted; font-size: Ui.body-md; font-family: Ui.font-text; wrap: word-wrap; }
                    Rectangle {
                        y: min(0, -(focus-row - 1) * th);
                        animate y { duration: Ui.focus-time; }
                        for t[i] in ov.thumbs: Rectangle {
                            x: mod(i, cols) * (tw + 20 * Ui.u) + 10 * Ui.u;
                            y: floor(i / cols) * th + 10 * Ui.u;
                            width: tw;
                            height: tw * 1.5;
                            border-radius: Ui.radius-sm;
                            clip: true;
                            background: Ui.surface-1;
                            border-width: i == ov.sel ? 4 * Ui.u : 0;
                            border-color: Ui.surface-solid;
                            Image { source: t.cover; width: parent.width; height: parent.height; image-fit: contain; }
                            if t.favorite: Icon { x: 8 * Ui.u; y: 8 * Ui.u; name: "check"; tint: Ui.success; }
                            TouchArea {
                                clicked => { root.clicked("thumb", i); }
                                changed has-hover => { if (self.has-hover) { root.hovered("thumb", i); } }
                            }
                        }
                    }
                }
                VerticalLayout {
                    width: 520 * Ui.u;
                    spacing: 12 * Ui.u;
                    alignment: start;
                    Rectangle {
                        height: 520 * Ui.u;
                        border-radius: Ui.radius-md;
                        background: Ui.surface-1;
                        clip: true;
                        Image { source: ov.preview; width: parent.width; height: parent.height; image-fit: contain; }
                    }
                    Text { text: ov.preview-text; color: Ui.on-accent-muted; font-size: Ui.label-md; font-family: Ui.font-text; wrap: word-wrap; }
                }
            }
        }
    }
    // Iniciando o jogo / voltando para a biblioteca.
    if ov.kind == "launch" || ov.kind == "progress": Rectangle {
        background: Ui.accent-deep.with-alpha(0.92);
        VerticalLayout {
            alignment: center;
            spacing: 24 * Ui.u;
            if ov.image.width > 0: Image { source: ov.image; height: 420 * Ui.u; image-fit: contain; }
            Text { text: ov.title; color: Ui.on-accent; font-size: Ui.headline-lg; font-family: Ui.font-title; font-weight: 300; horizontal-alignment: center; }
            Text { text: ov.text; color: Ui.on-accent-muted; font-size: Ui.body-lg; font-family: Ui.font-text; horizontal-alignment: center; wrap: word-wrap; }
        }
    }
}
