// Octopus (BRAND-001): o polvo da TelaCarregamento, montado tentáculo por tentáculo. É o mesmo desenho e a mesma
// animação da abertura, em qualquer tamanho, para o app reaproveitar (estados vazios, espera, "Bem-vindo de volta")
// em vez de ter outro polvo. Fora da API de tema (como o desktop e a abertura).

import { Ui } from "tokens.slint";

// Um tentáculo: a camada inteira do logo (704 × 802), girando em volta da base do corpo (meio da largura, 41% do alto).
component Tentacle inherits Rectangle {
    in property <image> source;
    in property <bool> arrived;
    // -1 esquerda, 1 direita, 0 os da frente (só crescem).
    in property <int> side;
    // Fase da ondulação (graus por tentáculo, para não ondularem juntos).
    in property <float> wave;
    in property <bool> idle;
    opacity: arrived ? 1 : 0;
    transform-origin: { x: self.width / 2, y: self.height * 0.4115 };
    transform-rotation: arrived ? 0deg : side * 40deg;
    transform-scale: arrived ? 1 : 0.6;
    animate opacity, transform-rotation, transform-scale { duration: Ui.tempo-tentaculo; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        transform-origin: { x: self.width / 2, y: self.height * 0.4115 };
        transform-rotation: idle ? 1.6deg * sin(animation-tick() / 2400ms * 360deg + root.wave * 1deg) : 0deg;
    }
}

// O tamanho vem da largura (o alto acompanha). Com `with-name: false` o corte fica só no polvo e no anel, sem o TAKO.
export component Octopus inherits Rectangle {
    // 0 a 1: os tentáculos chegam quando o valor passa do ponto de cada um (a TelaCarregamento amarra isto à barra).
    in property <float> progress;
    // No app não há barra: o polvo se monta sozinho ao aparecer, no ritmo de `tempo-montagem`.
    in property <bool> self-assemble: false;
    in property <bool> with-name: true;
    // Uma propriedade setada em `init` não anima: o Timer vira `started` depois do primeiro quadro.
    property <bool> started;
    property <float> own: started ? 1 : 0;
    animate own { duration: Ui.tempo-montagem; easing: linear; }
    // "Reduzir animações": o polvo já vem completo e parado.
    property <float> p: Ui.reduce-motion ? 1 : (self-assemble ? own : max(progress, 0));
    property <bool> done: p >= 0.88;
    property <bool> alive: done && !Ui.reduce-motion;
    property <length> h: self.width * (with-name ? 802 / 704 : 0.77);
    // Alto fixo pelos três limites (num layout, só `height` não vale e o corte sem o nome seria esticado).
    min-height: h;
    preferred-height: h;
    max-height: h;
    clip: true;
    Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            started = true;
        }
    }
    // `x` e `y` explícitos: sem eles o Slint centraliza o filho, e o corte sem o nome sairia dos dois lados.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: self.width * 802 / 704;
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("splash/splash-base.png");
            // O corpo respira com todos os tentáculos no lugar.
            transform-origin: { x: self.width / 2, y: self.height * 0.299 };
            transform-scale: alive ? 1 + 0.012 * sin(animation-tick() / 3200ms * 360deg) : 1;
        }
        // Ordem de chegada: alterna os lados (8, 20, 33, 46, 60, 74 e 88%).
        Tentacle { source: @image-url("splash/splash-t1.png"); arrived: p >= 0.08; side: -1; wave: 0; idle: alive; }
        Tentacle { source: @image-url("splash/splash-t2.png"); arrived: p >= 0.20; side: 1; wave: 70; idle: alive; }
        Tentacle { source: @image-url("splash/splash-t3.png"); arrived: p >= 0.33; side: -1; wave: 140; idle: alive; }
        Tentacle { source: @image-url("splash/splash-t4.png"); arrived: p >= 0.46; side: 1; wave: 210; idle: alive; }
        Tentacle { source: @image-url("splash/splash-t5.png"); arrived: p >= 0.60; side: -1; wave: 280; idle: alive; }
        Tentacle { source: @image-url("splash/splash-t6.png"); arrived: p >= 0.74; side: 1; wave: 350; idle: alive; }
        Tentacle { source: @image-url("splash/splash-t7.png"); arrived: p >= 0.88; side: 0; wave: 50; idle: alive; }
    }
}
