// Janela do modo desktop (ADR-0027): mouse e teclado, para organizar a biblioteca e configurar. Não faz parte da
// API de tema (os temas valem só para a tela cheia); usa os tokens do tema padrão numa escala de mesa. Como na tela
// cheia, o Tako calcula o estado e a seleção; aqui só se desenha e se avisa cliques, teclas e textos.

// Títulos em Poppins (`Ui.font-heading`) e o resto em Plus Jakarta Sans (`Ui.font-desk`), as duas OFL. A tela cheia
// mantém Inter e Source Sans 3; a Central reaproveitada aqui continua com as fontes dela.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";
import "fonts/SourceSans3-Light.ttf";
import "fonts/SourceSans3-Regular.ttf";
import "fonts/SourceSans3-Semibold.ttf";
import "fonts/SourceSans3-Bold.ttf";
import "fonts/Poppins-Regular.ttf";
import "fonts/Poppins-Medium.ttf";
import "fonts/Poppins-SemiBold.ttf";
import "fonts/Poppins-Bold.ttf";
import "fonts/Poppins-ExtraBold.ttf";
import "fonts/PlusJakartaSans-Regular.ttf";
import "fonts/PlusJakartaSans-Medium.ttf";
import "fonts/PlusJakartaSans-SemiBold.ttf";
import "fonts/PlusJakartaSans-Bold.ttf";
import "fonts/PlusJakartaSans-ExtraBold.ttf";

import { Ui } from "tokens.slint";
import { ControlCenter } from "main.slint";
import { PanelRow, Icon, Toggle } from "widgets.slint";
import { Icons } from "icons.slint";
import { Octopus } from "polvo.slint";
import { Overlay, Overline, OverlayView, Tile } from "overlay.slint";

export { Ui }

struct DeskNav { id: string, label: string, icon: string, count: string, section: string, selected: bool }
struct DeskGame { id: string, title: string, thumb: image, cover: image, accent: color, favorite: bool, running: bool, installed: bool, store-icon: string, store-name: string, checked: bool, index: int, label: string, kind: string, count: string, open: bool, installing: bool, progress: float, percent: string, install-label: string }
struct DeskBlock { kind: string, title: string, count: string, label: string, icon: string, open: bool, games: [DeskGame], first: int, index: int, rows-before: int, sections-before: int, groups-before: int }
struct DeskCategory { title: string, count: string, icon: string, games: [DeskGame] }
struct DeskGameView { has-game: bool, title: string, overline: string, description: string, art: image, art-blur: image, art-lum: [float], logo: image, accent: color, hint: string, install-note: string, install-warn: bool, running: bool, about-more: bool, genres: [string], genres-more: string, trailer: bool, art-loading: bool, show-logo: bool, title-pending: bool, store-icon: string, store-name: string, play-status: string, play-status-label: string }
struct CoverRow { current: image, has-current: bool, proposed: image, has-proposed: bool, current-label: string, level: int, confidence: string, reason: string, accept: string, other: string }
struct DeskStat { label: string, value: string }
struct DeskInfo { icon: string, label: string, value: string, detail: string, dot: bool, chips: [string], score: int }
struct DeskBar { label: string, value: string, fraction: float, today: bool, future: bool }
struct DeskEntry { id: string, title: string, detail: string, note: string, value: string, thumb: image, accent: color, fraction: float, dot: bool, header: bool, row: int }
struct DeskCard { title: string, count: string, auto: bool, covers: [DeskEntry] }
struct DeskProfile { name: string, initial: string, line: [DeskInfo], playing: bool, tabs: [string], tab: int, actions: [DeskInfo], tiles: [DeskInfo], week-label: string, week-total: string, week: [DeskBar], week-text: string, top: [DeskEntry], fan: [DeskEntry], recent-title: string, see-all: string, recent: [DeskEntry], empty: string, periods: [string], period: int, summary: string, sessions: [DeskEntry], cards-summary: string, cards: [DeskCard], auto-label: string, new-label: string, new-text: string, zone: string, index: int }
struct DeskMore { on: bool, labels: [string], description: string, details: [DeskInfo], sessions-summary: string, sessions: [DeskInfo], shots: [image] }

// Ícone do desktop: cor opaca com a transparência no elemento inteiro (com a cor translúcida no traço, o femtovg
// somava a transparência onde os traços se cruzam e o ícone parecia ter contorno) e pontas e cantos redondos,
// como os SVG das prévias. A tela cheia continua com o `Icon` dela.
component DeskIcon inherits Rectangle {
    in property <string> name;
    in property <color> tint: Ui.on-accent;
    in property <length> size: 20px;
    width: size;
    height: size;
    opacity: tint.to-hsv().alpha;
    // Logos de loja vêm do SVG com colorize: o Path com furos do femtovg deixa um contorno nas bordas.
    property <bool> store: !(name != "store-steam" && name != "store-epic" && name != "store-gog" && name != "store-ubisoft" && name != "store-ea" && name != "store-battlenet" && name != "store-amazon" && name != "store-xbox" && name != "store-manual");
    if name == "store-steam": Image { width: size; height: size; source: @image-url("stores/steam.svg"); colorize: tint.with-alpha(1); }
    if name == "store-epic": Image { width: size; height: size; source: @image-url("stores/epic.svg"); colorize: tint.with-alpha(1); }
    if name == "store-gog": Image { width: size; height: size; source: @image-url("stores/gog.svg"); colorize: tint.with-alpha(1); }
    if name == "store-ubisoft": Image { width: size; height: size; source: @image-url("stores/ubisoft.svg"); colorize: tint.with-alpha(1); }
    if name == "store-ea": Image { width: size; height: size; source: @image-url("stores/ea.svg"); colorize: tint.with-alpha(1); }
    if name == "store-battlenet": Image { width: size; height: size; source: @image-url("stores/battlenet.svg"); colorize: tint.with-alpha(1); }
    if name == "store-amazon": Image { width: size; height: size; source: @image-url("stores/amazon.svg"); colorize: tint.with-alpha(1); }
    if name == "store-xbox": Image { width: size; height: size; source: @image-url("stores/xbox.svg"); colorize: tint.with-alpha(1); }
    if name == "store-manual": Image { width: size; height: size; source: @image-url("stores/manual.svg"); colorize: tint.with-alpha(1); }
    if !store && Icons.stroke(name) != "": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Icons.stroke(name);
        stroke: tint.with-alpha(1);
        stroke-width: 1.8 * size / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
    if !store && Icons.fill(name) != "": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Icons.fill(name);
        fill: tint.with-alpha(1);
    }
}

// O que fica atrás do vidro: a arte do jogo em foco e a cópia desfocada dela (feita uma vez pelo Tako), no mesmo
// retângulo da janela. Cada painel de vidro desenha o pedaço da cópia que fica atrás dele.
// Textos do desktop que componentes fundos usam (o Tako preenche no idioma da pessoa).
export global DeskText {
    in-out property <string> silence: "Silenciar";
    in-out property <string> max: "Volume máximo";
}

// Entrada do app: falso enquanto o primeiro quadro não sai (o Tako liga `desk-intro` só na abertura); ao virar
// verdadeiro, cada parte entra no seu passo (`Ui.intro-delay`). Fica verdadeiro no resto do tempo.
global DeskIntro {
    in-out property <bool> on: true;
}

global DeskArt {
    in-out property <image> blur;
    // Troca de jogo: a cópia do jogo anterior fica embaixo e a nova (`blur`) entra por cima junto com a arte, para o
    // vidro e as bordas não trocarem antes do fundo (TrocaDeJogo › luz ambiente, vidro, accent).
    in-out property <image> blur-old;
    in-out property <bool> blur-in: true;
    // Largura do select que abriu a lista (SeletorDeColecao: a lista tem a largura dele); 0 = pela lista.
    in-out property <length> anchor-w;
    // Luminância média da cópia numa grade de 16 × 9 (linhas de cima para baixo).
    in-out property <[float]> lum;
    in-out property <bool> has-art;
    // Largura / altura da arte (a cópia desfocada tem a mesma proporção).
    in-out property <float> aspect: 16 / 9;
    in-out property <length> win-w;
    in-out property <length> win-h;
    // A cor do jogo cuja arte está na tela (o Desktop troca junto com a arte; quem pinta com ela anima em `art-fade`).
    in-out property <color> accent: Ui.accent;
    in-out property <color> accent-deep: Ui.accent-deep;
    // Retângulo da arte na janela (FundoDoJogo, padrão 3840 × 1240): cobre a altura com o centro da arte a 62% da
    // largura, sem sobra nas bordas; numa janela mais larga que a arte, cobre a largura e ancora a 30% do topo.
    out property <bool> small: win-w < 1280px;
    property <bool> fit-w: win-h > 0 && win-w / win-h > aspect;
    out property <length> w: fit-w ? win-w : win-h * aspect;
    out property <length> h: fit-w ? win-w / aspect : win-h;
    out property <length> x: fit-w ? 0 : clamp(0.62 * win-w - 0.5 * w, win-w - w, 0);
    out property <length> y: fit-w ? -(h - win-h) * 0.3 : 0;
    // A cópia desfocada ocupa o mesmo retângulo.
    out property <length> bx: x;
    out property <length> bw: w;
    // Configurações: sem jogo em foco, as mesmas formas em superfícies opacas sobre o cinza.
    in-out property <bool> gray;

    // Luminância da cópia num ponto da janela (fora da arte: o fundo escuro).
    public pure function lum-at(px: length, py: length) -> float {
        if (!has-art || w <= 0 || h <= 0 || px < x || py < y || px >= x + w || py >= y + h) { return 0; }
        return lum[floor((py - y) / h * 9) * 16 + floor((px - x) / w * 16)];
    }
}

// Liquid Glass: a cópia desfocada da arte atrás do painel, a tinta grafite (densa sobre arte clara), a luz da cor do
// jogo a partir do canto superior esquerdo, o brilho de cima, o contorno e o reflexo na borda. Sem cópia pronta, a
// tinta sólida; com "Reduzir transparência", tudo opaco. Nas Configurações, `settings-surface` sem vidro.
component Vidro inherits Rectangle {
    in property <length> radius: Ui.radius-card;
    // Camada (diálogo, menu, painel lateral, aviso): tinta densa, contorno forte e sombra de camada.
    in property <bool> layer;
    in property <bool> edge: true;
    // Tinta densa sempre (perigo, Sessões), além da escolha automática sobre arte clara.
    in property <bool> dense;
    // Sem vidro próprio (BarraLateralUnida): quem está sobre o vidro em L não pinta fundo, desfoque nem brilho.
    in property <bool> bare;
    // Moldura em L (barra + coluna num vidro só): `cut-x` é a largura da coluna e `cut-y` a altura da barra; com
    // `cut-x` > 0 o vidro (do tamanho da janela) pinta só a barra e a coluna, na mesma camada, sem emenda.
    in property <length> cut-x;
    in property <length> cut-y;
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    // Tinta adaptativa: densa quando a arte embaixo do painel é clara (limite 0,18, o mesmo do AccentPalette).
    property <bool> bright: cut-x > 0 ? (DeskArt.lum-at(ax + cut-x / 2, ay + cut-y + (self.height - cut-y) / 4)
        + DeskArt.lum-at(ax + cut-x / 2, ay + cut-y + (self.height - cut-y) * 3 / 4)
        + DeskArt.lum-at(ax + self.width / 4, ay + cut-y / 2)
        + DeskArt.lum-at(ax + self.width / 2, ay + cut-y / 2)
        + DeskArt.lum-at(ax + self.width * 3 / 4, ay + cut-y / 2)) / 5 > 0.18
        : (DeskArt.lum-at(ax + self.width / 2, ay + self.height / 2)
        + DeskArt.lum-at(ax + self.width / 4, ay + self.height / 4)
        + DeskArt.lum-at(ax + self.width * 3 / 4, ay + self.height / 4)
        + DeskArt.lum-at(ax + self.width / 4, ay + self.height * 3 / 4)
        + DeskArt.lum-at(ax + self.width * 3 / 4, ay + self.height * 3 / 4)) / 5 > 0.18;
    property <bool> lens: !DeskArt.gray && !Ui.reduce-transparency;
    property <brush> base-fill: DeskArt.gray ? Ui.settings-surface : Ui.glass-solid;
    border-radius: radius;
    background: bare || cut-x > 0 ? transparent : base-fill;
    drop-shadow-offset-y: layer ? Ui.shadow-layer-y : Ui.shadow-float-y;
    drop-shadow-blur: bare || cut-x > 0 ? 0px : (layer ? Ui.shadow-layer-blur : Ui.shadow-float-blur);
    drop-shadow-color: bare || cut-x > 0 ? transparent : (layer ? Ui.shadow-layer-color : Ui.shadow-float-color);
    animate background { duration: Ui.color-time; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    // Em L, duas faixas (a barra e a coluna) mostram a mesma pilha de camadas, alinhada pela janela.
    for part in cut-x > 0 ? 2 : 1: Rectangle {
        x: 0;
        y: part == 0 ? 0 : cut-y;
        width: part == 0 || cut-x <= 0 ? root.width : cut-x;
        height: cut-x <= 0 ? root.height : (part == 0 ? cut-y : root.height - cut-y);
        border-radius: root.radius;
        clip: true;
        visible: !root.bare;
        background: cut-x > 0 ? root.base-fill : transparent;
      Rectangle {
        x: 0;
        y: -parent.y;
        width: root.width;
        height: root.height;
        if lens && !DeskArt.has-art: Rectangle {
            x: -ax;
            y: -ay;
            width: DeskArt.win-w;
            height: DeskArt.win-h;
            background: @linear-gradient(160deg, DeskArt.accent 0%, DeskArt.accent-deep 100%);
            animate background { duration: Ui.art-fade(true); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        }
        // Troca de jogo: a cópia anterior embaixo e a nova entrando por cima junto com a arte.
        if lens && DeskArt.has-art: Image {
            x: DeskArt.bx - ax;
            y: DeskArt.y - ay;
            width: DeskArt.bw;
            height: DeskArt.h;
            source: DeskArt.blur-old;
            image-fit: fill;
        }
        if lens && DeskArt.has-art: Image {
            x: DeskArt.bx - ax;
            y: DeskArt.y - ay;
            width: DeskArt.bw;
            height: DeskArt.h;
            source: DeskArt.blur;
            image-fit: fill;
            opacity: DeskArt.blur.width > 0 && DeskArt.blur-in ? 1 : 0;
            animate opacity { duration: Ui.art-fade(DeskArt.blur-in); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        }
        // O vidro desfoca o que está atrás dele: a arte já com a luz da cor do jogo e os escurecimentos da janela.
        if lens && DeskArt.has-art: Rectangle {
            x: -ax;
            y: -ay;
            width: DeskArt.win-w;
            height: DeskArt.win-h;
            Rectangle {
                background: DeskArt.accent.with-alpha(0.22);
                animate background { duration: Ui.art-fade(true); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
            }
            Rectangle {
                background: DeskArt.small
                    ? @linear-gradient(90deg, Ui.art-scrim-left.with-alpha(0.35) 0%, Ui.art-scrim-left.with-alpha(0.35) 30%,
                        Ui.art-scrim-left 36%, Ui.art-scrim-left 74%, Ui.art-scrim-left.with-alpha(0) 90%)
                    : @linear-gradient(90deg, Ui.art-scrim-left.with-alpha(0.35) 0%, Ui.art-scrim-left.with-alpha(0.35) 20%,
                        Ui.art-scrim-left 27%, Ui.art-scrim-left 50%, Ui.art-scrim-left.with-alpha(0) 66%);
            }
            Rectangle { background: @linear-gradient(0deg, Ui.art-scrim-bottom 0%, Ui.art-scrim-bottom.with-alpha(0) 40%); }
        }
        if !DeskArt.gray: Rectangle {
            background: layer || dense || bright ? Ui.glass-panel-dense : Ui.glass-panel;
            animate background { duration: Ui.color-time; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        }
        // Luz ambiente: 16% da cor do jogo a partir do canto superior esquerdo, em tamanho fixo.
        if lens: Rectangle {
            x: -Ui.glass-light-width;
            y: -Ui.glass-light-height;
            width: Ui.glass-light-width * 2;
            height: Ui.glass-light-height * 2;
            background: @radial-gradient(circle, DeskArt.accent.with-alpha(0.16) 0%, DeskArt.accent.with-alpha(0) 75%);
            animate background { duration: Ui.art-fade(true); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        }
        // Volume da lente: brilho de cima, 150 px fixos para barra, painel e cartão parecerem o mesmo material.
        if !DeskArt.gray: Rectangle {
            y: 0;
            height: Ui.glass-highlight-height;
            background: @linear-gradient(180deg, Ui.glass-highlight 0%, Ui.glass-highlight.with-alpha(0) 100%);
        }
    }
    }
    // Contorno de 1px por dentro e o reflexo especular (forte no canto superior esquerdo, fraco no inferior direito).
    if edge: Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: DeskArt.gray ? Ui.settings-separator : (layer ? Ui.glass-edge-strong : Ui.glass-edge);
    }
    if edge && !DeskArt.gray: Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: @linear-gradient(170deg, Ui.glass-specular 0%, Ui.glass-specular.with-alpha(0.1) 18%,
            Ui.glass-specular.with-alpha(0) 40%, Ui.glass-specular.with-alpha(0) 80%, Ui.glass-specular.with-alpha(0.05) 100%);
    }
    @children
}

// Foco do teclado ou do controle, como na Apple TV: o item clareia (`focus-fill`), ganha um contorno fino
// (`focus-ring`) e um brilho em volta (`focus-glow`). Nunca muda a geometria; o mouse não mostra.
component FocusRing inherits Rectangle {
    in property <length> radius: Ui.radius-row;
    border-radius: radius;
    background: Ui.focus-fill;
    border-width: 1px;
    border-color: Ui.focus-ring;
    Rectangle {
        x: -Ui.focus-ring-width;
        y: -Ui.focus-ring-width;
        width: parent.width + 2 * Ui.focus-ring-width;
        height: parent.height + 2 * Ui.focus-ring-width;
        border-radius: root.radius + Ui.focus-ring-width;
        border-width: Ui.focus-ring-width;
        border-color: Ui.focus-glow;
    }
}

// Dica do mouse (MenusEDicas): aparece 500 ms depois de parar em cima e entra em 120 ms; some ao sair. Botões só
// de ícone e nomes cortados mostram o texto inteiro aqui.
component Tip inherits Rectangle {
    in property <string> text;
    in property <bool> hovering;
    property <bool> show;
    changed hovering => {
        show = false;
        tip-timer.running = hovering && text != "";
    }
    tip-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            show = root.hovering;
        }
    }
    // Abaixo do dono, centralizada; não captura o mouse.
    if show: Rectangle {
        property <bool> lit;
        // Entrada: ligar no `init` não anima (o Slint aplica antes do primeiro quadro); o Timer liga logo depois.
        Timer {
            interval: 1ms;
            running: true;
            triggered => {
                self.running = false;
                lit = true;
            }
        }
        opacity: lit ? 1 : 0;
        animate opacity { duration: Ui.tempo-texto-sai; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        x: (root.width - self.width) / 2;
        y: root.height + 6px;
        width: tl.preferred-width + 20px;
        height: 28px;
        border-radius: Ui.radius-thumb;
        background: Ui.glass-solid;
        border-width: 1px;
        border-color: Ui.glass-edge-strong;
        drop-shadow-offset-y: Ui.shadow-float-y;
        drop-shadow-blur: Ui.shadow-float-blur;
        drop-shadow-color: Ui.shadow-float-color;
        tl := Text { text: root.text; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 500; }
    }
}

// Botão do desktop: primário (sólido), perigo (texto vermelho) ou comum (translúcido). Só ícone quando sem rótulo.
component DeskButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> on;
    in property <bool> focused;
    in property <bool> enabled: true;
    in property <length> min-w: 0;
    // Botão quadrado (só ícone ou um símbolo).
    in property <bool> square: label == "";
    callback clicked();
    property <color> fg: primary ? Ui.on-surface-solid : (danger ? Ui.error : (on ? Ui.warning : Ui.on-accent));
    height: 56 * Ui.u;
    width: max(min-w, square ? self.height : lay.preferred-width);
    border-radius: Ui.radius-md;
    background: primary
        ? (ta.pressed ? Ui.surface-solid.darker(0.15) : (ta.has-hover ? Ui.surface-solid.darker(0.06) : Ui.surface-solid))
        : (ta.pressed ? Ui.surface-2 : (ta.has-hover ? Ui.surface-1 : Ui.surface-1.with-alpha(0.07)));
    opacity: enabled ? 1 : 0.5;
    animate background { duration: Ui.focus-time; }
    if focused: FocusRing { }
    lay := HorizontalLayout {
        padding-left: square ? 0 : 24 * Ui.u;
        padding-right: square ? 0 : 24 * Ui.u;
        spacing: 10 * Ui.u;
        alignment: center;
        if icon != "": DeskIcon { name: icon; tint: fg; size: 24 * Ui.u; y: (parent.height - self.height) / 2; }
        if label != "": Text {
            text: label;
            color: fg;
            font-size: Ui.label-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Campo de busca do conteúdo (CampoDeBusca): o texto vai inteiro para o Tako a cada mudança. Esc limpa (ou sai do
// campo); ↓ e Enter voltam à lista. O atalho aparece num keycap (Ctrl + K; "Esc" com o campo em foco).
component SearchBox inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <string> key-label;
    in property <string> esc-label;
    in property <bool> focused;
    callback edited(string);
    callback leave();
    in property <int> focus-request;
    changed focus-request => { if (self.visible && focus-request > 0) { ti.focus(); } }
    public function focus-input() { ti.focus(); }
    height: Ui.control-height;
    border-radius: Ui.radius-control;
    background: ti.has-focus || sta.has-hover ? Ui.glass-hover : Ui.glass-control;
    border-width: 1px;
    border-color: ti.has-focus ? Ui.glass-edge-strong : Ui.glass-edge;
    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    // O Tako pode mudar o texto (Limpar): o campo segue quando não está sendo editado.
    changed text => { if (ti.text != text) { ti.text = text; } }
    if focused && !ti.has-focus: FocusRing { radius: Ui.radius-control; }
    sta := TouchArea { mouse-cursor: MouseCursor.text; clicked => { ti.focus(); } }
    HorizontalLayout {
        padding-left: Ui.space-16;
        padding-right: Ui.space-8;
        spacing: Ui.space-12;
        DeskIcon { name: "search"; size: 20px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
        Rectangle {
            horizontal-stretch: 1;
            if ti.text == "": Text {
                width: parent.width;
                text: hint;
                color: Ui.desk-on-subtle;
                font-size: Ui.desk-label;
                vertical-alignment: center;
                overflow: elide;
            }
            FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        if (ti.text != "") {
                            ti.text = "";
                            root.edited("");
                        } else {
                            root.leave();
                        }
                        return accept;
                    }
                    if (e.text == Key.DownArrow) {
                        root.leave();
                        return accept;
                    }
                    reject
                }
                ti := TextInput {
                    width: parent.width;
                    height: parent.height;
                    text: root.text;
                    color: Ui.on-accent;
                    font-size: Ui.desk-label;
                    vertical-alignment: center;
                    single-line: true;
                    selection-background-color: Ui.glass-pressed;
                    selection-foreground-color: Ui.on-accent;
                    edited => { root.edited(self.text); }
                    accepted => { root.leave(); }
                }
            }
        }
        if key-label != "": Rectangle {
            y: (parent.height - self.height) / 2;
            height: 26px;
            width: kt.preferred-width + 2 * Ui.space-8;
            border-radius: 7px;
            background: Ui.keycap-bg;
            border-width: 1px;
            border-color: Ui.glass-edge;
            kt := Text {
                text: ti.has-focus ? esc-label : key-label;
                color: Ui.desk-on-subtle;
                font-size: Ui.desk-keycap;
                font-weight: 600;
            }
        }
    }
}

// Controles da janela integrados à barra superior, 46 × 64.
component WindowButton inherits Rectangle {
    in property <string> kind;
    in property <string> label;
    in property <bool> active: true;
    in property <bool> native-hover;
    in property <bool> native-pressed;
    callback clicked();
    width: Ui.window-control-width;
    height: Ui.topbar-height;
    background: ta.pressed || native-pressed ? (kind == "close" ? Ui.window-close-hover.with-alpha(0.9) : Ui.glass-pressed)
        : (ta.has-hover || native-hover) ? (kind == "close" ? Ui.window-close-hover : Ui.glass-hover) : transparent;
    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    accessible-role: button;
    accessible-label: label;
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: kind == "min" ? "M 0 5 H 10"
            : kind == "max" ? "M 0.5 0.5 H 9.5 V 9.5 H 0.5 Z"
            : kind == "restore" ? "M 2.5 0.5 H 9.5 V 7.5 M 0.5 2.5 H 7.5 V 9.5 H 0.5 Z"
            : "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: (ta.has-hover || native-hover) ? Ui.on-accent : (active ? Ui.desk-on-muted : Ui.on-accent-subtle);
        stroke-width: 1px;
        fill: transparent;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// BarraSuperior é também a barra da janela: marca, guias, perfil, Tela cheia e controles nativos.
component TopBar inherits Vidro {
    in property <[DeskNav]> items;
    in property <string> big-picture-label;
    in property <string> brand-label;
    in property <bool> brand-open;
    in property <string> profile-name;
    in property <string> profile-initial;
    in property <bool> maximized;
    in property <int> native-hover;
    in property <int> native-pressed;
    in property <bool> active: true;
    in property <[string]> labels;
    in property <string> update-label;
    out property <length> profile-x: profile.absolute-position.x;
    out property <length> drag-start: drag.absolute-position.x;
    out property <length> drag-end: drag.absolute-position.x + drag.width;
    callback action(string);
    in property <bool> small;
    // Foco do teclado na barra: -1 fora dela; 0 marca, 1… guias, depois perfil e Tela cheia.
    in property <int> focus-index: -1;
    callback clicked(string, int);
    // Onde abrir o menu da marca: 8 abaixo da barra, alinhado à marca.
    callback brand-menu(length, length);
    height: Ui.topbar-height;
    radius: 0px;
    edge: false;
    drop-shadow-blur: 0px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: transparent;
    // Barra lateral unida (`bare`): sem a linha de baixo, a barra e a coluna são um vidro só.
    Rectangle { visible: !root.bare; y: parent.height - 1px; height: 1px; background: Ui.glass-edge; }

    HorizontalLayout {
        padding-left: (small ? Ui.space-20 : Ui.space-36) - Ui.space-8;
        padding-right: 0px;
        spacing: small ? Ui.space-8 : Ui.space-12;
        brand := Rectangle {
            y: (parent.height - self.height) / 2;
            height: 48px;
            width: bl.preferred-width;
            border-radius: self.height / 2;
            background: bta.has-hover || brand-open ? Ui.glass-hover : transparent;
            animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
            accessible-role: button;
            accessible-label: brand-label;
            if focus-index == 0: FocusRing { radius: parent.height / 2; }
            bl := HorizontalLayout {
                padding-left: Ui.space-8;
                padding-right: 10px;
                spacing: 4px;
                Image {
                    // Logo horizontal em 2× (237 × 92) do design: exibida em 46px de altura (38 na janela pequena) sem serrilhado.
                    source: @image-url("tako-logo-brand.png");
                    height: small ? 38px : 46px;
                    width: self.height * 237 / 92;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                    // Hover: leve aumento e brilho; com "Reduzir animações" a escala fica em 1.
                    opacity: bta.has-hover ? 1 : 0.9;
                    transform-scale: bta.has-hover && !Ui.reduce-motion ? 1.04 : 1;
                    animate transform-scale, opacity { duration: Ui.tempo-hover; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                }
                DeskIcon { name: "chevron-down"; size: 12px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
            }
            bta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.brand-menu(brand.absolute-position.x + Ui.space-8, root.absolute-position.y + root.height + Ui.space-8);
                    root.clicked("desk-brand", 0);
                }
            }
        }
        Rectangle { width: small ? 0 : Ui.space-16; }
        HorizontalLayout {
            spacing: small ? 18px : Ui.space-28;
            for it[i] in items: Rectangle {
                width: gt.preferred-width;
                accessible-role: tab;
                accessible-label: it.label;
                if focus-index == 1 + i: FocusRing { radius: Ui.radius-thumb; }
                gt := Text {
                    text: it.label.to-uppercase();
                    color: it.selected || gta.has-hover || focus-index == 1 + i ? Ui.on-accent : Ui.desk-on-muted;
                    font-size: Ui.desk-label;
                    font-weight: 700;
                    letter-spacing: 0.04 * self.font-size;
                    vertical-alignment: center;
                    animate color { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                }
                if it.selected: Rectangle {
                    y: parent.height - 12px - self.height;
                    height: 2px;
                    border-radius: 1px;
                    background: Ui.on-accent;
                }
                gta := TouchArea {
                    mouse-cursor: pointer;
                    // Perfil é o 3 da barra (0 Biblioteca, 1 Configurações, 2 Tela cheia).
                    clicked => { root.clicked("desk-nav", it.id == "profile" ? 3 : 0); }
                }
            }
        }
        drag := Rectangle {
            horizontal-stretch: 1;
            TouchArea {
                pointer-event(ev) => {
                    if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down { root.action("drag"); }
                    if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up {
                        root.action("menu:" + (self.absolute-position.x + self.mouse-x) / 1px + "," + self.mouse-y / 1px);
                    }
                }
                double-clicked => { root.action("max"); }
            }
        }
        if update-label != "": Rectangle {
            width: ul.preferred-width + 26px + 8px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: parent.width - 8px;
                height: 24px;
                border-radius: self.height / 2;
                background: uta.has-hover ? Ui.glass-hover : Ui.glass-control;
                border-width: 1px;
                border-color: Ui.glass-edge;
                animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                accessible-role: button;
                accessible-label: update-label;
                Rectangle { x: 10px; y: (parent.height - self.height) / 2; width: 6px; height: 6px; border-radius: 3px; background: Ui.success; }
                ul := Text { x: 22px; text: update-label; color: Ui.on-accent; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                uta := TouchArea { mouse-cursor: pointer; clicked => { root.action("update"); } }
            }
        }
        profile := Rectangle {
            y: (parent.height - self.height) / 2;
            height: 40px;
            width: pl.preferred-width;
            border-radius: Ui.radius-control;
            background: pta.pressed ? Ui.glass-pressed : pta.has-hover ? Ui.glass-hover : Ui.glass-control;
            accessible-role: button;
            accessible-label: profile-name;
            if focus-index == 1 + items.length: FocusRing { radius: Ui.radius-control; }
            pl := HorizontalLayout {
                padding-left: 6px; padding-right: 10px; spacing: 8px;
                Rectangle {
                    width: 28px; height: 28px; y: (parent.height - self.height) / 2;
                    border-radius: 14px; background: Ui.glass-hover;
                    Text { text: profile-initial; color: Ui.on-accent; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
                if !small: Text { text: profile-name; max-width: 160px; overflow: elide; font-size: 14px; font-weight: 600; color: Ui.on-accent; vertical-alignment: center; }
                DeskIcon { name: "chevron-down"; size: 12px; y: (parent.height - self.height) / 2; }
            }
            pta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.brand-menu(profile.absolute-position.x, root.height + Ui.space-8);
                    root.clicked("desk-profile-menu", 0);
                }
            }
        }
        // Tela cheia: botão de 40 com gamepad de 22, inclusive na janela grande.
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 40px;
            width: 40px;
            border-radius: Ui.radius-control;
            background: fta.pressed ? Ui.glass-pressed : (fta.has-hover ? Ui.glass-hover : Ui.glass-control);
            border-width: 1px;
            border-color: Ui.glass-edge;
            animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
            accessible-role: button;
            accessible-label: big-picture-label;
            if focus-index == 2 + items.length: FocusRing { radius: Ui.radius-control; }
            DeskIcon { name: "gamepad"; size: 22px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            fta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clicked("desk-nav", 2); }
            }
            Tip { text: big-picture-label + " (F11)"; hovering: fta.has-hover; }
        }
        HorizontalLayout {
            spacing: 0px;
            WindowButton { native-hover: root.native-hover == 3; native-pressed: root.native-pressed == 3; kind: "min"; active: root.active; label: labels[0]; clicked => { root.action("min"); } }
            WindowButton { native-hover: root.native-hover == 1; native-pressed: root.native-pressed == 1; kind: maximized ? "restore" : "max"; active: root.active; label: maximized ? labels[2] : labels[1]; clicked => { root.action("max"); } }
            WindowButton { native-hover: root.native-hover == 2; native-pressed: root.native-pressed == 2; kind: "close"; active: root.active; label: labels[3]; clicked => { root.action("close"); } }
        }
    }
}

// Segunda camada de vidro: o item escolhido (jogo, aba, categoria, opção) dentro de um painel. Reflexo em cima,
// contorno claro e, nas linhas da lista, uma sombra curta.
component Selected inherits Rectangle {
    in property <length> radius: Ui.radius-row;
    in property <bool> lifted;
    // A seleção não "voa" entre linhas: a nova acende em `tempo-foco`.
    property <bool> lit;
    // Entrada: ligar no `init` não anima (o Slint aplica antes do primeiro quadro); o Timer liga logo depois.
    Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            lit = true;
        }
    }
    opacity: lit ? 1 : 0;
    animate opacity { duration: Ui.focus-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    border-radius: radius;
    background: Ui.glass-selected;
    drop-shadow-offset-y: lifted ? 6px : 0;
    drop-shadow-blur: lifted ? 16px : 0;
    drop-shadow-color: lifted ? Ui.shadow-float-color : transparent;
    Rectangle {
        border-radius: root.radius;
        background: @linear-gradient(180deg, Ui.glass-item-highlight 0%, Ui.glass-item-highlight.with-alpha(0.04) 60%, Ui.glass-item-highlight.with-alpha(0) 100%);
    }
    Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: Ui.glass-item-edge;
    }
    // Brilho de 1px no topo.
    Rectangle {
        x: root.radius / 2;
        y: 1px;
        width: parent.width - root.radius;
        height: 1px;
        background: Ui.on-accent.with-alpha(0.2);
    }
}

// Abas da biblioteca (Todos · Favoritos · Coleções) como seletor segmentado: um trilho com as opções de largura
// igual; a escolhida na segunda camada de vidro. Nas Grade e Categorias, o mesmo trilho fica num bloco solto.
component Tabs inherits Rectangle {
    in property <[string]> tabs;
    in property <int> current;
    in property <int> focus-index: -1;
    callback clicked(int);
    // Sem trilho (como nas prévias): só a escolhida tem contorno, o da segunda camada de vidro.
    height: 40px;
    // A pílula da escolhida desliza para a nova aba em `tempo-foco` (TrocaDeTela › abas internas).
    property <length> tab-w: (root.width - 6px - 2px * (tabs.length - 1)) / max(1, tabs.length);
    if current >= 0 && current < tabs.length: Selected {
        x: 3px + current * (tab-w + 2px);
        y: 3px;
        width: tab-w;
        height: root.height - 6px;
        radius: 11px;
        animate x { duration: Ui.focus-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    // Abas de largura igual, na mesma conta da pílula (num layout, o texto mais longo ganhava mais largura).
    for t[i] in tabs: Rectangle {
        x: 3px + i * (tab-w + 2px);
        y: 3px;
        width: tab-w;
        height: root.height - 6px;
        border-radius: 11px;
        background: i != current && tta.has-hover ? Ui.glass-hover : transparent;
        animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        accessible-role: tab;
        accessible-label: t;
        if i == focus-index: FocusRing { radius: 11px; }
        Text {
            text: t;
            color: i == current ? Ui.on-accent : Ui.desk-on-muted;
            font-size: 14px * Ui.text-scale;
            font-weight: i == current ? 600 : 500;
            overflow: elide;
        }
        tta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(i); }
        }
    }
}

// Ícone discreto da linha de contagem (ordenar, filtrar, modo de exibição): alvo de 30, sem botão; hover clareia.
component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> badge;
    in property <bool> on;
    in property <bool> focused;
    callback clicked();
    height: 30px;
    width: badge != "" ? il.preferred-width : self.height;
    border-radius: Ui.radius-thumb;
    background: ita.has-hover ? Ui.glass-hover : transparent;
    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    accessible-role: button;
    accessible-label: label;
    if focused: FocusRing { radius: Ui.radius-thumb; }
    il := HorizontalLayout {
        padding-left: badge != "" ? 7px : 0;
        padding-right: badge != "" ? 8px : 0;
        spacing: 5px;
        alignment: center;
        DeskIcon { name: icon; size: 17px; tint: on || ita.has-hover ? Ui.on-accent : Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
        if badge != "": Text { text: badge; color: Ui.on-accent; font-size: Ui.desk-overline; font-weight: 700; vertical-alignment: center; }
    }
    ita := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tip { text: label; hovering: ita.has-hover; }
}

// Anel de progresso da instalação (NaoInstalados): trilha fraca e o arco da fração; a loja que não informa a
// fração (negativa) mostra um arco girando, parado com "reduzir animações".
component ProgressRing inherits Rectangle {
    in property <length> size: 36px;
    in property <length> thickness: 3.5px;
    in property <float> fraction: -1;
    in property <color> tint: Ui.on-accent;
    in property <color> track: #ffffff26;
    width: size;
    height: size;
    property <float> box: size / 1px;
    property <float> r: box / 2 - thickness / 2px;
    property <angle> sweep: (fraction < 0 ? 0.25 : min(max(fraction, 0.01), 0.999)) * 360deg;
    Rectangle {
        border-radius: parent.width / 2;
        border-width: root.thickness;
        border-color: root.track;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.box;
        viewbox-height: root.box;
        commands: "M " + root.box / 2 + " " + (root.box / 2 - root.r) + " A " + root.r + " " + root.r + " 0 " + (root.sweep > 180deg ? "1" : "0") + " 1 " + (root.box / 2 + root.r * Math.sin(root.sweep)) + " " + (root.box / 2 - root.r * Math.cos(root.sweep));
        stroke: root.tint;
        stroke-width: root.thickness;
        fill: transparent;
        transform-rotation: fraction < 0 && !Ui.reduce-motion ? animation-tick() / 900ms * 360deg : 0deg;
    }
}

// Cabeçalho de uma loja na seção NÃO INSTALADOS (lista e grade): ícone, nome, quantos jogos e ⌄ (aberto) ou › (fechado).
component StoreGroup inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> count;
    in property <string> label;
    in property <bool> open;
    in property <bool> focused;
    callback clicked();
    height: 36px;
    border-radius: Ui.radius-control - 4px;
    background: ta.has-hover ? Ui.glass-hover : transparent;
    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    accessible-role: button;
    accessible-label: label;
    accessible-expandable: true;
    accessible-expanded: open;
    accessible-action-default => { root.clicked(); }
    if focused: FocusRing { radius: root.border-radius; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        DeskIcon { name: icon; size: 16px; tint: Ui.on-accent-muted; y: (parent.height - self.height) / 2; }
        Text { text: title; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 600; vertical-alignment: center; }
        Text { text: count; color: Ui.on-accent-subtle; font-size: 13px * Ui.text-scale; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        DeskIcon { name: open ? "chevron-down" : "chevron"; size: 16px; tint: Ui.on-accent-muted; y: (parent.height - self.height) / 2; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Divisória NÃO INSTALADOS: linha de 1 em `divider` e, embaixo, o overline com o total.
component NotInstalledTitle inherits Rectangle {
    in property <string> title;
    in property <string> count;
    // A lista recua 8 como as linhas; na grade a divisória alinha com as capas.
    in property <length> inset: 8px;
    accessible-role: text;
    accessible-label: title + " " + count;
    Rectangle { x: inset; y: 14px; width: parent.width - 2 * inset; height: 1px; background: Ui.divider; }
    HorizontalLayout {
        x: inset;
        y: 14px + 1px + 12px;
        height: 16px * Ui.text-scale;
        spacing: 8px;
        alignment: start;
        Text { text: title; color: Ui.on-accent-subtle; font-size: Ui.desk-overline; font-weight: 700; letter-spacing: 0.08 * self.font-size; vertical-alignment: center; }
        Text { text: count; color: Ui.on-accent-subtle; font-size: Ui.desk-overline; font-weight: 600; vertical-alignment: center; }
    }
}

// Linha da lista (ListaDeJogos): miniatura quadrada, nome, loja de origem e, na escolhida, o ▶ redondo. Na seleção
// múltipla, a caixa redonda à esquerda; Ctrl e Shift no clique marcam.
component GameRow inherits Rectangle {
    in property <DeskGame> data;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> selecting;
    in property <length> thumb: Ui.thumb-size;
    callback clicked();
    callback toggle();
    callback range();
    callback play();
    callback install();
    callback menu(length, length);
    property <bool> picked: selecting ? data.checked : selected;
    // Em cima do ⬇ o mouse sai da linha para o botão: ele conta como a linha, senão o ⬇ some sob o cursor.
    property <bool> hot: ta.has-hover || ita.has-hover;
    border-radius: Ui.radius-row;
    background: !picked && hot ? Ui.glass-hover : transparent;
    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    accessible-role: list-item;
    accessible-label: data.label;
    if picked: Selected { lifted: true; }
    if focused: FocusRing { }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                if (ev.modifiers.control || ev.modifiers.meta) {
                    root.toggle();
                } else if (ev.modifiers.shift) {
                    root.range();
                } else {
                    root.clicked();
                }
            }
        }
        double-clicked => { root.play(); }
    }
    HorizontalLayout {
        padding-left: Ui.space-8;
        padding-right: 6px;
        spacing: 14px;
        if selecting: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: data.checked ? Ui.primary-top : Ui.glass-control;
            border-width: data.checked ? 0 : 1px;
            border-color: Ui.glass-edge-strong;
            if data.checked: DeskIcon { name: "tick"; size: 16px; tint: Ui.on-primary; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle(); }
            }
        }
        Rectangle {
            y: (parent.height - self.height) / 2;
            // 40 na linha comum, 32 na linha compacta da janela pequena.
            width: root.thumb;
            height: self.width;
            border-radius: Ui.radius-thumb;
            clip: true;
            opacity: data.installed ? 1 : 0.5;
            // Sem capa: tons fechados da cor do jogo, nunca a cor pura.
            background: @linear-gradient(160deg, data.accent.mix(Ui.desk-canvas, 0.55) 0%, data.accent.mix(Ui.desk-canvas, 0.25) 100%);
            // O quadrado do topo da capa (CapaDoJogo), não o meio.
            Image { width: parent.width; height: parent.height; source: data.thumb; image-fit: cover; vertical-alignment: top; }
        }
        nt := Text {
            text: data.title;
            color: data.installed ? Ui.on-accent : Ui.on-accent-muted;
            font-size: Ui.desk-label;
            font-weight: picked ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if data.running: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Ui.success;
        }
        // Vaga fixa do ▶: a linha escolhida não empurra nada (FIX-004). A loja fica no destaque.
        Rectangle {
            width: 36px;
            // NaoInstalados: o ⬇ no lugar do ▶ (no mouse em cima e na linha escolhida) e, baixando, o anel.
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                visible: data.install-label != "" && !data.installing && !selecting;
                opacity: hot || selected ? 1 : 0;
                animate opacity { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                background: ita.has-hover ? Ui.glass-edge-strong : Ui.glass-pressed;
                border-width: 1px;
                border-color: Ui.glass-edge-strong;
                animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                accessible-role: button;
                accessible-label: data.install-label;
                accessible-action-default => { root.install(); }
                DeskIcon { name: "download"; size: 18px; tint: Ui.on-accent; }
                ita := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.install(); }
                }
            }
            if data.installing && !selecting: ProgressRing {
                y: (parent.height - self.height) / 2;
                size: 36px;
                fraction: data.progress;
                accessible-role: progress-indicator;
                accessible-label: data.install-label;
                accessible-value: data.percent;
                accessible-value-minimum: 0;
                accessible-value-maximum: 100;
            }
            if selected && !selecting && data.install-label == "": Rectangle {
            y: (parent.height - self.height) / 2;
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: pta.has-hover ? Ui.glass-edge-strong : Ui.glass-pressed;
            border-width: 1px;
            border-color: Ui.glass-edge-strong;
            animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
            accessible-role: button;
            DeskIcon { name: "play"; size: 18px; tint: Ui.on-accent; }
            pta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.play(); }
            }
            }
        }
    }
    // Nome cortado com reticências (largura medida, não um número de letras): o inteiro fica na dica.
    Tip { text: nt.preferred-width > nt.width ? data.title : ""; hovering: ta.has-hover; }
}

// Lista virtualizada: só as linhas visíveis existem; rola com a roda do mouse e segue a seleção do teclado. As linhas
// crescem com o "Tamanho do texto".
component GameList inherits Rectangle {
    in property <[DeskGame]> games;
    in property <int> selected;
    in property <bool> key-focus;
    in property <bool> selecting;
    callback clicked(string, int);
    callback menu(length, length);
    callback scrolled(int);
    // Janela pequena (JanelaPequena): linhas compactas de 42 com miniatura de 32.
    in property <bool> compact;
    property <length> row-h: (compact ? 42px : Ui.game-row-height) + (Ui.text-scale - 1) * 32px + 6px;
    property <int> first: max(0, floor(-fl.viewport-y / row-h));
    // Vagas fixas: a linha `r` fica sempre na vaga `mod(r, slots)`. Rolar uma linha troca só a vaga que saiu de cima
    // (ela entra embaixo); as outras guardam dados, textos, miniatura e a seleção, sem refazer nada por quadro.
    property <int> slots: min(ceil(fl.height / row-h) + 2, games.length);
    changed first => { root.scrolled(first); }
    changed selected => {
        if (selected >= 0) {
            if (selected * row-h + fl.viewport-y < 0) {
                fl.viewport-y = -selected * row-h;
            } else if ((selected + 1) * row-h + fl.viewport-y > fl.height) {
                fl.viewport-y = -((selected + 1) * row-h - fl.height);
            }
        }
    }
    // Sem `clip` aqui: o Flickable já recorta as linhas e a barra de rolagem fica fora, na borda do painel.
    fl := Flickable {
        viewport-height: games.length * row-h;
        // A vaga serve a jogo, divisória e cabeçalho de loja: todos com a mesma altura, então a conta de posição, as
        // vagas fixas e a rolagem seguem iguais.
        for k in slots: Rectangle {
            // `want` muda em todas as vagas a cada linha rolada; `r` só na que trocou de linha (o `changed` corta a
            // propagação), então só ela refaz `data` e o que depende dele.
            property <int> want: first + mod(k - first, slots);
            property <int> r;
            init => { r = want; }
            changed want => { r = want; }
            visible: r < games.length;
            x: 0;
            y: r * row-h;
            width: fl.width;
            height: row-h - 6px;
            if r < games.length && games[r].kind == "": GameRow {
                width: parent.width;
                height: parent.height;
                thumb: compact ? 32px : Ui.thumb-size;
                data: games[parent.r];
                selected: parent.r == root.selected;
                focused: key-focus && parent.r == root.selected;
                selecting: root.selecting;
                clicked => { root.clicked("game", games[parent.r].index); }
                toggle => { root.clicked("game-toggle", games[parent.r].index); }
                range => { root.clicked("game-range", games[parent.r].index); }
                play => { root.clicked("game-play", games[parent.r].index); }
                install => { root.clicked("game-play", games[parent.r].index); }
                menu(x, y) => {
                    root.menu(x, y);
                    root.clicked("game-menu", games[parent.r].index);
                }
            }
            if r < games.length && games[r].kind == "section": NotInstalledTitle {
                width: parent.width;
                height: parent.height;
                title: games[parent.r].title;
                count: games[parent.r].count;
            }
            if r < games.length && games[r].kind == "group": StoreGroup {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                icon: games[parent.r].store-icon;
                title: games[parent.r].title;
                count: games[parent.r].count;
                label: games[parent.r].label;
                open: games[parent.r].open;
                focused: key-focus && parent.r == root.selected;
                clicked => { root.clicked("group", games[parent.r].index); }
            }
        }
    }
    // Quanto a barra de rolagem sai para a direita: encostada na borda do painel, não no fim das linhas.
    in property <length> bar-out;
    // Barra de rolagem fina (só quando a lista passa da altura).
    if games.length * row-h > fl.height: Rectangle {
        x: parent.width + bar-out - 5px;
        width: 3px;
        border-radius: 1.5px;
        y: -fl.viewport-y / (games.length * row-h) * fl.height;
        height: max(24px, fl.height * fl.height / (games.length * row-h));
        background: Ui.glass-pressed;
    }
}

// SeletorDeColecao: na aba Coleções, um select da largura do painel (40, raio `radius-control`, alinhado às abas)
// com a coleção escolhida e quantos jogos ela tem; o Tako abre a lista embaixo dele.
component CollectionSelect inherits Rectangle {
    in property <DeskNav> current;
    in property <bool> focused;
    callback clicked();
    callback menu(length, length);
    height: 40px;
    border-radius: Ui.radius-control;
    background: ta.has-hover ? Ui.glass-hover : Ui.glass-control;
    border-width: 1px;
    border-color: Ui.glass-edge;
    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    accessible-role: combobox;
    accessible-label: current.label;
    if focused: FocusRing { radius: Ui.radius-control; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        DeskIcon { name: "layers"; size: 18px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
        Text { text: current.label; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: current.count; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; vertical-alignment: center; }
        DeskIcon { name: "updown"; size: 14px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // A lista do SeletorDeColecao tem a largura do select.
            DeskArt.anchor-w = root.width;
            root.menu(root.absolute-position.x + root.width, root.absolute-position.y + root.height + 6px);
            root.clicked();
        }
    }
}

// ListaVazia: nunca um painel em branco; o polvo (BRAND-001, o da abertura), o porquê e a saída.
component EmptyList inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    in property <string> action;
    callback clicked();
    alignment: center;
    spacing: 10px;
    padding-left: Ui.space-20;
    padding-right: Ui.space-20;
    padding-bottom: Ui.space-36;
    HorizontalLayout {
        alignment: center;
        Octopus { width: 94px; with-name: false; self-assemble: true; accessible-role: none; }
    }
    Text { text: title; color: Ui.on-accent; font-family: Ui.font-heading; font-size: Ui.desk-label-lg; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
    if text != "": Text { text: text; color: Ui.desk-on-muted; font-size: 14px * Ui.text-scale; horizontal-alignment: center; wrap: word-wrap; }
    if action != "": HorizontalLayout {
        alignment: center;
        padding-top: 6px;
        Rectangle {
            height: Ui.control-height;
            width: al.preferred-width;
            border-radius: self.height / 2;
            background: ata.pressed ? Ui.glass-pressed : (ata.has-hover ? Ui.glass-hover : Ui.glass-control);
            border-width: 1px;
            border-color: Ui.glass-edge;
            accessible-role: button;
            accessible-label: action;
            al := HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                Text { text: action; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 500; vertical-alignment: center; }
            }
            ata := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clicked(); }
            }
        }
    }
}

// Blocos de espera (EstadoCarregando) no tamanho do que vai chegar; pulsam devagar, parados com "Reduzir animações".
component Skeleton inherits Rectangle {
    in property <length> radius: Ui.radius-thumb;
    border-radius: radius;
    background: Ui.glass-control;
    opacity: Ui.reduce-motion ? 0.8 : 0.55 + 0.45 * abs(sin(animation-tick() / Ui.tempo-pulso * 180deg));
}

// Barra de ações da seleção múltipla: pílula de vidro de camada no pé do painel da lista.
component BulkBar inherits Vidro {
    in property <[PanelRow]> actions;
    callback clicked(int);
    layer: true;
    radius: 26px;
    height: 52px;
    HorizontalLayout {
        padding-left: Ui.space-8;
        padding-right: Ui.space-8;
        spacing: 2px;
        alignment: space-between;
        for a[i] in actions: HorizontalLayout {
            if i == actions.length - 1: Rectangle { width: 1px; height: 22px; y: 15px; background: Ui.divider; }
            Rectangle {
                y: (52px - self.height) / 2;
                height: 36px;
                width: i < 2 ? bl.preferred-width : self.height;
                border-radius: self.height / 2;
                background: bta.has-hover ? Ui.glass-hover : transparent;
                animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                accessible-role: button;
                accessible-label: a.title;
                bl := HorizontalLayout {
                    padding-left: i < 2 ? 10px : 0;
                    padding-right: i < 2 ? 10px : 0;
                    spacing: 8px;
                    alignment: center;
                    DeskIcon { name: a.icon; size: 18px; tint: Ui.on-accent; y: (parent.height - self.height) / 2; }
                    if i < 2: Text { text: a.title; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 600; vertical-alignment: center; }
                }
                bta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.clicked(i); }
                }
            }
        }
    }
}

// Capa 2:3 da grade e das categorias (o CartaoDeJogo da tela cheia na escala de mesa): jogando no canto de cima à
// direita, favorito à esquerda, não instalado a 45%. Foco: cresce 4%, foco suave e o ▶ no meio; hover só clareia.
component CoverCard inherits Rectangle {
    in property <DeskGame> data;
    in property <bool> focused;
    callback clicked();
    callback toggle();
    callback range();
    callback play();
    callback install();
    callback menu(length, length);
    // Só a grade (NaoInstalados): ⬇ no lugar do ▶ e o anel de progresso nas capas que faltam instalar.
    in property <bool> install-ui;
    property <bool> to-install: install-ui && data.install-label != "";
    property <bool> hot: cta.has-hover || ica.has-hover;
    // O ⬇ ou o anel por cima: a capa clareia e o nome escrito nela some por baixo.
    property <bool> covered: to-install && (data.installing || focused || hot);
    property <length> cover-h: self.width * 1.5;
    property <length> grow: focused ? self.width * 0.02 : 0;
    accessible-role: button;
    accessible-label: data.label;
    Rectangle {
        x: -grow;
        y: -grow;
        width: root.width + 2 * grow;
        height: root.cover-h + 2 * grow;
        animate x, y, width, height { duration: Ui.focus-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        border-radius: Ui.radius-card;
        clip: true;
        background: @linear-gradient(160deg, data.accent.mix(Ui.desk-canvas, 0.6) 0%, data.accent.mix(Ui.desk-canvas, 0.25) 100%);
        opacity: data.installed ? 1 : (to-install && data.installing ? 0.75 : (covered ? 0.8 : 0.45));
        animate opacity { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        drop-shadow-offset-y: 10px;
        drop-shadow-blur: 26px;
        drop-shadow-color: Ui.shadow-float-color;
        // Luz no alto à esquerda, como a Cover da tela cheia.
        Rectangle {
            x: -parent.width * 0.3;
            y: -parent.height * 0.6;
            width: parent.width * 1.2;
            height: parent.height * 1.4;
            background: @radial-gradient(circle, Ui.on-accent.with-alpha(0.12) 0%, Ui.on-accent.with-alpha(0) 60%);
        }
        if data.cover.width == 0: Text {
            x: 14px;
            width: parent.width - 28px;
            text: data.title;
            opacity: covered ? 0 : 1;
            animate opacity { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
            color: Ui.on-accent;
            font-family: Ui.font-heading;
            font-size: 19px * Ui.text-scale;
            font-weight: 700;
            letter-spacing: -0.01 * self.font-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Image { width: parent.width; height: parent.height; source: data.cover; image-fit: cover; }
        Rectangle { background: cta.has-hover && !focused ? Ui.glass-hover : transparent; }
        Rectangle { border-radius: Ui.radius-card; border-width: 1px; border-color: Ui.glass-edge; }
        if data.checked: Rectangle { border-radius: Ui.radius-card; border-width: 3px; border-color: Ui.primary-top; }
    }
    if focused: Rectangle {
        x: -grow;
        y: -grow;
        width: root.width + 2 * grow;
        height: root.cover-h + 2 * grow;
        FocusRing { radius: Ui.radius-card; background: transparent; }
        if !to-install: Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 28px;
            background: Ui.primary-top;
            drop-shadow-offset-y: Ui.shadow-float-y;
            drop-shadow-blur: Ui.shadow-float-blur;
            drop-shadow-color: Ui.shadow-float-color;
            DeskIcon { name: "play"; size: 22px; tint: Ui.on-primary; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.play(); }
            }
        }
    }
    if data.favorite: Rectangle {
        x: 8px;
        y: 8px;
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: Ui.desk-canvas.with-alpha(0.6);
        DeskIcon { name: "starfill"; size: 16px; tint: Ui.warning; }
    }
    if data.running: Rectangle {
        x: root.width - 25px;
        y: 7px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Ui.desk-canvas.with-alpha(0.65);
        Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Ui.success; }
    }
    HorizontalLayout {
        y: root.cover-h + 10px;
        height: 22px;
        spacing: Ui.space-8;
        Text {
            text: data.title;
            color: data.installed ? Ui.on-accent : Ui.on-accent-muted;
            font-size: 14px * Ui.text-scale;
            font-weight: data.installed ? 600 : 500;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }
        // O grupo da loja já diz de onde o jogo vem: sem o ícone nos que faltam instalar.
        if !to-install: DeskIcon { name: data.store-icon; size: 16px; tint: Ui.desk-on-muted; y: 3px; }
    }
    cta := TouchArea {
        y: 0;
        height: root.cover-h;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                if (ev.modifiers.control || ev.modifiers.meta) {
                    root.toggle();
                } else if (ev.modifiers.shift) {
                    root.range();
                } else {
                    root.clicked();
                }
            }
        }
        double-clicked => { root.play(); }
    }
    // Depois da `cta`, que cobre a capa inteira: o ⬇ precisa ficar por cima para receber o clique. Em cima dele o
    // mouse sai da capa, então ele conta como a capa (`hot`), senão sumiria sob o cursor.
    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.cover-h - self.height) / 2;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        visible: to-install && !data.installing;
        opacity: focused || hot ? 1 : 0;
        animate opacity { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        background: Ui.primary-top;
        drop-shadow-offset-y: Ui.shadow-float-y;
        drop-shadow-blur: Ui.shadow-float-blur;
        drop-shadow-color: Ui.shadow-float-color;
        accessible-role: button;
        accessible-label: data.install-label;
        accessible-action-default => { root.install(); }
        DeskIcon { name: "download"; size: 22px; tint: Ui.on-primary; }
        ica := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.install(); }
        }
    }
    // Baixando: anel de 64 com a % no meio (sem a %, a loja não informa e o arco gira).
    if to-install && data.installing: Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.cover-h - self.height) / 2;
        width: 64px;
        height: 64px;
        accessible-role: progress-indicator;
        accessible-label: data.install-label;
        accessible-value: data.percent;
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        Rectangle { border-radius: 32px; background: #000b; }
        ProgressRing { size: 64px; thickness: 5px; fraction: data.progress; track: #ffffff33; }
        Text { text: data.percent; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// BibliotecaGrade: capas 2:3 de 172 × 258, 22 entre colunas, quantas couberem (mínimo 4); virtualizada por linhas.
// Os instalados ficam num trecho e a seção NÃO INSTALADOS vem depois, um trecho por loja: cada um sabe quantas linhas
// de capa e quantos cabeçalhos vêm antes dele (o Tako conta), então a posição é uma soma e a rolagem só cria as
// linhas que aparecem em cada trecho.
component CoverGrid inherits Rectangle {
    in property <[DeskBlock]> blocks;
    // Linhas de capas, divisórias e cabeçalhos de loja do total; e onde está o foco (as mesmas contagens antes dele e
    // 1 se for um cabeçalho).
    in property <[int]> extent;
    in property <[int]> focus-at;
    in property <string> focus-id;
    in property <int> focus-group: -1;
    in property <bool> key-focus;
    in property <int> columns: 4;
    callback clicked(string, int);
    callback menu(length, length);
    callback scrolled(int);
    property <length> cell-w: (self.width - (columns - 1) * 22px) / columns;
    property <length> row-h: cell-w * 1.5 + 32px + 26px;
    // Divisória: 6 de respiro, 1 de linha e o overline; cabeçalho de loja: 36 e 12 até as capas.
    property <length> sec-h: 46px;
    property <length> grp-h: 48px;
    property <length> focus-top: focus-at[0] * row-h + focus-at[1] * sec-h + focus-at[2] * grp-h;
    property <length> focus-h: focus-at[3] == 1 ? grp-h : row-h;
    changed focus-top => {
        if (focus-at.length > 0) {
            if (focus-top + fl.viewport-y < 0) {
                fl.viewport-y = -focus-top;
            } else if (focus-top + focus-h + fl.viewport-y > fl.height) {
                fl.viewport-y = -(focus-top + focus-h - fl.height);
            }
        }
    }
    clip: true;
    fl := Flickable {
        viewport-height: extent[0] * row-h + extent[1] * sec-h + extent[2] * grp-h;
        for b in blocks: blk := Rectangle {
            property <length> top: b.rows-before * row-h + b.sections-before * sec-h + b.groups-before * grp-h;
            property <length> head: b.kind == "section" ? sec-h : (b.kind == "group" ? grp-h : 0px);
            property <int> n-rows: ceil(b.games.length / columns);
            // As linhas do trecho que cruzam a janela (de `lo` até `hi`, sem incluir).
            property <int> lo: max(0, min(n-rows, floor((-fl.viewport-y - top - head) / row-h)));
            property <int> hi: max(0, min(n-rows, ceil((-fl.viewport-y + fl.height - top - head) / row-h)));
            // O trecho que está no alto da janela avisa a primeira capa (miniaturas e capas só perto dela).
            property <int> report: -fl.viewport-y >= top && -fl.viewport-y < top + head + n-rows * row-h ? b.first + lo * columns : -1;
            changed report => {
                if (report >= 0) {
                    root.scrolled(report);
                }
            }
            x: 0;
            y: top;
            width: fl.width;
            height: head + n-rows * row-h;
            if b.kind == "section": NotInstalledTitle {
                x: 0;
                width: parent.width;
                height: sec-h;
                inset: 0px;
                title: b.title;
                count: b.count;
            }
            if b.kind == "group": StoreGroup {
                x: 0;
                y: 0;
                width: 260px;
                icon: b.icon;
                title: b.title;
                count: b.count;
                label: b.label;
                open: b.open;
                focused: key-focus && b.index == focus-group;
                clicked => { root.clicked("group", b.index); }
            }
            for i in max(0, blk.hi - blk.lo) * columns: CoverCard {
                property <int> k: blk.lo * columns + i;
                visible: k < b.games.length;
                x: mod(k, columns) * (cell-w + 22px);
                y: blk.head + floor(k / columns) * row-h + 8px;
                width: cell-w;
                height: row-h - 8px;
                data: b.games[k];
                install-ui: true;
                // A capa selecionada fica destacada (moldura, ▶ ou ⬇) também com o mouse, como na prévia da grade.
                focused: b.games[k].id == focus-id;
                clicked => { root.clicked("cover", b.games[k].index); }
                toggle => { root.clicked("game-toggle", b.games[k].index); }
                range => { root.clicked("game-range", b.games[k].index); }
                play => { root.clicked("cover-play", b.games[k].index); }
                install => { root.clicked("cover-play", b.games[k].index); }
                menu(x, y) => {
                    root.menu(x, y);
                    root.clicked("cover-menu", b.games[k].index);
                }
            }
        }
    }
}

// BibliotecaCategorias: fileiras de capas agrupadas, com o nome, quantos jogos e "Ver todos ›"; virtualizadas na
// vertical; cada fileira rola na horizontal (roda com Shift ou ‹ › nas pontas).
component CategoryRows inherits Rectangle {
    in property <[DeskCategory]> rows;
    in property <string> see-all;
    in property <bool> key-focus;
    in property <int> focus-row;
    in property <int> focus-col;
    callback clicked(string, int);
    callback menu(length, length);
    callback scrolled(int);
    property <length> cell-w: 150px;
    // Cabeçalho (20) + 14 até as capas, capa, 10 + nome, e 22 até a próxima fileira (gd-shead, gd-shelves).
    property <length> row-h: cell-w * 1.5 + 34px + 6px + 32px + 22px;
    property <int> first: max(0, floor(-fl.viewport-y / row-h));
    property <int> shown: min(ceil(fl.height / row-h) + 1, max(0, rows.length - first));
    changed first => { root.scrolled(first); }
    changed focus-row => {
        if (key-focus) {
            if (focus-row * row-h + fl.viewport-y < 0) {
                fl.viewport-y = -focus-row * row-h;
            } else if ((focus-row + 1) * row-h + fl.viewport-y > fl.height) {
                fl.viewport-y = -((focus-row + 1) * row-h - fl.height);
            }
        }
    }
    clip: true;
    fl := Flickable {
        viewport-height: rows.length * row-h;
        for i in shown: Rectangle {
            property <DeskCategory> cat: rows[first + i];
            y: (first + i) * row-h;
            height: row-h;
            HorizontalLayout {
                y: 0;
                height: 24px;
                spacing: 12px;
                Text { text: cat.title; color: Ui.on-accent; font-family: Ui.font-heading; font-size: Ui.desk-title; font-weight: 700; vertical-alignment: center; }
                Text { text: cat.count; color: Ui.desk-on-muted; font-size: 14px * Ui.text-scale; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: sl.preferred-width;
                    border-radius: Ui.radius-thumb;
                    background: sta.has-hover ? Ui.glass-hover : transparent;
                    accessible-role: button;
                    accessible-label: see-all + " · " + cat.title;
                    sl := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 4px;
                        Text { text: see-all; color: Ui.desk-on-muted; font-size: 14px * Ui.text-scale; vertical-alignment: center; }
                        DeskIcon { name: "chevron"; size: 14px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
                    }
                    sta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.clicked("cat-all", first + i); }
                    }
                }
            }
            hf := Flickable {
                y: 34px;
                height: row-h - 34px;
                viewport-width: cat.games.length * (cell-w + 20px);
                interactive: self.viewport-width > self.width;
                for g[j] in cat.games: CoverCard {
                    x: j * (cell-w + 20px) + 4px;
                    y: 6px;
                    width: cell-w;
                    height: cell-w * 1.5 + 40px;
                    data: g;
                    focused: key-focus && first + i == focus-row && j == focus-col;
                    clicked => { root.clicked("cat-cover", g.index); }
                    play => { root.clicked("cat-cover-play", g.index); }
                    menu(x, y) => {
                        root.menu(x, y);
                        root.clicked("cat-cover-menu", g.index);
                    }
                }
            }
            // ‹ › nas pontas da fileira quando ela passa da largura (nada só por arrastar).
            if hf.viewport-width > hf.width: Rectangle {
                x: 0;
                y: 40px + cell-w * 0.75 - 18px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                visible: hf.viewport-x < 0;
                background: Ui.glass-panel-dense;
                border-width: 1px;
                border-color: Ui.glass-edge-strong;
                DeskIcon { name: "chevron-left"; size: 16px; tint: Ui.on-accent; }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { hf.viewport-x = min(0, hf.viewport-x + hf.width * 0.8); }
                }
            }
            if hf.viewport-width > hf.width: Rectangle {
                x: parent.width - 36px;
                y: 40px + cell-w * 0.75 - 18px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                visible: hf.viewport-x > hf.width - hf.viewport-width;
                background: Ui.glass-panel-dense;
                border-width: 1px;
                border-color: Ui.glass-edge-strong;
                DeskIcon { name: "chevron"; size: 16px; tint: Ui.on-accent; }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { hf.viewport-x = max(hf.width - hf.viewport-width, hf.viewport-x - hf.width * 0.8); }
                }
            }
        }
    }
}

// Etiqueta de estado do destaque: INSTALADO, NÃO INSTALADO, JOGANDO (com o ponto verde), QUEBRADO.
component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> live;
    height: 26px;
    width: bl.preferred-width;
    border-radius: self.height / 2;
    background: Ui.glass-control;
    border-width: 1px;
    border-color: Ui.glass-edge-strong;
    bl := HorizontalLayout {
        padding-left: Ui.space-12;
        padding-right: Ui.space-12;
        spacing: 6px;
        if live: Rectangle { y: 9px; width: 8px; height: 8px; border-radius: 4px; background: Ui.success; }
        Text {
            text: root.text;
            color: Ui.on-accent;
            font-size: Ui.desk-overline;
            font-weight: 700;
            letter-spacing: 0.1 * self.font-size;
            vertical-alignment: center;
        }
    }
}

// Status do usuário (Jogando, Pausado…): ponto de 8, cheio ou vazado.
component PlayStatusDot inherits Rectangle {
    in property <string> status;
    property <bool> hollow: status == "" || status == "none" || status == "wishlist";
    property <color> tint: status == "playing" ? Ui.success : (status == "paused" ? Ui.warning : (status == "beaten" ? Ui.on-accent : (status == "wishlist" ? Ui.desk-on-muted : Ui.desk-on-subtle)));
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border-width: hollow ? 1.5px : 0;
    border-color: tint;
    background: hollow ? transparent : tint;
}

component PlayStatusSelect inherits Rectangle {
    in property <string> status;
    in property <string> label;
    callback clicked(length, length);
    height: 28px;
    width: sl.preferred-width;
    border-radius: 14px;
    background: sta.has-hover ? Ui.glass-hover : Ui.glass-control;
    border-width: 1px;
    border-color: Ui.glass-edge-strong;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(self.absolute-position.x + self.width, self.absolute-position.y + self.height + 6px); }
    sl := HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        PlayStatusDot { status: root.status; y: (parent.height - self.height) / 2; }
        Text {
            text: label;
            color: status == "" ? Ui.desk-on-muted : Ui.on-accent;
            font-size: 13px * Ui.text-scale;
            font-weight: 600;
            vertical-alignment: center;
        }
        DeskIcon { name: "updown"; size: 14px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
    }
    sta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            DeskArt.anchor-w = root.width;
            root.clicked(root.absolute-position.x + root.width, root.absolute-position.y + root.height + 6px);
        }
    }
}

// Loja de origem do jogo escolhido: cápsula de vidro com o logo e o nome.
component StorePill inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    height: 28px;
    width: sl.preferred-width;
    border-radius: self.height / 2;
    background: Ui.glass-control;
    border-width: 1px;
    border-color: Ui.glass-edge-strong;
    accessible-role: image;
    accessible-label: text;
    sl := HorizontalLayout {
        padding-left: Ui.space-12;
        padding-right: Ui.space-12;
        spacing: 6px;
        DeskIcon { name: icon; size: 16px; tint: Ui.on-accent; y: (parent.height - self.height) / 2; }
        Text { text: root.text; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 600; vertical-alignment: center; }
    }
}

// Faixa de estado do jogo: cápsula de vidro com itens separados por divisórias (ícone de 26, rótulo em caixa alta e
// valor). Só os itens que o Tako tem; na janela pequena, os três primeiros.
component StatusStrip inherits Vidro {
    in property <[DeskInfo]> items;
    in property <bool> small;
    height: 62px;
    width: sl.preferred-width;
    sl := HorizontalLayout {
        padding-left: Ui.space-16;
        padding-right: 22px;
        for it[i] in items: HorizontalLayout {
            // Metacritic é o último da faixa e o primeiro a sair quando falta largura.
            visible: it.icon == "metacritic" ? !small : (!small || i < 3);
            spacing: 11px;
            // Divisória no meio do espaço entre os itens.
            if i > 0: HorizontalLayout {
                padding-left: small ? 11px : 14px;
                padding-right: small ? 0 : 3px;
                Rectangle { width: 1px; height: 30px; y: 16px; background: Ui.divider; }
            }
            if it.icon != "metacritic": DeskIcon { name: it.icon; size: 26px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
            if it.icon == "metacritic": Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 6px;
                y: (parent.height - self.height) / 2;
                background: it.score >= 75 ? Ui.success : (it.score >= 50 ? Ui.warning : Ui.error);
                Text {
                    text: it.score;
                    font-family: Ui.font-text;
                    font-size: 11px * Ui.text-scale;
                    font-weight: 800;
                    color: it.score < 50 ? #ffffff : #0b0d10;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 5px;
                Text {
                    text: it.label.to-uppercase();
                    color: Ui.desk-on-muted;
                    font-size: 11px * Ui.text-scale;
                    font-weight: 700;
                    letter-spacing: 0.08 * self.font-size;
                }
                HorizontalLayout {
                    spacing: 7px;
                    if it.dot: Rectangle { y: (parent.height - self.height) / 2; width: 8px; height: 8px; border-radius: 4px; background: Ui.success; }
                    Text { text: it.value; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 500; }
                }
            }
        }
    }
}

// Pílula principal (Jogar, Voltar ao jogo, Instalar): branca, a única por tela. Responde no pressionar (0,97).
// Anel de progresso (JogarEAbrir): trilha fraca e um arco girando; com "reduzir animações" fica parado.
component Ring inherits Rectangle {
    in property <length> size: 22px;
    in property <color> tint: Ui.on-primary;
    width: size;
    height: size;
    Rectangle {
        border-radius: parent.width / 2;
        border-width: 2px;
        border-color: tint.with-alpha(0.25);
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 2 A 10 10 0 0 1 22 12";
        stroke: tint;
        stroke-width: 2px;
        fill: transparent;
        transform-rotation: Ui.reduce-motion ? 0deg : animation-tick() / 900ms * 360deg;
    }
}

component PlayButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    // Texto menor ao lado do rótulo ("Steam · 9,1 GB" no Instalar).
    in property <string> sub;
    // Botão dividido (jogo em mais de uma loja): o ⌄ de 48 ao lado, 2 de vão.
    in property <bool> split;
    in property <string> more-label;
    in property <bool> enabled: true;
    in property <bool> focused;
    in property <bool> small;
    callback clicked();
    callback more-clicked(length, length);
    height: small ? 50px : Ui.primary-height;
    property <length> main-w: split ? pl.preferred-width : max(small ? 180px : 232px, pl.preferred-width);
    width: split ? main-w + 2px + 48px : main-w;
    accessible-role: button;
    accessible-label: sub != "" ? label + ", " + sub : label;
    property <float> press: pta.pressed && enabled ? Ui.escala-pressionado : 1;
    // Na ponta de dentro do botão dividido o canto é de 6.
    property <length> inner-r: split ? 6px : root.height / 2;
    Rectangle {
        x: (root.main-w - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.main-w * press;
        height: root.height * press;
        border-radius: self.height / 2;
        background: @linear-gradient(180deg, Ui.primary-top 0%, Ui.primary-bottom 100%);
        drop-shadow-offset-y: Ui.shadow-float-y;
        drop-shadow-blur: Ui.shadow-float-blur;
        drop-shadow-color: Ui.shadow-float-color;
        opacity: enabled ? 1 : 0.7;
        // Botão dividido: a ponta de dentro é de 6, não redonda; o degradê vertical esconde a emenda.
        if split: Rectangle { x: parent.width - parent.height / 2; width: parent.height / 2; border-radius: 6px; background: @linear-gradient(180deg, Ui.primary-top 0%, Ui.primary-bottom 100%); }
        // Brilho de 1px no topo.
        Rectangle { x: parent.height / 2; y: 1px; width: parent.width - parent.height / 2 - root.inner-r; height: 1px; background: Ui.primary-top; }
        if pta.pressed: Rectangle { border-radius: parent.border-radius; background: Ui.on-primary.with-alpha(0.06); }
    }
    if split: Rectangle {
        x: root.main-w + 2px;
        y: (root.height - self.height) / 2;
        width: 48px * more-press;
        height: root.height * more-press;
        border-radius: self.height / 2;
        background: @linear-gradient(180deg, Ui.primary-top 0%, Ui.primary-bottom 100%);
        drop-shadow-offset-y: Ui.shadow-float-y;
        drop-shadow-blur: Ui.shadow-float-blur;
        drop-shadow-color: Ui.shadow-float-color;
        opacity: enabled ? 1 : 0.7;
        // A ponta de dentro (esquerda) também é de 6.
        Rectangle { width: parent.height / 2; border-radius: 6px; background: @linear-gradient(180deg, Ui.primary-top 0%, Ui.primary-bottom 100%); }
        property <float> more-press: mta.pressed && enabled ? Ui.escala-pressionado : 1;
        DeskIcon { name: "chevron-down"; size: 20px; tint: Ui.on-primary; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        mta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: more-label;
            clicked => { root.more-clicked(self.absolute-position.x, self.absolute-position.y + self.height + 8px); }
        }
    }
    if focused: FocusRing { radius: root.height / 2; background: transparent; }
    pl := HorizontalLayout {
        x: 0;
        width: root.main-w;
        padding-left: split ? 22px : 32px;
        padding-right: split ? 24px : 32px;
        spacing: split ? 10px : Ui.space-12;
        alignment: center;
        if icon == "ring": Ring { size: 22px; tint: Ui.on-primary; y: (parent.height - self.height) / 2; }
        if icon != "ring": DeskIcon { name: icon; size: 22px; tint: Ui.on-primary; y: (parent.height - self.height) / 2; }
        Text { text: label; color: Ui.on-primary; font-size: 19px * Ui.text-scale; font-weight: 700; vertical-alignment: center; }
        if sub != "": Text { text: sub; color: Ui.on-primary.with-alpha(0.65); font-size: 13px * Ui.text-scale; font-weight: 600; vertical-alignment: center; }
    }
    pta := TouchArea {
        width: root.main-w;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Botão redondo de vidro só com ícone (favoritar, ⋯, engrenagem) ou pílula de vidro com rótulo (Encerrar jogo).
// Sobre a arte é uma lente; perigo usa a tinta densa para o vermelho manter contraste.
component GlassButton inherits Vidro {
    in property <string> icon;
    in property <string> label;
    in property <bool> show-label;
    in property <bool> on;
    in property <bool> danger;
    in property <bool> focused;
    in property <bool> small;
    callback clicked();
    dense: danger;
    radius: self.height / 2;
    // Pressionar responde na hora (pointer-down), sem animação.
    transform-scale: gta.pressed ? Ui.escala-pressionado : 1;
    height: show-label ? Ui.control-height + 8px : (small ? 46px : Ui.round-button);
    width: show-label ? gl.preferred-width : self.height;
    accessible-role: button;
    accessible-label: label;
    Rectangle {
        border-radius: root.height / 2;
        background: gta.pressed ? Ui.glass-pressed : (gta.has-hover ? Ui.glass-hover : transparent);
        animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    }
    if focused: FocusRing { radius: root.height / 2; background: transparent; }
    gl := HorizontalLayout {
        padding-left: show-label ? 18px : 0;
        padding-right: show-label ? 20px : 0;
        spacing: 10px;
        alignment: center;
        DeskIcon {
            name: icon;
            size: 22px;
            tint: danger ? Ui.error : (on ? Ui.warning : Ui.on-accent);
            y: (parent.height - self.height) / 2;
        }
        if show-label: Text { text: label; color: danger ? Ui.error : Ui.on-accent; font-size: Ui.desk-label; font-weight: 600; vertical-alignment: center; }
    }
    gta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tip { text: show-label ? "" : label; hovering: gta.has-hover; }
}

// Título de cartão (Poppins, `title`).
component CardTitle inherits Text {
    color: Ui.on-accent;
    font-family: Ui.font-heading;
    font-size: Ui.desk-title;
    font-weight: 700;
    overflow: elide;
}

// CartaoSobre: descrição (cortada com "Mais", que abre o texto inteiro) e os gêneros como texto no rodapé.
component AboutCard inherits Vidro {
    in property <string> title;
    in property <string> text;
    in property <bool> more;
    in property <string> more-label;
    in property <[string]> genres;
    in property <string> genres-more;
    in property <bool> small;
    callback more-clicked();
    VerticalLayout {
        padding-left: small ? Ui.space-16 : Ui.space-24;
        padding-right: small ? Ui.space-16 : Ui.space-24;
        padding-top: small ? Ui.space-16 : Ui.space-24;
        padding-bottom: small ? Ui.space-16 : Ui.space-20;
        spacing: small ? 10px : Ui.space-16;
        CardTitle { text: title; }
        // A descrição ocupa a sobra e corta com "…": não pede altura para a fileira crescer.
        Text { text: root.text; color: Ui.desk-on-muted; font-size: Ui.desk-body; line-height-factor: 1.23; wrap: word-wrap; overflow: elide; vertical-stretch: 1; min-height: 0; preferred-height: 0; }
        if genres.length > 0 || more: VerticalLayout {
            spacing: Ui.space-12;
            Rectangle { height: 1px; background: Ui.glass-edge; }
            HorizontalLayout {
                height: 24px;
                spacing: Ui.space-8;
                for g[i] in genres: HorizontalLayout {
                    visible: !small || i < 2;
                    spacing: Ui.space-8;
                    if i > 0: Text { text: "-"; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; vertical-alignment: center; }
                    Text { text: g; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; font-weight: 500; vertical-alignment: center; max-width: 150px; overflow: elide; }
                }
                if genres-more != "" && !small: Text { text: genres-more; color: Ui.desk-on-subtle; font-size: Ui.desk-label-sm; font-weight: 500; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if more: Rectangle {
                    width: ml.preferred-width + 16px;
                    border-radius: Ui.radius-thumb;
                    background: mta.has-hover ? Ui.glass-hover : transparent;
                    accessible-role: button;
                    accessible-label: more-label;
                    ml := Text { text: more-label; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 600; }
                    mta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.more-clicked(); }
                    }
                }
            }
        }
    }
}

// CartaoTrailer: miniatura parada (a arte), escurecida embaixo, com o botão de vidro "Trailer"; só toca ao clicar.
component TrailerCard inherits Rectangle {
    in property <image> art;
    in property <string> label;
    callback clicked();
    border-radius: Ui.radius-card;
    clip: true;
    background: Ui.glass-solid;
    drop-shadow-offset-y: Ui.shadow-float-y;
    drop-shadow-blur: Ui.shadow-float-blur;
    drop-shadow-color: Ui.shadow-float-color;
    Image { width: parent.width; height: parent.height; source: art; image-fit: cover; }
    Rectangle { background: @linear-gradient(0deg, Ui.desk-canvas.with-alpha(0.8) 0%, Ui.desk-canvas.with-alpha(0) 55%); }
    Rectangle { border-radius: Ui.radius-card; border-width: 1px; border-color: Ui.glass-edge; }
    GlassButton {
        x: Ui.space-16;
        y: parent.height - self.height - Ui.space-16;
        height: 40px;
        show-label: true;
        icon: "play";
        label: root.label;
        clicked => { root.clicked(); }
    }
}

// CartaoDetalhes: linhas em grade (ícone · rótulo · valor) que dividem a altura, com divisórias; Status com o ponto.
component DetailsCard inherits Vidro {
    in property <string> title;
    in property <[DeskInfo]> rows;
    in property <bool> small;
    // Coluna dos rótulos pelo mais longo, nunca menos que 104 (corrige o "Desenvolv…").
    property <length> label-w: max(104px, 13 * 7.4px * Ui.text-scale);
    VerticalLayout {
        padding-left: small ? Ui.space-16 : Ui.space-24;
        padding-right: small ? Ui.space-16 : Ui.space-24;
        padding-top: small ? Ui.space-16 : Ui.space-24;
        padding-bottom: small ? Ui.space-16 : Ui.space-20;
        // Título → linhas 8; as linhas dividem a altura sem espaço entre elas (mín. 28, máx. 40).
        spacing: 0;
        CardTitle { text: title; }
        Rectangle { height: small ? 4px : 8px; }
        for r[i] in rows: Rectangle {
            vertical-stretch: 1;
            min-height: small ? 22px : 28px;
            max-height: 40px;
            if i > 0: Rectangle { y: 0; height: 1px; background: Ui.divider; }
            HorizontalLayout {
                spacing: Ui.space-12;
                DeskIcon { name: r.icon; size: 16px; tint: Ui.desk-on-subtle; y: (parent.height - self.height) / 2; }
                Text { text: r.label; width: root.label-w; color: Ui.desk-on-subtle; font-size: Ui.desk-label-sm; font-weight: 500; vertical-alignment: center; overflow: elide; }
                if r.chips.length == 0: HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Ui.space-8;
                    if r.dot: Rectangle { y: (parent.height - self.height) / 2; width: 8px; height: 8px; border-radius: 4px; background: Ui.success; }
                    // Valor cortado com "…": o inteiro aparece na dica ao passar o mouse.
                    Rectangle {
                        horizontal-stretch: 1;
                        vt := Text { width: parent.width; height: parent.height; text: r.value; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        vta := TouchArea { }
                        Tip { text: vt.preferred-width > vt.width ? r.value : ""; hovering: vta.has-hover; }
                    }
                }
                if r.chips.length > 0: HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    for c in r.chips: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        width: min(cl.preferred-width + 16px, 96px);
                        border-radius: 11px;
                        background: Ui.glass-control;
                        border-width: 1px;
                        border-color: Ui.glass-edge;
                        cl := Text { width: parent.width - 16px; text: c; color: Ui.on-accent; font-size: Ui.desk-overline; font-weight: 600; overflow: elide; horizontal-alignment: center; }
                    }
                    if r.value != "": Text { text: r.value; color: Ui.desk-on-subtle; font-size: Ui.desk-label-sm; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        if rows.length < 6: Rectangle { vertical-stretch: 6 - rows.length; }
    }
}

// CartaoSessoes: o histórico (SESSION-002): título com "Ver todas ›", o resumo e as últimas sessões.
component SessionsCard inherits Vidro {
    in property <[string]> labels;
    in property <string> summary;
    in property <[DeskInfo]> rows;
    callback see-all();
    dense: true;
    VerticalLayout {
        padding: Ui.space-24;
        padding-bottom: Ui.space-20;
        spacing: 6px;
        HorizontalLayout {
            CardTitle { text: labels[0]; horizontal-stretch: 1; }
            Rectangle {
                width: sl.preferred-width + 8px;
                border-radius: Ui.radius-thumb;
                background: sta.has-hover ? Ui.glass-hover : transparent;
                accessible-role: button;
                accessible-label: labels[1];
                sl := HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    Text { text: labels[1]; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; vertical-alignment: center; }
                    DeskIcon { name: "chevron"; size: 14px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
                }
                sta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.see-all(); }
                }
            }
        }
        Text { text: summary; color: Ui.desk-on-subtle; font-size: Ui.desk-label-sm; font-weight: 500; }
        for r[i] in rows: Rectangle {
            vertical-stretch: 1;
            max-height: 40px;
            if i > 0: Rectangle { y: 0; height: 1px; background: Ui.divider; }
            HorizontalLayout {
                spacing: Ui.space-8;
                if r.dot: Rectangle { y: (parent.height - self.height) / 2; width: 8px; height: 8px; border-radius: 4px; background: Ui.success; }
                Text { text: r.label; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 700; vertical-alignment: center; }
                Text { text: r.detail; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: r.value; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 600; vertical-alignment: center; }
            }
        }
    }
}

// Fileira de cartões do destaque: Sobre, Detalhes e Sessões, 20 entre eles (larguras 1,25 · 1,1 · 1,1).
component CardRow inherits Rectangle {
    in property <DeskGameView> game;
    in property <[DeskInfo]> details;
    in property <string> sessions-summary;
    in property <[DeskInfo]> sessions;
    in property <[string]> card-labels;
    in property <string> about-label;
    in property <string> details-label;
    in property <bool> small;
    in property <bool> show-about;
    in property <bool> show-sessions;
    callback clicked(string, int);
    // Larguras 1,25 · 1,1 · 1,1, 20 entre eles (ou 1,25 · 1,1 sem sessões); o trailer mora na fase 2.
    property <float> s-about: 1.25;
    property <float> s-details: 1.1;
    property <float> s-sessions: 1.1;
    property <float> total: (show-about ? s-about : 0) + s-details + (show-sessions ? s-sessions : 0);
    property <int> cards: (show-about ? 1 : 0) + 1 + (show-sessions ? 1 : 0);
    property <length> unit: (root.width - (cards - 1) * Ui.space-20) / total;
    property <length> about-w: show-about ? unit * s-about + Ui.space-20 : 0;
    property <length> details-w: unit * s-details;
    // Altura que o conteúdo pede (Detalhes com seis linhas), para a fileira crescer em vez de cortar.
    out property <length> content-h: dc.min-height;
    // Entrada do app: os cartões acendem um a um depois das ações, subindo `intro-rise`.
    property <float> intro-about: DeskIntro.on ? 1 : 0;
    animate intro-about { duration: Ui.page-time; delay: Ui.intro-delay(5); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <float> intro-details: DeskIntro.on ? 1 : 0;
    animate intro-details { duration: Ui.page-time; delay: Ui.intro-delay(6); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <float> intro-sessions: DeskIntro.on ? 1 : 0;
    animate intro-sessions { duration: Ui.page-time; delay: Ui.intro-delay(7); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    if show-about: AboutCard {
        x: 0;
        y: (1 - intro-about) * Ui.intro-rise;
        opacity: intro-about;
        height: root.height;
        width: unit * s-about;
        title: about-label;
        text: game.description;
        more: game.about-more;
        more-label: card-labels[2];
        genres: game.genres;
        genres-more: game.genres-more;
        small: small;
        more-clicked => { root.clicked("about-more", 0); }
    }
    dc := DetailsCard {
        x: about-w;
        y: (1 - intro-details) * Ui.intro-rise;
        opacity: intro-details;
        height: root.height;
        width: details-w;
        title: details-label;
        rows: details;
        small: small;
    }
    if show-sessions: SessionsCard {
        x: about-w + details-w + Ui.space-20;
        y: (1 - intro-sessions) * Ui.intro-rise;
        opacity: intro-sessions;
        height: root.height;
        width: unit * s-sessions;
        labels: card-labels;
        summary: sessions-summary;
        rows: sessions;
        see-all => { root.clicked("sessions", 0); }
    }
}

// EstadoCarregando: o destaque e os cartões já com a forma final (etiqueta, título, faixa, botões e três cartões), em
// blocos de espera que crescem com o tamanho do texto, para o layout não pular quando os dados chegam.
component LoadingStage inherits VerticalLayout {
    in property <bool> small;
    alignment: end;
    spacing: small ? Ui.space-16 : Ui.space-28;
    VerticalLayout {
        spacing: small ? 10px : 14px;
        alignment: end;
        HorizontalLayout { alignment: start; Skeleton { width: 120px * Ui.text-scale; height: 26px; radius: 13px; } }
        HorizontalLayout { alignment: start; Skeleton { width: (small ? 360px : 480px) * Ui.text-scale; height: (small ? 40px * Ui.text-scale : Ui.desk-display) * 1.1; radius: 10px; } }
        HorizontalLayout { alignment: start; Skeleton { width: 420px * Ui.text-scale; height: 62px; radius: 31px; } }
        HorizontalLayout {
            alignment: start;
            spacing: Ui.space-12;
            padding-top: 6px;
            Skeleton { width: max(small ? 180px : 232px, 140px * Ui.text-scale); height: small ? 50px : Ui.primary-height; radius: self.height / 2; }
            for i in 3: Skeleton { width: small ? 46px : Ui.round-button; height: small ? 46px : Ui.round-button; radius: self.height / 2; }
        }
    }
    HorizontalLayout {
        height: small ? 190px : Ui.card-height;
        spacing: Ui.space-20;
        Skeleton { horizontal-stretch: 1.25; radius: Ui.radius-card; }
        Skeleton { horizontal-stretch: 1.1; radius: Ui.radius-card; }
        if !small: Skeleton { horizontal-stretch: 1.1; radius: Ui.radius-card; }
    }
}

// Destaque do jogo selecionado e a fileira de cartões, ancorados embaixo sobre a arte (Destaque, AcoesDoJogo,
// CartaoSobre, CartaoTrailer, CartaoDetalhes, CartaoSessoes). Com quatro cartões, a fileira rola na horizontal.
component GameStage inherits VerticalLayout {
    // O jogo que chega; `game` é o que está na tela (o anterior fica até o texto apagar).
    in property <DeskGameView> game-in;
    property <DeskGameView> game;
    in property <[PanelRow]> actions;
    in property <[DeskInfo]> stats;
    in property <[DeskInfo]> details;
    in property <string> sessions-summary;
    in property <[DeskInfo]> sessions;
    in property <[string]> card-labels;
    in property <string> about-label;
    in property <string> details-label;
    in property <string> more-install-label;
    in property <string> zone;
    in property <int> zone-index;
    in property <bool> focus-visible;
    in property <bool> small;
    callback clicked(string, int);
    callback menu(length, length);
    property <bool> show-about: game.description != "";
    // Entrada do app: etiqueta e título, depois faixa e ações, subindo `intro-rise` (o logo só acende: o layout dele
    // já usa o `y`).
    property <float> intro-title: DeskIntro.on ? 1 : 0;
    animate intro-title { duration: Ui.page-time; delay: Ui.intro-delay(3); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <float> intro-actions: DeskIntro.on ? 1 : 0;
    animate intro-actions { duration: Ui.page-time; delay: Ui.intro-delay(4); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    // Troca de jogo (TrocaDeJogo): título, faixa e cartões do jogo anterior apagam em 120 (`curva-saida`), o novo
    // entra em 200 (`curva-entrada`); a arte faz o crossfade dela. Mudança no mesmo jogo troca na hora.
    property <bool> text-in: true;
    init => { game = game-in; }
    changed game-in => {
        if (game-in.title == game.title) {
            game = game-in;
        } else {
            text-in = false;
            text-timer.running = true;
        }
    }
    text-timer := Timer {
        interval: max(1ms, Ui.tempo-texto-sai);
        running: false;
        triggered => {
            self.running = false;
            game = game-in;
            text-rise = false;
            text-in = true;
            rise-timer.running = true;
        }
    }
    // O texto novo entra subindo 8: começa 8 abaixo (sem animar) e sobe em 200.
    property <bool> text-rise: true;
    rise-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            text-rise = true;
        }
    }
    // Abaixo de 1280 de largura ou na janela pequena, Sessões sai da fileira da fase 1.
    property <bool> show-sessions: sessions.length > 0 && !small && DeskArt.win-w >= 1280px;
    alignment: end;
    // Os 8 da subida do texto saem do espaço até os cartões.
    spacing: (small ? Ui.space-16 : Ui.space-28) - 8px;
    VerticalLayout {
        spacing: small ? 10px : 14px;
        alignment: end;
        padding-bottom: text-rise ? 8px : 0px;
        animate padding-bottom { duration: Ui.text-fade(text-rise) * (text-rise ? 1 : 0); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        opacity: text-in ? 1 : 0;
        animate opacity { duration: Ui.text-fade(text-in); easing: text-in ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
        if game.overline != "": HorizontalLayout {
            alignment: start;
            Badge {
                text: game.overline;
                live: game.running;
                y: (1 - intro-title) * Ui.intro-rise;
                opacity: intro-title;
            }
        }
        // TituloDoJogo: o logo do jogo numa caixa de 520 × 180 (380 × 130 na janela pequena), ancorado embaixo à
        // esquerda, nunca ampliado acima do tamanho dele; a etiqueta fica 20 acima.
        // Logo ainda carregando: a caixa fica vazia na altura dele (nunca o nome em texto antes do logo).
        if game.show-logo || game.title-pending: HorizontalLayout {
            alignment: start;
            padding-top: 20px - (small ? 10px : 14px);
            min-height: game.title-pending ? self.box-h + self.padding-top : 0;
            property <length> box-w: small ? 380px : 520px;
            property <length> box-h: small ? 130px : 180px;
            property <length> src-w: max(1px, game.logo.width * 1px);
            property <length> src-h: max(1px, game.logo.height * 1px);
            property <float> fit: min(1, min(box-w / src-w, box-h / src-h));
            Image {
                source: game.logo;
                // O logo acende quando chega, em vez de aparecer de uma vez.
                opacity: game.logo.width > 0 ? intro-title : 0;
                animate opacity { duration: Ui.text-fade(true); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                width: parent.src-w * parent.fit;
                height: parent.src-h * parent.fit;
                image-fit: contain;
                accessible-role: image;
                accessible-label: game.title;
            }
        }
        // Título em até duas linhas, até 620 de largura (520 na janela pequena), crescendo para cima: um título longo
        // encolhe (até 36) para caber em duas.
        if !game.show-logo && !game.title-pending: HorizontalLayout {
            title-measure := Text {
                visible: false;
                width: 0;
                text: game.title;
                font-family: Ui.font-heading;
                font-size: small ? 40px * Ui.text-scale : Ui.desk-display;
                font-weight: 700;
                letter-spacing: -0.02 * self.font-size;
            }
            Text {
                property <length> base: title-measure.font-size;
                property <length> fit: base * 1.7 * (small ? 520px : 620px) / max(1px, title-measure.preferred-width);
                text: game.title;
                y: (1 - intro-title) * Ui.intro-rise;
                opacity: intro-title;
                color: Ui.on-accent;
                font-family: Ui.font-heading;
                font-size: max(min(base, fit), 36px * Ui.text-scale);
                // Entrelinha 1,04 do `display` (Poppins tem 1,5 de natural).
                line-height-factor: 0.69;
                font-weight: 700;
                letter-spacing: -0.02 * self.font-size;
                // Sem `max-height`: com ele o Slint cortava na primeira linha; o tamanho acima já limita a duas.
                wrap: word-wrap;
                max-width: small ? 520px : 620px;
                // Sem esticar, o Text ficava com a largura da palavra mais longa e cortava.
                horizontal-stretch: 1;
            }
            Rectangle { horizontal-stretch: 0.0001; }
        }
        if stats.length > 0: HorizontalLayout {
            alignment: start;
            StatusStrip {
                items: stats;
                small: small;
                y: (1 - intro-actions) * Ui.intro-rise;
                opacity: intro-actions;
            }
        }
        HorizontalLayout {
            spacing: Ui.space-12;
            alignment: start;
            padding-top: 6px;
            for a[i] in actions: HorizontalLayout {
                if a.style == "primary": PlayButton {
                    y: (1 - intro-actions) * Ui.intro-rise;
                    opacity: intro-actions;
                    label: a.title;
                    icon: a.icon;
                    sub: a.description;
                    split: a.on;
                    more-label: more-install-label;
                    enabled: a.enabled;
                    small: small;
                    focused: focus-visible && zone == "actions" && zone-index == i;
                    clicked => { root.clicked("action", i); }
                    more-clicked(x, y) => {
                        root.menu(x, y);
                        root.clicked("install-more", i);
                    }
                }
                if a.style != "primary": GlassButton {
                    y: (parent.height - self.height) / 2 + (1 - intro-actions) * Ui.intro-rise;
                    opacity: intro-actions;
                    icon: a.icon;
                    label: a.title;
                    show-label: a.style == "danger";
                    on: a.on;
                    danger: a.style == "danger";
                    small: small;
                    focused: focus-visible && zone == "actions" && zone-index == i;
                    clicked => {
                        root.menu(self.absolute-position.x, self.absolute-position.y + self.height + 6px);
                        root.clicked("action", i);
                    }
                }
            }
        }
        // Jogo não instalado: espaço livre e por onde a instalação abre; sem espaço, o aviso em `warning`.
        if game.install-note != "": Text {
            text: game.install-note;
            opacity: intro-actions;
            color: game.install-warn ? Ui.warning : Ui.desk-on-muted;
            font-size: Ui.desk-label-sm;
            font-weight: 500;
            wrap: word-wrap;
        }
        if game.hint != "": Text { text: game.hint; opacity: intro-actions; color: Ui.warning; font-size: Ui.desk-label; wrap: word-wrap; }
    }
    // Fileira Sobre · Detalhes · Sessões da fase 1 (o trailer fica na fase 2).
    // 248 (190 na janela pequena), crescendo se o conteúdo pedir mais: nada passa da borda do cartão.
    CardRow {
        opacity: text-in ? 1 : 0;
        animate opacity { duration: Ui.text-fade(text-in); easing: text-in ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
        height: max(small ? 190px : Ui.card-height, self.content-h);
        game: game;
        details: details;
        sessions-summary: sessions-summary;
        sessions: sessions;
        card-labels: card-labels;
        about-label: about-label;
        details-label: details-label;
        small: small;
        show-about: show-about;
        show-sessions: show-sessions;
        clicked(z, i) => { root.clicked(z, i); }
    }
}

// Linha de rótulo e valor da fase 2 (como no CartaoDetalhes), 36 de altura mínima; o valor quebra em linhas.
component MoreRow inherits Rectangle {
    in property <DeskInfo> info;
    in property <bool> first;
    in property <length> label-w;
    min-height: 36px;
    if !first: Rectangle { y: 0; height: 1px; background: Ui.divider; }
    HorizontalLayout {
        padding-top: Ui.space-8;
        padding-bottom: Ui.space-8;
        spacing: Ui.space-12;
        if info.icon != "": DeskIcon { name: info.icon; size: 16px; tint: Ui.desk-on-subtle; y: (parent.height - self.height) / 2; }
        if info.dot: Rectangle { y: (parent.height - self.height) / 2; width: 8px; height: 8px; border-radius: 4px; background: Ui.success; }
        Text { text: info.label; width: root.label-w; color: info.icon != "" ? Ui.desk-on-subtle : Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: info.icon != "" ? 500 : 700; vertical-alignment: center; overflow: elide; }
        if info.detail != "": Text { text: info.detail; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; vertical-alignment: center; }
        Text { text: info.value; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 600; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; horizontal-alignment: info.icon != "" ? left : right; }
    }
}

// Cartão de vidro denso fixo da fase 2: título `title` e o conteúdo embaixo, 24 por dentro (16 na janela pequena).
// Rolagem sem lag: vidro denso fixo (glass-panel-dense + contorno glass-edge), sem desfoque ao vivo e sem sombra.
component MoreCard inherits Rectangle {
    in property <string> title;
    in property <bool> small;
    border-radius: Ui.radius-card;
    background: Ui.glass-panel-dense;
    border-width: 1px;
    border-color: Ui.glass-edge;
    VerticalLayout {
        padding: small ? Ui.space-16 : Ui.space-24;
        padding-bottom: small ? Ui.space-16 : Ui.space-20;
        spacing: Ui.space-12;
        if title != "": CardTitle { text: title; }
        @children
    }
}

// DestaqueFases › fase 2: o que o Tako sabe do jogo além da primeira tela.
// Duas colunas (58% e 42%, 20 entre elas; uma coluna abaixo de 820 ou na janela pequena).
// Sem repetir a fase 1: Sobre e Sessões saem da fase 2. O Trailer fica no topo da coluna larga.
// Rolagem sem lag: cartões em vidro denso fixo sem desfoque ao vivo e sem sombra; 40 px de esmaecido embaixo.
component GameMore inherits Rectangle {
    in property <DeskMore> more;
    in property <bool> trailer;
    in property <image> art;
    in property <bool> small;
    in property <length> offset;
    out property <length> scroll-max: max(0px, content-h - view.height);
    callback clicked(string, int);
    property <bool> one-col: small || root.width < 820px;
    property <length> gap: small ? Ui.space-16 : Ui.space-20;
    property <length> left-w: one-col ? root.width : (root.width - gap) * 0.58;
    property <length> right-w: one-col ? root.width : root.width - left-w - gap;
    property <length> content-h: one-col
        ? (lc.preferred-height > 0 && rc.preferred-height > 0 ? lc.preferred-height + gap + rc.preferred-height : lc.preferred-height + rc.preferred-height)
        : max(lc.preferred-height, rc.preferred-height);
    property <length> label-w: max(104px, 13 * 7.4px * Ui.text-scale);
    // "⌃ Voltar": volta para a fase 1 (como a roda para cima no topo, Page Up e Esc).
    back := Vidro {
        x: (root.width - self.width) / 2;
        y: 0;
        height: 32px;
        width: bl.preferred-width;
        radius: 16px;
        accessible-role: button;
        accessible-label: more.labels[1];
        if bta.has-hover: Rectangle { border-radius: 16px; background: Ui.glass-hover; }
        bl := HorizontalLayout {
            padding-left: Ui.space-12;
            padding-right: Ui.space-16;
            spacing: 6px;
            DeskIcon { name: "chevron-up"; size: 16px; tint: Ui.on-accent; y: (parent.height - self.height) / 2; }
            Text { text: more.labels[1]; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 600; vertical-alignment: center; }
        }
        bta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked("game-more", 0); }
        }
    }
    view := Rectangle {
        y: back.height + Ui.space-12;
        height: root.height - self.y;
        clip: true;
        Rectangle {
            y: -root.offset;
            height: root.content-h;
            // Coluna larga (58%): Trailer (16:9, raio 12, botão "Assistir trailer") e Requisitos (se houvesse fonte).
            lc := VerticalLayout {
                x: 0;
                y: 0;
                width: root.left-w;
                height: self.preferred-height;
                spacing: root.gap;
                if trailer: MoreCard {
                    title: more.labels[6];
                    small: small;
                    Rectangle {
                        height: (root.left-w - (small ? Ui.space-16 : Ui.space-24) * 2) * 9 / 16;
                        border-radius: 12px;
                        clip: true;
                        background: Ui.glass-control;
                        Image { width: parent.width; height: parent.height; source: root.art; image-fit: cover; }
                        Rectangle { background: @linear-gradient(0deg, Ui.desk-canvas.with-alpha(0.85) 0%, Ui.desk-canvas.with-alpha(0) 55%); }
                        Rectangle { border-radius: 12px; border-width: 1px; border-color: Ui.glass-edge; }
                        GlassButton {
                            x: 14px;
                            y: parent.height - self.height - 14px;
                            height: 40px;
                            show-label: true;
                            icon: "play";
                            label: more.labels[6];
                            clicked => { root.clicked("trailer", 0); }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clicked("trailer", 0); }
                        }
                    }
                }
            }
            // Coluna estreita (42%): Detalhes completos e Imagens (miniaturas de 256 × 144, 192 × 108, raio 8).
            rc := VerticalLayout {
                x: root.one-col ? 0 : root.left-w + root.gap;
                y: root.one-col ? (lc.preferred-height > 0 ? lc.preferred-height + root.gap : 0) : 0;
                width: root.right-w;
                height: self.preferred-height;
                spacing: root.gap;
                if more.details.length > 0: MoreCard {
                    title: more.labels[3];
                    small: small;
                    VerticalLayout {
                        spacing: 0;
                        for r[i] in more.details: MoreRow { info: r; first: i == 0; label-w: root.label-w; }
                    }
                }
                if more.shots.length > 0: MoreCard {
                    title: more.labels[5];
                    small: small;
                    HorizontalLayout {
                        spacing: Ui.space-12;
                        alignment: start;
                        for shot in more.shots: Rectangle {
                            width: small ? 192px : 256px;
                            height: self.width * 9 / 16;
                            border-radius: 8px;
                            clip: true;
                            background: Ui.glass-control;
                            Image { width: parent.width; height: parent.height; source: shot; image-fit: cover; }
                            Rectangle { border-radius: 8px; border-width: 1px; border-color: Ui.glass-edge; }
                        }
                    }
                }
            }
        }
        // 40 px de esmaecido embaixo mostram que a rolagem continua.
        if root.scroll-max > 0 && root.offset < root.scroll-max - 4px: Rectangle {
            y: parent.height - 40px;
            height: 40px;
            width: parent.width;
            background: @linear-gradient(180deg, transparent 0%, Ui.desk-canvas.with-alpha(0.85) 100%);
        }
    }
}

// DestaqueFases: o destaque em duas fases. Um gesto da roda (ou do trackpad) para baixo troca para a fase 2 inteira;
// para cima no topo dela, volta. Uma troca por gesto: a roda fica travada até o gesto parar (300 sem eventos, 500 no
// mínimo). A fase nova entra 24 de baixo/cima em `tempo-fase` (`curva-entrada`); a atual apaga em `tempo-fase-sai`.
// Quem decide a fase é o Tako (`more.on`): Page Down/Up, Esc e a troca de jogo também passam por ele.
component GamePhases inherits Rectangle {
    in property <DeskMore> more;
    in property <bool> trailer;
    in property <image> art;
    in property <bool> small;
    callback clicked(string, int);
    property <bool> on: more.on;
    // A fase 2 guarda o último conteúdo enquanto apaga (o Tako para de mandar a captura ao voltar).
    property <DeskMore> shown;
    init => {
        if (more.on) {
            shown = more;
        }
    }
    changed more => {
        if (more.on) {
            shown = more;
        }
    }
    // Trava da roda: `busy` depois de trocar de fase; `scrolled` depois de rolar a fase 2 (não troca no mesmo gesto).
    property <bool> busy;
    property <bool> scrolled;
    property <int> ticks;
    property <int> quiet;
    property <length> offset;
    changed on => {
        offset = 0;
        busy = true;
        ticks = 0;
        quiet = 0;
    }
    Timer {
        interval: 100ms;
        running: root.busy || root.scrolled;
        triggered => {
            root.ticks += 1;
            root.quiet += 1;
            if (root.quiet >= 3 && (!root.busy || root.ticks >= 5)) {
                root.busy = false;
                root.scrolled = false;
            }
        }
    }
    // Embaixo de tudo: os botões não tratam a roda e ela chega aqui; a lista de jogos fica fora deste retângulo.
    TouchArea {
        scroll-event(e) => {
            if (abs(e.delta-y) <= abs(e.delta-x) || abs(e.delta-y) < 2px) {
                return reject;
            }
            root.quiet = 0;
            if (root.busy) {
                return accept;
            }
            if (!root.on) {
                if (e.delta-y < 0) {
                    root.busy = true;
                    root.ticks = 0;
                    root.clicked("game-more", 1);
                }
                return accept;
            }
            if ((e.delta-y < 0 && root.offset < more2.scroll-max) || (e.delta-y > 0 && root.offset > 0)) {
                if (!root.scrolled) {
                    root.ticks = 0;
                }
                root.scrolled = true;
                root.offset = max(0px, min(more2.scroll-max, root.offset - e.delta-y));
                return accept;
            }
            if (e.delta-y > 0 && !root.scrolled) {
                root.busy = true;
                root.ticks = 0;
                root.clicked("game-more", 0);
            }
            accept
        }
    }
    Rectangle {
        y: on ? -24px : 0;
        animate y { duration: Ui.tempo-fase; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        opacity: on ? 0 : 1;
        animate opacity { duration: Ui.phase-fade(!on); easing: !on ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
        visible: self.opacity > 0.01;
        @children
        // "Mais sobre o jogo ⌄": no respiro embaixo do destaque, no centro; abre a fase 2. Na janela pequena o
        // respiro não cabe a dica: lá a fase 2 abre pela roda e pelo Page Down.
        if !small: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height + 2px;
            height: 24px;
            width: hl.preferred-width;
            border-radius: self.height / 2;
            background: hta.has-hover ? Ui.glass-hover : transparent;
            accessible-role: button;
            accessible-label: more.labels[0];
            hl := HorizontalLayout {
                padding-left: Ui.space-12;
                padding-right: Ui.space-8;
                spacing: 4px;
                Text { text: more.labels[0]; color: Ui.desk-on-muted; font-size: Ui.desk-overline; font-weight: 600; vertical-alignment: center; }
                DeskIcon { name: "chevron-down"; size: 14px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
            }
            hta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clicked("game-more", 1); }
            }
        }
    }
    more2 := GameMore {
        y: on ? 0 : 24px;
        animate y { duration: Ui.tempo-fase; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        opacity: on ? 1 : 0;
        animate opacity { duration: Ui.phase-fade(on); easing: on ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
        visible: self.opacity > 0.01;
        more: shown;
        trailer: trailer;
        art: root.art;
        small: small;
        offset: root.offset;
        clicked(z, i) => { root.clicked(z, i); }
    }
}

// Ícones da linha de contagem: inverter a ordem e filtrar; filtros ativos só acendem o ícone.
component SortFilter inherits HorizontalLayout {
    in property <bool> reversed;
    in property <int> filter-count;
    in property <[string]> labels;
    callback clicked(string);
    spacing: 2px;
    IconBtn { icon: "sort"; label: labels[3]; on: reversed; clicked => { root.clicked("reverse"); } }
    IconBtn {
        icon: "filter";
        label: labels[4];
        on: filter-count > 0;
        clicked => { root.clicked("filter"); }
    }
}

// Biblioteca (TelaBiblioteca). Lista: o painel de vidro da lista à esquerda e o destaque à direita. Grade e
// Categorias: os controles em blocos de vidro soltos no topo e as capas na largura toda. A busca fica na barra.
component DeskLibrary inherits Rectangle {
    in property <string> search;
    in property <string> search-hint;
    in property <string> search-key;
    in property <string> search-esc;
    in property <int> search-focus;
    callback edited(string);

    in property <[string]> tabs;
    in property <int> tab;
    in property <[DeskNav]> collections;
    in property <DeskNav> collection;
    in property <int> filter-count;
    in property <[[PanelRow]]> filter-chips;
    in property <string> clear-label;
    in property <string> count;
    // Janela pequena: só a contagem, sem o nome da ordenação (os quatro ícones ocupam o resto da linha).
    in property <string> count-short;
    in property <[DeskGame]> games;
    in property <int> selected;
    // Grade: os trechos (instalados, divisória, lojas), o tamanho total e onde está o foco.
    in property <[DeskBlock]> blocks;
    in property <[int]> grid-extent;
    in property <[int]> grid-focus;
    in property <string> focus-id;
    in property <int> focus-group: -1;
    in property <DeskGameView> game;
    // DestaqueFases: a fase 2 do destaque (e se ela está aberta).
    in property <DeskMore> more;
    in property <[PanelRow]> actions;
    in property <[DeskInfo]> stats;
    in property <[DeskInfo]> details;
    in property <string> sessions-summary;
    in property <[DeskInfo]> sessions;
    in property <[string]> card-labels;
    in property <string> about-label;
    in property <string> details-label;
    in property <string> more-install-label;
    in property <string> zone;
    in property <int> zone-index;
    in property <bool> focus-visible;
    in property <string> empty-title;
    in property <string> empty-text;
    in property <string> empty-action;
    in property <string> empty-zone;
    in property <bool> small;
    in property <bool> selecting;
    in property <bool> reversed;
    // O modo pedido; `view` é o que está na tela (o anterior fica até sair).
    in property <string> view-in: "list";
    property <string> view: "list";
    in property <string> group-label;
    in property <string> group-prefix;
    in property <[PanelRow]> bulk;
    in property <bool> loading;
    in property <string> loading-label;
    // Lista, Grade, Categorias, Inverter ordem, Filtrar e ordenar, Modo de exibição (dicas e rótulos acessíveis).
    in property <[string]> view-labels;
    in property <[DeskCategory]> categories;
    in property <int> cat-focus-row;
    in property <int> cat-focus-col;
    in property <string> see-all;
    in property <string> cat-empty;
    in property <string> cat-empty-text;
    in property <string> cat-empty-action;
    // Colunas da grade: capas de 172 com 22 entre elas, no mínimo 4.
    out property <int> columns: max(4, floor((self.width + 22px) / (170px + 22px)));
    callback clicked(string, int);
    callback scrolled(int);
    callback menu(length, length);
    callback focus-main();
    // BarraLateralUnida: a lista vira uma coluna colada na borda esquerda, de baixo da barra até o rodapé, com `col-w`
    // de largura (Normal 380, Estreita 336, contada da borda da janela). `narrow` vale para os dois layouts.
    in property <bool> unified;
    in property <bool> narrow;
    in property <length> col-w: 380px;
    // As margens da janela ao redor desta área (as mesmas do padding do Desktop).
    property <length> pad-x: small ? Ui.space-20 : Ui.space-36;
    property <length> gap: small ? Ui.space-20 : Ui.space-28;
    property <length> pad-b: small ? Ui.space-16 : Ui.space-28;
    property <length> list-w: narrow || root.width < 1100px - 2 * Ui.space-36 ? Ui.list-width-narrow : Ui.list-width;
    out property <bool> wide: view != "list";
    property <bool> docked: unified && !wide;
    // Entrada do app: o painel da lista (ou os controles da grade) e depois as capas.
    property <float> intro-list: DeskIntro.on ? 1 : 0;
    animate intro-list { duration: Ui.page-time; delay: Ui.intro-delay(2); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <float> intro-covers: DeskIntro.on ? 1 : 0;
    animate intro-covers { duration: Ui.page-time; delay: Ui.intro-delay(3); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    // Troca de modo (TrocaDeModo): o modo atual sai em 120 (`curva-saida`) e o novo entra em 140 (`curva-entrada`).
    // Troca de aba (TrocaDeTela › abas internas): a pílula desliza e a lista troca só por opacidade, 80 e 120.
    property <bool> mode-in: true;
    property <bool> list-in: true;
    init => { view = view-in; }
    changed view-in => {
        mode-in = false;
        mode-timer.running = true;
    }
    mode-timer := Timer {
        interval: max(1ms, Ui.tempo-texto-sai);
        running: false;
        triggered => {
            self.running = false;
            view = view-in;
            mode-in = true;
            root.focus-main();
        }
    }
    changed tab => {
        list-in = false;
        list-timer.running = true;
    }
    list-timer := Timer {
        interval: max(1ms, Ui.focus-time / 2);
        running: false;
        triggered => {
            self.running = false;
            list-in = true;
        }
    }

    if !wide: HorizontalLayout {
        opacity: mode-in ? 1 : 0;
        animate opacity { duration: Ui.mode-fade(mode-in); easing: mode-in ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
        spacing: gap;
        // Unida: o conteúdo começa 28 depois da coluna, que sai da área e vai até as bordas da janela.
        Rectangle {
            width: docked ? col-w + Ui.space-28 - pad-x - gap : list-w;
          Vidro {
            bare: docked;
            edge: !docked;
            x: docked ? -pad-x - root.x : 0;
            y: (docked ? -Ui.space-20 : 0) + (1 - intro-list) * Ui.intro-rise;
            width: docked ? col-w : parent.width;
            height: docked ? root.height + Ui.space-20 + pad-b : parent.height;
            opacity: intro-list;
            VerticalLayout {
                padding-top: docked ? Ui.space-28 : Ui.space-16;
                padding-left: docked ? Ui.space-20 : Ui.space-12;
                padding-right: docked ? 18px : Ui.space-12;
                padding-bottom: docked ? Ui.space-16 : Ui.space-12;
                spacing: docked ? 12px : 6px;
                Tabs {
                    tabs: tabs;
                    current: tab;
                    focus-index: focus-visible && zone == "tabs" ? zone-index : -1;
                    clicked(i) => { root.clicked("tab", i); }
                }
                SearchBox {
                    height: 40px;
                    text: search;
                    hint: search-hint;
                    key-label: search-key;
                    esc-label: search-esc;
                    focus-request: root.wide ? 0 : search-focus;
                    edited(t) => { root.edited(t); }
                    leave => { root.clicked("search-leave", 0); root.focus-main(); }
                }
                if tab == 2 && collections.length > 0: CollectionSelect {
                    current: collection;
                    focused: focus-visible && zone == "collections";
                    clicked => { root.clicked("collection-select", 0); }
                    menu(x, y) => { root.menu(x, y); }
                }
                HorizontalLayout {
                    height: 36px;
                    padding-left: 9px;
                    padding-right: 8px;
                    spacing: 2px;
                    Text {
                        text: loading ? loading-label : (small ? count-short : count);
                        color: selecting ? Ui.on-accent : Ui.desk-on-subtle;
                        font-size: Ui.desk-label-sm;
                        font-weight: selecting ? 700 : 500;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    IconBtn {
                        y: (parent.height - self.height) / 2;
                        icon: "plus";
                        label: view-labels[6];
                        clicked => { root.clicked("add-game", 0); }
                    }
                    IconBtn {
                        y: (parent.height - self.height) / 2;
                        icon: "grid";
                        label: view-labels[5];
                        clicked => {
                            root.menu(self.absolute-position.x, self.absolute-position.y + self.height + 6px);
                            root.clicked("view-menu", 0);
                        }
                    }
                    SortFilter {
                        y: (parent.height - self.height) / 2;
                        reversed: reversed;
                        filter-count: filter-count;
                        labels: view-labels;
                        clicked(z) => { root.clicked(z, 0); }
                    }
                }
                if filter-chips.length > 0: HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        for row[r] in filter-chips: HorizontalLayout {
                            height: 28px;
                            spacing: 6px;
                            alignment: start;
                            for chip[i] in row: Rectangle {
                                width: chip-layout.preferred-width;
                                height: 28px;
                                border-radius: 14px;
                                background: Ui.glass-control;
                                border-width: 1px;
                                border-color: Ui.glass-edge-strong;
                                chip-layout := HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 2px;
                                    spacing: 2px;
                                    Text {
                                        text: chip.title;
                                        color: Ui.on-accent;
                                        font-size: 12px * Ui.text-scale;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        y: 2px;
                                        border-radius: 12px;
                                        background: remove-ta.has-hover ? Ui.glass-hover : transparent;
                                        accessible-role: button;
                                        accessible-label: chip.description;
                                        accessible-action-default => { root.clicked("remove-filter", r * 2 + i); }
                                        DeskIcon { name: "close"; size: 12px; tint: Ui.desk-on-muted; }
                                        remove-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.clicked("remove-filter", r * 2 + i); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if filter-count > 1: Rectangle {
                        width: clear-text.preferred-width + 8px;
                        accessible-role: button;
                        accessible-label: clear-label;
                        accessible-action-default => { root.clicked("clear-filters", 0); }
                        clear-text := Text {
                            height: 28px;
                            text: clear-label;
                            font-size: 12px * Ui.text-scale;
                            font-weight: 600;
                            color: Ui.on-accent;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clicked("clear-filters", 0); }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    if loading: VerticalLayout {
                        alignment: start;
                        spacing: 6px;
                        for i in 8: HorizontalLayout {
                            height: Ui.game-row-height;
                            padding-left: Ui.space-8;
                            spacing: 14px;
                            Skeleton { width: Ui.thumb-size; height: Ui.thumb-size; y: 2px; }
                            Skeleton { width: 110px + mod(i * 37, 80) * 1px; height: 14px; y: 15px; radius: 7px; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    if !loading && games.length == 0: EmptyList {
                        title: empty-title;
                        text: empty-text;
                        action: empty-action;
                        clicked => { root.clicked(empty-zone, 0); }
                    }
                    if !loading && games.length > 0: GameList {
                        opacity: list-in ? 1 : 0;
                        animate opacity { duration: Ui.list-fade(list-in); easing: list-in ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
                        height: parent.height - (selecting ? 60px : 0);
                        bar-out: docked ? 18px : Ui.space-12;
                        compact: small;
                        games: games;
                        selected: selected;
                        selecting: selecting;
                        key-focus: focus-visible && zone == "list";
                        clicked(z, i) => {
                            root.focus-main();
                            root.clicked(z, i);
                        }
                        menu(x, y) => { root.menu(x, y); }
                        scrolled(f) => { root.scrolled(f); }
                    }
                    if selecting: BulkBar {
                        x: 0;
                        y: parent.height - self.height;
                        width: parent.width;
                        actions: bulk;
                        clicked(i) => {
                            root.menu(self.absolute-position.x + self.width - 260px, self.absolute-position.y - 120px);
                            root.clicked("bulk", i);
                        }
                    }
                }
            }
          }
        }
        if !game.has-game && !loading: Rectangle { horizontal-stretch: 1; }
        // Espera (BRAND-001): o polvo no alto da área livre do destaque, fora do layout, sem tirar largura do texto.
        if !game.has-game && loading: Rectangle {
            horizontal-stretch: 1;
            LoadingStage { x: 0; y: 0; width: parent.width; height: parent.height; small: small; }
            Octopus { x: 0; y: 0; width: 90px; height: 69px; with-name: false; self-assemble: true; accessible-role: none; }
        }
        if game.has-game: phases := GamePhases {
            horizontal-stretch: 1;
            more: more;
            trailer: game.trailer;
            art: game.art;
            small: small;
            clicked(z, i) => { root.clicked(z, i); }
          GameStage {
            width: phases.width;
            height: phases.height;
            game-in: game;
            actions: actions;
            stats: stats;
            details: details;
            sessions-summary: sessions-summary;
            sessions: sessions;
            card-labels: card-labels;
            about-label: about-label;
            details-label: details-label;
            more-install-label: more-install-label;
            zone: zone;
            zone-index: zone-index;
            focus-visible: focus-visible;
            small: small;
            clicked(z, i) => { root.clicked(z, i); }
            menu(x, y) => { root.menu(x, y); }
          }
        }
    }

    // Loja do jogo escolhido, no canto superior direito do destaque.
    if !wide && !small && !more.on && game.has-game: HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        alignment: end;
        opacity: mode-in ? 1 : 0;
        animate opacity { duration: Ui.mode-fade(mode-in); easing: mode-in ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
        spacing: 8px;
        PlayStatusSelect {
            status: game.play-status;
            label: game.play-status-label;
            clicked(x, y) => { root.menu(x, y); root.clicked("status", 0); }
        }
        if game.store-name != "": StorePill { icon: game.store-icon; text: game.store-name; }
    }

    if wide: VerticalLayout {
        opacity: mode-in ? 1 : 0;
        animate opacity { duration: Ui.mode-fade(mode-in); easing: mode-in ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
        spacing: Ui.space-20;
        HorizontalLayout {
            opacity: intro-list;
            height: 46px;
            spacing: Ui.space-12;
            Vidro {
                width: small ? 240px : 330px;
                Tabs {
                    x: 3px;
                    y: 3px;
                    width: parent.width - 6px;
                    tabs: tabs;
                    current: tab;
                    focus-index: focus-visible && zone == "tabs" ? zone-index : -1;
                    clicked(i) => { root.clicked("tab", i); }
                }
            }
            if view == "grid": Text {
                width: small ? 64px : self.preferred-width;
                text: small ? count-short : count;
                color: selecting ? Ui.on-accent : Ui.desk-on-muted;
                font-size: Ui.desk-label;
                font-weight: selecting ? 700 : 500;
                vertical-alignment: center;
                overflow: elide;
            }
            if view == "categories": Vidro {
                width: small ? 56px : gl.preferred-width;
                radius: 23px;
                accessible-role: button;
                accessible-label: group-label;
                gl := HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    spacing: 6px;
                    if !small: Text { text: group-prefix; color: Ui.desk-on-muted; font-size: 14px * Ui.text-scale; font-weight: 500; vertical-alignment: center; }
                    if !small: Text { text: group-label; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 700; vertical-alignment: center; }
                    DeskIcon { name: "updown"; size: 16px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.menu(parent.absolute-position.x, parent.absolute-position.y + parent.height + 6px);
                        root.clicked("group-by", 0);
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Vidro {
                width: sf.preferred-width + 16px;
                sf := SortFilter {
                    x: 8px;
                    y: 8px;
                    reversed: reversed;
                    filter-count: filter-count;
                    labels: view-labels;
                    clicked(z) => { root.clicked(z, 0); }
                }
            }
            // Modo de exibição: três ícones, o escolhido na segunda camada de vidro.
            Vidro {
                width: 3 * 38px + 2 * 2px + 10px;
                HorizontalLayout {
                    padding: 5px;
                    spacing: 2px;
                    for v[i] in ["list", "grid", "categories"]: Rectangle {
                        width: 38px;
                        border-radius: 10px;
                        background: v != view && vta.has-hover ? Ui.glass-hover : transparent;
                        accessible-role: button;
                        accessible-label: view-labels[i];
                        if v == view: Selected { radius: 10px; }
                        DeskIcon { name: i == 0 ? "list" : (i == 1 ? "grid" : "layers"); size: 18px; tint: v == view ? Ui.on-accent : Ui.desk-on-muted; }
                        vta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clicked("view", i); }
                        }
                    }
                }
            }
        }
        if tab == 2 && collections.length > 0: CollectionSelect {
            width: 280px;
            height: 40px;
            current: collection;
            focused: focus-visible && zone == "collections";
            clicked => { root.clicked("collection-select", 0); }
            menu(x, y) => { root.menu(x, y); }
        }
        Rectangle {
            opacity: intro-covers;
            vertical-stretch: 1;
            if games.length == 0 && view == "grid": EmptyList {
                title: empty-title;
                text: empty-text;
                action: empty-action;
                clicked => { root.clicked(empty-zone, 0); }
            }
            grid := CoverGrid {
                opacity: list-in ? 1 : 0;
                animate opacity { duration: Ui.list-fade(list-in); easing: list-in ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
                visible: view == "grid";
                columns: root.columns;
                blocks: view == "grid" ? blocks : [];
                extent: grid-extent;
                focus-at: grid-focus;
                focus-id: focus-id;
                focus-group: focus-group;
                key-focus: focus-visible && zone == "list";
                clicked(z, i) => {
                    root.focus-main();
                    root.clicked(z, i);
                }
                menu(x, y) => { root.menu(x, y); }
                scrolled(f) => { root.scrolled(f); }
            }
            if view == "categories" && categories.length == 0: EmptyList {
                title: cat-empty;
                text: cat-empty-text;
                action: cat-empty-action;
                clicked => { root.clicked("group-store", 0); }
            }
            if view == "categories": CategoryRows {
                opacity: list-in ? 1 : 0;
                animate opacity { duration: Ui.list-fade(list-in); easing: list-in ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
                rows: categories;
                see-all: see-all;
                key-focus: focus-visible && zone == "list";
                focus-row: cat-focus-row;
                focus-col: cat-focus-col;
                clicked(z, i) => {
                    root.focus-main();
                    root.clicked(z, i);
                }
                menu(x, y) => { root.menu(x, y); }
                scrolled(f) => { root.scrolled(f); }
            }
            if selecting && view == "grid": BulkBar {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 8px;
                width: 420px;
                actions: bulk;
                clicked(i) => {
                    root.menu(self.absolute-position.x + self.width - 260px, self.absolute-position.y - 120px);
                    root.clicked("bulk", i);
                }
            }
        }
    }
    SearchBox {
        visible: wide;
        x: (parent.width - self.width) / 2;
        y: 1px;
        width: small ? 280px : 420px;
        text: search;
        hint: search-hint;
        key-label: search-key;
        esc-label: search-esc;
        focus-request: root.wide ? search-focus : 0;
        edited(t) => { root.edited(t); }
        leave => { root.clicked("search-leave", 0); root.focus-main(); }
    }
}

// Chave liga/desliga do desktop (50 × 30, verde ligada).
component DeskToggle inherits Rectangle {
    in property <bool> on;
    width: 50px;
    height: 30px;
    border-radius: 15px;
    background: on ? Ui.success : Ui.glass-pressed;
    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    Rectangle {
        y: 3px;
        x: on ? parent.width - self.width - 3px : 3px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: Ui.primary-top;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 3px;
        drop-shadow-color: Ui.shadow-float-color;
        animate x { duration: Ui.focus-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
}

// Alto-falante do ControleDeslizante: botão de 28 com ícone de 18.
component SliderSpeaker inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: sta.has-hover ? (DeskArt.gray ? Ui.settings-control-hover : Ui.glass-hover) : transparent;
    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    DeskIcon { name: icon; size: 18px; tint: Ui.desk-on-muted; }
    sta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ControleDeslizante (valor contínuo, 0–100): alto-falante que silencia e volta · trilha de 180 com a bolinha ·
// alto-falante que vai a 100% · valor escrito. Arrasta-se; clicar na trilha pula para o ponto e já arrasta; a roda
// muda 5%. `value` vem do Tako ("70" ou o texto de mudo); ← → (Shift), Home/End e Page Up/Down também são dele.
component DeskSlider inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <bool> focused;
    // Valor novo e se a pessoa soltou (aí o Tako toca a amostra).
    callback changed(int, bool);
    property <float> level: value.is-float() ? clamp(value.to-float(), 0, 100) : 0;
    property <bool> muted: level <= 0;
    // Volume de antes do mudo, para o alto-falante voltar a ele.
    property <float> before: 70;
    property <float> drag-v;
    property <bool> dragging: tta.pressed;
    property <float> shown: dragging ? drag-v : level;
    width: 28px + 180px + 28px + 40px + 3 * 10px;
    height: 28px;
    HorizontalLayout {
        spacing: 10px;
        SliderSpeaker {
            icon: root.muted ? "speaker-mute" : "speaker";
            label: DeskText.silence;
            clicked => {
                if root.muted {
                    root.changed(round(root.before > 0 ? root.before : 50), true);
                } else {
                    root.before = root.level;
                    root.changed(0, true);
                }
            }
        }
        track := Rectangle {
            width: 180px;
            accessible-role: slider;
            accessible-label: root.label;
            accessible-value: root.muted ? root.value : round(root.level) + "%";
            accessible-value-minimum: 0;
            accessible-value-maximum: 100;
            accessible-value-step: 5;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 6px;
                border-radius: 3px;
                background: DeskArt.gray ? Ui.settings-control : Ui.glass-pressed;
                Rectangle {
                    x: 0;
                    width: parent.width * root.shown / 100;
                    border-radius: 3px;
                    background: root.muted ? Ui.on-accent-subtle : Ui.on-accent;
                }
            }
            if root.focused: Rectangle {
                x: knob.x - 4px;
                y: knob.y - 4px;
                width: knob.width + 8px;
                height: knob.height + 8px;
                border-radius: self.height / 2;
                background: Ui.focus-glow;
                border-width: 2px;
                border-color: Ui.focus-ring;
            }
            knob := Rectangle {
                property <length> s: tta.has-hover || root.dragging ? 18px * 1.12 : 18px;
                width: s;
                height: s;
                x: parent.width * root.shown / 100 - self.width / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: Ui.primary-top;
                drop-shadow-color: #00000059;
                drop-shadow-offset-y: 1px;
                drop-shadow-blur: 4px;
                animate width, height { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
            }
            // Arrastando: o valor numa dica acima da bolinha.
            if root.dragging: Rectangle {
                width: tipv.preferred-width + 16px;
                height: 24px;
                x: knob.x + knob.width / 2 - self.width / 2;
                y: knob.y - self.height - 6px;
                border-radius: 6px;
                background: Ui.settings-surface;
                border-width: 1px;
                border-color: Ui.glass-edge-strong;
                tipv := Text { text: round(root.drag-v) + "%"; color: Ui.on-accent; font-size: 12px; font-weight: 600; }
            }
            tta := TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                        root.drag-v = clamp(self.mouse-x / self.width * 100, 0, 100);
                        root.changed(round(root.drag-v), false);
                    } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                        root.changed(round(root.drag-v), true);
                    }
                }
                moved => {
                    if self.pressed {
                        root.drag-v = clamp(self.mouse-x / self.width * 100, 0, 100);
                        root.changed(round(root.drag-v), false);
                    }
                }
                scroll-event(e) => {
                    if e.delta-y > 0 {
                        root.changed(min(100, round(root.level) + 5), true);
                    } else if e.delta-y < 0 {
                        root.changed(max(0, round(root.level) - 5), true);
                    }
                    accept
                }
            }
        }
        SliderSpeaker {
            icon: "volume";
            label: DeskText.max;
            clicked => { root.changed(100, true); }
        }
        Text {
            width: 40px;
            text: root.muted ? root.value : round(root.level) + "%";
            color: Ui.on-accent;
            font-size: 13px * Ui.text-scale;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Logo do emulador (LojaEncontrada, variante emulador): o oficial de cada projeto em 24, sem fundo; os que o tema
// não tem viram as iniciais num selo de vidro.
component EmuLogo inherits Rectangle {
    in property <string> name;
    in property <length> size: 24px;
    width: size;
    height: size;
    property <bool> has-logo: name == "emu-retroarch" || name == "emu-dolphin" || name == "emu-pcsx2" || name == "emu-duckstation" || name == "emu-ppsspp" || name == "emu-ryujinx" || name == "emu-cemu" || name == "emu-rpcs3";
    if name == "emu-retroarch": Image { width: size; height: size; source: @image-url("emulators/retroarch.png"); image-fit: contain; }
    if name == "emu-dolphin": Image { width: size; height: size; source: @image-url("emulators/dolphin.png"); image-fit: contain; }
    if name == "emu-pcsx2": Image { width: size; height: size; source: @image-url("emulators/pcsx2.png"); image-fit: contain; }
    if name == "emu-duckstation": Image { width: size; height: size; source: @image-url("emulators/duckstation.png"); image-fit: contain; }
    if name == "emu-ppsspp": Image { width: size; height: size; source: @image-url("emulators/ppsspp.png"); image-fit: contain; }
    if name == "emu-ryujinx": Image { width: size; height: size; source: @image-url("emulators/ryujinx.png"); image-fit: contain; }
    if name == "emu-cemu": Image { width: size; height: size; source: @image-url("emulators/cemu.png"); image-fit: contain; }
    if name == "emu-rpcs3": Image { width: size; height: size; source: @image-url("emulators/rpcs3.png"); image-fit: contain; }
    if !has-logo: Rectangle {
        border-radius: 7px;
        background: Ui.glass-control;
        border-width: 1px;
        border-color: Ui.glass-edge;
        Text {
            text: name == "emu-ppsspp" ? "PSP" : name == "emu-ryujinx" ? "RY" : name == "emu-cemu" ? "CE" : name == "emu-rpcs3" ? "RP" : "";
            color: Ui.on-accent;
            font-size: 11px;
            font-weight: 700;
        }
    }
}

// Linha de configuração, painel ou diálogo (dk-row): linhas seguidas formam UM grupo com divisórias, nunca caixas
// soltas. `first`/`last` arredondam as pontas do grupo; cabeçalhos de grupo em `overline`.
component DeskRow inherits Rectangle {
    in property <PanelRow> data;
    in property <bool> focused;
    in property <bool> first: true;
    in property <bool> last: true;
    // PainelLateral (filtros): liga/desliga como caixa de marcar. Toda escolha de uma opção entre várias é um select
    // (CampoDeSelecao): a pílula com ⌃⌄; o Tako abre a lista junto dela.
    in property <bool> side-panel;
    property <bool> as-check: side-panel && data.kind == "toggle";
    // Opção solta num diálogo ("Não perguntar de novo"): linha sem caixa.
    in property <bool> loose;
    // Lista do onboarding (LojaEncontrada): linhas sem caixa, separadas por divisórias.
    in property <bool> bare;
    // FilaDeCapas: a linha da fila (capa atual, proposta, confiança e as ações dentro dela).
    in property <CoverRow> cv;
    property <bool> is-cover: data.kind == "cover";
    // Pasta de ROMs do onboarding: caixa própria, 18 abaixo da lista.
    property <bool> card: bare && data.style == "card";
    property <length> card-gap: card ? 18px : 0;
    property <bool> emu: data.icon == "emu-retroarch" || data.icon == "emu-dolphin" || data.icon == "emu-pcsx2" || data.icon == "emu-duckstation" || data.icon == "emu-ppsspp" || data.icon == "emu-ryujinx" || data.icon == "emu-cemu" || data.icon == "emu-rpcs3";
    // A linha da fila cresce com o motivo (texto essencial: quebra em vez de cortar). Onboarding (`bare`): linhas de
    // 12 em cima e embaixo, sem a altura mínima das Configurações.
    out property <length> row-h: is-header ? 40px : (is-cover ? max(120px, covl.preferred-height) : max(loose ? Ui.control-height : bare ? 46px : Ui.settings-row-height, lay.preferred-height) + card-gap);
    callback clicked();
    // Ação dentro da linha: 0 = Aceitar, 1 = Escolher outra.
    callback act(int);
    // ControleDeslizante: valor novo e se soltou.
    callback slide(int, bool);
    // Canto inferior direito da pílula do select, para a lista nascer embaixo dela, alinhada à direita.
    callback anchor(length, length);
    property <bool> is-header: data.kind == "header";
    property <color> group-bg: DeskArt.gray ? Ui.settings-surface : Ui.glass-control;
    // Grupos das Configurações usam o raio dos cartões; nos painéis de vidro, o dos controles.
    property <length> group-r: DeskArt.gray ? Ui.radius-card : Ui.radius-control;
    property <color> fg: data.style == "danger" ? Ui.error : Ui.on-accent;
    height: row-h;
    opacity: data.enabled || is-header ? 1 : 0.45;
    if card: Rectangle {
        y: root.card-gap;
        height: parent.height - root.card-gap;
        border-radius: Ui.radius-row;
        background: ta.has-hover ? Ui.glass-hover.mix(Ui.glass-solid, 0.5) : Ui.glass-solid;
        border-width: 1px;
        border-color: Ui.glass-edge;
    }
    if !is-header && bare && !card: Rectangle {
        background: ta.has-hover && data.enabled ? Ui.glass-hover : transparent;
        Rectangle { y: 0; height: 1px; background: Ui.divider; }
        if last: Rectangle { y: parent.height - 1px; height: 1px; background: Ui.divider; }
    }
    if !is-header && !loose && !bare: Rectangle {
        border-top-left-radius: first ? group-r : 0;
        border-top-right-radius: first ? group-r : 0;
        border-bottom-left-radius: last ? group-r : 0;
        border-bottom-right-radius: last ? group-r : 0;
        background: ta.has-hover && data.enabled ? (DeskArt.gray ? Ui.settings-control-hover.mix(Ui.settings-surface, 0.5) : Ui.glass-hover.mix(Ui.glass-control, 0.5)) : group-bg;
        animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        // Divisória entre linhas do mesmo grupo, recuada 18 da esquerda.
        if !first: Rectangle { x: 18px; y: 0; width: parent.width - 18px; height: 1px; background: DeskArt.gray ? Ui.settings-separator : Ui.divider; }
    }
    if focused && !is-header: FocusRing { radius: Ui.radius-control; }
    if is-header: Text {
        x: 4px;
        y: parent.height - self.height - 8px;
        text: data.title.to-uppercase();
        color: Ui.desk-on-subtle;
        font-size: Ui.desk-overline;
        font-weight: 700;
        letter-spacing: 0.1 * self.font-size;
    }
    ta := TouchArea {
        enabled: !is-header && !is-cover;
        mouse-cursor: data.enabled ? pointer : default;
        clicked => {
            if (data.kind == "choice") {
                DeskArt.anchor-w = 0;
                root.anchor(root.absolute-position.x + root.width - 14px, root.absolute-position.y + (root.height + (DeskArt.gray ? 36px : 32px)) / 2 + 6px);
            }
            root.clicked();
        }
    }
    // Sem `if`: o `row-h` precisa ler a altura dela (elemento dentro de `if` não é visível de fora).
    covl := HorizontalLayout {
        visible: is-cover;
        padding-left: 18px;
        padding-right: 14px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 16px;
        // Nome e de onde veio (loja ou "Instalado à mão").
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 0;
            preferred-width: 170px;
            min-width: 70px;
            max-width: 170px;
            Text { text: data.title; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 500; wrap: word-wrap; }
            Text { text: data.description; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; overflow: elide; }
        }
        // Capa atual, ou "Sem capa" tracejado (o Slint não tem traço; contorno fino).
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 64px;
            height: 64px;
            border-radius: 10px;
            clip: true;
            if cv.has-current: Image { width: parent.width; height: parent.height; source: cv.current; image-fit: cover; vertical-alignment: top; }
            if !cv.has-current: Rectangle {
                border-radius: 10px;
                border-width: 1.5px;
                border-color: DeskArt.gray ? Ui.settings-separator : Ui.glass-edge-strong;
                Text { width: parent.width; height: parent.height; text: cv.current-label; color: Ui.desk-on-muted; font-size: 11px * Ui.text-scale; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
            }
        }
        if cv.has-proposed: Rectangle {
            width: 18px;
            DeskIcon { name: "chevron"; size: 18px; tint: Ui.desk-on-muted; }
        }
        if cv.has-proposed: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 64px;
            height: 64px;
            border-radius: 10px;
            clip: true;
            background: DeskArt.gray ? Ui.settings-control : Ui.glass-control;
            Image { width: parent.width; height: parent.height; source: cv.proposed; image-fit: cover; vertical-alignment: top; }
        }
        // Confiança sempre escrita e com três barrinhas (a cor nunca sozinha); o motivo embaixo.
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;
            min-width: 100px;
            if cv.level > 0: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                HorizontalLayout {
                    spacing: 2px;
                    alignment: end;
                    y: 1px;
                    width: 16px;
                    height: 12px;
                    for h[k] in [5px, 8px, 12px]: Rectangle {
                        width: 4px;
                        height: h;
                        y: 12px - h;
                        border-radius: 1px;
                        background: k < cv.level ? (cv.level == 3 ? Ui.success : (cv.level == 2 ? Ui.warning : Ui.error)) : (DeskArt.gray ? Ui.settings-separator : Ui.glass-edge-strong);
                    }
                }
                Text { text: cv.confidence; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 600; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
            }
            Text { text: cv.reason; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; line-height-factor: 1.07; wrap: word-wrap; }
        }
        // Aceitar (só com proposta) e Escolher outra, uma sobre a outra para a linha caber na janela pequena.
        VerticalLayout {
            alignment: center;
            spacing: 8px;
            horizontal-stretch: 0;
            for label[k] in [cv.accept, cv.other]: Rectangle {
                visible: label != "";
                width: label == "" ? 0 : pl.preferred-width + 28px;
                height: label == "" ? 0 : 36px;
                border-radius: self.height / 2;
                background: pta.has-hover ? Ui.settings-control-hover : Ui.settings-control;
                animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                accessible-role: button;
                accessible-label: label + ": " + data.title;
                pl := Text { x: 14px; text: label; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 600; vertical-alignment: center; height: parent.height; }
                pta := TouchArea { mouse-cursor: pointer; clicked => { root.act(k); } }
            }
        }
    }
    lay := HorizontalLayout {
        visible: !is-header && !is-cover;
        y: root.card-gap;
        height: parent.height - root.card-gap;
        padding-left: card ? 16px : loose || bare ? 4px : 18px;
        padding-right: card ? 16px : 14px;
        padding-top: card ? 14px : DeskArt.gray ? 12px : 10px;
        padding-bottom: card ? 14px : DeskArt.gray ? 12px : 10px;
        spacing: 14px;
        if data.kind == "radio" || data.kind == "check" || as-check: Rectangle {
            width: 20px;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: data.kind == "radio" ? self.height / 2 : 6px;
                border-width: 2px;
                border-color: data.on ? Ui.on-accent : Ui.desk-on-muted;
                background: data.on ? Ui.on-accent : transparent;
                if data.on: Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: data.kind == "radio" ? 4px : 2px;
                    background: Ui.on-primary;
                }
            }
        }
        if data.icon != "": Rectangle {
            width: emu ? 24px : 22px;
            // Logos de loja em SVG (LojaEncontrada); os outros nomes caem no ícone comum; emuladores com o logo.
            if !emu: DeskIcon { name: data.icon; size: 22px; tint: data.style == "danger" ? Ui.error : Ui.desk-on-muted; }
            if emu: EmuLogo { name: data.icon; }
        }
        if data.image.width > 0: Rectangle {
            width: 36px;
            Image { source: data.image; width: 36px; height: 36px; image-fit: contain; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: data.title;
                color: fg;
                font-size: Ui.desk-label;
                font-weight: data.emphasized ? 600 : 500;
                wrap: word-wrap;
            }
            if data.description != "": Text {
                text: data.description;
                color: Ui.desk-on-muted;
                font-size: Ui.desk-label-sm;
                // 13/1,35 das linhas (Plus Jakarta tem 1,26 de natural).
                line-height-factor: 1.07;
                wrap: word-wrap;
            }
        }
        if data.kind == "toggle" && !as-check: DeskToggle { on: data.on; y: (parent.height - self.height) / 2; }
        // Loja encontrada (onboarding): ponto `success` quando a pasta existe.
        if data.kind == "info" && data.on: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            // Halo de 3 a 25% (pf-dot).
            background: Ui.success.with-alpha(0.25);
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Ui.success; }
        }
        // Bateria do controle (28 × 12), sempre com o número; abaixo de 20% em `warning`.
        if data.key == "controller" && data.value != "": battery := Rectangle {
            width: 32px;
            property <float> level: clamp(data.value.to-float() / 100, 0, 1);
            Rectangle {
                width: 28px;
                height: 12px;
                border-radius: 3px;
                border-width: 1.5px;
                border-color: level < 0.2 ? Ui.warning : Ui.desk-on-muted;
                Rectangle {
                    x: 2px;
                    width: (parent.width - 4px) * battery.level;
                    height: parent.height - 4px;
                    border-radius: 1.5px;
                    background: battery.level < 0.2 ? Ui.warning : Ui.on-accent;
                }
            }
            Rectangle { x: 29px; width: 2px; height: 5px; border-radius: 1px; background: Ui.desk-on-muted; }
        }
        if data.kind == "slider": DeskSlider {
            y: (parent.height - self.height) / 2;
            value: data.value;
            label: data.title;
            focused: root.focused;
            changed(v, done) => { root.slide(v, done); }
        }
        // Select (CampoDeSelecao): pílula de 36 (32 no vidro), valor 14/600 e ⌃⌄; de 120 a 280, cortando com "…".
        if data.kind == "choice": Rectangle {
            y: (parent.height - self.height) / 2;
            height: DeskArt.gray ? 36px : 32px;
            width: clamp(ml.preferred-width, 120px, 280px);
            border-radius: self.height / 2;
            background: DeskArt.gray
                ? (ta.has-hover ? Ui.settings-control-hover : Ui.settings-control)
                : (ta.has-hover ? Ui.glass-hover : Ui.glass-control);
            border-width: DeskArt.gray ? 0 : 1px;
            border-color: Ui.glass-edge;
            animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
            accessible-role: combobox;
            accessible-label: data.title + ": " + data.value;
            ml := HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 12px;
                Text { text: data.value; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Rectangle { width: 14px; DeskIcon { name: "updown"; size: 14px; tint: Ui.desk-on-muted; } }
            }
        }
        // Nas Configurações a ação é um botão em pílula com o nome dela ("Trocar", "Procurar").
        if data.kind == "action" && data.value != "" && DeskArt.gray: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 36px;
            width: al.preferred-width + 32px;
            border-radius: self.height / 2;
            background: ta.has-hover ? Ui.settings-control-hover : Ui.settings-control;
            animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
            al := Text { text: data.value; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 600; }
        }
        // Pasta de ROMs: a ação é um link sublinhado ("Trocar").
        if card && data.value != "": Rectangle {
            width: cl.preferred-width;
            cl := Text { text: data.value; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 500; }
            Rectangle { y: (parent.height + cl.preferred-height) / 2; height: 1px; background: Ui.on-accent; }
        }
        if !card && data.value != "" && data.kind != "toggle" && data.kind != "slider" && data.kind != "choice" && !(data.kind == "action" && DeskArt.gray): Text {
            text: data.value;
            color: data.style == "warning" ? Ui.warning : (data.emphasized ? Ui.on-accent : Ui.desk-on-muted);
            // Resumo do onboarding: a quantidade em 15/600.
            font-size: bare ? Ui.desk-label : Ui.desk-label-sm;
            font-weight: data.emphasized ? 600 : 500;
            vertical-alignment: center;
            horizontal-alignment: right;
            max-width: 260px;
            overflow: elide;
        }
        if (data.kind == "action" || data.kind == "button") && !as-check && !card && !(data.kind == "action" && data.value != "" && DeskArt.gray): Text { text: "›"; color: Ui.desk-on-subtle; font-size: 18px; vertical-alignment: center; }
    }
}

// Botão do rodapé de um popup: a principal é a pílula branca (uma só, por último); as outras em vidro; perigo em
// `error` sobre o vidro, nunca na pílula branca.
component PopupButton inherits Rectangle {
    in property <PanelRow> data;
    in property <bool> focused;
    in property <length> custom-height;
    callback clicked();
    // "Continuar" e "Concluir" dos assistentes também são a ação principal aqui.
    property <bool> primary: data.style == "primary" || data.key == "next" || data.key == "done";
    in property <length> min-w;
    height: custom-height > 0 ? custom-height : Ui.control-height;
    width: max(min-w, primary ? 110px : 0, pl.preferred-width);
    border-radius: self.height / 2;
    background: primary
        ? @linear-gradient(180deg, Ui.primary-top 0%, Ui.primary-bottom 100%)
        : (pta.pressed ? Ui.glass-pressed : (pta.has-hover ? Ui.glass-hover : Ui.glass-control));
    border-width: primary ? 0 : 1px;
    border-color: Ui.glass-edge;
    opacity: data.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: data.title;
    if focused: FocusRing { radius: root.height / 2; background: transparent; }
    pl := HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        if data.icon != "": DeskIcon { name: data.icon; size: 18px; tint: primary ? Ui.on-primary : (data.style == "danger" ? Ui.error : Ui.on-accent); y: (parent.height - self.height) / 2; }
        Text {
            text: data.title;
            color: primary ? Ui.on-primary : (data.style == "danger" ? Ui.error : Ui.on-accent);
            font-size: Ui.desk-label;
            font-weight: primary ? 700 : 600;
            vertical-alignment: center;
        }
    }
    pta := TouchArea {
        enabled: data.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Linhas roláveis (roda do mouse) que seguem o foco do teclado, agrupadas: cabeçalhos quebram os grupos. Nos popups e
// painéis (`footer`), as linhas de botão saem daqui e vão para o rodapé.
component RowScroll inherits Rectangle {
    in property <[PanelRow]> rows;
    in property <int> sel;
    in property <bool> key-focus;
    in property <bool> footer;
    // Diálogo sem rodapé (mais de três ações): as ações ficam na ordem do Tako, empilhadas em largura total; um grupo de uma linha só fica solto.
    in property <bool> inline-buttons;
    in property <bool> bare;
    in property <bool> side-panel;
    in property <length> gap: Ui.space-8;
    // FilaDeCapas: dados extras das linhas "cover", na mesma ordem das linhas.
    in property <[CoverRow]> covers;
    // Outra camada no mesmo lugar (outro título): volta ao topo.
    in property <string> content-key;
    out property <length> content-h: rl.preferred-height;
    callback clicked(string, int);
    callback anchor(length, length);
    pure function body(i: int) -> bool {
        // A caixa da pasta de ROMs (onboarding) fecha o grupo de cima.
        return i >= 0 && i < rows.length && rows[i].kind != "header" && rows[i].style != "card" && !((footer || inline-buttons) && rows[i].kind == "button");
    }
    clip: true;
    changed content-key => { fl.viewport-y = 0; }
    // Só o teclado puxa a lista até a linha focada; o mouse rola pela roda.
    changed sel => {
        if (key-focus && sel >= 0 && sel < rows.length) {
            if (rl.y-of(sel) + fl.viewport-y < 0) {
                fl.viewport-y = -rl.y-of(sel);
            } else if (rl.y-of(sel) + 72px + fl.viewport-y > fl.height) {
                fl.viewport-y = -(rl.y-of(sel) + 72px - fl.height);
            }
        }
    }
    fl := Flickable {
        viewport-height: rl.preferred-height;
        rl := VerticalLayout {
            // Posição aproximada de uma linha (altura média), para seguir o foco sem medir cada uma.
            pure function y-of(i: int) -> length { return i * (self.preferred-height / max(1, rows.length)); }
            width: fl.width - 6px;
            for r[i] in rows: Rectangle {
                property <bool> button: r.kind == "button";
                height: button ? (footer ? 0 : (inline-buttons ? 48px : row.row-h)) : row.row-h;
                visible: !(footer && button);
                if inline-buttons && button: PopupButton {
                    width: parent.width;
                    height: parent.height;
                    data: r;
                    focused: key-focus && i == sel;
                    clicked => { root.clicked("row", i); }
                }
                row := DeskRow {
                    visible: !(button && (footer || inline-buttons));
                    bare: root.bare;
                    side-panel: root.side-panel;
                    data: r;
                    cv: covers[i];
                    act(k) => { root.clicked("row-act:" + k, i); }
                    loose: inline-buttons && !root.body(i - 1) && !root.body(i + 1);
                    first: !root.body(i - 1);
                    last: !root.body(i + 1);
                    focused: key-focus && i == sel;
                    clicked => { root.clicked("row", i); }
                    slide(v, done) => { root.clicked((done ? "row-drop:" : "row-slide:") + v, i); }
                    anchor(x, y) => { root.anchor(x, y); }
                }
            }
        }
    }
}

// Botão redondo de fechar dos popups e painéis (o X; Esc faz o mesmo).
component CloseButton inherits Rectangle {
    in property <length> size: 32px;
    // Nome para leitores de tela ("Fechar"): botão só de ícone.
    in property <string> label;
    callback clicked();
    width: size;
    height: size;
    border-radius: size / 2;
    background: cta.has-hover ? Ui.glass-hover : Ui.glass-control;
    accessible-role: button;
    accessible-label: label;
    DeskIcon { name: "close"; size: 18px; tint: Ui.on-accent; }
    cta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Ação de texto do rodapé do popup (PadraoPopup): sem caixa, à esquerda.
component FooterLink inherits Rectangle {
    in property <string> title;
    in property <bool> focused;
    callback clicked();
    height: Ui.control-height;
    width: sk.preferred-width + 16px;
    border-radius: Ui.radius-thumb;
    background: ska.has-hover ? Ui.glass-hover : transparent;
    accessible-role: button;
    accessible-label: title;
    if focused: FocusRing { radius: Ui.radius-thumb; }
    sk := Text { text: title; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 600; }
    ska := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Rodapé dos popups: as linhas de botão, à direita, na ordem do Tako.
component PopupFooter inherits HorizontalLayout {
    in property <[PanelRow]> rows;
    in property <int> sel;
    in property <bool> key-focus;
    callback clicked(int);
    alignment: end;
    for r[i] in rows: HorizontalLayout {
        visible: r.kind == "button";
        padding-left: self.visible ? 10px : 0;
        if r.kind == "button": PopupButton {
            data: r;
            focused: key-focus && i == sel;
            clicked => { root.clicked(i); }
        }
    }
}

// Configurações (TelaConfiguracoes): a mesma estrutura da biblioteca sobre o cinza. À esquerda, o painel de categorias
// no lugar da lista (CategoriaDeConfiguracao); à direita, ancorado no topo, o cabeçalho da categoria e os grupos de
// linhas, até 860 de largura.
component DeskSettings inherits Rectangle {
    in property <string> search;
    in property <string> search-hint;
    in property <string> search-key;
    in property <string> search-esc;
    in property <int> search-focus;
    callback edited(string);
    callback focus-main();
    // Troca de página: o conteúdo entra 16 px em `tempo-pagina`; barra e painel não se mexem de lugar.
    property <bool> shown;
    // Entrada: ligar no `init` não anima (o Slint aplica antes do primeiro quadro); o Timer liga logo depois.
    Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            shown = true;
        }
    }
    // Entra como página (TrocaDeTela): de 16 px ao lado, em `tempo-pagina`.
    opacity: shown ? 1 : 0;
    x: shown ? 0 : 16px;
    animate opacity, x { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    // Troca de categoria (abas internas): as linhas saem em 80 e as novas entram em 120, só opacidade.
    property <bool> rows-in: true;
    // Pela categoria, não pelo título: digitar na busca não pisca as linhas.
    changed category-focus => {
        rows-in = false;
        rows-timer.running = true;
    }
    rows-timer := Timer {
        interval: max(1ms, Ui.focus-time / 2);
        running: false;
        triggered => {
            self.running = false;
            rows-in = true;
        }
    }
    in property <string> count;
    in property <[DeskNav]> categories;
    in property <int> category-focus;
    in property <string> heading;
    in property <string> subtitle;
    in property <[PanelRow]> rows;
    in property <[CoverRow]> covers;
    in property <int> row-focus;
    in property <bool> focus-visible;
    in property <bool> small;
    callback clicked(string, int);
    callback menu(length, length);
    property <length> list-w: root.width < 1100px - 2 * Ui.space-36 ? Ui.list-width-narrow : Ui.list-width;
    HorizontalLayout {
        spacing: small ? Ui.space-20 : Ui.space-28;
        Vidro {
            width: list-w;
            height: cl.preferred-height;
            cl := VerticalLayout {
                padding-top: Ui.space-16;
                padding-left: Ui.space-12;
                padding-right: Ui.space-12;
                padding-bottom: Ui.space-12;
                spacing: small ? 4px : 6px;
                SearchBox {
                    text: search;
                    hint: search-hint;
                    key-label: search-key;
                    esc-label: search-esc;
                    focus-request: search-focus;
                    edited(t) => { root.edited(t); }
                    leave => { root.focus-main(); }
                }
                if !small: HorizontalLayout {
                    padding-left: Ui.space-12;
                    Text {
                    height: 36px;
                    text: count;
                    color: Ui.desk-on-subtle;
                    font-size: Ui.desk-label-sm;
                    font-weight: 500;
                    vertical-alignment: center;
                    }
                }
                for c[i] in categories: Rectangle {
                    // Na busca, a categoria sem nada que combine fica apagada.
                    opacity: c.count == "0" ? 0.4 : 1;
                    // Na janela pequena as oito categorias cabem em 600 de altura.
                    height: (small ? Ui.control-height : Ui.list-row-height) + (Ui.text-scale - 1) * 32px;
                    border-radius: Ui.radius-row;
                    background: !c.selected && cta.has-hover ? Ui.glass-hover : transparent;
                    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                    accessible-role: tab;
                    accessible-label: c.label;
                    if c.selected: Selected { lifted: true; }
                    if focus-visible && row-focus < 0 && i == category-focus: FocusRing { }
                    HorizontalLayout {
                        padding-left: Ui.space-8;
                        spacing: 14px;
                        // Ícone sem fundo no lugar da miniatura do jogo, para os nomes alinharem como na lista.
                        Rectangle {
                            width: Ui.thumb-size;
                            DeskIcon { name: c.icon; size: 22px; tint: c.selected ? Ui.on-accent : Ui.desk-on-muted; }
                        }
                        Text {
                            text: c.label;
                            color: Ui.on-accent;
                            font-size: Ui.desk-label;
                            font-weight: c.selected ? 600 : 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // Contagem do item (FilaDeCapas: capas a revisar; na busca, linhas que combinam).
                        if c.count != "" && c.count != "0": Rectangle {
                            width: cnt.preferred-width + Ui.space-12;
                            cnt := Text { x: 0; text: c.count; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; vertical-alignment: center; height: parent.height; }
                        }
                    }
                    cta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.clicked("category", i); }
                    }
                }
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            VerticalLayout {
                max-width: 860px;
                horizontal-stretch: 1;
                opacity: rows-in ? 1 : 0;
                animate opacity { duration: Ui.list-fade(rows-in); easing: rows-in ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
                // Ancorado no topo: numa janela alta a sobra fica embaixo das linhas.
                alignment: start;
                spacing: Ui.space-12;
                // Cabeçalho na altura do conteúdo: numa janela alta a sobra fica nas linhas, não aqui.
                HorizontalLayout {
                    vertical-stretch: 0;
                    padding-top: 4px;
                    padding-bottom: 10px;
                    padding-left: 8px;
                    spacing: 18px;
                    Rectangle {
                        width: 34px;
                        DeskIcon { name: categories[category-focus].icon; size: 34px; tint: Ui.on-accent; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: heading; color: Ui.on-accent; font-family: Ui.font-heading; font-size: Ui.desk-headline; font-weight: 700; letter-spacing: -0.01 * self.font-size; }
                        Text { text: subtitle; color: Ui.desk-on-muted; font-size: Ui.desk-label; wrap: word-wrap; }
                    }
                }
                RowScroll {
                    vertical-stretch: 1;
                    content-key: heading;
                    rows: rows;
                    covers: covers;
                    sel: row-focus;
                    key-focus: focus-visible;
                    clicked(z, i) => { root.clicked(z, i); }
                    anchor(x, y) => { root.menu(x, y); }
                }
            }
            Rectangle { horizontal-stretch: 0.0001; }
        }
    }
}

// Indicador de passos do AssistenteInicial: feitos com ✓, o atual na segunda camada de vidro, os seguintes apagados,
// ligados por traços de 1px.
component Stepper inherits HorizontalLayout {
    in property <[string]> steps;
    in property <int> current;
    spacing: Ui.space-8;
    for name[i] in steps: HorizontalLayout {
        spacing: Ui.space-8;
        horizontal-stretch: i > 0 ? 1 : 0;
        if i > 0: Rectangle { horizontal-stretch: 1; min-width: 18px; height: 1px; y: 15px; background: i <= current ? Ui.desk-on-muted : Ui.divider; }
        Rectangle {
            height: 30px;
            width: sl.preferred-width;
            border-radius: 15px;
            if i == current: Selected { radius: 15px; }
            sl := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                if i < current: DeskIcon { name: "tick"; size: 14px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
                Text {
                    text: name;
                    color: i == current ? Ui.on-accent : (i < current ? Ui.desk-on-muted : Ui.desk-on-subtle);
                    font-size: Ui.desk-label-sm;
                    font-weight: i == current ? 600 : 500;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Link do onboarding (Não uso emuladores, Revisar capas, Trocar): texto 14/500 apagado; `underline` sublinha.
component OnbLink inherits Rectangle {
    in property <string> text;
    in property <bool> focused;
    in property <bool> underline;
    callback clicked();
    width: lt.preferred-width + 8px;
    height: Ui.control-height;
    accessible-role: button;
    accessible-label: text;
    if focused: FocusRing { radius: Ui.radius-thumb; background: transparent; }
    lt := Text {
        text: root.text;
        color: lta.has-hover ? Ui.on-accent : Ui.desk-on-muted;
        font-size: 14px * Ui.text-scale;
        font-weight: 500;
    }
    if underline: Rectangle {
        x: (parent.width - lt.preferred-width) / 2;
        y: (parent.height + lt.preferred-height) / 2;
        width: lt.preferred-width;
        height: 1px;
        background: lt.color;
    }
    lta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Opção em linha do onboarding (EscolhaDoOnboarding, OnboardingCapas): marcador à esquerda, nome 15/600 e o que
// acontece; a escolhida na segunda camada de vidro. Clique em qualquer parte escolhe.
component OnbRadio inherits Rectangle {
    in property <PanelRow> data;
    in property <bool> focused;
    // Janela baixa: 10 em cima e embaixo.
    in property <bool> compact;
    callback clicked();
    height: rl.preferred-height;
    border-radius: Ui.radius-row;
    background: data.on ? Ui.glass-selected.mix(Ui.glass-solid, 0.5) : Ui.glass-solid;
    border-width: 1px;
    border-color: data.on ? Ui.glass-item-edge : Ui.glass-edge;
    accessible-role: radio-button;
    accessible-checked: data.on;
    accessible-label: data.title;
    accessible-description: data.description;
    if focused: FocusRing { radius: Ui.radius-row; background: transparent; }
    rl := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: compact ? 10px : 14px;
        padding-bottom: compact ? 10px : 14px;
        spacing: 14px;
        Rectangle {
            width: 22px;
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: data.on ? Ui.primary-top : transparent;
                    border-width: data.on ? 0 : 1.5px;
                    border-color: Ui.glass-item-edge;
                    if data.on: DeskIcon { name: "tick"; size: 14px; tint: Ui.on-primary; }
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            Text { text: data.title; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 600; wrap: word-wrap; }
            if data.description != "": Text { text: data.description; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; wrap: word-wrap; }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Capa da comparação do onboarding: sem arte (cor do jogo + nome, o fallback da Cover) ou com a capa.
component OnbCover inherits VerticalLayout {
    in property <Tile> tile;
    in property <bool> art;
    in property <string> caption;
    spacing: 8px;
    alignment: start;
    Rectangle {
        width: 84px;
        height: 126px;
        border-radius: 10px;
        clip: true;
        background: @linear-gradient(160deg, tile.accent 0%, tile.accent.darker(0.6) 100%);
        if !art: Text {
            x: 8px;
            width: parent.width - 16px;
            text: tile.title;
            color: Ui.on-accent;
            font-size: 14px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        if art: Image { width: parent.width; height: parent.height; source: tile.cover; image-fit: cover; }
    }
    Text { text: caption; color: Ui.desk-on-muted; font-size: 12px * Ui.text-scale; font-weight: 500; horizontal-alignment: center; }
}


// Opção com miniatura do onboarding (EscolhaDoOnboarding): a escolhida na segunda camada de vidro, com o marcador
// branco e ✓; clicar em qualquer parte escolhe. A miniatura é desenhada com as peças do Tako.
component ModeCard inherits Rectangle {
    in property <PanelRow> data;
    in property <bool> focused;
    // Jogos da parede: as cores da lista e das capas da miniatura.
    in property <[Tile]> tiles;
    // Janela baixa: miniatura de 96 em vez de 190, para Continuar caber na tela.
    in property <bool> compact;
    property <length> thumb-h: compact ? 96px : 190px;
    callback clicked();
    width: 372px;
    height: thumb-h + (compact ? 112px : 134px);
    border-radius: Ui.radius-card;
    background: data.on ? Ui.glass-selected.mix(Ui.glass-solid, 0.5) : Ui.glass-solid;
    border-width: 1px;
    border-color: data.on ? Ui.glass-item-edge : Ui.glass-edge;
    accessible-role: radio-button;
    accessible-checked: data.on;
    accessible-label: data.title;
    accessible-description: data.description;
    // A escolhida também com o foco suave em volta (om-on).
    if data.on || focused: FocusRing { radius: Ui.radius-card; background: transparent; }
    // Miniatura desenhada com as peças do Tako: a janela sobre a área de trabalho, ou a TV com o destaque e as capas.
    Rectangle {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: root.thumb-h;
        border-radius: 14px;
        clip: true;
        background: data.icon == "monitor" ? @linear-gradient(160deg, #2a3550 0%, #151a26 100%) : #0b0d12;
        if data.icon == "monitor": Rectangle {
            // Janela (om-w) com a barra de título e o corpo: lista e destaque.
            x: 22px;
            y: 18px;
            width: parent.width - 44px;
            height: parent.height - 52px;
            border-radius: 8px;
            clip: true;
            background: #0f1218;
            border-width: 1px;
            border-color: #ffffff1f;
            Rectangle {
                height: 14px;
                y: 0;
                background: #1a1e27;
                for s[k] in 3: Rectangle { x: parent.width - 30px + k * 10px; width: 6px; height: 6px; border-radius: 3px; background: #ffffff33; }
            }
            Rectangle {
                y: 14px;
                height: parent.height - 14px;
                background: @radial-gradient(circle, #2a9d8466 0%, transparent 70%);
                // Lista (om-list): cinco linhas com a cor de cada jogo.
                Rectangle {
                    x: 8px;
                    y: 8px;
                    width: parent.width * 0.34;
                    height: parent.height - 16px;
                    border-radius: 6px;
                    background: #ffffff12;
                    for k in 5: Rectangle {
                        x: 5px;
                        y: 5px + k * (root.compact ? 9px : 16px);
                        width: parent.width - 10px;
                        height: root.compact ? 6px : 12px;
                        border-radius: 3px;
                        background: #ffffff1f;
                        Rectangle { x: 0; width: parent.width * 0.22; border-radius: 3px; background: k < tiles.length ? tiles[k].accent : Ui.glass-pressed; }
                    }
                }
                // Destaque (om-hero): título, linha e o botão.
                Rectangle { x: parent.width * 0.4; y: parent.height - 38px; width: parent.width * 0.4; height: 9px; border-radius: 3px; background: #ffffffd9; }
                Rectangle { x: parent.width * 0.4; y: parent.height - 25px; width: parent.width * 0.26; height: 5px; border-radius: 3px; background: #ffffff59; }
                Rectangle { x: parent.width * 0.4; y: parent.height - 16px; width: parent.width * 0.17; height: 10px; border-radius: 5px; background: #ffffff; }
            }
        }
        // Barra de tarefas (om-task).
        if data.icon == "monitor": Rectangle { y: parent.height - 18px; height: 18px; background: #0b0d12cc; }
        if data.icon != "monitor": Rectangle {
            // TV (om-tv): o destaque grande e a fileira de capas.
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 30px;
            border-radius: 8px;
            clip: true;
            background: @linear-gradient(160deg, tiles.length > 0 ? tiles[0].accent : Ui.accent 0%, #0b0d12 100%);
            // Janela baixa: só a fileira de capas cabe na TV.
            if !root.compact: Rectangle { x: 10px; y: parent.height - 98px; width: parent.width * 0.46; height: 12px; border-radius: 3px; background: #ffffffe6; }
            if !root.compact: Rectangle { x: 10px; y: parent.height - 81px; width: parent.width * 0.26; height: 9px; border-radius: 5px; background: #ffffff; }
            for k in 5: Rectangle {
                x: 10px + k * (parent.width - 20px + 6px) / 5;
                y: parent.height - self.height - 8px;
                width: (parent.width - 20px + 6px) / 5 - 6px;
                height: min(50px, self.width * 1.5);
                border-radius: 4px;
                background: k < tiles.length ? @linear-gradient(160deg, tiles[k].accent 0%, tiles[k].accent.darker(0.65) 100%) : Ui.glass-pressed;
                border-width: k == 0 ? 2px : 0;
                border-color: #ffffffb3;
            }
        }
        // O controle ao lado (om-pad).
        if data.icon != "monitor": Rectangle {
            x: parent.width - 46px;
            y: parent.height - 36px;
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: #1c1f27;
            DeskIcon { name: "gamepad"; size: 18px; tint: Ui.desk-on-muted; }
        }
    }
    // Marcador redondo: branco com ✓ na escolhida, vazio na outra.
    Rectangle {
        x: parent.width - 44px;
        y: 22px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: data.on ? Ui.primary-top : #0b0d12a6;
        border-width: data.on ? 0 : 1.5px;
        border-color: Ui.glass-item-edge;
        if data.on: DeskIcon { name: "tick"; size: 14px; tint: Ui.on-primary; }
    }
    VerticalLayout {
        x: 18px;
        y: root.thumb-h + 26px;
        width: parent.width - 36px;
        height: self.preferred-height;
        spacing: 6px;
        Text { text: data.title; color: Ui.on-accent; font-size: 18px * Ui.text-scale; font-weight: 700; }
        Text { text: data.description; color: Ui.desk-on-muted; font-size: 14px * Ui.text-scale; wrap: word-wrap; }
        // Para quem é cada modo, em uma linha (OnboardingModo).
        if data.value != "" && !root.compact: Text { text: data.value; color: Ui.desk-on-muted; font-size: 12px * Ui.text-scale; font-weight: 500; overflow: elide; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}


// Camadas por cima da janela (PadraoPopup): diálogo no centro escurecendo o fundo, painel lateral à direita sem
// escurecer (tarefa paralela), menu junto do ponteiro e campo de texto. Todas no vidro de camada. O seletor de arte e
// as camadas de jogo usam o desenho da tela cheia, na escala da mesa.
component DeskOverlay inherits Rectangle {
    in property <Overlay> ov;
    // Entrada: o vidro "materializa" (opacidade e escala 0,98 → 1) em `tempo-pagina`; o menu nasce de 0,96 em
    // `tempo-foco`; o painel lateral desliza da direita.
    property <bool> shown;
    // Entrada: ligar no `init` não anima (o Slint aplica antes do primeiro quadro); o Timer liga logo depois.
    Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            shown = true;
        }
    }
    in property <bool> top-most;
    in property <bool> focus-visible;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <bool> bar-menu;
    in property <image> art;
    in property <bool> leaving;
    in property <string> cancel-label;
    in property <string> ok-label;
    in property <string> close-label;
    callback clicked(string, int);
    callback menu(length, length);
    callback edited(string, string);
    callback hovered(string, int);
    property <bool> generic: ov.kind != "panel" && ov.kind != "menu" && ov.kind != "keyboard" && ov.kind != "tags" && ov.kind != "art"
        && ov.kind != "splash" && ov.kind != "launch" && ov.kind != "progress" && ov.kind != "update";
    property <bool> has-buttons: ov.rows.length > 0 && ov.rows[ov.rows.length - 1].kind == "button";
    if ov.kind == "splash" || ov.kind == "launch" || ov.kind == "progress": OverlayView {
        ov: ov;
        top-most: top-most;
        art: art;
        leaving: leaving;
        clicked(z, i) => { root.clicked(z, i); }
        hovered(z, i) => { root.hovered(z, i); }
    }
    // AtualizacaoDoApp: Baixando (`ov.tab2 == 1`, barra em `ov.tab`/1000) e Pronta. `ov.overline` = versão nova (600),
    // `tabs2` = [resto da linha de versão, ajuda do rodapé, tempo restante]; `ov.tabs` = novidades; `ov.input` = jogo aberto.
    if ov.kind == "update": Rectangle {
        background: ov.secret ? transparent : #00000030;
        TouchArea { clicked => { root.clicked("outside", 0); } }
        Vidro {
            layer: true;
            dense: true;
            width: min(500px, root.width - 32px);
            height: min(update-layout.preferred-height, root.height - 32px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            radius: Ui.radius-card;
            TouchArea { }
            update-scroll := Flickable {
                viewport-height: update-layout.preferred-height;
                update-layout := VerticalLayout {
                    width: update-scroll.width;
                    padding: 24px;
                    spacing: 18px;
                    HorizontalLayout {
                        spacing: 14px;
                        Rectangle {
                            width: 48px; height: 48px; border-radius: 14px; background: Ui.glass-control;
                            border-width: 1px; border-color: Ui.glass-edge-strong;
                            DeskIcon { name: ov.tab2 == 1 ? "download" : "refresh"; size: 24px; x: 11px; y: 11px; }
                        }
                        VerticalLayout {
                            spacing: 6px; alignment: start;
                            Text { text: ov.title; color: Ui.on-accent; font-size: 20px * Ui.text-scale; font-weight: 700; overflow: elide; }
                            HorizontalLayout {
                                spacing: 4px; alignment: start;
                                Text { text: ov.overline; color: Ui.on-accent; font-size: 13px * Ui.text-scale; font-weight: 600; }
                                Text { text: ov.tabs2.length > 0 ? ov.tabs2[0] : ""; color: Ui.on-accent-muted; font-size: 13px * Ui.text-scale; font-weight: 500; overflow: elide; }
                            }
                        }
                        Rectangle {
                            width: 32px; height: 32px; border-radius: 16px; background: Ui.glass-control;
                            accessible-role: button; accessible-label: root.close-label;
                            if focus-visible && ov.sel == 2: FocusRing { radius: 16px; }
                            DeskIcon { name: "close"; size: 14px; x: 9px; y: 9px; tint: Ui.on-accent-muted; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.clicked("outside", 0); } }
                        }
                    }
                    if ov.tab2 == 1: VerticalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 6px; background: #ffffff1f; border-radius: 3px; clip: true;
                            Rectangle { width: parent.width * ov.tab / 1000; background: Ui.on-accent; border-radius: 3px; }
                        }
                        HorizontalLayout {
                            Text { text: ov.text; color: Ui.on-accent-subtle; font-size: 12px * Ui.text-scale; font-weight: 500; horizontal-stretch: 1; }
                            Text { text: ov.tabs2.length > 2 ? ov.tabs2[2] : ""; color: Ui.on-accent-subtle; font-size: 12px * Ui.text-scale; font-weight: 500; }
                        }
                    }
                    if ov.tabs.length > 0: Rectangle {
                        height: notes-layout.preferred-height + 28px;
                        border-radius: Ui.radius-control; background: #ffffff0a;
                        border-width: 1px; border-color: Ui.glass-edge;
                        notes-layout := VerticalLayout {
                            padding: 14px; padding-left: 16px; padding-right: 16px;
                            spacing: 10px;
                            Text { text: ov.input-hint.to-uppercase(); color: Ui.desk-on-subtle; font-size: Ui.desk-overline; font-weight: 700; letter-spacing: 0.04 * self.font-size; }
                            VerticalLayout {
                                spacing: 6px;
                                for note in ov.tabs: Text { text: "•  " + note; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 500; overflow: elide; }
                            }
                            Rectangle {
                                height: 24px;
                                Text { text: ov.preview-text; color: Ui.on-accent-muted; font-size: 13px * Ui.text-scale; font-weight: 600; vertical-alignment: center; horizontal-alignment: left; width: parent.width; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.clicked("notes", 0); } }
                            }
                        }
                    }
                    if ov.input != "": Rectangle {
                        height: warn-layout.preferred-height + 20px;
                        border-radius: Ui.radius-control;
                        background: Ui.warning.with-alpha(0.14);
                        border-width: 1px; border-color: Ui.warning.with-alpha(0.4);
                        accessible-role: text; accessible-label: ov.input;
                        warn-layout := HorizontalLayout {
                            padding: 10px; padding-left: 12px; padding-right: 12px; spacing: 10px;
                            DeskIcon { name: "alert"; size: 18px; tint: Ui.warning; y: 1px; }
                            Text { text: ov.input; color: Ui.on-accent; font-size: 13px * Ui.text-scale; font-weight: 500; wrap: word-wrap; horizontal-stretch: 1; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px; alignment: end;
                        Text {
                            text: ov.tabs2.length > 1 ? ov.tabs2[1] : "";
                            color: Ui.on-accent-subtle; font-size: 12px * Ui.text-scale; font-weight: 500;
                            wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
                        }
                        for r[i] in ov.rows: PopupButton {
                            data: r; height: 44px;
                            focused: focus-visible && top-most && ov.sel == i;
                            clicked => { root.clicked("row", i); }
                        }
                    }
                }
            }
        }
    }
    // SeletorDeImagens: popup grande (40 × 48 das bordas, até 1440) com cabeçalho e X, Capa · Fundo · Logo · Ícone,
    // Fonte em select, Estilo e "Escolher do computador…"; a grade na largura toda e a prévia fixa de 380. Clicar
    // escolhe; "Usar" aplica. `ov.rows`: fonte, estilo, do computador, usar, voltar à original, cancelar, atual, prévia.
    if ov.kind == "art" && ov.rows.length >= 8: Rectangle {
        background: Ui.desk-canvas.with-alpha(shown ? 0.7 : 0);
        animate background { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        TouchArea { }
        // Proporção da imagem por tipo: capa 2:3, fundo 31:10, logo 2:1 contido, ícone 1:1.
        property <float> ratio: ov.tab == 0 ? 1.5 : (ov.tab == 1 ? 1240 / 3840 : (ov.tab == 2 ? 0.5 : 1));
        Vidro {
            layer: true;
            opacity: shown ? 1 : 0;
            transform-scale: shown && top-most ? 1 : Ui.escala-entrada;
            animate opacity, transform-scale { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            width: min(parent.width - 80px, 1440px);
            height: parent.height - 96px;
            x: (parent.width - self.width) / 2;
            y: 48px;
            VerticalLayout {
                padding: Ui.space-24;
                spacing: Ui.space-16;
                HorizontalLayout {
                    height: 48px;
                    spacing: 14px;
                    if ov.image.width > 0: Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 40px;
                        height: 40px;
                        border-radius: Ui.radius-thumb;
                        clip: true;
                        Image { width: parent.width; height: parent.height; source: ov.image; image-fit: cover; vertical-alignment: top; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: ov.title; color: Ui.on-accent; font-family: Ui.font-heading; font-size: 22px * Ui.text-scale; font-weight: 700; overflow: elide; }
                        if ov.text != "": Text { text: ov.text; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; overflow: elide; }
                    }
                    CloseButton { label: close-label; y: 4px; size: 40px; clicked => { root.clicked("cancel", 0); } }
                }
                HorizontalLayout {
                    height: 40px;
                    spacing: Ui.space-12;
                    Tabs {
                        width: 360px;
                        tabs: ov.tabs;
                        current: ov.tab;
                        clicked(i) => { root.clicked("tab", i); }
                    }
                    // Fonte: select (CampoDeSelecao) com a lista junto da pílula.
                    src := Rectangle {
                        y: 4px;
                        height: 32px;
                        width: clamp(srcl.preferred-width, 160px, 280px);
                        border-radius: self.height / 2;
                        background: srcta.has-hover ? Ui.glass-hover : Ui.glass-control;
                        border-width: 1px;
                        border-color: Ui.glass-edge;
                        accessible-role: combobox;
                        accessible-label: ov.rows[0].title + ": " + (ov.tab2 >= 0 && ov.tab2 < ov.tabs2.length ? ov.tabs2[ov.tab2] : "");
                        srcl := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 8px;
                            Text { text: ov.tab2 >= 0 && ov.tab2 < ov.tabs2.length ? ov.tabs2[ov.tab2] : ""; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            DeskIcon { name: "updown"; size: 14px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
                        }
                        srcta := TouchArea { mouse-cursor: pointer; clicked => { srcpop.show(); } }
                        srcpop := PopupWindow {
                            x: 0;
                            y: parent.height + 6px;
                            width: max(parent.width, 220px);
                            Rectangle {
                                border-radius: Ui.radius-control;
                                background: Ui.glass-solid;
                                border-width: 1px;
                                border-color: Ui.glass-edge-strong;
                                drop-shadow-offset-y: Ui.shadow-layer-y;
                                drop-shadow-blur: Ui.shadow-layer-blur;
                                drop-shadow-color: Ui.shadow-layer-color;
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 2px;
                                    for s[i] in ov.tabs2: Rectangle {
                                        height: 36px;
                                        border-radius: 10px;
                                        background: sta.has-hover ? Ui.glass-hover : transparent;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 12px;
                                            spacing: 8px;
                                            Rectangle { width: 18px; if i == ov.tab2: DeskIcon { name: "tick"; size: 16px; tint: Ui.on-accent; } }
                                            Text { text: s; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: i == ov.tab2 ? 600 : 500; vertical-alignment: center; }
                                        }
                                        sta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked("tab2", i); } }
                                    }
                                }
                            }
                        }
                    }
                    // Estilo (SteamGridDB): select; a lista é a mesma do CampoDeSelecao, junto da pílula.
                    if ov.rows[1].enabled: Rectangle {
                        y: 4px;
                        height: 32px;
                        width: clamp(stl.preferred-width, 160px, 280px);
                        border-radius: self.height / 2;
                        background: stta.has-hover ? Ui.glass-hover : Ui.glass-control;
                        border-width: 1px;
                        border-color: Ui.glass-edge;
                        animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                        accessible-role: combobox;
                        accessible-label: ov.rows[1].title + ": " + ov.rows[1].value;
                        stl := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 8px;
                            Text { text: ov.rows[1].title + ": " + ov.rows[1].value; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            DeskIcon { name: "updown"; size: 14px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
                        }
                        stta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                DeskArt.anchor-w = parent.width;
                                root.menu(parent.absolute-position.x + parent.width, parent.absolute-position.y + parent.height + 6px);
                                root.clicked("style", 0);
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PopupButton {
                        y: (parent.height - self.height) / 2;
                        data: ov.rows[2];
                        clicked => { root.clicked("file", 0); }
                    }
                }
                Rectangle { height: 1px; background: Ui.divider; }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: Ui.space-24;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        Text {
                            text: ov.thumbs.length + " · " + (ov.tab2 >= 0 && ov.tab2 < ov.tabs2.length ? ov.tabs2[ov.tab2] : "");
                            color: Ui.desk-on-muted;
                            font-size: Ui.desk-label-sm;
                            font-weight: 600;
                        }
                    // Grade na largura toda: colunas de pelo menos 132 (fundo 2 por linha, ícone 8), 16 entre elas.
                    grid := Flickable {
                        horizontal-stretch: 1;
                        property <int> cols: ov.tab == 1 ? 2 : (ov.tab == 3 ? 8 : max(2, floor((self.width + 16px) / (132px + 16px))));
                        // As setas do teclado andam pelas mesmas colunas que aparecem.
                        changed cols => { root.hovered("cols", self.cols); }
                        init => { root.hovered("cols", self.cols); }
                        // 4 de folga nas bordas: o anel da escolhida (2 + 2) não é cortado.
                        property <length> cell-w: (self.width - 8px - (cols - 1) * 16px) / cols;
                        property <length> cell-h: cell-w * ratio;
                        viewport-height: ceil(ov.thumbs.length / cols) * (cell-h + 16px) + 8px;
                        // Perto do fim: o Tako carrega a próxima página.
                        changed viewport-y => {
                            if (-self.viewport-y + self.height > self.viewport-height - 2 * (cell-h + 16px)) {
                                root.hovered("more", 0);
                            }
                        }
                        for t[i] in ov.thumbs: Rectangle {
                            x: 4px + mod(i, grid.cols) * (grid.cell-w + 16px);
                            y: floor(i / grid.cols) * (grid.cell-h + 16px) + 4px - (tta.has-hover && i != ov.sel ? 2px : 0);
                            width: grid.cell-w;
                            height: grid.cell-h;
                            animate y { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                            accessible-role: list-item;
                            accessible-label: t.title;
                            Rectangle {
                                border-radius: 12px;
                                clip: true;
                                background: ov.tab == 2 ? #0b0d12 : Ui.glass-control;
                                Image { width: parent.width; height: parent.height; source: t.cover; image-fit: ov.tab >= 2 ? contain : cover; }
                                Rectangle {
                                    border-radius: 12px;
                                    border-width: 1px;
                                    border-color: tta.has-hover ? Ui.glass-edge-strong : Ui.glass-edge;
                                }
                            }
                            // Escolhida: anel de 2 com 2 de folga e ✓ no canto.
                            if i == ov.sel: Rectangle {
                                x: -4px;
                                y: -4px;
                                width: parent.width + 8px;
                                height: parent.height + 8px;
                                border-radius: 16px;
                                border-width: 2px;
                                border-color: Ui.on-accent;
                            }
                            if i == ov.sel: Rectangle {
                                x: parent.width - self.width - 8px;
                                y: 8px;
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: Ui.primary-top;
                                DeskIcon { name: "tick"; size: 14px; tint: Ui.on-primary; }
                            }
                            if t.favorite: Rectangle {
                                x: 8px;
                                y: parent.height - self.height - 8px;
                                height: 22px;
                                width: cur.preferred-width + 16px;
                                border-radius: 11px;
                                background: Ui.desk-canvas.with-alpha(0.85);
                                cur := Text { text: ov.rows[6].title; color: Ui.on-accent; font-size: Ui.desk-overline; font-weight: 600; }
                            }
                            tta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked("thumb", i); } }
                        }
                    }
                    }
                    Rectangle { width: 1px; background: Ui.divider; }
                    // Prévia fixa de 380: a escolhida grande (até 320 de altura, centralizada), o que ela é e as ações.
                    VerticalLayout {
                        width: 380px;
                        spacing: 14px;
                        Text { text: ov.rows[7].title.to-uppercase(); color: Ui.desk-on-subtle; font-size: Ui.desk-overline; font-weight: 700; letter-spacing: 0.1 * self.font-size; }
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                height: min(380px * ratio, 320px);
                                width: self.height / ratio;
                                border-radius: Ui.radius-card;
                                clip: true;
                                background: ov.tab == 2 ? #0b0d12 : Ui.glass-control;
                                Image { width: parent.width; height: parent.height; source: ov.preview; image-fit: ov.tab >= 2 ? contain : cover; }
                            }
                        }
                        Text { text: ov.preview-text; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; wrap: word-wrap; }
                        // Aba Logo (TituloDoJogo): "Título deste jogo" e o aviso de pouco contraste.
                        if ov.tab == 2 && ov.rows.length > 9: DeskRow {
                            data: ov.rows[8];
                            clicked => { root.clicked("title-mode", 0); }
                            anchor(x, y) => { root.menu(x, y); }
                        }
                        if ov.tab == 2 && ov.rows.length > 9 && ov.rows[9].value != "": Text {
                            text: ov.rows[9].value;
                            color: Ui.warning;
                            font-size: Ui.desk-label-sm;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                        // Regra .dk-stack: botão principal na largura toda em cima (52) e as duas secundárias embaixo lado a lado com a mesma largura (44, 10 entre elas).
                        VerticalLayout {
                            spacing: 10px;
                            PopupButton {
                                width: parent.width;
                                custom-height: 52px;
                                data: ov.rows[3];
                                clicked => { root.clicked("use", 0); }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                PopupButton {
                                    horizontal-stretch: 1;
                                    custom-height: 44px;
                                    data: ov.rows[4];
                                    clicked => { root.clicked("original", 0); }
                                }
                                PopupButton {
                                    horizontal-stretch: 1;
                                    custom-height: 44px;
                                    data: ov.rows[5];
                                    clicked => { root.clicked("cancel", 0); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // Diálogo (e qualquer camada sem desenho próprio): cabeçalho com o X, o corpo em grupos e as ações no rodapé.
    if generic && ov.tab2 != 1: Rectangle {
        background: Ui.desk-canvas.with-alpha(shown ? 0.55 : 0);
        animate background { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        TouchArea { }
        Vidro {
            layer: true;
            opacity: shown ? 1 : 0;
            // Empilhar (TrocaDePopup): a camada de baixo recua para 0,98; a de cima a escurece com o scrim dela.
            transform-scale: shown && top-most ? 1 : Ui.escala-entrada;
            animate opacity, transform-scale { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            width: min(parent.width - 80px, ov.wide ? 680px : (ov.compact ? 440px : 540px));
            height: min(dlg.preferred-height, parent.height - 80px);
            dlg := VerticalLayout {
                padding: Ui.space-24;
                spacing: 14px;
                if ov.kind == "dialog" && ov.tabs.length > 0: Stepper { steps: ov.tabs; current: ov.tab; }
                HorizontalLayout {
                    spacing: 14px;
                    if ov.image.width > 0: Image { source: ov.image; width: 44px; height: 44px; image-fit: contain; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        if ov.overline != "" && ov.tabs.length == 0: HorizontalLayout {
                            alignment: start;
                            Badge { text: ov.overline; }
                        }
                        if ov.overline != "" && ov.tabs.length > 0: Text {
                            text: ov.overline;
                            color: Ui.desk-on-muted;
                            font-size: Ui.desk-overline;
                            font-weight: 700;
                            letter-spacing: 0.1 * self.font-size;
                        }
                        Text { text: ov.title; color: Ui.on-accent; font-family: Ui.font-heading; font-size: Ui.desk-title; font-weight: 700; wrap: word-wrap; }
                        if ov.text != "": Text { text: ov.text; color: Ui.desk-on-muted; font-size: Ui.desk-body; line-height-factor: 1.23; wrap: word-wrap; }
                    }
                    CloseButton { label: close-label; clicked => { root.clicked("outside", 0); } }
                }
                // Assistente (com passos): ações no rodapé, "Pular" como texto à esquerda. Outros diálogos: ações
                // empilhadas em largura total, na ordem do Tako.
                RowScroll {
                    min-height: min(self.content-h, 80px);
                    preferred-height: self.content-h;
                    vertical-stretch: 1;
                    inline-buttons: ov.tabs.length == 0 && !ov.footer;
                    footer: ov.tabs.length > 0 || ov.footer;
                    content-key: ov.title;
                    rows: ov.rows;
                    sel: top-most ? ov.sel : -1;
                    key-focus: focus-visible;
                    clicked(z, i) => { root.clicked(z, i); }
                    anchor(x, y) => { root.menu(x, y); }
                }
                // Rodapé (PadraoPopup): ação de texto à esquerda ("Pular" nos passos, estilo "link"); à direita as outras,
                // com a principal por último (nos passos, a ordem já vem pronta; nos demais, a lista vem na ordem do Tako).
                if ov.tabs.length > 0 || ov.footer: HorizontalLayout {
                    padding-top: 4px;
                    for r[i] in ov.rows: HorizontalLayout {
                        visible: r.kind == "button" && (r.key == "skip" || r.style == "link");
                        if r.kind == "button" && (r.key == "skip" || r.style == "link"): FooterLink {
                            title: r.title;
                            focused: focus-visible && top-most && i == ov.sel;
                            clicked => { root.clicked("row", i); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    for k in ov.rows.length: HorizontalLayout {
                        property <int> i: ov.footer ? ov.rows.length - 1 - k : k;
                        property <bool> mine: ov.rows[i].kind == "button" && ov.rows[i].key != "skip" && ov.rows[i].style != "link";
                        visible: mine;
                        padding-left: self.visible ? 10px : 0;
                        if mine: PopupButton {
                            data: ov.rows[i];
                            focused: focus-visible && top-most && i == ov.sel;
                            clicked => { root.clicked("row", i); }
                        }
                    }
                }
            }
        }
    }
    // Onboarding do desktop em tela inteira (TelaOnboarding → OnboardingPronto): fundo preto, parede de capas
    // inclinada à direita (ambiente, sem foco), a marca e "Pular configuração" no topo e uma pergunta por tela.
    if generic && ov.tab2 == 1: Rectangle {
        background: Ui.splash-bg;
        TouchArea { }
        property <bool> last: ov.tab == ov.tabs.length - 1;
        property <bool> low: root.height < 760px;
        // Parede de capas (ob2-wall): 4 colunas de 210, inclinada 8°; no Pronto fica mais clara (são os jogos da
        // pessoa).
        Rectangle {
            // Janela estreita: a parede não entra embaixo da coluna.
            x: max(parent.width - 920px, 560px);
            y: -120px;
            width: 1080px;
            height: parent.height + 240px;
            clip: true;
            opacity: last ? 0.8 : 0.55;
            accessible-role: none;
            Rectangle {
                x: 40px;
                y: 60px;
                width: 4 * 210px + 3 * 22px;
                height: 4 * 315px + 3 * 22px;
                transform-rotation: -8deg;
                for t[i] in ov.thumbs: Rectangle {
                    x: mod(i, 4) * 232px;
                    y: floor(i / 4) * 337px;
                    width: 210px;
                    height: 315px;
                    border-radius: Ui.radius-card;
                    clip: true;
                    background: @linear-gradient(160deg, t.accent 0%, t.accent.darker(0.65) 100%);
                    Text {
                        x: 14px;
                        width: parent.width - 28px;
                        text: t.title;
                        color: Ui.on-accent;
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Image { width: parent.width; height: parent.height; source: t.cover; image-fit: cover; }
                }
            }
        }
        // A parede some no preto à esquerda (ob2-bg).
        Rectangle { background: @linear-gradient(90deg, Ui.splash-bg 0%, Ui.splash-bg 38%, Ui.splash-bg.with-alpha(0.7) 55%, Ui.splash-bg.with-alpha(0.25) 100%); }
        Image {
            x: 56px;
            y: 28px;
            height: 46px;
            width: self.height * 495 / 192;
            source: @image-url("tako-logo.png");
            image-fit: contain;
        }
        // "Pular configuração" sempre visível no topo (nunca prender a pessoa num tour).
        for r[i] in ov.rows: Rectangle {
            visible: r.key == "skip";
            if r.key == "skip": Vidro {
                layer: true;
                radius: self.height / 2;
                x: root.width - self.width - 56px;
                y: 30px;
                height: Ui.control-height;
                width: osk.preferred-width;
                accessible-role: button;
                accessible-label: r.title;
                if focus-visible && top-most && i == ov.sel: FocusRing { radius: parent.height / 2; background: transparent; }
                osk := HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    Text { text: r.title; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 600; vertical-alignment: center; }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.clicked("row", i); }
                }
            }
        }
        // Passos do onboarding (PassosDoOnboardingMovimento): avançar entra 24 px da direita, voltar da esquerda, em
        // `tempo-pagina`.
        property <string> step-key: ov.title;
        property <bool> step-in: true;
        property <int> last-step: ov.tab;
        property <int> step-dir: 1;
        changed step-key => {
            step-dir = ov.tab >= last-step ? 1 : -1;
            last-step = ov.tab;
            step-in = false;
            step-timer.running = true;
        }
        step-timer := Timer {
            interval: 1ms;
            running: false;
            triggered => {
                self.running = false;
                step-in = true;
            }
        }
        VerticalLayout {
            x: 120px + (step-in && shown ? 0 : 24px * step-dir);
            opacity: step-in && shown ? 1 : 0;
            animate x, opacity { duration: Ui.enter(step-in); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            // Centralizada, mas nunca embaixo da marca do topo.
            y: max(low ? 88px : 104px, (parent.height - self.height) / 2);
            width: min(ov.tab == 3 ? 760px : 520px, parent.width - 200px);
            height: self.preferred-height;
            spacing: low ? 12px : 18px;
            // PassosDoOnboarding: "n de 5" (13/600, números tabulares) e cinco traços de 24 × 3; do passo 2 em
            // diante o texto vira "‹ Voltar" no hover.
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                accessible-role: text;
                accessible-label: ov.overline;
                Rectangle {
                    width: bt.preferred-width;
                    height: 20px;
                    bt := Text {
                        text: ov.tab > 0 && bta.has-hover && ov.tabs2.length > 0 ? "‹ " + ov.tabs2[0] : ov.overline;
                        color: bta.has-hover && ov.tab > 0 ? Ui.on-accent : Ui.desk-on-muted;
                        font-size: Ui.desk-label-sm;
                        font-weight: 600;
                    }
                    bta := TouchArea {
                        enabled: ov.tab > 0;
                        mouse-cursor: ov.tab > 0 ? pointer : default;
                        clicked => { root.clicked("outside", 0); }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    // O traço do passo alcançado cresce em `tempo-pagina`.
                    for d[i] in ov.tabs: Rectangle {
                        y: 9px;
                        width: 24px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: Ui.on-accent.with-alpha(0.15);
                        Rectangle {
                            x: 0;
                            width: i <= ov.tab ? parent.width : 0;
                            border-radius: 1.5px;
                            background: Ui.on-accent;
                            animate width { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                        }
                    }
                }
            }
            // Título em duas linhas (a quebra vem do texto), 56/700.
            Text {
                text: ov.title;
                color: Ui.on-accent;
                font-family: Ui.font-heading;
                // Janela baixa: o título cai para 40, como no destaque da janela pequena.
                font-size: low ? 40px * Ui.text-scale : Ui.desk-display;
                font-weight: 700;
                line-height-factor: 0.69;
                letter-spacing: -0.02 * self.font-size;
                wrap: word-wrap;
            }
            // Na largura da coluna: com largura menor o layout media a altura na largura da coluna e cortava a
            // segunda linha.
            if ov.text != "": Text { text: ov.text; color: Ui.desk-on-muted; font-size: low ? Ui.desk-body : Ui.desk-label-lg; line-height-factor: 1.23; wrap: word-wrap; }
            // Capas: a comparação de um jogo de verdade (sem capa → com capa) e as duas opções em linha.
            if ov.tab == 2: VerticalLayout {
                // O espaço fica em cada item visível (os ocultos do `for` não somam).
                for r[i] in ov.rows: VerticalLayout {
                    visible: r.kind == "compare" || r.kind == "radio";
                    padding-bottom: r.kind == "radio" && i + 1 < ov.rows.length && ov.rows[i + 1].kind == "radio" ? 10px : 0;
                    if r.kind == "compare" && !low: HorizontalLayout {
                        alignment: start;
                        spacing: 18px;
                        padding-bottom: 14px;
                        OnbCover { tile: ov.thumbs[r.value.to-float()]; caption: r.title; }
                        Rectangle {
                            width: 20px;
                            DeskIcon { y: 53px; name: "chevron"; size: 20px; tint: Ui.desk-on-muted; }
                        }
                        OnbCover { tile: ov.thumbs[r.value.to-float()]; art: true; caption: r.description; }
                    }
                    if r.kind == "radio": OnbRadio {
                        compact: low;
                        data: r;
                        focused: focus-visible && top-most && i == ov.sel;
                        clicked => { root.clicked("row", i); }
                    }
                }
            }
            // Modo: as duas opções lado a lado, com a miniatura de cada modo.
            if ov.tab == 3: HorizontalLayout {
                alignment: start;
                for r[i] in ov.rows: HorizontalLayout {
                    visible: r.kind == "radio";
                    padding-right: self.visible ? Ui.space-16 : 0;
                    if r.kind == "radio": ModeCard {
                        compact: low;
                        tiles: ov.thumbs;
                        data: r;
                        focused: focus-visible && top-most && i == ov.sel;
                        clicked => { root.clicked("row", i); }
                    }
                }
            }
            // Lojas, emuladores (com a pasta de ROMs) e o resumo do Pronto: linhas sem caixa (LojaEncontrada).
            if ov.tab != 2 && ov.tab != 3: RowScroll {
                preferred-height: self.content-h;
                // Até seis linhas inteiras numa janela de 900; o resto rola.
                max-height: low ? max(96px, root.height - 470px) : min(420px, root.height - 470px);
                footer: true;
                bare: true;
                content-key: ov.title;
                rows: ov.rows;
                sel: top-most ? ov.sel : -1;
                key-focus: focus-visible;
                clicked(z, i) => { root.clicked(z, i); }
                anchor(x, y) => { root.menu(x, y); }
            }
            // A escolha do passo do modo (OnboardingPronto): "Abre em janela" e o link "Trocar".
            // Só no Pronto: itens ocultos de um `for` somariam o espaçamento da coluna.
            if ov.tab == 4: VerticalLayout { for r[i] in ov.rows: HorizontalLayout {
                visible: r.style == "line";
                if r.style == "line": HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    DeskIcon { y: (parent.height - self.height) / 2; name: r.icon; size: 18px; tint: Ui.desk-on-muted; }
                    Text { text: r.title; color: Ui.desk-on-muted; font-size: Ui.desk-label; font-weight: 500; vertical-alignment: center; }
                    Text { text: r.value; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 700; vertical-alignment: center; }
                    OnbLink {
                        text: r.description;
                        underline: true;
                        focused: focus-visible && top-most && i == ov.sel;
                        clicked => { root.clicked("row", i); }
                    }
                }
            } }
            // Ações: a principal em pílula de 220 × 52, as outras em vidro e os links em texto.
            HorizontalLayout {
                padding-top: low ? 2px : 10px;
                alignment: start;
                // Itens ocultos não podem somar espaço: o espaçamento fica em cada botão.
                for r[i] in ov.rows: HorizontalLayout {
                    visible: r.kind == "button" && r.key != "skip" && r.style != "line";
                    padding-right: self.visible ? 14px : 0;
                    if r.kind == "button" && r.key != "skip" && r.style != "line" && r.style != "link": PopupButton {
                        property <bool> main: r.style == "primary" || r.key == "next" || r.key == "done";
                        y: (parent.height - self.height) / 2;
                        height: main ? 52px : Ui.control-height;
                        min-w: main ? 220px : 0;
                        data: r;
                        focused: focus-visible && top-most && i == ov.sel;
                        clicked => { root.clicked("row", i); }
                    }
                    if r.kind == "button" && r.style == "link": OnbLink {
                        y: (parent.height - self.height) / 2;
                        text: r.title;
                        focused: focus-visible && top-most && i == ov.sel;
                        clicked => { root.clicked("row", i); }
                    }
                }
            }
            // Janela baixa com texto grande: a nota cede o espaço para as ações caberem.
            if ov.input-hint != "" && !(low && Ui.text-scale > 1.1): Text { text: ov.input-hint; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; wrap: word-wrap; }
        }
    }

    // Painel lateral: flutua à direita a 36 das bordas, sem escurecer a janela; clique fora ou Esc fecha.
    if ov.kind == "panel": Rectangle {
        // Scrim de 0 a 25% junto com a entrada do painel (PainelEAviso).
        background: Ui.desk-canvas.with-alpha(shown ? 0.25 : 0);
        animate background { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        TouchArea { clicked => { root.clicked("outside", 0); } }
        Vidro {
            layer: true;
            // Mesma margem direita do conteúdo (20 na janela pequena).
            x: parent.width - self.width - (parent.width < 1280px ? Ui.space-20 : Ui.space-36) + (shown ? 0 : 48px);
            opacity: shown ? 1 : 0;
            animate x, opacity { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            // Abaixo da barra superior, alinhado com o conteúdo: 84 do topo e 28 de baixo (480 de largura no largo).
            y: 84px;
            width: min(parent.width - 120px, ov.wide ? 480px : 440px);
            height: min(parent.height - 84px - Ui.space-28, pl.preferred-height);
            TouchArea { }
            pl := VerticalLayout {
                padding: 22px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: Ui.space-12;
                    // Capa do jogo (ConfiguracoesDoJogo): miniatura de 40, recortada, raio `radius-thumb`.
                    if ov.image.width > 0: Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 40px;
                        height: 40px;
                        border-radius: Ui.radius-thumb;
                        clip: true;
                        Image { width: parent.width; height: parent.height; source: ov.image; image-fit: cover; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        if ov.overline != "" && !ov.wide: Text {
                            text: ov.overline;
                            color: Ui.desk-on-muted;
                            font-size: Ui.desk-overline;
                            font-weight: 700;
                            letter-spacing: 0.1 * self.font-size;
                            overflow: elide;
                        }
                        Text { text: ov.title; color: Ui.on-accent; font-family: Ui.font-heading; font-size: Ui.desk-title; font-weight: 700; wrap: word-wrap; }
                        // No largo, o jogo e as mudanças vão embaixo do título.
                        if ov.overline != "" && ov.wide: Text { text: ov.overline; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; overflow: elide; }
                    }
                    CloseButton { label: close-label; size: 40px; clicked => { root.clicked("outside", 0); } }
                }
                if ov.text != "": Text { text: ov.text; color: Ui.desk-on-muted; font-size: Ui.desk-body; line-height-factor: 1.23; wrap: word-wrap; }
                RowScroll {
                    vertical-stretch: 1;
                    preferred-height: self.content-h;
                    footer: true;
                    side-panel: !ov.wide;
                    content-key: ov.title;
                    rows: ov.rows;
                    sel: top-most ? ov.sel : -1;
                    key-focus: focus-visible;
                    clicked(z, i) => { root.clicked(z, i); }
                    anchor(x, y) => { root.menu(x, y); }
                }
                if has-buttons: PopupFooter {
                    rows: ov.rows;
                    sel: top-most ? ov.sel : -1;
                    key-focus: focus-visible;
                    clicked(i) => { root.clicked("row", i); }
                }
            }
        }
    }
    // Menu (MenuDeContexto, MenuDoTako): vidro de camada junto do ponteiro, do botão ⋯ ou da marca; clique fora
    // fecha. Item de 36 com ícone de 18, atalho à direita e divisórias entre grupos.
    if ov.kind == "menu": Rectangle {
        TouchArea { clicked => { root.clicked("outside", 0); } }
        Vidro {
            layer: true;
            opacity: shown ? 1 : 0;
            transform-scale: shown ? 1 : Ui.escala-menu;
            // Nasce do ponto que abriu: do canto do ponteiro/botão, ou do canto direito da pílula no select.
            transform-origin: { x: select ? self.width : clamp(menu-x - self.x, 0, self.width), y: menu-y > self.y ? self.height : 0 };
            animate opacity, transform-scale { duration: Ui.focus-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            radius: Ui.radius-control;
            // Select (`wide`): nasce embaixo da pílula, alinhado à direita dela; vira para cima se não couber.
            property <bool> select: ov.wide;
            width: select ? clamp(max(ml.preferred-width, DeskArt.anchor-w), 200px, max(340px, DeskArt.anchor-w)) : (ov.title == "" ? 280px : 260px);
            height: min(ml.preferred-height, select ? 8 * 38px + 12px : root.height - 40px);
            x: clamp(select ? menu-x - self.width : menu-x, 12px, root.width - self.width - 12px);
            y: select && menu-y + self.height > root.height - 12px
                ? max(12px, menu-y - 6px - 36px - 6px - self.height)
                : clamp(menu-y, bar-menu ? Ui.space-8 : 12px, root.height - self.height - 12px);
            TouchArea { }
            // Até 8 opções visíveis no select; o resto rola.
            mf := Flickable {
                viewport-height: ml.preferred-height;
                ml := VerticalLayout {
                    width: mf.width;
                    padding: 6px;
                    spacing: 2px;
                    if ov.title != "": Text {
                        text: ov.title;
                        color: Ui.desk-on-subtle;
                        font-size: Ui.desk-label-sm;
                        font-weight: 600;
                        height: 30px;
                        vertical-alignment: center;
                        overflow: elide;
                        x: 10px;
                    }
                    for r[i] in ov.rows: Rectangle {
                        height: r.kind == "separator" ? 9px : (r.description != "" ? 54px : 36px);
                        border-radius: 10px;
                        background: r.kind != "separator" && mta.has-hover && r.enabled ? Ui.glass-hover : transparent;
                        animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                        opacity: r.enabled ? 1 : 0.5;
                        if r.kind == "separator": Rectangle { x: 8px; width: parent.width - 16px; height: 1px; background: Ui.divider; }
                        if focus-visible && i == ov.sel && top-most: FocusRing { radius: 10px; }
                        if r.kind != "separator": HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            // "Instalar pela": a coluna do ✓ (16) vem antes do ícone da loja.
                            if r.style == "offer": Rectangle { width: 16px; if r.on: DeskIcon { name: "tick"; size: 16px; tint: Ui.on-accent; } }
                            // No select, a coluna do ✓ (16) marca a atual, em peso 600.
                            if r.key == "updates" && !r.enabled: Ring { size: 18px; tint: Ui.on-accent; y: (parent.height - self.height) / 2; }
                            if !ov.wide && (r.key != "updates" || r.enabled): DeskIcon { name: r.icon; size: 18px; tint: r.style == "success" ? Ui.success : (r.style == "warning" ? Ui.warning : (r.style == "danger" ? Ui.error : Ui.desk-on-muted)); y: (parent.height - self.height) / 2; }
                            if ov.wide: Rectangle { width: 18px; DeskIcon { name: r.icon; size: 16px; tint: Ui.on-accent; } }
                            if r.style == "play-status": PlayStatusDot { status: r.value; y: (parent.height - self.height) / 2; }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 2px; alignment: center;
                                Text {
                                    text: r.title; color: r.style == "danger" ? Ui.error : Ui.on-accent;
                                    font-size: ov.wide ? 14px * Ui.text-scale : Ui.desk-label;
                                    font-weight: r.emphasized ? 600 : 500; overflow: elide;
                                }
                                if r.description != "": Text { text: r.description; color: Ui.desk-on-subtle; font-size: 12px * Ui.text-scale; overflow: elide; }
                            }
                            if r.value != "" && r.style != "play-status": Text {
                                text: r.value;
                                color: Ui.desk-on-subtle;
                                font-size: Ui.desk-keycap;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                        mta := TouchArea {
                            enabled: r.kind != "separator";
                            mouse-cursor: pointer;
                            clicked => { root.clicked("row", i); }
                        }
                    }
                }
            }
        }
    }
    // EtiquetasDoJogo: PainelLateral com as etiquetas do jogo como chips (× para tirar), o campo "+ Etiqueta" e as
    // sugestões presas ao campo (as existentes com o número de jogos e `Criar "…"`). `ov.tabs` = chips, `ov.tabs2` =
    // linha de cada chip, `ov.thumb-cols` = número de linhas, `ov.rows` = sugestões, `ov.preview-text` = "Tirar".
    if ov.kind == "tags": Rectangle {
        background: Ui.desk-canvas.with-alpha(shown ? 0.25 : 0);
        animate background { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        TouchArea { clicked => { root.clicked("outside", 0); } }
        Vidro {
            layer: true;
            x: parent.width - self.width - (parent.width < 1280px ? Ui.space-20 : Ui.space-36) + (shown ? 0 : 48px);
            opacity: shown ? 1 : 0;
            animate x, opacity { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            y: 84px;
            width: min(parent.width - 120px, 440px);
            height: min(parent.height - 84px - Ui.space-28, tl.preferred-height);
            TouchArea { }
            tl := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: Ui.space-12;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        if ov.overline != "": Text {
                            text: ov.overline;
                            color: Ui.desk-on-muted;
                            font-size: Ui.desk-overline;
                            font-weight: 700;
                            letter-spacing: 0.1 * self.font-size;
                            overflow: elide;
                        }
                        Text { text: ov.title; color: Ui.on-accent; font-family: Ui.font-heading; font-size: Ui.desk-title; font-weight: 700; wrap: word-wrap; }
                    }
                    CloseButton { label: close-label; size: 40px; clicked => { root.clicked("outside", 0); } }
                }
                if ov.text != "": Text { text: ov.text; color: Ui.desk-on-muted; font-size: Ui.desk-body; line-height-factor: 1.23; wrap: word-wrap; }
                // Chips, uma fileira por linha calculada pelo Tako.
                VerticalLayout {
                    spacing: 8px;
                    for line in ov.thumb-cols: HorizontalLayout {
                        height: 32px;
                        alignment: start;
                        for t[i] in ov.tabs: HorizontalLayout {
                          padding-right: ov.tabs2[i] == line + "" ? 8px : 0;
                          if ov.tabs2[i] == line + "": Rectangle {
                                width: ctxt.preferred-width + 14px + 34px;
                                height: 32px;
                                border-radius: self.height / 2;
                                background: Ui.glass-control;
                                border-width: 1px;
                                border-color: Ui.glass-edge;
                                ctxt := Text {
                                    x: 14px;
                                    text: t;
                                    color: Ui.on-accent;
                                    font-size: Ui.desk-label-sm;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                                // × de 16 dentro de uma área de clique de 24.
                                Rectangle {
                                    x: parent.width - 28px;
                                    y: (parent.height - 24px) / 2;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: xta.has-hover ? Ui.glass-hover : transparent;
                                    accessible-role: button;
                                    accessible-label: ov.preview-text + " " + t;
                                    DeskIcon { name: "close"; size: 14px; x: 5px; y: 5px; tint: Ui.desk-on-muted; }
                                    xta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked("chip", i); } }
                                }
                            }
                          }
                        }
                    }
                // Campo no fim da fileira.
                Rectangle {
                    height: Ui.control-height;
                    border-radius: Ui.radius-control;
                    background: Ui.glass-control;
                    border-width: 1px;
                    border-color: tti.has-focus ? Ui.glass-edge-strong : Ui.glass-edge;
                    property <string> typed: ov.input;
                    changed typed => { if (tti.text != ov.input) { tti.text = ov.input; } }
                    if tti.text == "": Text {
                        x: 14px;
                        width: parent.width - 28px;
                        text: ov.input-hint;
                        color: Ui.desk-on-subtle;
                        font-size: Ui.desk-label;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    FocusScope {
                        x: 14px;
                        width: parent.width - 28px;
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                root.clicked("cancel", 0);
                                return accept;
                            }
                            if (e.text == Key.DownArrow) {
                                root.clicked("move", 1);
                                return accept;
                            }
                            if (e.text == Key.UpArrow) {
                                root.clicked("move", 0);
                                return accept;
                            }
                            if (e.text == Key.Backspace && tti.text == "") {
                                root.clicked("backspace", 0);
                                return accept;
                            }
                            reject
                        }
                        tti := TextInput {
                            width: parent.width;
                            height: parent.height;
                            color: Ui.on-accent;
                            font-size: Ui.desk-label;
                            vertical-alignment: center;
                            single-line: true;
                            selection-background-color: Ui.glass-pressed;
                            init => { self.text = ov.input; self.focus(); }
                            edited => { root.edited("overlay-input", self.text); }
                            accepted => { root.clicked("done", 0); }
                        }
                    }
                }
                // Sugestões: a lista do MenuDeContexto junto do campo.
                if ov.rows.length > 0: Rectangle {
                    height: min(ov.rows.length * 38px + 12px, 280px);
                    border-radius: Ui.radius-control;
                    background: Ui.glass-solid;
                    border-width: 1px;
                    border-color: Ui.glass-edge-strong;
                    Flickable {
                        y: 6px;
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height - 12px;
                        viewport-height: ov.rows.length * 38px;
                        for r[i] in ov.rows: Rectangle {
                            y: i * 38px;
                            height: 36px;
                            border-radius: 10px;
                            background: i == ov.sel ? Ui.focus-fill : (rta.has-hover ? Ui.glass-hover : transparent);
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                if r.icon != "": DeskIcon { name: r.icon; size: 16px; tint: Ui.on-accent; y: (parent.height - self.height) / 2; }
                                Text { text: r.title; color: Ui.on-accent; font-size: 14px * Ui.text-scale; font-weight: r.key == "create" ? 600 : 500; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                if r.value != "": Text { text: r.value; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; vertical-alignment: center; }
                            }
                            rta := TouchArea {
                                mouse-cursor: pointer;
                                moved => { root.hovered("row", i); }
                                clicked => { root.clicked("row", i); }
                            }
                        }
                    }
                }
            }
        }
    }
    // Campo de texto (CampoDeTexto): diálogo de 480 com o teclado do computador, colar e seleção; Enter confirma, Esc
    // cancela.
    if ov.kind == "keyboard": Rectangle {
        background: Ui.desk-canvas.with-alpha(shown ? 0.6 : 0);
        animate background { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        TouchArea { }
        Vidro {
            layer: true;
            opacity: shown ? 1 : 0;
            transform-scale: shown ? 1 : Ui.escala-entrada;
            animate opacity, transform-scale { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            width: min(parent.width - 80px, 480px);
            height: kl.preferred-height;
            kl := VerticalLayout {
                padding: Ui.space-24;
                spacing: 14px;
                HorizontalLayout {
                    Text { text: ov.title; color: Ui.on-accent; font-family: Ui.font-heading; font-size: Ui.desk-title; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; }
                    CloseButton { label: close-label; clicked => { root.clicked("cancel", 0); } }
                }
                Rectangle {
                    height: Ui.control-height;
                    border-radius: Ui.radius-control;
                    background: Ui.glass-control;
                    border-width: 1px;
                    border-color: Ui.glass-edge-strong;
                    FocusScope {
                        x: 14px;
                        width: parent.width - 28px;
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                root.clicked("cancel", 0);
                                return accept;
                            }
                            reject
                        }
                        ki := TextInput {
                            width: parent.width;
                            height: parent.height;
                            color: Ui.on-accent;
                            font-size: Ui.desk-label;
                            vertical-alignment: center;
                            single-line: true;
                            input-type: ov.secret ? InputType.password : InputType.text;
                            selection-background-color: Ui.glass-pressed;
                            init => {
                                self.text = ov.input;
                                self.focus();
                                self.select-all();
                            }
                            edited => { root.edited("overlay-input", self.text); }
                            accepted => { root.clicked("done", 0); }
                        }
                    }
                }
                if ov.text != "": Text { text: ov.text; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    PopupButton { data: { kind: "button", title: cancel-label, enabled: true }; clicked => { root.clicked("cancel", 0); } }
                    PopupButton { data: { kind: "button", title: ok-label, style: "primary", enabled: true }; clicked => { root.clicked("done", 0); } }
                }
            }
        }
    }
}

// Fundo da janela. Na biblioteca, a arte do jogo em foco, nítida, na altura da janela; nas bordas (atrás da lista e à
// direita) ela se funde com a cópia desfocada misturada a 45% do accent, como uma luz da cor do jogo; escurecida só
// atrás do título e embaixo dos cartões. Sem arte, um degradê do accent. Nas Configurações, o cinza `settings-bg`.
// Capa pequena da TelaPerfil: o quadrado do topo da capa; sem capa, o degradê da cor do jogo.
component ProfileThumb inherits Rectangle {
    in property <DeskEntry> data;
    in property <length> radius: Ui.radius-thumb;
    border-radius: radius;
    clip: true;
    background: @linear-gradient(160deg, data.accent.mix(Ui.desk-canvas, 0.55) 0%, data.accent.mix(Ui.desk-canvas, 0.25) 100%);
    Image { width: parent.width; height: parent.height; source: data.thumb; image-fit: cover; vertical-alignment: top; }
    Rectangle { border-radius: root.radius; border-width: 1px; border-color: Ui.glass-edge; }
}

// Linha de sessão (TelaPerfil › Sessões recentes e PerfilSessoes): capa, jogo, quando, o total do jogo e a duração.
component ProfileSessionRow inherits Rectangle {
    in property <DeskEntry> data;
    in property <bool> focused;
    in property <bool> small;
    in property <length> thumb: 48px;
    callback clicked();
    // Ao ganhar o foco do teclado, a rolagem traz a linha para a tela.
    callback reveal(length, length);
    changed focused => {
        if (focused) {
            root.reveal(self.absolute-position.y, self.height);
        }
    }
    border-radius: Ui.radius-row;
    background: ta.has-hover ? Ui.glass-hover : transparent;
    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    accessible-role: list-item;
    accessible-label: data.title + " · " + data.detail + " · " + data.value;
    if focused: FocusRing { }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: small ? 12px : 18px;
        ProfileThumb { data: data; width: root.thumb; height: root.thumb; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;
            Text { text: data.title; color: Ui.on-accent; font-size: Ui.desk-label-lg; font-weight: 600; overflow: elide; }
            HorizontalLayout {
                spacing: 8px;
                if data.dot: Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: Ui.success;
                }
                Text { text: data.detail; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; overflow: elide; horizontal-stretch: 1; }
            }
        }
        if data.note != "" && !small: Text {
            width: 220px;
            text: data.note;
            color: Ui.desk-on-muted;
            font-size: Ui.desk-label-sm;
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: small ? 96px : 120px;
            text: data.value;
            color: Ui.on-accent;
            font-size: Ui.desk-label;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Bloco da Visão geral (vidro denso, 310 de altura): o visual em cima e, abaixo da divisória, rótulo e valor grande.
// No foco (mouse, teclado ou controle) cresce 2,5% com o foco suave; com Reduzir animações, fica do tamanho.
component ProfileTile inherits Vidro {
    in property <DeskInfo> info;
    in property <bool> focused;
    in property <bool> small;
    callback clicked();
    dense: true;
    accessible-role: button;
    accessible-label: info.label + ": " + info.value;
    transform-scale: (focused || ta.has-hover) && !Ui.reduce-motion ? 1.025 : 1;
    animate transform-scale { duration: Ui.focus-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    if focused: FocusRing { radius: Ui.radius-card; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding-top: small ? 16px : 22px;
        padding-left: small ? 16px : 24px;
        padding-right: small ? 16px : 24px;
        padding-bottom: small ? 16px : 24px;
        spacing: small ? 12px : 16px;
        Rectangle {
            vertical-stretch: 1;
            @children
        }
        Rectangle { height: 1px; background: Ui.divider; }
        VerticalLayout {
            spacing: 6px;
            Text { text: info.label; color: Ui.desk-on-muted; font-size: Ui.desk-label; font-weight: 500; overflow: elide; }
            Text { text: info.value; color: Ui.on-accent; font-size: small ? Ui.desk-title : Ui.desk-headline; font-weight: 700; overflow: elide; }
        }
    }
}

// Cartão de coleção (PerfilColecoes): mosaico com até 4 capas, nome, quantidade e o selo Automática.
component ProfileCard inherits Vidro {
    in property <DeskCard> card;
    in property <bool> focused;
    in property <string> auto-label;
    callback clicked();
    dense: true;
    accessible-role: button;
    accessible-label: card.title + " · " + card.count + (card.auto ? " · " + auto-label : "");
    transform-scale: (focused || ta.has-hover) && !Ui.reduce-motion ? 1.025 : 1;
    animate transform-scale { duration: Ui.focus-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    if focused: FocusRing { radius: Ui.radius-card; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        mosaic := Rectangle {
            vertical-stretch: 1;
            border-radius: 12px;
            clip: true;
            property <int> n: card.covers.length;
            property <length> half-w: (self.width - 4px) / 2;
            property <length> half-h: (self.height - 4px) / 2;
            // Coleção vazia: o mosaico só com o contorno.
            if n == 0: Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: Ui.glass-item-edge;
            }
            // 1 capa ocupa tudo; 2 lado a lado; 3: duas em cima e a terceira na metade de baixo; 4: 2 × 2.
            for c[i] in card.covers: ProfileThumb {
                data: c;
                radius: 0;
                x: n == 1 || (n == 3 && i == 2) ? 0 : mod(i, 2) * (mosaic.half-w + 4px);
                y: n <= 2 ? 0 : floor(i / 2) * (mosaic.half-h + 4px);
                width: n == 1 || (n == 3 && i == 2) ? mosaic.width : mosaic.half-w;
                height: n <= 2 ? mosaic.height : mosaic.half-h;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            padding-left: 4px;
            padding-right: 4px;
            VerticalLayout {
                spacing: 5px;
                horizontal-stretch: 1;
                Text { text: card.title; color: Ui.on-accent; font-size: Ui.desk-label-lg; font-weight: 650; overflow: elide; }
                Text { text: card.count; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; font-weight: 500; overflow: elide; }
            }
            if card.auto: Rectangle {
                y: parent.height - self.height;
                height: 24px;
                width: al.preferred-width;
                border-radius: 12px;
                background: Ui.glass-control;
                border-width: 1px;
                border-color: Ui.glass-edge-strong;
                al := HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 5px;
                    DeskIcon { name: "layers"; size: 13px; y: (parent.height - self.height) / 2; }
                    Text { text: auto-label; color: Ui.on-accent; font-size: Ui.desk-overline; font-weight: 600; vertical-alignment: center; }
                }
            }
        }
    }
}

// TelaPerfil (UX-004, SESSION-002): identidade, guias de texto, ações em ícone e o conteúdo da guia (Visão geral,
// Sessões, Coleções), com a arte do mais jogado do mês no fundo. Família e Conquistas só com o backend deles.
component DeskProfileScreen inherits Rectangle {
    in property <DeskProfile> p;
    in property <bool> focus-visible;
    in property <bool> small;
    callback clicked(string, int);
    // Entra como página (TrocaDeTela): de 16 px ao lado, em `tempo-pagina`.
    property <bool> shown;
    Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            shown = true;
        }
    }
    opacity: shown ? 1 : 0;
    x: shown ? 0 : 16px;
    animate opacity, x { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    // Troca de guia (abas internas): o conteúdo sai em 80 e o novo entra em 120, só opacidade.
    property <bool> tab-in: true;
    changed cur-tab => {
        tab-in = false;
        tab-timer.running = true;
    }
    property <int> cur-tab: p.tab;
    tab-timer := Timer {
        interval: max(1ms, Ui.focus-time / 2);
        running: false;
        triggered => {
            self.running = false;
            tab-in = true;
            fl.viewport-y = 0;
        }
    }
    property <bool> kb: focus-visible;
    property <length> gap: small ? 16px : 24px;
    property <length> avatar: small ? 72px : 120px;
    // Três blocos iguais (o texto de cada um não muda a largura).
    property <length> tile-w: (fl.width - 2 * gap) / 3;
    // Foco do teclado na barra, nas guias ou nas ações: a página volta ao topo.
    changed zone => {
        if (zone == "bar" || zone == "tabs" || zone == "actions") {
            fl.viewport-y = 0;
        }
    }
    property <string> zone: p.zone;
    // Traz para a tela o que ganhou o foco do teclado (`top` na janela).
    function reveal(top: length, h: length) {
        if (!kb) {
            return;
        }
        if (top - fl.absolute-position.y < 0) {
            fl.viewport-y = min(0, fl.viewport-y - (top - fl.absolute-position.y) + 12px);
        } else if (top + h > fl.absolute-position.y + fl.height) {
            fl.viewport-y = max(fl.height - fl.viewport-height, fl.viewport-y - (top + h - fl.absolute-position.y - fl.height) - 12px);
        }
    }
    fl := Flickable {
        viewport-height: col.preferred-height;
        col := VerticalLayout {
            width: fl.width;
            padding-top: small ? 8px : 30px;
            padding-bottom: Ui.space-16;
            spacing: 0;
            // Identidade: avatar com a inicial (ponto verde com um jogo aberto), nome e a linha de estado.
            HorizontalLayout {
                spacing: small ? 20px : 30px;
                Rectangle {
                    width: avatar + 8px;
                    height: self.width;
                    border-radius: self.width / 2;
                    // Cores sólidas: o renderizador de software não arredonda degradês.
                    background: #ffffff26;
                    Rectangle {
                        width: avatar;
                        height: avatar;
                        border-radius: avatar / 2;
                        background: Ui.accent.mix(Ui.accent-deep, 0.5);
                        animate background { duration: Ui.art-fade(true); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                        border-width: 1px;
                        border-color: #ffffff2e;
                        Text { text: p.initial; color: Ui.on-accent; font-size: avatar * 0.42; font-weight: 700; }
                    }
                    if p.playing: Rectangle {
                        x: parent.width - self.width - 6px;
                        y: parent.height - self.height - 6px;
                        width: small ? 16px : 22px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Ui.success;
                        border-width: 4px;
                        border-color: #10131a;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: small ? 8px : 12px;
                    horizontal-stretch: 1;
                    Text {
                        text: p.name;
                        accessible-role: text;
                        accessible-label: p.name;
                        color: Ui.on-accent;
                        font-size: small ? Ui.desk-headline * 1.3 : Ui.desk-display;
                        font-weight: 800;
                        letter-spacing: -0.025 * self.font-size;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 14px;
                        for it[i] in p.line: HorizontalLayout {
                            spacing: 14px;
                            if i > 0: Rectangle { width: 1px; height: 16px; y: (parent.height - self.height) / 2; background: Ui.glass-item-edge; }
                            if it.dot: Rectangle {
                                width: 8px;
                                height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Ui.success;
                            }
                            Text {
                                text: it.label;
                                color: it.dot ? Ui.on-accent : Ui.desk-on-muted;
                                font-size: small ? Ui.desk-label : Ui.desk-label-lg;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            Rectangle { height: small ? 16px : 34px; }
            // Guias de texto (a atual com o traço de 3 embaixo) e, à direita, as ações em ícone redondo.
            HorizontalLayout {
                spacing: small ? 24px : 36px;
                for t[i] in p.tabs: Rectangle {
                    width: tt.preferred-width;
                    height: tt.preferred-height + 24px;
                    accessible-role: tab;
                    accessible-label: t;
                    property <bool> focused: kb && p.zone == "tabs" && p.index == i;
                    if focused: FocusRing { radius: Ui.radius-thumb; }
                    tt := Text {
                        y: 10px;
                        text: t;
                        color: i == p.tab || tta.has-hover || focused ? Ui.on-accent : Ui.desk-on-muted;
                        font-size: small ? Ui.desk-label-lg : Ui.desk-title;
                        font-weight: i == p.tab ? 650 : 500;
                        animate color { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                    }
                    if i == p.tab: Rectangle {
                        y: parent.height - self.height;
                        height: 3px;
                        border-radius: 2px;
                        background: Ui.on-accent;
                    }
                    tta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.clicked("profile-tab", i); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                for a[i] in p.actions: Rectangle {
                    property <bool> focused: kb && p.zone == "actions" && p.index == i;
                    y: (parent.height - self.height) / 2;
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: focused ? Ui.focus-fill : (ata.has-hover ? Ui.glass-hover : Ui.glass-control);
                    border-width: 1px;
                    border-color: focused ? Ui.focus-ring : Ui.glass-edge;
                    animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                    accessible-role: button;
                    accessible-label: a.label;
                    DeskIcon { name: a.icon; size: 21px; }
                    ata := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.clicked("profile-action", i); }
                    }
                    // O nome aparece acima do ícone no hover e no foco do teclado.
                    if ata.has-hover || focused: Rectangle {
                        y: -self.height - 10px;
                        x: (parent.width - self.width) / 2;
                        width: an.preferred-width + 20px;
                        height: 28px;
                        border-radius: Ui.radius-thumb;
                        background: Ui.glass-panel-dense;
                        border-width: 1px;
                        border-color: Ui.glass-edge-strong;
                        an := Text { text: a.label; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 600; }
                    }
                }
            }
            Rectangle { height: small ? 14px : 22px; }

            // ── Visão geral: Tempo jogado · Mais jogado · Jogos na biblioteca, e as sessões recentes.
            if p.tab == 0: VerticalLayout {
                opacity: tab-in ? 1 : 0;
                animate opacity { duration: Ui.list-fade(tab-in); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                spacing: 0;
                HorizontalLayout {
                    spacing: gap;
                    // Texto maior (125%): o bloco cresce junto para o valor não encostar na borda.
                    height: (small ? 236px : 310px) + max(0, Ui.text-scale - 1) * 160px;
                    // Tempo jogado: a semana em barras, só hoje com o valor e em branco; dia que não chegou, contornado.
                    ProfileTile {
                        width: tile-w;
                        info: p.tiles[0];
                        small: root.small;
                        focused: kb && p.zone == "tiles" && p.index == 0;
                        clicked => { root.clicked("profile-tile", 0); }
                        VerticalLayout {
                            spacing: 14px;
                            HorizontalLayout {
                                Text { text: p.week-label; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; font-weight: 500; horizontal-stretch: 1; }
                                Text { text: p.week-total; color: Ui.on-accent; font-size: Ui.desk-label-sm; font-weight: 650; }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                accessible-role: image;
                                accessible-label: p.week-text;
                                property <length> bar-gap: small ? 5px : 8px;
                                property <length> slot: (self.width - 6 * bar-gap) / 7;
                                for b[i] in p.week: Rectangle {
                                    x: i * (parent.slot + parent.bar-gap);
                                    width: parent.slot;
                                    property <length> label-h: 12px * Ui.text-scale;
                                    // Até onde o valor de hoje pode ir sem sair do gráfico.
                                    property <length> right-room: parent.width - self.x;
                                    property <length> room: self.height - 2 * self.label-h - 14px;
                                    property <length> bar-w: min(30px, self.width);
                                    Text {
                                        y: parent.height - self.height;
                                        text: b.label;
                                        color: b.today ? Ui.on-accent : Ui.desk-on-muted;
                                        font-size: Ui.desk-overline * 0.92;
                                        font-weight: 600;
                                    }
                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        width: parent.bar-w;
                                        height: b.future ? parent.room : parent.room * b.fraction;
                                        y: parent.height - parent.label-h - 7px - self.height;
                                        border-radius: 4px;
                                        background: b.future ? transparent : (b.today ? Ui.primary-top : Ui.glass-item-highlight);
                                        border-width: b.future ? 1px : 0;
                                        border-color: Ui.glass-item-edge;
                                        drop-shadow-blur: b.today ? 16px : 0;
                                        drop-shadow-color: b.today ? #ffffff40 : transparent;
                                    }
                                    if b.value != "": Text {
                                        width: self.preferred-width;
                                        x: max(-parent.x, min((parent.width - self.width) / 2, parent.right-room - self.width));
                                        y: parent.height - parent.label-h - 14px - parent.room * b.fraction - self.height;
                                        text: b.value;
                                        color: Ui.on-accent;
                                        font-size: Ui.desk-overline;
                                        font-weight: 700;
                                        wrap: no-wrap;
                                    }
                                }
                            }
                        }
                    }
                    // Mais jogado: três jogos com capa, horas e trilho proporcional (o primeiro em branco).
                    ProfileTile {
                        width: tile-w;
                        info: p.tiles[1];
                        small: root.small;
                        focused: kb && p.zone == "tiles" && p.index == 1;
                        clicked => { root.clicked("profile-tile", 1); }
                        VerticalLayout {
                            alignment: start;
                            spacing: small ? 10px : 14px;
                            for e[i] in p.top: HorizontalLayout {
                                spacing: 14px;
                                ProfileThumb { data: e; width: small ? 36px : 52px; height: self.width; }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: e.title; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                                        Text { text: e.value; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; font-weight: 500; }
                                    }
                                    Rectangle {
                                        height: 4px;
                                        border-radius: 2px;
                                        background: Ui.glass-control;
                                        Rectangle {
                                            x: 0;
                                            width: parent.width * e.fraction;
                                            border-radius: 2px;
                                            background: i == 0 ? Ui.primary-top : Ui.glass-item-highlight;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Jogos na biblioteca: leque com as três últimas capas, a mais recente na frente.
                    ProfileTile {
                        width: tile-w;
                        info: p.tiles[2];
                        small: root.small;
                        focused: kb && p.zone == "tiles" && p.index == 2;
                        clicked => { root.clicked("profile-tile", 2); }
                        Rectangle {
                            property <float> k: small ? 0.7 : 1;
                            width: 236px * k;
                            height: 140px * k;
                            for e[i] in p.fan: ProfileThumb {
                                property <bool> front: i == p.fan.length - 1;
                                data: e;
                                radius: 14px;
                                width: (front ? 116px : 92px) * parent.k;
                                height: self.width;
                                x: front ? 60px * parent.k : (i == 0 ? 0 : parent.width - self.width);
                                y: (front ? 8px : 26px) * parent.k;
                                transform-rotation: front ? 0deg : (i == 0 ? -7deg : 7deg);
                                drop-shadow-offset-y: 10px;
                                drop-shadow-blur: 26px;
                                drop-shadow-color: #00000073;
                            }
                        }
                    }
                }
                // Sessões recentes (com "Ver todas"), na rolagem.
                HorizontalLayout {
                    padding-top: small ? 20px : 34px;
                    padding-bottom: 12px;
                    Text { text: p.recent-title; color: Ui.on-accent; font-size: Ui.desk-title; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; accessible-role: text; }
                    if p.recent.length > 0: Rectangle {
                        width: sl.preferred-width + 12px;
                        border-radius: Ui.radius-thumb;
                        background: sla.has-hover ? Ui.glass-hover : transparent;
                        accessible-role: button;
                        accessible-label: p.see-all;
                        sl := HorizontalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: p.see-all; color: sla.has-hover ? Ui.on-accent : Ui.desk-on-muted; font-size: Ui.desk-label-sm; font-weight: 500; vertical-alignment: center; }
                            DeskIcon { name: "chevron"; size: 15px; tint: Ui.desk-on-muted; y: (parent.height - self.height) / 2; }
                        }
                        sla := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clicked("profile-see-all", 0); }
                        }
                    }
                }
                Vidro {
                    dense: true;
                    VerticalLayout {
                        padding-left: small ? 8px : 14px;
                        padding-right: small ? 8px : 14px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        if p.recent.length == 0: Text {
                            height: 72px;
                            text: p.empty;
                            color: Ui.desk-on-muted;
                            font-size: Ui.desk-label;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        for e[i] in p.recent: VerticalLayout {
                            if i > 0: Rectangle { height: 1px; background: Ui.divider; }
                            ProfileSessionRow {
                                height: small ? 60px : 72px;
                                data: e;
                                small: root.small;
                                thumb: small ? 40px : 48px;
                                focused: kb && p.zone == "list" && p.index == i;
                                clicked => { root.clicked("profile-row", i); }
                                reveal(t, h) => { root.reveal(t, h); }
                            }
                        }
                    }
                }
            }

            // ── Sessões: período (Esta semana · Este mês · Tudo), o resumo e a lista agrupada por dia.
            if p.tab == 1: VerticalLayout {
                opacity: tab-in ? 1 : 0;
                animate opacity { duration: Ui.list-fade(tab-in); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                spacing: 18px;
                HorizontalLayout {
                    spacing: 14px;
                    Vidro {
                        width: small ? 300px : 360px;
                        height: 46px;
                        radius: Ui.radius-control;
                        Tabs {
                            y: 3px;
                            tabs: p.periods;
                            current: p.period;
                            focus-index: kb && p.zone == "periods" ? p.index : -1;
                            clicked(i) => { root.clicked("profile-period", i); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: p.summary; color: Ui.desk-on-muted; font-size: Ui.desk-label; font-weight: 500; vertical-alignment: center; }
                }
                Vidro {
                    dense: true;
                    VerticalLayout {
                        padding-left: small ? 8px : 14px;
                        padding-right: small ? 8px : 14px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        if p.sessions.length == 0: Text {
                            height: 72px;
                            text: p.empty;
                            color: Ui.desk-on-muted;
                            font-size: Ui.desk-label;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        // As linhas contam sem os cabeçalhos (o Tako recebe o índice da sessão).
                        for e[i] in p.sessions: VerticalLayout {
                            if e.header: HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 18px;
                                padding-bottom: 8px;
                                spacing: 10px;
                                Text { text: e.title; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 700; }
                                Text { text: e.detail; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; font-weight: 500; horizontal-stretch: 1; }
                                Text { text: e.value; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; font-weight: 600; }
                            }
                            if !e.header: Rectangle { height: 1px; background: Ui.divider; }
                            if !e.header: ProfileSessionRow {
                                height: small ? 56px : 64px;
                                data: e;
                                small: root.small;
                                thumb: small ? 36px : 44px;
                                focused: kb && p.zone == "list" && p.index == e.row;
                                clicked => { root.clicked("profile-row", e.row); }
                                reveal(t, h) => { root.reveal(t, h); }
                            }
                        }
                    }
                }
            }

            // ── Coleções: resumo e a grade de cartões (as do usuário e as automáticas), com Nova coleção no fim.
            if p.tab == 2: VerticalLayout {
                opacity: tab-in ? 1 : 0;
                animate opacity { duration: Ui.list-fade(tab-in); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                spacing: 18px;
                Text { text: p.cards-summary; color: Ui.desk-on-muted; font-size: Ui.desk-label; font-weight: 500; height: 30px; vertical-alignment: center; }
                grid := Rectangle {
                    property <int> cols: 4;
                    property <length> card-w: (self.width - (cols - 1) * gap) / cols;
                    property <length> card-h: small ? 190px : 236px;
                    property <int> rows: ceil((p.cards.length + 1) / cols);
                    height: rows * card-h + (rows - 1) * gap;
                    for c[i] in p.cards: ProfileCard {
                        x: mod(i, grid.cols) * (grid.card-w + gap);
                        y: floor(i / grid.cols) * (grid.card-h + gap);
                        width: grid.card-w;
                        height: grid.card-h;
                        card: c;
                        auto-label: p.auto-label;
                        focused: kb && p.zone == "list" && p.index == i;
                        clicked => { root.clicked("profile-row", i); }
                        changed focused => {
                            if (self.focused) {
                                root.reveal(self.absolute-position.y, self.height);
                            }
                        }
                    }
                    // Nova coleção: cartão contornado, sempre depois das coleções.
                    Rectangle {
                        property <int> i: p.cards.length;
                        property <bool> focused: kb && p.zone == "list" && p.index == i;
                        changed focused => {
                            if (focused) {
                                root.reveal(self.absolute-position.y, self.height);
                            }
                        }
                        x: mod(i, grid.cols) * (grid.card-w + gap);
                        y: floor(i / grid.cols) * (grid.card-h + gap);
                        width: grid.card-w;
                        height: grid.card-h;
                        border-radius: Ui.radius-card;
                        border-width: 1.5px;
                        border-color: Ui.glass-item-edge;
                        background: nta.has-hover ? Ui.glass-hover : transparent;
                        animate background { duration: Ui.tempo-hover; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                        accessible-role: button;
                        accessible-label: p.new-label;
                        if focused: FocusRing { radius: Ui.radius-card; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            padding: 14px;
                            HorizontalLayout {
                                alignment: center;
                                DeskIcon { name: "plus"; size: 24px; }
                            }
                            Text { text: p.new-label; color: Ui.on-accent; font-size: Ui.desk-label-lg; font-weight: 650; horizontal-alignment: center; overflow: elide; }
                            Text { text: p.new-text; color: Ui.desk-on-muted; font-size: Ui.desk-label-sm; font-weight: 500; horizontal-alignment: center; wrap: word-wrap; }
                        }
                        nta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clicked("profile-row", i); }
                        }
                    }
                }
            }
        }
    }
}

component ArtLayer inherits Rectangle {
    in property <image> art;
    // Troca de jogo (TrocaDeJogo): a arte que está na tela fica opaca embaixo; a nova entra por cima (700),
    // assentando de 1,04 a 1 (900) com a cópia desfocada dela saindo (500). Nunca as duas em fade juntas.
    // Sem ligação (`top-src: art`): senão, ao trocar, a "antiga" já seria a nova.
    property <image> top-src;
    property <image> bottom-src;
    property <bool> top-in: true;
    // Opacidade da de cima; a cópia desfocada dela (`DeskArt.blur`) entra no vidro e nas bordas no mesmo passo.
    property <float> top-alpha: top-in ? 1 : 0;
    animate top-alpha { duration: Ui.art-fade(top-in); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    // A cópia que acompanha a arte de cima (vira a de baixo na próxima troca).
    property <image> blur-top;
    init => {
        top-src = art;
        blur-top = DeskArt.blur;
    }
    changed art => {
        // Troca interrompida: fica embaixo a que mais aparece no quadro (a de cima só se já passou da metade).
        if (top-alpha >= 0.5) {
            bottom-src = top-src;
            DeskArt.blur-old = blur-top;
        }
        top-src = art;
        blur-top = DeskArt.blur;
        top-in = false;
        DeskArt.blur-in = false;
        top-timer.running = true;
    }
    top-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            top-in = true;
            DeskArt.blur-in = true;
        }
    }
    // Máscara das bordas em faixas (o Slint não tem máscara): opaca até 12%, some em 30%, volta de 62% a 92%.
    property <int> strips: 128;
    pure function edge(t: float) -> float {
        return t < 0.12 ? 1 : (t < 0.30 ? (0.30 - t) / 0.18 : (t < 0.62 ? 0 : (t < 0.92 ? (t - 0.62) / 0.30 : 1)));
    }
    background: DeskArt.gray ? Ui.settings-bg : Ui.desk-canvas;
    animate background { duration: Ui.color-time; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    Rectangle {
        opacity: DeskArt.gray ? 0 : 1;
        animate opacity { duration: Ui.color-time; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        if !DeskArt.has-art: Rectangle {
            background: @linear-gradient(160deg, DeskArt.accent 0%, DeskArt.accent-deep 100%);
            animate background { duration: Ui.art-fade(true); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
            // Brilho suave no alto à direita (EstadoSemArte).
            Rectangle {
                x: parent.width * 0.55;
                y: -parent.height * 0.35;
                width: parent.width * 0.7;
                height: parent.width * 0.7;
                background: @radial-gradient(circle, Ui.on-accent.with-alpha(0.08) 0%, Ui.on-accent.with-alpha(0) 70%);
            }
        }
        if DeskArt.has-art: Rectangle {
            Image {
                x: DeskArt.x;
                y: DeskArt.y;
                width: DeskArt.w;
                height: DeskArt.h;
                source: root.bottom-src;
                image-fit: fill;
            }
            // A nova, por cima: 1,04 → 1 a partir do centro, vindo 18 da direita.
            property <float> grow: root.top-in ? 1 : 1.04;
            animate grow { duration: Ui.art-settle(root.top-in); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            property <length> shift: root.top-in ? 0 : 18px;
            animate shift { duration: Ui.art-settle(root.top-in); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            Image {
                width: DeskArt.w * parent.grow;
                height: DeskArt.h * parent.grow;
                x: DeskArt.x - (self.width - DeskArt.w) / 2 + parent.shift;
                y: DeskArt.y - (self.height - DeskArt.h) / 2;
                source: root.top-src;
                image-fit: fill;
                opacity: root.top-alpha;
                // O desfoque sai: a cópia desfocada da mesma arte por cima, de 1 a 0 (o Slint não anima `blur`).
                if DeskArt.blur.width > 0: Image {
                    width: parent.width;
                    height: parent.height;
                    source: DeskArt.blur;
                    image-fit: fill;
                    opacity: root.top-in ? 0 : 1;
                    // Sai de 120 a 620: a imagem nítida já está aparecendo quando o desfoque começa a sair.
                    animate opacity { duration: Ui.art-unblur(root.top-in); delay: Ui.art-unblur-delay(root.top-in); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                }
            }
            if DeskArt.blur.width > 0: Rectangle {
                for i in strips: Rectangle {
                    // Faixas em px inteiros e sem sobreposição: nada de costura entre elas.
                    x: round(i * root.width / strips / 1px) * 1px;
                    width: round((i + 1) * root.width / strips / 1px) * 1px - self.x;
                    clip: true;
                    opacity: root.edge((i + 0.5) / strips);
                    visible: self.opacity > 0;
                    Image {
                        x: DeskArt.bx - parent.x;
                        y: DeskArt.y;
                        width: DeskArt.bw;
                        height: DeskArt.h;
                        source: DeskArt.blur-old;
                        image-fit: fill;
                    }
                    Image {
                        x: DeskArt.bx - parent.x;
                        y: DeskArt.y;
                        width: DeskArt.bw;
                        height: DeskArt.h;
                        source: DeskArt.blur;
                        image-fit: fill;
                        opacity: root.top-alpha;
                    }
                    Rectangle {
                        background: DeskArt.accent.with-alpha(0.45);
                        animate background { duration: Ui.art-fade(true); easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                    }
                }
            }
        }
        // Escurecimento: leve atrás da lista (a arte aparece pelo vidro), 70% atrás do título, nada à direita.
        Rectangle {
            background: DeskArt.small
                ? @linear-gradient(90deg, Ui.art-scrim-left.with-alpha(0.35) 0%, Ui.art-scrim-left.with-alpha(0.35) 30%,
                    Ui.art-scrim-left 36%, Ui.art-scrim-left 74%, Ui.art-scrim-left.with-alpha(0) 90%)
                : @linear-gradient(90deg, Ui.art-scrim-left.with-alpha(0.35) 0%, Ui.art-scrim-left.with-alpha(0.35) 20%,
                    Ui.art-scrim-left 27%, Ui.art-scrim-left 50%, Ui.art-scrim-left.with-alpha(0) 66%);
        }
        Rectangle {
            background: @linear-gradient(0deg, Ui.art-scrim-bottom 0%, Ui.art-scrim-bottom.with-alpha(0) 40%);
        }
    }
}

export component Desktop inherits Window {
    in property <bool> control-center;
    in property <[PanelRow]> cc-icons;
    in property <int> cc-icon-focus;
    in property <int> cc-panel-for: -1;
    in property <[PanelRow]> cc-panel;
    in property <int> cc-panel-focus: -1;
    in property <string> cc-game-title;
    in property <string> cc-game-meta;
    // Geral.
    in property <string> page: "desk-library";
    in property <string> toast;
    in property <[Overlay]> overlays;
    in property <bool> leaving;
    in property <image> backdrop;

    // Barra de cima.
    in property <[DeskNav]> desk-nav;
    in property <string> desk-big-picture-label;
    in property <string> desk-brand-label;
    in property <string> desk-search-key;
    in property <string> desk-search-esc;
    in property <string> desk-cancel-label;
    in property <string> desk-toast-undo;
    // "Bem-vindo de volta": o polvo no lugar do ✓ do aviso (BRAND-001).
    in property <bool> desk-toast-mascot;
    in property <string> desk-ok-label;
    in property <int> desk-search-focus;
    in property <bool> desk-focus-visible;

    // Biblioteca.
    in property <[string]> desk-tabs;
    in property <int> desk-tab;
    in property <[DeskNav]> desk-collections;
    in property <DeskNav> desk-collection;
    in property <string> desk-search;
    in property <string> desk-search-hint;
    in property <string> desk-filter-label;
    in property <int> desk-filter-count;
    in property <[[PanelRow]]> desk-filter-chips;
    in property <bool> desk-filtered;
    in property <string> desk-clear-label;
    in property <string> desk-count;
    in property <string> desk-count-short;
    in property <[DeskGame]> desk-games;
    in property <int> desk-selected: -1;
    in property <[DeskBlock]> desk-blocks;
    in property <[int]> desk-grid-extent;
    in property <[int]> desk-grid-focus;
    in property <string> desk-focus-id;
    in property <int> desk-focus-group: -1;
    in property <DeskGameView> desk-game;
    in property <DeskMore> desk-more;
    in property <[PanelRow]> desk-actions;
    in property <[DeskInfo]> desk-stats;
    in property <[DeskInfo]> desk-details;
    in property <string> desk-sessions-summary;
    in property <[DeskInfo]> desk-sessions;
    in property <[string]> desk-card-labels;
    in property <string> desk-about-label;
    in property <string> desk-details-label;
    in property <string> desk-install-more-label;
    in property <string> desk-zone: "list";
    in property <int> desk-zone-index;
    in property <string> desk-empty-title;
    in property <string> desk-empty-text;
    in property <string> desk-empty-action;
    in property <string> desk-empty-zone;
    in property <bool> desk-selecting;
    in property <bool> desk-reversed;
    in property <string> desk-view: "list";
    // BarraLateralUnida (Aparência › Layout): a lista vira uma coluna colada à barra de cima; `desk-sidebar-narrow` =
    // "Largura da barra lateral: Estreita" (vale para os dois layouts).
    in property <bool> desk-sidebar-unified;
    in property <bool> desk-sidebar-narrow;
    in property <string> desk-group-label;
    in property <string> desk-group-prefix;
    in property <[PanelRow]> desk-bulk;
    in property <bool> desk-loading;
    in property <string> desk-loading-label;
    in property <[string]> desk-view-labels;
    in property <[DeskCategory]> desk-categories;
    in property <int> desk-cat-focus-row;
    in property <int> desk-cat-focus-col;
    in property <string> desk-see-all;
    in property <string> desk-cat-empty;
    in property <string> desk-cat-empty-text;
    in property <string> desk-cat-empty-action;
    // Colunas da grade, para as setas andarem por elas (o Tako lê como na tela cheia).
    out property <int> library-columns: lib.columns;

    // Perfil (TelaPerfil).
    in property <DeskProfile> desk-profile;

    // Configurações (as mesmas propriedades da tela cheia).
    in property <string> settings-title;
    in property <string> settings-count;
    in property <string> settings-search;
    in property <string> desk-settings-search-hint;
    in property <[DeskNav]> settings-categories;
    in property <int> settings-category-focus;
    in property <string> settings-heading;
    in property <string> settings-subtitle;
    in property <[PanelRow]> settings-rows;
    in property <[CoverRow]> settings-covers;
    in property <int> settings-row-focus: -1;

    // Entrada: zona e índice (como na tela cheia), textos editados e a primeira linha visível da lista.
    callback clicked(string, int);
    callback hovered(string, int);
    callback edited(string, string);
    callback scrolled(int);
    callback key(string, bool, bool, bool, bool) -> bool;
    callback key-released(string);

    // Onde abrir o menu ⋯ / botão direito.
    property <length> menu-x;
    property <length> menu-y;

    title: "Tako";
    icon: @image-url("tako-mark.png");
    // Sem a moldura do sistema: a BarraDaJanela desenha logo e botões.
    no-frame: true;
    in property <string> desk-profile-name;
    in property <string> desk-profile-initial;
    out property <float> window-drag-start: bar.drag-start / 1px;
    out property <float> window-drag-end: bar.drag-end / 1px;
    in property <bool> window-maximized;
    in property <int> window-native-hover;
    in property <int> window-native-pressed;
    in property <bool> window-active: true;
    in property <string> desk-update-label;
    in property <[string]> desk-window-labels: ["", "", "", ""];
    callback window-action(string);
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Ui.desk-canvas;
    default-font-family: Ui.font-desk;

    // Janela abaixo de 1280 de largura: margens, cartões e título encolhem (JanelaPequena).
    // Janela baixa (1280 × 720) também: título, faixa, ações e cartões de 248 não cabem em 720.
    property <bool> small: self.width < 1280px || self.height < 760px;

    init => {
        // Escala de mesa dos tokens (o palco da tela cheia tem 1080 unidades de altura).
        Ui.u = 0.75px;
        root.sync-art();
        fs.focus();
    }
    function sync-art() {
        DeskArt.win-w = root.width;
        DeskArt.win-h = root.height;
        DeskArt.gray = page != "desk-library" && page != "desk-profile";
        // Troca de jogo: enquanto a arte nova carrega, fica a anterior (senão o fundo pisca sem arte e o vidro
        // fica sólido); quando chega, a arte faz um crossfade só.
        if (!desk-game.art-loading) {
            DeskArt.has-art = desk-game.has-game && desk-game.art.width > 0;
            DeskArt.blur = desk-game.art-blur;
            DeskArt.lum = desk-game.art-lum;
            DeskArt.accent = Ui.accent;
            DeskArt.accent-deep = Ui.accent-deep;
            if (desk-game.art.height > 0) {
                DeskArt.aspect = desk-game.art.width / desk-game.art.height;
            }
            root.art-shown = desk-game.art;
        }
    }
    property <image> art-shown;
    // A cor do jogo muda junto com a arte (enquanto a nova carrega, fica a do jogo que está na tela).
    property <color> accent-now: Ui.accent;
    changed accent-now => { root.sync-art(); }
    changed width => { root.sync-art(); }
    changed height => { root.sync-art(); }
    changed page => {
        floating-search = false;
        root.sync-art();
        if (page == "desk-library") {
            lib-in = false;
            lib-timer.running = true;
        }
    }
    // Volta para a biblioteca: o conteúdo entra 16 px em `tempo-pagina`.
    property <bool> lib-in: true;
    lib-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            lib-in = true;
        }
    }
    changed desk-game => { root.sync-art(); }

    property <int> content-search-focus;
    property <bool> floating-search;
    public function focus-content-search() {
        floating-search = page != "desk-library" && page != "settings";
        search-timer.running = true;
    }
    search-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => { self.running = false; content-search-focus += 1; }
    }
    changed desk-search-focus => { root.focus-content-search(); }

    // Teclado: o Tako decide o que cada tecla faz; Ctrl+K (ou Ctrl+F) vai para a busca e Ctrl+, para as Configurações.
    fs := FocusScope {
        key-pressed(e) => {
            if (e.modifiers.control && !e.modifiers.alt && (e.text == "k" || e.text == "K" || e.text == "f" || e.text == "F") && (page == "desk-library" || page == "settings" || page == "desk-profile") && overlays.length == 0) {
                root.focus-content-search();
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.alt && e.text == "," && overlays.length == 0) {
                root.clicked("desk-nav", 1);
                return accept;
            }
            if (root.key(e.text, e.repeat, e.modifiers.control, e.modifiers.shift, e.modifiers.alt)) { return accept; }
            reject
        }
        key-released(e) => {
            root.key-released(e.text);
            accept
        }
    }

    // Entrada do app (só na abertura): o Tako liga `desk-intro` antes do primeiro quadro (tudo apagado) e desliga
    // depois dele; aí a arte acende em `tempo-cor` e a barra 70 depois, só por opacidade (a barra não se move).
    in property <bool> desk-intro;
    changed desk-intro => { DeskIntro.on = !desk-intro; }
    property <float> intro-art: DeskIntro.on ? 1 : 0;
    animate intro-art { duration: Ui.color-time; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    ArtLayer {
        art: art-shown;
        opacity: intro-art;
    }
    // Perfil: escurecimento de cima para baixo mais forte que o da biblioteca (os blocos ficam sobre a parte escura).
    if page == "desk-profile": Rectangle {
        background: @linear-gradient(180deg, Ui.art-scrim-strong.with-alpha(0.2) 0%, Ui.art-scrim-strong.with-alpha(0.3) 26%,
            Ui.art-scrim-strong.with-alpha(0.8) 46%, Ui.art-scrim-strong 70%);
    }
    // Grade e Categorias: as capas são o conteúdo e a arte é só ambiente, com escurecimento mais forte.
    if page == "desk-library" && desk-view != "list": Rectangle {
        background: @linear-gradient(180deg, Ui.art-scrim-strong.with-alpha(0.35) 0%, Ui.art-scrim-strong.with-alpha(0.7) 22%,
            Ui.art-scrim-strong.with-alpha(0.88) 45%, Ui.art-scrim-strong 100%);
    }

    // Só a biblioteca em Lista tem coluna; Grade, Categorias e as outras telas ficam como sempre.
    property <bool> unified: desk-sidebar-unified && page == "desk-library" && !lib.wide;
    property <length> col-w: desk-sidebar-narrow ? 336px : 380px;
    // Um vidro só em L (barra + coluna) atrás das duas, que ficam sem vidro próprio: duas camadas deixariam uma
    // linha na emenda.
    if unified: Vidro {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        radius: 0px;
        edge: false;
        cut-x: col-w;
        cut-y: Ui.topbar-height;
    }

    VerticalLayout {
        padding-left: small ? Ui.space-20 : Ui.space-36;
        padding-right: small ? Ui.space-20 : Ui.space-36;
        padding-top: Ui.topbar-height + Ui.space-20;
        padding-bottom: small ? Ui.space-16 : Ui.space-28;
        spacing: small ? 14px : Ui.space-20;
        Rectangle {
            vertical-stretch: 1;
            lib := DeskLibrary {
                visible: page == "desk-library";
                x: lib-in ? 0 : 16px;
                opacity: lib-in ? 1 : 0;
                animate x, opacity { duration: Ui.enter(lib-in); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                search: desk-search;
                search-hint: desk-search-hint;
                search-key: desk-search-key;
                search-esc: desk-search-esc;
                search-focus: page == "desk-library" ? content-search-focus : 0;
                edited(t) => { root.edited("search", t); }
                tabs: desk-tabs;
                tab: desk-tab;
                collections: desk-collections;
                collection: desk-collection;
                small: root.small;
                filter-count: desk-filter-count;
                filter-chips: desk-filter-chips;
                clear-label: desk-clear-label;
                count: desk-count;
                count-short: desk-count-short;
                games: page == "desk-library" ? desk-games : [];
                selected: desk-selected;
                blocks: page == "desk-library" ? desk-blocks : [];
                grid-extent: desk-grid-extent;
                grid-focus: desk-grid-focus;
                focus-id: desk-focus-id;
                focus-group: desk-focus-group;
                game: desk-game;
                more: desk-more;
                actions: desk-actions;
                stats: desk-stats;
                details: desk-details;
                sessions-summary: desk-sessions-summary;
                sessions: desk-sessions;
                card-labels: desk-card-labels;
                about-label: desk-about-label;
                details-label: desk-details-label;
                more-install-label: desk-install-more-label;
                zone: desk-zone;
                zone-index: desk-zone-index;
                focus-visible: desk-focus-visible;
                empty-title: desk-empty-title;
                empty-text: desk-empty-text;
                empty-action: desk-empty-action;
                empty-zone: desk-empty-zone;
                selecting: desk-selecting;
                reversed: desk-reversed;
                view-in: desk-view;
                unified: desk-sidebar-unified;
                narrow: desk-sidebar-narrow;
                col-w: col-w;
                group-label: desk-group-label;
                group-prefix: desk-group-prefix;
                bulk: desk-bulk;
                loading: desk-loading;
                loading-label: desk-loading-label;
                view-labels: desk-view-labels;
                categories: page == "desk-library" ? desk-categories : [];
                cat-focus-row: desk-cat-focus-row;
                cat-focus-col: desk-cat-focus-col;
                see-all: desk-see-all;
                cat-empty: desk-cat-empty;
                cat-empty-text: desk-cat-empty-text;
                cat-empty-action: desk-cat-empty-action;
                clicked(z, i) => { root.clicked(z, i); }
                scrolled(f) => { root.scrolled(f); }
                menu(x, y) => {
                    root.menu-x = x;
                    root.menu-y = y;
                }
                focus-main => { fs.focus(); }
            }
            if page == "desk-profile": DeskProfileScreen {
                p: desk-profile;
                focus-visible: desk-focus-visible;
                small: root.small;
                clicked(z, i) => {
                    fs.focus();
                    root.clicked(z, i);
                }
            }
            settings := DeskSettings {
                visible: page == "settings";
                search: settings-search;
                search-hint: desk-settings-search-hint;
                search-key: desk-search-key;
                search-esc: desk-search-esc;
                search-focus: page == "settings" ? content-search-focus : 0;
                edited(t) => { root.edited("search", t); }
                focus-main => { fs.focus(); }
                count: settings-count;
                categories: settings-categories;
                category-focus: settings-category-focus;
                heading: settings-heading;
                subtitle: settings-subtitle;
                rows: settings-rows;
                covers: settings-covers;
                row-focus: settings-row-focus;
                focus-visible: desk-focus-visible;
                small: root.small;
                clicked(z, i) => {
                    fs.focus();
                    root.clicked(z, i);
                }
                menu(x, y) => {
                    root.menu-x = x;
                    root.menu-y = y;
                }
            }
        }
    }

    SearchBox {
        visible: floating-search && page == "desk-profile";
        x: (parent.width - self.width) / 2;
        y: Ui.topbar-height + Ui.space-20;
        width: root.small ? 280px : 420px;
        text: desk-search;
        hint: desk-search-hint;
        key-label: desk-search-key;
        esc-label: desk-search-esc;
        focus-request: content-search-focus;
        edited(t) => { root.edited("search", t); }
        leave => { floating-search = false; fs.focus(); }
    }

    if control-center: ControlCenter {
        icons: cc-icons;
        icon-focus: cc-icon-focus;
        panel-for: cc-panel-for;
        panel: cc-panel;
        panel-focus: cc-panel-focus;
        game-title: cc-game-title;
        game-meta: cc-game-meta;
        overlay: false;
        clicked(z, i) => { fs.focus(); root.clicked("cc-" + z, i); }
        hovered(z, i) => { root.hovered("cc-" + z, i); }
    }

    // As camadas ficam na área do app, abaixo da BarraDaJanela (que continua usável).
    for ov[i] in overlays: DeskOverlay {
        y: Ui.topbar-height;
        height: root.height - Ui.topbar-height;
        ov: ov;
        cancel-label: desk-cancel-label;
        ok-label: desk-ok-label;
        close-label: desk-window-labels[3];
        top-most: i == overlays.length - 1;
        focus-visible: desk-focus-visible;
        property <bool> brand-menu: ov.kind == "menu" && ov.rows[0].key == "settings" && ov.title == "";
        property <bool> profile-menu: ov.kind == "menu" && ov.rows[0].key == "view-profile";
        bar-menu: brand-menu || profile-menu;
        menu-x: brand-menu ? (small ? Ui.space-20 : Ui.space-36) : profile-menu ? bar.profile-x : root.menu-x;
        menu-y: brand-menu || profile-menu ? Ui.space-8 : root.menu-y - Ui.topbar-height;
        art: desk-game.art;
        leaving: leaving;
        clicked(z, idx) => {
            if (i == overlays.length - 1) {
                fs.focus();
                root.clicked("overlay-" + z, idx);
            }
        }
        hovered(z, idx) => { if (i == overlays.length - 1) { root.hovered("overlay-" + z, idx); } }
        edited(z, t) => { root.edited(z, t); }
        menu(x, y) => {
            root.menu-x = x;
            root.menu-y = y;
        }
    }

    // Aviso (toast, PainelEAviso): entra subindo 12 em `tempo-pagina`; sai só por opacidade em `tempo-saida` (o texto
    // fica até sumir). Não rouba o foco.
    property <string> toast-shown;
    property <bool> toast-on: toast != "";
    changed toast => {
        if (toast != "") {
            toast-shown = toast;
        }
    }
    // Aviso: vidro de camada denso (legível sobre qualquer arte).
    if toast-shown != "": Vidro {
        dense: true;
        property <bool> shown;
        Timer {
            interval: 1ms;
            running: true;
            triggered => {
                self.running = false;
                shown = true;
            }
        }
        layer: true;
        radius: self.height / 2;
        x: (root.width - self.width) / 2;
        // Depois de sumir, não recebe cliques (o "Desfazer" escondido não pode ser clicado).
        visible: self.opacity > 0;
        y: root.height - self.height - Ui.space-28 + (shown ? 0 : 12px);
        opacity: shown && toast-on ? 1 : 0;
        animate y { duration: Ui.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate opacity { duration: Ui.toast-fade(toast-on); easing: toast-on ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1); }
        height: Ui.control-height;
        width: tl.preferred-width;
        // Ponteiro por cima pausa o tempo do aviso (PainelEAviso); o "Desfazer" tem a própria zona.
        TouchArea { changed has-hover => { root.hovered("toast", self.has-hover ? 1 : 0); } }
        tl := HorizontalLayout {
            padding-left: Ui.space-20;
            padding-right: Ui.space-20;
            spacing: 10px;
            if !desk-toast-mascot: DeskIcon { name: "check"; size: 18px; tint: Ui.success; y: (parent.height - self.height) / 2; }
            if desk-toast-mascot: Octopus { y: (parent.height - self.height) / 2; width: 34px; with-name: false; self-assemble: true; accessible-role: none; }
            Text { text: toast-shown; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 600; vertical-alignment: center; }
            // "Desfazer" das ações em lote: texto clicável à direita, sem roubar o foco.
            if desk-toast-undo != "": Rectangle {
                width: ut.preferred-width + 16px;
                y: 6px;
                height: parent.height - 12px;
                border-radius: Ui.radius-thumb;
                background: uta.has-hover ? Ui.glass-hover : transparent;
                accessible-role: button;
                accessible-label: desk-toast-undo;
                ut := Text { text: desk-toast-undo; color: Ui.on-accent; font-size: Ui.desk-label; font-weight: 700; }
                uta := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => { root.hovered("toast", self.has-hover ? 3 : 2); }
                    clicked => { root.clicked("toast-undo", 0); }
                }
            }
        }
    }
    bar := TopBar {
        y: 0px;
        width: root.width;
        bare: unified;
        profile-name: desk-profile-name;
        profile-initial: desk-profile-initial;
        maximized: window-maximized;
        native-hover: window-native-hover;
        native-pressed: window-native-pressed;
        active: window-active;
        labels: desk-window-labels;
        update-label: desk-update-label;
        action(a) => { root.window-action(a); }
        items: desk-nav;
        big-picture-label: desk-big-picture-label;
        brand-label: desk-brand-label;
        brand-open: overlays.length > 0 && overlays[overlays.length - 1].kind == "menu" && overlays[overlays.length - 1].rows[0].key == "settings" && overlays[overlays.length - 1].title == "";
        small: root.small;
        focus-index: desk-focus-visible && desk-zone == "bar" && (page == "desk-library" || page == "desk-profile") ? desk-zone-index : -1;
        brand-menu(x, y) => {
            root.menu-x = x;
            root.menu-y = y;
        }
        clicked(z, i) => {
            fs.focus();
            root.clicked(z, i);
        }
    }
    Rectangle {
        border-radius: window-maximized ? 0px : 8px;
        border-width: 1px;
        border-color: #ffffff26;
        background: transparent;
    }
}
