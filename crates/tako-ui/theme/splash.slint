// TelaCarregamento: a janela de abertura (440 × 600, sem moldura, raio 16). O polvo se monta com o progresso: anel, corpo
// e TAKO desde o começo; cada um dos 7 tentáculos chega girando a partir da base quando a barra passa do ponto dele.
// Com todos no lugar, os tentáculos ondulam devagar e o corpo respira. Fora da API de tema (como o desktop).

import "fonts/PlusJakartaSans-Regular.ttf";
import { Ui } from "tokens.slint";
import { Octopus } from "polvo.slint";

export { Ui }

export component Splash inherits Window {
    no-frame: true;
    width: 440px;
    height: 600px;
    background: transparent;
    title: "Tako";
    icon: @image-url("tako-mark.png");
    // 0 a 1; negativo = ainda sem número (barra indeterminada).
    in property <float> progress: -1;
    in property <string> status;
    in property <string> percent;
    // Linha opcional embaixo da barra (tamanho e versão).
    in property <string> sub;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 16px;
        background: Ui.desk-canvas;
        clip: true;

        // Canvas com brilho lilás atrás do polvo
        Rectangle {
            x: 20px;
            y: 40px;
            width: 400px;
            height: 380px;
            background: @radial-gradient(circle, #beb4ff22 0%, transparent 70%);
        }

        // Logo vertical: 352 de largura, 28 do topo.
        Octopus {
            x: 44px;
            y: 28px;
            width: 352px;
            height: 401px;
            wave-forever: true;
            progress: root.progress;
            accessible-role: image;
            accessible-label: "Tako";
        }

        // Estado: texto e porcentagem (13, números tabulares), barra de 3 em pedra `#d8c8bc` sobre `#1a1a20` e a linha opcional.
        VerticalLayout {
            x: 44px;
            y: parent.height - 36px - self.height;
            width: parent.width - 88px;
            height: self.preferred-height;
            spacing: 8px;
            HorizontalLayout {
                Text { text: status; color: Ui.splash-muted; font-family: "Plus Jakarta Sans"; font-size: 13px; horizontal-stretch: 1; overflow: elide; }
                Text { text: percent; color: Ui.splash-muted; font-family: "Plus Jakarta Sans"; font-size: 13px; }
            }
            Rectangle {
                height: 3px;
                border-radius: 1.5px;
                background: Ui.splash-track;
                clip: true;
                accessible-role: progress-indicator;
                accessible-label: status;
                accessible-value: percent;
                // Barra real; sem número, um trecho de 30% que corre (parado com "Reduzir animações").
                if progress >= 0: Rectangle { x: 0; width: parent.width * clamp(progress, 0, 1); border-radius: 1.5px; background: Ui.splash-bar; }
                if progress < 0: Rectangle {
                    width: parent.width * 0.3;
                    x: Ui.reduce-motion ? parent.width * 0.2 : (parent.width * 1.3) * mod(animation-tick() / 1400ms, 1) - self.width;
                    border-radius: 1.5px;
                    background: Ui.splash-bar;
                }
            }
            if sub != "": Text { text: sub; color: Ui.splash-muted; font-family: "Plus Jakarta Sans"; font-size: 12px; }
        }
    }
}
