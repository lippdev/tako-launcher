// Gerado de src/Launcher.UI.Wpf/Resources/Icons.xaml (ícones 24x24 do Tako; logos das lojas: Simple Icons, CC0).
// Traço (stroke) e preenchimento (fill) separados, como no WPF.

export global Icons {
    public pure function stroke(name: string) -> string {
        if (name == "home") { return "M 3 11.5 L 12 4 l 9 7.5 V 20 a 1 1 0 0 1 -1 1 h -5 v -6 H 9 v 6 H 4 a 1 1 0 0 1 -1 -1 Z"; }
        else if (name == "image") { return "M 4.5 5 H 19.5 A 1 1 0 0 1 20.5 6 V 18 A 1 1 0 0 1 19.5 19 H 4.5 A 1 1 0 0 1 3.5 18 V 6 A 1 1 0 0 1 4.5 5 Z M 3.5 16 l 5 -5 l 4 4 l 3 -3 l 5 5 M 14.5 9 A 1.5 1.5 0 1 0 17.5 9 A 1.5 1.5 0 1 0 14.5 9 Z"; }
        else if (name == "grid") { return "M 5 3.5 H 9 A 1.5 1.5 0 0 1 10.5 5 V 9 A 1.5 1.5 0 0 1 9 10.5 H 5 A 1.5 1.5 0 0 1 3.5 9 V 5 A 1.5 1.5 0 0 1 5 3.5 Z M 15 3.5 H 19 A 1.5 1.5 0 0 1 20.5 5 V 9 A 1.5 1.5 0 0 1 19 10.5 H 15 A 1.5 1.5 0 0 1 13.5 9 V 5 A 1.5 1.5 0 0 1 15 3.5 Z M 5 13.5 H 9 A 1.5 1.5 0 0 1 10.5 15 V 19 A 1.5 1.5 0 0 1 9 20.5 H 5 A 1.5 1.5 0 0 1 3.5 19 V 15 A 1.5 1.5 0 0 1 5 13.5 Z M 15 13.5 H 19 A 1.5 1.5 0 0 1 20.5 15 V 19 A 1.5 1.5 0 0 1 19 20.5 H 15 A 1.5 1.5 0 0 1 13.5 19 V 15 A 1.5 1.5 0 0 1 15 13.5 Z"; }
        else if (name == "check") { return "M 3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12 Z M 7.5 12.5 l 3 3 l 6 -6.5"; }
        else if (name == "star") { return "M 12 3.5 L 14.6 8.9 l 5.9 0.8 l -4.3 4.1 l 1 5.8 L 12 16.9 l -5.2 2.7 l 1 -5.8 l -4.3 -4.1 l 5.9 -0.8 Z"; }
        else if (name == "gear") { return "M 8.8 12 A 3.2 3.2 0 1 0 15.2 12 A 3.2 3.2 0 1 0 8.8 12 Z M 19.4 13.5 a 7.6 7.6 0 0 0 0 -3 l 2 -1.6 l -2 -3.4 l -2.4 1 a 7.4 7.4 0 0 0 -2.6 -1.5 L 14 2.5 h -4 l -0.4 2.5 A 7.4 7.4 0 0 0 7 6.5 l -2.4 -1 l -2 3.4 l 2 1.6 a 7.6 7.6 0 0 0 0 3 l -2 1.6 l 2 3.4 l 2.4 -1 a 7.4 7.4 0 0 0 2.6 1.5 l 0.4 2.5 h 4 l 0.4 -2.5 a 7.4 7.4 0 0 0 2.6 -1.5 l 2.4 1 l 2 -3.4 Z"; }
        else if (name == "power") { return "M 12 3 v 9 M 6.3 6.8 a 8 8 0 1 0 11.4 0"; }
        else if (name == "search") { return "M 4.5 11 A 6.5 6.5 0 1 0 17.5 11 A 6.5 6.5 0 1 0 4.5 11 Z M 16 16 l 4.5 4.5"; }
        else if (name == "info") { return "M 3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12 Z M 12 11 v 6"; }
        else if (name == "chevron") { return "M 9 5 l 7 7 l -7 7"; }
        else if (name == "more") { return "M 3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12 Z M 12 8 v 8 M 8 12 h 8"; }
        else if (name == "alert") { return "M 12 3 L 2.5 20 h 19 Z M 12 10 v 4.5"; }
        else if (name == "folder") { return "M 3 7 a 2 2 0 0 1 2 -2 h 4 l 2 2 h 8 a 2 2 0 0 1 2 2 v 8 a 2 2 0 0 1 -2 2 H 5 a 2 2 0 0 1 -2 -2 Z"; }
        else if (name == "gamepad") { return "M 7 8 h 10 a 5 5 0 0 1 4.8 6.4 l -0.9 3 a 2.5 2.5 0 0 1 -4.3 0.9 L 14.5 16 h -5 l -2.1 2.3 a 2.5 2.5 0 0 1 -4.3 -0.9 l -0.9 -3 A 5 5 0 0 1 7 8 Z M 8 11 v 3 M 6.5 12.5 h 3"; }
        else if (name == "keyboard") { return "M 4.5 6 H 19.5 A 2 2 0 0 1 21.5 8 V 16 A 2 2 0 0 1 19.5 18 H 4.5 A 2 2 0 0 1 2.5 16 V 8 A 2 2 0 0 1 4.5 6 Z M 7 14 h 10"; }
        else if (name == "camera") { return "M 4 8 h 3 l 2 -3 h 6 l 2 3 h 3 a 1 1 0 0 1 1 1 v 9 a 1 1 0 0 1 -1 1 H 4 a 1 1 0 0 1 -1 -1 V 9 a 1 1 0 0 1 1 -1 Z M 8.5 13 A 3.5 3.5 0 1 0 15.5 13 A 3.5 3.5 0 1 0 8.5 13 Z"; }
        else if (name == "gauge") { return "M 4.5 17 a 8 8 0 1 1 15 0 M 12 13 l 4 -4"; }
        else if (name == "volume") { return "M 4 9.5 h 3.5 L 12 6 v 12 l -4.5 -3.5 H 4 Z M 15.5 9.5 a 3.5 3.5 0 0 1 0 5 M 18 7 a 7 7 0 0 1 0 10"; }
        else if (name == "monitor") { return "M 4.5 4.5 H 19.5 A 1.5 1.5 0 0 1 21 6 V 15 A 1.5 1.5 0 0 1 19.5 16.5 H 4.5 A 1.5 1.5 0 0 1 3 15 V 6 A 1.5 1.5 0 0 1 4.5 4.5 Z M 9 20 h 6 M 12 16.5 V 20"; }
        else if (name == "tv") { return "M 3.5 6 H 20.5 A 1.5 1.5 0 0 1 22 7.5 V 16 A 1.5 1.5 0 0 1 20.5 17.5 H 3.5 A 1.5 1.5 0 0 1 2 16 V 7.5 A 1.5 1.5 0 0 1 3.5 6 Z M 8 21 h 8 M 9 2.5 l 3 3.5 l 3 -3.5"; }
        else if (name == "palette") { return "M 12 3 a 9 9 0 1 0 0 18 c 1.2 0 1.8 -0.8 1.8 -1.7 c 0 -1.3 -1.2 -1.6 -1.2 -2.8 c 0 -1 0.8 -1.5 1.8 -1.5 H 17 a 4 4 0 0 0 4 -4 C 21 6.6 17 3 12 3 Z"; }
        else if (name == "limit") { return "M 4.5 16 a 8 8 0 1 1 15 0 M 12 12 l 3 -4.5 M 5 20 h 14"; }
        else if (name == "pointer") { return "M 6 3 L 6 18.5 L 10.2 14.6 L 13.2 21 L 15.9 19.8 L 12.9 13.5 L 18.5 13.2 Z"; }
        else if (name == "battery") { return "M 4.5 7.5 H 17.5 A 2 2 0 0 1 19.5 9.5 V 14.5 A 2 2 0 0 1 17.5 16.5 H 4.5 A 2 2 0 0 1 2.5 14.5 V 9.5 A 2 2 0 0 1 4.5 7.5 Z M 21.5 10.5 v 3"; }
        else if (name == "filter") { return "M 4 7 h 9 M 17 7 h 3 M 4 17 h 3 M 11 17 h 9 M 13 7 A 2 2 0 1 0 17 7 A 2 2 0 1 0 13 7 Z M 7 17 A 2 2 0 1 0 11 17 A 2 2 0 1 0 7 17 Z"; }
        else if (name == "sort") { return "M 7 4 v 16 M 3.5 16.5 L 7 20 l 3.5 -3.5 M 17 20 V 4 M 13.5 7.5 L 17 4 l 3.5 3.5"; }
        else if (name == "close") { return "M 6 6 l 12 12 M 18 6 l -12 12"; }
        return "";
    }
