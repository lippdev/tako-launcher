// Componentes do tema padrão (DESIGN.md › Components).
import { Ui } from "tokens.slint";
import { Icons } from "icons.slint";

export struct Hint { glyph: string, label: string }

// Linha de painel, de configurações ou de diálogo. `kind`: toggle, choice, action, info, header,
// radio, check, slider, text, button.
export struct PanelRow {
    key: string,
    kind: string,
    title: string,
    description: string,
    value: string,
    action: string,
    on: bool,
    enabled: bool,
    emphasized: bool,
    icon: string,
    style: string,
    image: image,
}

export component Icon inherits Rectangle {
    in property <string> name;
    in property <color> tint: Ui.on-accent;
    in property <length> size: 26 * Ui.u;
    width: size;
    height: size;
    if Icons.stroke(name) != "": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Icons.stroke(name);
        stroke: tint;
        stroke-width: 1.8 * size / 24;
        fill: transparent;
    }
    if Icons.fill(name) != "": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Icons.fill(name);
        fill: tint;
    }
}

// Glifo de botão do controle (círculo branco com a letra) ou tecla.
export component Glyph inherits Rectangle {
    in property <string> label;
    property <bool> wide: label.character-count > 2;
    height: 34 * Ui.u;
    width: wide ? t.preferred-width + 20 * Ui.u : 34 * Ui.u;
    border-radius: self.height / 2;
    background: Ui.surface-solid;
    t := Text {
        text: label;
        color: Ui.on-surface-solid;
        font-size: 18 * Ui.u;
        font-weight: 800;
        font-family: Ui.font-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component HintBar inherits Rectangle {
    in property <[Hint]> hints;
    callback activate(int);
    height: Ui.hint-bar;
    HorizontalLayout {
        padding-left: Ui.safe-x;
        padding-right: Ui.safe-x;
        spacing: 36 * Ui.u;
        alignment: end;
        for h[i] in hints: HorizontalLayout {
            spacing: 12 * Ui.u;
            alignment: center;
            Glyph { label: h.glyph; y: (parent.height - self.height) / 2; }
            Text {
                text: h.label;
                color: Ui.on-accent-muted;
                font-size: Ui.label-sm;
                font-weight: 500;
                font-family: Ui.font-text;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.activate(i); } }
        }
    }
}

// Pílula: botão primário (branco) ou secundário (translúcido).
export component Pill inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> focused;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    callback hovered();
    property <bool> solid: primary || focused;
    height: 76 * Ui.u;
    width: max(76 * Ui.u, lay.preferred-width);
    border-radius: self.height / 2;
    background: solid ? Ui.surface-solid : Ui.surface-2;
    opacity: enabled ? 1 : 0.45;
    animate background { duration: Ui.focus-time; }
    Rectangle {
        x: -6 * Ui.u;
        y: -6 * Ui.u;
        width: parent.width + 12 * Ui.u;
        height: parent.height + 12 * Ui.u;
        border-radius: self.height / 2;
        border-width: focused ? 4 * Ui.u : 0;
        border-color: Ui.surface-solid;
    }
    lay := HorizontalLayout {
        padding-left: label == "" ? 25 * Ui.u : 44 * Ui.u;
        padding-right: label == "" ? 25 * Ui.u : 44 * Ui.u;
        spacing: 14 * Ui.u;
        alignment: center;
        if icon != "": Icon {
            name: icon;
            y: (parent.height - self.height) / 2;
            tint: danger && !solid ? Ui.error : (solid ? Ui.on-surface-solid : Ui.on-accent);
        }
        if label != "": Text {
            text: label;
            color: danger && !solid ? Ui.error : (solid ? Ui.on-surface-solid : Ui.on-accent);
            font-size: Ui.label-lg;
            font-weight: 600;
            font-family: Ui.font-text;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => { if (self.has-hover) { root.hovered(); } }
    }
}

// Chave liga/desliga, com as cores "sobre superfície sólida" quando a linha está focada.
export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> solid;
    width: 64 * Ui.u;
    height: 36 * Ui.u;
    border-radius: self.height / 2;
    background: on ? (solid ? Ui.control-on-on-solid : Ui.success) : (solid ? transparent : Ui.control-track-off);
    border-width: !on && solid ? 2 * Ui.u : 0;
    border-color: Ui.control-off-on-solid;
    animate background { duration: Ui.focus-time; }
    Rectangle {
        width: 26 * Ui.u;
        height: 26 * Ui.u;
        border-radius: self.height / 2;
        y: 5 * Ui.u;
        x: on ? parent.width - self.width - 5 * Ui.u : 5 * Ui.u;
        background: !on && solid ? Ui.control-off-on-solid : #FFFFFF;
        animate x { duration: Ui.focus-time; }
    }
}

// Linha de configuração ou de painel.
export component RowView inherits Rectangle {
    in property <PanelRow> data;
    in property <bool> focused;
    // Painel lateral: linha focada vira a superfície sólida; Configurações: ganha surface-2.
    in property <bool> panel-style: true;
    callback clicked();
    callback hovered();
    property <bool> solid: focused && panel-style;
    property <color> fg: solid ? Ui.on-surface-solid : Ui.on-accent;
    property <color> fg-muted: solid ? Ui.on-surface-solid-muted : Ui.on-accent-muted;
    property <bool> is-header: data.kind == "header";
    height: is-header ? 64 * Ui.u : max(92 * Ui.u, lay.preferred-height);
    border-radius: Ui.radius-lg;
    background: is-header ? transparent : (solid ? Ui.surface-solid : (focused ? Ui.surface-2 : Ui.surface-1));
    opacity: data.enabled || is-header ? 1 : 0.45;
    animate background { duration: Ui.focus-time; }
    if focused && !panel-style: Rectangle {
        x: -6 * Ui.u;
        y: -6 * Ui.u;
        width: parent.width + 12 * Ui.u;
        height: parent.height + 12 * Ui.u;
        border-radius: Ui.radius-lg + 6 * Ui.u;
        border-width: 4 * Ui.u;
        border-color: Ui.surface-solid;
    }
    if is-header: Text {
        x: 8 * Ui.u;
        y: parent.height - self.height - 10 * Ui.u;
        text: data.title;
        color: Ui.on-accent-muted;
        font-size: Ui.label-sm;
        font-weight: 700;
        letter-spacing: 0.16 * Ui.label-sm;
        font-family: Ui.font-text;
    }
    lay := HorizontalLayout {
        visible: !is-header;
        padding-left: 28 * Ui.u;
        padding-right: 28 * Ui.u;
        padding-top: 16 * Ui.u;
        padding-bottom: 16 * Ui.u;
        spacing: 20 * Ui.u;
        if data.kind == "radio" || data.kind == "check": Rectangle {
            width: 30 * Ui.u;
            height: 30 * Ui.u;
            y: (parent.height - self.height) / 2;
            border-radius: data.kind == "radio" ? self.height / 2 : 6 * Ui.u;
            border-width: 2.5 * Ui.u;
            border-color: solid ? Ui.control-off-on-solid : Ui.control-off;
            Rectangle {
                width: 16 * Ui.u;
                height: 16 * Ui.u;
                border-radius: data.kind == "radio" ? self.height / 2 : 3 * Ui.u;
                background: fg;
                visible: data.on;
            }
        }
        if data.icon != "": Icon { name: data.icon; tint: fg; y: (parent.height - self.height) / 2; }
        if data.image.width > 0: Image {
            source: data.image;
            width: 48 * Ui.u;
            height: 48 * Ui.u;
            image-fit: contain;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 4 * Ui.u;
            horizontal-stretch: 1;
            Text {
                text: data.title;
                color: data.style == "danger" && !solid ? Ui.error : fg;
                font-size: Ui.label-lg;
                font-weight: data.emphasized ? 700 : 600;
                font-family: Ui.font-text;
                overflow: elide;
            }
            if data.description != "": Text {
                text: data.description;
                color: fg-muted;
                font-size: Ui.label-sm;
                font-family: Ui.font-text;
                wrap: word-wrap;
                max-height: 2 * 23 * Ui.u;
                overflow: elide;
            }
        }
        if data.kind == "toggle": Toggle { on: data.on; solid: solid; y: (parent.height - self.height) / 2; }
        if data.value != "" && data.kind != "toggle": Rectangle {
            y: (parent.height - self.height) / 2;
            height: 48 * Ui.u;
            width: vt.preferred-width + 36 * Ui.u + (data.kind == "action" || data.kind == "choice" ? 30 * Ui.u : 0);
            border-radius: self.height / 2;
            background: solid ? Ui.value-pill-on-solid : Ui.surface-2;
            vt := Text {
                x: 18 * Ui.u;
                text: data.value;
                color: data.emphasized ? fg : fg-muted;
                font-size: Ui.label-md;
                font-weight: data.emphasized ? 700 : 600;
                font-family: Ui.font-text;
                vertical-alignment: center;
            }
            if data.kind == "action" || data.kind == "choice": Text {
                x: parent.width - 34 * Ui.u;
                text: data.kind == "choice" ? "⇄" : "›";
                color: fg-muted;
                font-size: Ui.label-lg;
                vertical-alignment: center;
            }
        }
        if data.value == "" && data.kind == "action": Icon {
            name: "chevron";
            tint: fg-muted;
            size: 24 * Ui.u;
            y: (parent.height - self.height) / 2;
        }
        if data.kind == "slider": Rectangle {
            y: (parent.height - self.height) / 2;
            width: 260 * Ui.u;
            height: 10 * Ui.u;
            border-radius: self.height / 2;
            background: solid ? Ui.control-track-on-solid : Ui.control-track-off;
            Rectangle {
                x: 0;
                width: parent.width * clamp(data.value.to-float() / 100, 0, 1);
                border-radius: parent.border-radius;
                background: fg;
            }
        }
    }
    TouchArea {
        enabled: !is-header;
        clicked => { root.clicked(); }
        changed has-hover => { if (self.has-hover) { root.hovered(); } }
    }
}
